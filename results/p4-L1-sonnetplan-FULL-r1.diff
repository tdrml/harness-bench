+// ---------------------------------------------------------------------------
+// getDocumenterPrompt
+// ---------------------------------------------------------------------------
+
+describe('getDocumenterPrompt', () => {
+  const baseParams = {
+    repoFullName: 'acme/telos',
+    correlationId: 'corr-abc123',
+  };
+
+  it('returns a non-empty string', () => {
+    const result = getDocumenterPrompt(baseParams);
+    expect(typeof result).toBe('string');
+    expect(result.length).toBeGreaterThan(0);
+  });
+
+  it('interpolates repoFullName', () => {
+    const result = getDocumenterPrompt(baseParams);
+    expect(result).toContain('acme/telos');
+  });
+
+  it('interpolates correlationId', () => {
+    const result = getDocumenterPrompt(baseParams);
+    expect(result).toContain('corr-abc123');
+  });
+
+  it('includes role definition', () => {
+    const result = getDocumenterPrompt(baseParams);
+    expect(result.toLowerCase()).toContain('documentarian');
+  });
+
+  it('includes docs/OVERVIEW.md as output path', () => {
+    const result = getDocumenterPrompt(baseParams);
+    expect(result).toContain('docs/OVERVIEW.md');
+  });
+
+  it('includes expected output format with overviewPath and summary', () => {
+    const result = getDocumenterPrompt(baseParams);
+    expect(result).toContain('overviewPath');
+    expect(result).toContain('summary');
+  });
+
+  it('includes security guardrails', () => {
+    const result = getDocumenterPrompt(baseParams);
+    expect(result.toLowerCase()).toContain('secret');
+  });
+
+  it('includes prohibited operations', () => {
+    const result = getDocumenterPrompt(baseParams);
+    expect(result.toLowerCase()).toContain('do not commit');
+  });
+
+  it('interpolates optional repoStructure', () => {
+    const result = getDocumenterPrompt({
+      ...baseParams,
+      repoStructure: 'packages/\n  core/\n    src/index.ts',
+    });
+    expect(result).toContain('packages/');
+    expect(result).toContain('core/');
+  });
+
+  it('interpolates optional existingOverview', () => {
+    const result = getDocumenterPrompt({
+      ...baseParams,
+      existingOverview: '# Existing Overview\n\nOld content',
+    });
+    expect(result).toContain('Existing Overview');
+    expect(result).toContain('Old content');
+  });
+
+  it('omits repo structure section when not provided', () => {
+    const result = getDocumenterPrompt(baseParams);
+    expect(result).not.toContain('Repository Structure');
+  });
+
+  it('omits existing overview section when not provided', () => {
+    const result = getDocumenterPrompt(baseParams);
+    expect(result).not.toContain('Existing Overview');
+  });
+});
