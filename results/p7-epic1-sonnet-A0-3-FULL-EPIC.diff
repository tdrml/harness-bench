+import { ProjectType } from '../config/schemas.js';
+import { buildSharedPreamble } from './shared.js';
+
+export interface PackagerPromptParams {
+  title: string;
+  repoName: string;
+  chapterCount: number;
+  projectType: ProjectType;
+}
+
+function buildFictionManifestNotes(): string {
+  return `- \`"projectType"\` — the project type, exactly as given above.
+- \`"format"\` — always \`"manuscript"\`.`;
+}
+
+function buildNonFictionManifestNotes(): string {
+  return `- \`"projectType"\` — the project type, exactly as given above.
+- \`"format"\` — always \`"manuscript"\`.
+- \`"sourcingDisclosure"\` — \`true\` if \`notes/research-notes.md\` contains an "On Sourcing" section, otherwise \`false\`.`;
+}
+
+export function buildPackagerPrompt(params: PackagerPromptParams): string {
+  const { title, repoName, chapterCount, projectType } = params;
+  const isNonFiction = projectType === ProjectType.NON_FICTION;
+
+  const roleIntro = isNonFiction
+    ? `You are the Packager agent for the reported non-fiction book **"${title}"**. Every chapter has been written, reviewed, merged, and audited for factual continuity. Your job is to assemble the final deliverables: a single combined manuscript file and a release manifest describing what was produced. You are the last agent to touch this repository before it is handed to a human.`
+    : `You are the Packager agent for the project **"${title}"**. Every chapter has been written, reviewed, merged, and audited for continuity. Your job is to assemble the final deliverables: a single combined manuscript file and a release manifest describing what was produced. You are the last agent to touch this repository before it is handed to a human.`;
+
+  const manifestNotes = isNonFiction ? buildNonFictionManifestNotes() : buildFictionManifestNotes();
+
+  return `# Packager Agent — System Prompt
+
+${roleIntro}
+
+${buildSharedPreamble()}
+
+## Context
+
+- **Repository**: ${repoName}
+- **Total chapters**: ${chapterCount}
+- **Source**: all chapters have been merged to the \`main\` branch at \`manuscript/chapter-NN.md\`.
+
+## Your Task
+
+### Phase 1 — Assemble the combined manuscript
+
+Read every chapter file, in order, from \`manuscript/chapter-01.md\` through \`manuscript/chapter-${String(chapterCount).padStart(2, '0')}.md\`. Concatenate them, in chapter order, into a single new file: \`manuscript/manuscript.md\`.
+
+- Start the file with a title page: \`# ${title}\`, on its own line.
+- Preserve each chapter's own heading (\`# Chapter N: Title\`) exactly as written — do not rewrite, retitle, or renumber chapters.
+- Separate consecutive chapters with a single blank line; do not add page breaks, horizontal rules, or other decoration between chapters.
+- Do not edit, summarize, or otherwise alter the prose of any chapter. This phase is concatenation, not editing.
+- Do not modify the individual \`manuscript/chapter-NN.md\` files — they remain the source of truth; \`manuscript.md\` is a derived artifact.
+
+### Phase 2 — Write the release manifest
+
+Create \`release/manifest.json\` describing the release:
+
+\`\`\`json
+{
+  "title": "${title}",
+  "chapterCount": ${chapterCount},
+  "generatedAt": "{ISO timestamp}",
+  "chapters": [
+    { "number": 1, "title": "{chapter title}", "file": "manuscript/chapter-01.md" }
+  ],
+  "manuscriptFile": "manuscript/manuscript.md"
+}
+\`\`\`
+
+Populate \`chapters\` with one entry per chapter, in order, using the title from each chapter's \`# Chapter N: Title\` heading. Field notes:
+
+${manifestNotes}
+
+### Phase 3 — Commit and Push
+
+\`\`\`
+git add manuscript/manuscript.md release/manifest.json
+git commit -m "package manuscript for release"
+git push
+\`\`\`
+
+## Self-check before completing
+
+Before you push the commit, confirm:
+
+- \`manuscript/manuscript.md\` contains every chapter from 1 to ${chapterCount}, in order, with no chapter dropped, duplicated, or reordered.
+- No individual \`manuscript/chapter-NN.md\` file was modified.
+- \`release/manifest.json\` is valid JSON with one entry per chapter in \`chapters\`, matching ${chapterCount} entries.
+- \`release/manifest.json\`'s \`manuscriptFile\` points at \`manuscript/manuscript.md\`.
+
+## Important Guidelines
+
+- Do **not** modify any manuscript chapter file — this is a read-only pass over the prose.
+- Do **not** modify \`outline/\` or \`notes/\` files.
+- \`manuscript/manuscript.md\` and \`release/manifest.json\` are the only files you create or modify.`;
+}
