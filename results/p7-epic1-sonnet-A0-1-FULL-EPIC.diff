+/**
+ * Integration test: Store listing generation stage.
+ *
+ * Verifies that GENERATE_LISTING work items are dispatched to the marketer
+ * handler, that a successful marketer run is validated and moves the project
+ * to RELEASED, that an invalid listing moves the project to FAILED, and that
+ * a failed marketer run is retried by re-enqueuing GENERATE_LISTING.
+ */
+import { describe, it, expect, beforeEach, beforeAll, vi } from 'vitest';
+
+vi.mock('@auto-graph/core', async (importOriginal) => {
+  const actual = await importOriginal<typeof import('@auto-graph/core')>();
+  const mockAws = await import('./helpers/mock-aws.js');
+  const { mockGitHub } = await import('./helpers/mock-github.js');
+  const { addToQueue } = await import('./helpers/queue.js');
+  const { TEST_PROJECT_CONFIG, PROJECT_ID } = await import('./helpers/test-data.js');
+
+  return {
+    ...actual,
+    createDynamoClient: vi.fn().mockReturnValue({}),
+    ProjectService: mockAws.MockProjectService,
+    TaskGraphService: mockAws.MockTaskGraphService,
+    AgentRunService: mockAws.MockAgentRunService,
+    RepoLockService: mockAws.MockRepoLockService,
+    TaskOutputService: mockAws.MockTaskOutputService,
+    RateLimitService: mockAws.MockRateLimitService,
+    createGitHubClient: vi.fn().mockReturnValue(mockGitHub),
+    enqueue: vi.fn().mockImplementation(async (_url: string, item: unknown) => {
+      addToQueue(item);
+    }),
+    validateProjectConfig: vi.fn().mockImplementation((data: Record<string, unknown>) => ({
+      ...TEST_PROJECT_CONFIG,
+      projectId: (data['projectId'] as string | undefined) ?? PROJECT_ID,
+    })),
+  };
+});
+
+vi.mock('../../shared/index.js', async (importOriginal) => {
+  const actual = await importOriginal<typeof import('../../shared/index.js')>();
+  return {
+    ...actual,
+    getECSTaskStatus: vi.fn().mockResolvedValue({ status: 'STOPPED', exitCode: 0 }),
+  };
+});
+
+// launchAgentRun calls launchECSTask directly from ecs-launcher.js (not via
+// the shared barrel), so the ECS launch mock must target that module.
+vi.mock('../../shared/ecs-launcher.js', async (importOriginal) => {
+  const actual = await importOriginal<typeof import('../../shared/ecs-launcher.js')>();
+  return {
+    ...actual,
+    launchECSTask: vi.fn().mockResolvedValue(
+      'arn:aws:ecs:us-east-1:123456789:task/inttest/mock-task-id',
+    ),
+  };
+});
+
+import { store, resetStore } from './helpers/store.js';
+import { resetQueue, pendingQueue } from './helpers/queue.js';
+import { resetMockGitHub, fileContents } from './helpers/mock-github.js';
+import {
+  PROJECT_ID,
+  BASE_ENV,
+  MOCK_TASK_ARN,
+  makeProjectItem,
+} from './helpers/test-data.js';
+import { dispatch } from './helpers/pipeline-runner.js';
+import { getECSTaskStatus } from '../../shared/index.js';
+
+const VALID_LISTING = {
+  title: 'The Test Novel',
+  blurb: 'A hero embarks on a journey to save the world from ancient darkness.',
+  keywords: ['fantasy', 'hero', 'darkness', 'quest', 'adventure', 'magic', 'legend'],
+  categories: ['Fantasy', 'Adventure', 'Young Adult'],
+  author: 'Jordan Vale',
+};
+
+beforeAll(() => {
+  for (const [key, value] of Object.entries(BASE_ENV)) {
+    process.env[key] = value;
+  }
+});
+
+beforeEach(() => {
+  resetStore();
+  resetQueue();
+  resetMockGitHub();
+  fileContents.delete('release/listing.json');
+  vi.mocked(getECSTaskStatus).mockResolvedValue({ status: 'STOPPED', exitCode: 0 });
+});
+
+describe('GENERATE_LISTING dispatch', () => {
+  it('launches the marketer ECS task, marks the project RELEASING, and enqueues RECONCILE', async () => {
+    store.projects.set(PROJECT_ID, makeProjectItem({ status: 'PACKAGING' }));
+
+    await dispatch({ type: 'GENERATE_LISTING', projectId: PROJECT_ID });
+
+    const project = store.projects.get(PROJECT_ID);
+    expect(project?.status).toBe('RELEASING');
+
+    const agentRuns = Array.from(store.agentRuns.values());
+    expect(agentRuns).toHaveLength(1);
+    expect(agentRuns[0]?.workerType).toBe('marketer');
+    expect(agentRuns[0]?.status).toBe('RUNNING');
+
+    expect(pendingQueue).toHaveLength(1);
+    expect(pendingQueue[0]).toMatchObject({ type: 'RECONCILE', projectId: PROJECT_ID });
+  });
+});
+
+describe('GENERATE_LISTING reconcile — success with valid listing', () => {
+  it('marks the marketer agent run SUCCEEDED and the project RELEASED', async () => {
+    store.projects.set(PROJECT_ID, makeProjectItem({ status: 'RELEASING' }));
+    fileContents.set('release/listing.json', JSON.stringify(VALID_LISTING));
+
+    const runId = 'run-marketer-1';
+    store.agentRuns.set(runId, {
+      runId,
+      projectId: PROJECT_ID,
+      taskArn: MOCK_TASK_ARN,
+      workerType: 'marketer',
+      status: 'RUNNING',
+      startedAt: new Date().toISOString(),
+    });
+
+    await dispatch({ type: 'RECONCILE', projectId: PROJECT_ID, runId });
+
+    expect(store.agentRuns.get(runId)?.status).toBe('SUCCEEDED');
+    expect(store.projects.get(PROJECT_ID)?.status).toBe('RELEASED');
+  });
+});
+
+describe('GENERATE_LISTING reconcile — success with invalid listing', () => {
+  it('marks the project FAILED when the listing fails validation', async () => {
+    store.projects.set(PROJECT_ID, makeProjectItem({ status: 'RELEASING' }));
+    fileContents.set(
+      'release/listing.json',
+      JSON.stringify({ ...VALID_LISTING, categories: ['Fantasy'] }),
+    );
+
+    const runId = 'run-marketer-invalid';
+    store.agentRuns.set(runId, {
+      runId,
+      projectId: PROJECT_ID,
+      taskArn: MOCK_TASK_ARN,
+      workerType: 'marketer',
+      status: 'RUNNING',
+      startedAt: new Date().toISOString(),
+    });
+
+    await dispatch({ type: 'RECONCILE', projectId: PROJECT_ID, runId });
+
+    expect(store.agentRuns.get(runId)?.status).toBe('SUCCEEDED');
+    expect(store.projects.get(PROJECT_ID)?.status).toBe('FAILED');
+  });
+});
+
+describe('GENERATE_LISTING reconcile — success with missing listing', () => {
+  it('marks the project FAILED when release/listing.json is missing', async () => {
+    store.projects.set(PROJECT_ID, makeProjectItem({ status: 'RELEASING' }));
+    // No fileContents entry — mock-github returns '' for unknown paths, which
+    // is not valid JSON.
+
+    const runId = 'run-marketer-missing';
+    store.agentRuns.set(runId, {
+      runId,
+      projectId: PROJECT_ID,
+      taskArn: MOCK_TASK_ARN,
+      workerType: 'marketer',
+      status: 'RUNNING',
+      startedAt: new Date().toISOString(),
+    });
+
+    await dispatch({ type: 'RECONCILE', projectId: PROJECT_ID, runId });
+
+    expect(store.agentRuns.get(runId)?.status).toBe('SUCCEEDED');
+    expect(store.projects.get(PROJECT_ID)?.status).toBe('FAILED');
+  });
+});
+
+describe('GENERATE_LISTING reconcile — retry on failure', () => {
+  it('re-enqueues GENERATE_LISTING when the marketer task fails', async () => {
+    vi.mocked(getECSTaskStatus).mockResolvedValue({ status: 'STOPPED', exitCode: 1 });
+    store.projects.set(PROJECT_ID, makeProjectItem({ status: 'RELEASING' }));
+
+    const runId = 'run-marketer-failed';
+    store.agentRuns.set(runId, {
+      runId,
+      projectId: PROJECT_ID,
+      taskArn: MOCK_TASK_ARN,
+      workerType: 'marketer',
+      status: 'RUNNING',
+      startedAt: new Date().toISOString(),
+    });
+
+    await dispatch({ type: 'RECONCILE', projectId: PROJECT_ID, runId });
+
+    expect(store.agentRuns.get(runId)?.status).toBe('FAILED');
+    expect(pendingQueue).toHaveLength(1);
+    expect(pendingQueue[0]).toMatchObject({ type: 'GENERATE_LISTING', projectId: PROJECT_ID });
+  });
+});
