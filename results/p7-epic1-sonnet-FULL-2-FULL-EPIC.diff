@@ -0,0 +1,254 @@
+import { describe, it, expect, beforeEach, vi } from 'vitest';
+import { mockClient } from 'aws-sdk-client-mock';
+import { ECSClient, RunTaskCommand } from '@aws-sdk/client-ecs';
+import type { AgentRunService, TaskOutputService } from '@auto-graph/core';
+import type { EnvironmentConfig } from '@auto-graph/core';
+import { launchAgentRun } from '../launch-agent-run.js';
+
+const ecsMock = mockClient(ECSClient);
+
+beforeEach(() => {
+  ecsMock.reset();
+});
+
+const config: EnvironmentConfig = {
+  AWS_REGION: 'us-east-1',
+  DYNAMODB_TABLE_PREFIX: 'test',
+  SQS_QUEUE_URL: 'https://sqs.us-east-1.amazonaws.com/123',
+  ECS_CLUSTER_ARN: 'arn:aws:ecs:us-east-1:123:cluster/main',
+  ECS_SUBNETS: 'subnet-aaa',
+  ECS_SECURITY_GROUPS: 'sg-aaa',
+  GITHUB_TOKEN: 'ghp_test',
+  GITHUB_ORG: 'test-org',
+  ORCHESTRATION_REPO: 'test-repo',
+  LOG_LEVEL: 'info',
+};
+
+function makeServices() {
+  const agentRunService = { create: vi.fn().mockResolvedValue(undefined) } as unknown as AgentRunService;
+  const taskOutputService = { save: vi.fn().mockResolvedValue(undefined) } as unknown as TaskOutputService;
+  return { agentRunService, taskOutputService };
+}
+
+describe('launchAgentRun', () => {
+  it('generates a ULID run id', async () => {
+    const taskArn = 'arn:aws:ecs:us-east-1:123:task/abc';
+    ecsMock.on(RunTaskCommand).resolves({ tasks: [{ taskArn }], failures: [] });
+    const { agentRunService, taskOutputService } = makeServices();
+
+    const result = await launchAgentRun({
+      taskDefArn: 'worker:1',
+      workerType: 'outliner',
+      systemPrompt: 'prompt text',
+      projectId: 'proj-1',
+      repoName: 'the-repo',
+      config,
+      agentRunService,
+      taskOutputService,
+    });
+
+    expect(result.runId).toMatch(/^[0-9A-HJKMNP-TV-Z]{26}$/);
+    expect(result.taskArn).toBe(taskArn);
+  });
+
+  it('saves the system prompt as a system-prompt task output', async () => {
+    ecsMock.on(RunTaskCommand).resolves({
+      tasks: [{ taskArn: 'arn:aws:ecs:us-east-1:123:task/xyz' }],
+      failures: [],
+    });
+    const { agentRunService, taskOutputService } = makeServices();
+
+    const result = await launchAgentRun({
+      taskDefArn: 'worker:1',
+      workerType: 'planner',
+      systemPrompt: 'the system prompt',
+      projectId: 'proj-1',
+      repoName: 'the-repo',
+      config,
+      agentRunService,
+      taskOutputService,
+    });
+
+    expect(taskOutputService.save).toHaveBeenCalledOnce();
+    const [outputItem] = vi.mocked(taskOutputService.save).mock.calls[0]!;
+    expect(outputItem.runId).toBe(result.runId);
+    expect(outputItem.outputType).toBe('system-prompt');
+    expect(outputItem.projectId).toBe('proj-1');
+    expect(outputItem.content).toBe('the system prompt');
+    expect(outputItem.contentLength).toBe('the system prompt'.length);
+  });
+
+  it('launches the ECS task with the standard environment keys', async () => {
+    ecsMock.on(RunTaskCommand).resolves({
+      tasks: [{ taskArn: 'arn:aws:ecs:us-east-1:123:task/env' }],
+      failures: [],
+    });
+    const { agentRunService, taskOutputService } = makeServices();
+
+    const result = await launchAgentRun({
+      taskDefArn: 'arn:aws:ecs:us-east-1:123:task-definition/auto-graph-outliner:1',
+      workerType: 'outliner',
+      systemPrompt: 'prompt',
+      projectId: 'proj-1',
+      repoName: 'the-repo',
+      config,
+      agentRunService,
+      taskOutputService,
+    });
+
+    const calls = ecsMock.commandCalls(RunTaskCommand);
+    expect(calls).toHaveLength(1);
+    expect(calls[0]!.args[0].input.taskDefinition).toBe(
+      'arn:aws:ecs:us-east-1:123:task-definition/auto-graph-outliner:1',
+    );
+    const overrides = calls[0]!.args[0].input.overrides?.containerOverrides?.[0];
+    expect(overrides?.command).toEqual(['claude', '-p', '$SYSTEM_PROMPT']);
+    expect(overrides?.environment).toContainEqual({ name: 'PROJECT_ID', value: 'proj-1' });
+    expect(overrides?.environment).toContainEqual({ name: 'REPO_NAME', value: 'the-repo' });
+    expect(overrides?.environment).toContainEqual({ name: 'RUN_ID', value: result.runId });
+    expect(overrides?.environment).toContainEqual({ name: 'AWS_REGION', value: 'us-east-1' });
+    expect(overrides?.environment).toContainEqual({ name: 'DYNAMODB_TABLE_PREFIX', value: 'test' });
+  });
+
+  it('merges extraEnv into the ECS task environment', async () => {
+    ecsMock.on(RunTaskCommand).resolves({
+      tasks: [{ taskArn: 'arn:aws:ecs:us-east-1:123:task/extra' }],
+      failures: [],
+    });
+    const { agentRunService, taskOutputService } = makeServices();
+
+    await launchAgentRun({
+      taskDefArn: 'worker:1',
+      workerType: 'writer',
+      systemPrompt: 'prompt',
+      projectId: 'proj-1',
+      repoName: 'the-repo',
+      extraEnv: { CHAPTER_NUMBER: '3', BRANCH_NAME: 'chapter-03' },
+      config,
+      agentRunService,
+      taskOutputService,
+    });
+
+    const calls = ecsMock.commandCalls(RunTaskCommand);
+    const overrides = calls[0]!.args[0].input.overrides?.containerOverrides?.[0];
+    expect(overrides?.environment).toContainEqual({ name: 'CHAPTER_NUMBER', value: '3' });
+    expect(overrides?.environment).toContainEqual({ name: 'BRANCH_NAME', value: 'chapter-03' });
+  });
+
+  it('creates an agent run record with status RUNNING', async () => {
+    const taskArn = 'arn:aws:ecs:us-east-1:123:task/run-record';
+    ecsMock.on(RunTaskCommand).resolves({ tasks: [{ taskArn }], failures: [] });
+    const { agentRunService, taskOutputService } = makeServices();
+
+    const result = await launchAgentRun({
+      taskDefArn: 'worker:1',
+      workerType: 'editor',
+      systemPrompt: 'prompt',
+      projectId: 'proj-1',
+      repoName: 'the-repo',
+      config,
+      agentRunService,
+      taskOutputService,
+    });
+
+    expect(agentRunService.create).toHaveBeenCalledOnce();
+    const [runItem] = vi.mocked(agentRunService.create).mock.calls[0]!;
+    expect(runItem.runId).toBe(result.runId);
+    expect(runItem.projectId).toBe('proj-1');
+    expect(runItem.taskArn).toBe(taskArn);
+    expect(runItem.workerType).toBe('editor');
+    expect(runItem.status).toBe('RUNNING');
+    expect(runItem.nodeId).toBeUndefined();
+  });
+
+  it('includes nodeId on the agent run record when supplied', async () => {
+    ecsMock.on(RunTaskCommand).resolves({
+      tasks: [{ taskArn: 'arn:aws:ecs:us-east-1:123:task/node' }],
+      failures: [],
+    });
+    const { agentRunService, taskOutputService } = makeServices();
+
+    await launchAgentRun({
+      taskDefArn: 'worker:1',
+      workerType: 'reviser',
+      systemPrompt: 'prompt',
+      projectId: 'proj-1',
+      repoName: 'the-repo',
+      config,
+      agentRunService,
+      taskOutputService,
+      nodeId: 'node-42',
+    });
+
+    const [runItem] = vi.mocked(agentRunService.create).mock.calls[0]!;
+    expect(runItem.nodeId).toBe('node-42');
+  });
+
+  it('uses the same run id for the task output and the agent run record', async () => {
+    ecsMock.on(RunTaskCommand).resolves({
+      tasks: [{ taskArn: 'arn:aws:ecs:us-east-1:123:task/shared-id' }],
+      failures: [],
+    });
+    const { agentRunService, taskOutputService } = makeServices();
+
+    await launchAgentRun({
+      taskDefArn: 'worker:1',
+      workerType: 'auditor',
+      systemPrompt: 'prompt',
+      projectId: 'proj-1',
+      repoName: 'the-repo',
+      config,
+      agentRunService,
+      taskOutputService,
+    });
+
+    const [outputItem] = vi.mocked(taskOutputService.save).mock.calls[0]!;
+    const [runItem] = vi.mocked(agentRunService.create).mock.calls[0]!;
+    expect(outputItem.runId).toBe(runItem.runId);
+  });
+
+  // Documents the current behavior: the system prompt is saved before the ECS
+  // task is launched, so a failed launch leaves an orphaned system-prompt record.
+  it('saves the system prompt even when the ECS task launch fails', async () => {
+    ecsMock.on(RunTaskCommand).rejects(new Error('ECS launch error'));
+    const { agentRunService, taskOutputService } = makeServices();
+
+    await expect(
+      launchAgentRun({
+        taskDefArn: 'worker:1',
+        workerType: 'continuity-checker',
+        systemPrompt: 'prompt',
+        projectId: 'proj-1',
+        repoName: 'the-repo',
+        config,
+        agentRunService,
+        taskOutputService,
+      }),
+    ).rejects.toThrow('ECS launch error');
+
+    expect(taskOutputService.save).toHaveBeenCalledOnce();
+    expect(agentRunService.create).not.toHaveBeenCalled();
+  });
+
+  it('propagates an error and does not create the agent run record when it rejects', async () => {
+    ecsMock.on(RunTaskCommand).resolves({
+      tasks: [{ taskArn: 'arn:aws:ecs:us-east-1:123:task/create-fail' }],
+      failures: [],
+    });
+    const { agentRunService, taskOutputService } = makeServices();
+    vi.mocked(agentRunService.create).mockRejectedValueOnce(new Error('DynamoDB write error'));
+
+    await expect(
+      launchAgentRun({
+        taskDefArn: 'worker:1',
+        workerType: 'writer',
+        systemPrompt: 'prompt',
+        projectId: 'proj-1',
+        repoName: 'the-repo',
+        config,
+        agentRunService,
+        taskOutputService,
+      }),
+    ).rejects.toThrow('DynamoDB write error');
+  });
+});
