+import { describe, it, expect } from 'vitest';
+import {
+  resolveChapterTarget,
+  resolveWordCountRange,
+  resolveTolerance,
+  formatToleranceForPrompt,
+  clampToProjectType,
+} from '../index.js';
+import { ProjectType } from '../../config/schemas.js';
+
+describe('resolveChapterTarget', () => {
+  it('divides the book target evenly across chapters', () => {
+    expect(resolveChapterTarget({ targetWordCount: 90_000, chapterCount: 3 })).toBe(30_000);
+  });
+
+  it('floors a non-integer division', () => {
+    expect(resolveChapterTarget({ targetWordCount: 90_000, chapterCount: 7 })).toBe(12_857);
+  });
+
+  it('throws when chapterCount is zero', () => {
+    expect(() => resolveChapterTarget({ targetWordCount: 90_000, chapterCount: 0 })).toThrow(Error);
+  });
+
+  it('throws when chapterCount is negative', () => {
+    expect(() => resolveChapterTarget({ targetWordCount: 90_000, chapterCount: -3 })).toThrow(Error);
+  });
+});
+
+describe('resolveTolerance', () => {
+  it('returns the pinned tolerance per stage', () => {
+    expect(resolveTolerance('writer')).toBe(0.05);
+    expect(resolveTolerance('review')).toBe(0.1);
+    expect(resolveTolerance('merge')).toBe(0.2);
+  });
+});
+
+describe('resolveWordCountRange', () => {
+  it('bands the writer stage at ±5%', () => {
+    expect(resolveWordCountRange({ targetWordCount: 90_000, chapterCount: 3, stage: 'writer' }))
+      .toEqual({ min: 28_500, max: 31_500 });
+  });
+
+  it('bands the review stage at ±10%', () => {
+    expect(resolveWordCountRange({ targetWordCount: 90_000, chapterCount: 3, stage: 'review' }))
+      .toEqual({ min: 27_000, max: 33_000 });
+  });
+
+  it('bands the merge stage at ±20%', () => {
+    expect(resolveWordCountRange({ targetWordCount: 90_000, chapterCount: 3, stage: 'merge' }))
+      .toEqual({ min: 24_000, max: 36_000 });
+  });
+
+  it('floors the minimum and ceils the maximum', () => {
+    // target 3 333 → min 3 166.35, max 3 499.65
+    expect(resolveWordCountRange({ targetWordCount: 10_000, chapterCount: 3, stage: 'writer' }))
+      .toEqual({ min: 3_166, max: 3_500 });
+  });
+
+  it('propagates the chapterCount guard', () => {
+    expect(() =>
+      resolveWordCountRange({ targetWordCount: 10_000, chapterCount: 0, stage: 'writer' }),
+    ).toThrow(Error);
+  });
+});
+
+describe('formatToleranceForPrompt', () => {
+  it('renders each stage tolerance as a percentage', () => {
+    expect(formatToleranceForPrompt('writer')).toBe('±5%');
+    expect(formatToleranceForPrompt('review')).toBe('±10%');
+    expect(formatToleranceForPrompt('merge')).toBe('±20%');
+  });
+});
+
+describe('clampToProjectType', () => {
+  it('leaves a range already inside the project type band untouched', () => {
+    expect(
+      clampToProjectType({ range: { min: 3_200, max: 4_800 }, projectType: ProjectType.NOVEL }),
+    ).toEqual({ min: 3_200, max: 4_800 });
+  });
+
+  it('raises a minimum below the project type floor', () => {
+    expect(
+      clampToProjectType({ range: { min: 1_000, max: 4_000 }, projectType: ProjectType.NOVEL }),
+    ).toEqual({ min: 3_000, max: 4_000 });
+  });
+
+  it('lowers a maximum above the project type ceiling', () => {
+    expect(
+      clampToProjectType({ range: { min: 3_500, max: 9_000 }, projectType: ProjectType.NOVEL }),
+    ).toEqual({ min: 3_500, max: 5_000 });
+  });
+
+  it('collapses a band entirely above the project type band onto the ceiling', () => {
+    expect(
+      clampToProjectType({ range: { min: 24_000, max: 36_000 }, projectType: ProjectType.NOVEL }),
+    ).toEqual({ min: 5_000, max: 5_000 });
+  });
+
+  it('collapses a band entirely below the project type band onto the floor', () => {
+    expect(
+      clampToProjectType({ range: { min: 240, max: 360 }, projectType: ProjectType.NOVEL }),
+    ).toEqual({ min: 3_000, max: 3_000 });
+  });
+
+  it('clamps against the band of the given project type', () => {
+    expect(
+      clampToProjectType({ range: { min: 1_000, max: 9_000 }, projectType: ProjectType.NOVELLA }),
+    ).toEqual({ min: 2_500, max: 4_000 });
+  });
+});
