+    });
+
+    it('reports CHAPTER_GAP when a chapter number is missing', () => {
+      expect(structureCodes([makeChapter(1), makeChapter(3)])).toEqual(['CHAPTER_GAP']);
+    });
+
+    it('reports CHAPTER_GAP when the numbering does not start at 1', () => {
+      expect(structureCodes([makeChapter(2), makeChapter(3)])).toEqual(['CHAPTER_GAP']);
+    });
+
+    it('reports CHAPTER_GAP when a path is not a canonical chapter path', () => {
