--- /dev/null
+++ b/packages/core/src/release-policy/validate.ts
@@ -0,0 +1,221 @@
+import type {
+  KdpListing,
+  ListingError,
+  ListingValidation,
+  ChapterFile,
+  ManuscriptError,
+  ManuscriptValidation,
+} from './types.js';
+import { getChapterNumberFromPath } from '../writing/paths.js';
+
+export const MAX_BLURB_LENGTH = 4000;
+export const REQUIRED_KEYWORD_COUNT = 7;
+export const REQUIRED_CATEGORY_COUNT = 3;
+export const ALLOWED_BLURB_TAGS = ['b', 'i', 'u', 'br', 'p', 'ul', 'li', 'ol', 'h4', 'h5', 'h6'];
+
+export function validateListing(listing: KdpListing): ListingValidation {
+  const errors: ListingError[] = [];
+
+  // BLURB_TOO_LONG — blurb longer than 4000 characters
+  if (listing.blurb.length > MAX_BLURB_LENGTH) {
+    errors.push({
+      code: 'BLURB_TOO_LONG',
+      detail: `Blurb length ${listing.blurb.length} exceeds maximum ${MAX_BLURB_LENGTH} characters.`,
+    });
+  }
+
+  // BLURB_EMPTY — blurb is empty or whitespace only
+  if (listing.blurb.trim().length === 0) {
+    errors.push({
+      code: 'BLURB_EMPTY',
+      detail: 'Blurb is empty or contains only whitespace.',
+    });
+  }
+
+  // KEYWORD_COUNT — keywords.length is not exactly 7
+  if (listing.keywords.length !== REQUIRED_KEYWORD_COUNT) {
+    errors.push({
+      code: 'KEYWORD_COUNT',
+      detail: `Keywords count ${listing.keywords.length} does not equal required count ${REQUIRED_KEYWORD_COUNT}.`,
+    });
+  }
+
+  // CATEGORY_COUNT — categories.length is not exactly 3
+  if (listing.categories.length !== REQUIRED_CATEGORY_COUNT) {
+    errors.push({
+      code: 'CATEGORY_COUNT',
+      detail: `Categories count ${listing.categories.length} does not equal required count ${REQUIRED_CATEGORY_COUNT}.`,
+    });
+  }
+
+  // UNRESOLVED_PLACEHOLDER — any string field contains "TODO:" (one error total)
+  const fieldsToCheck: (string | undefined)[] = [
+    listing.title,
+    listing.subtitle,
+    listing.blurb,
+    listing.author,
+    ...listing.keywords,
+    ...listing.categories,
+  ];
+
+  if (fieldsToCheck.some((field) => field !== undefined && field.includes('TODO:'))) {
+    errors.push({
+      code: 'UNRESOLVED_PLACEHOLDER',
+      detail: 'One or more fields contain unresolved TODO: placeholder.',
+    });
+  }
+
+  // DISALLOWED_HTML — blurb contains HTML tags outside allowlist (case-insensitive, one error total)
+  const htmlTagRegex = /<\/?([a-zA-Z][a-zA-Z0-9]*)\b[^>]*>/g;
+  const foundTags = new Set<string>();
+  let match: RegExpExecArray | null;
+
+  while ((match = htmlTagRegex.exec(listing.blurb)) !== null) {
+    const tagName = match[1];
+    if (tagName !== undefined) {
+      foundTags.add(tagName.toLowerCase());
+    }
+  }
+
+  const disallowedTags = Array.from(foundTags).filter(
+    (tag) => !ALLOWED_BLURB_TAGS.includes(tag)
+  );
+
+  if (disallowedTags.length > 0) {
+    errors.push({
+      code: 'DISALLOWED_HTML',
+      detail: `Blurb contains disallowed HTML tags: ${disallowedTags.join(', ')}.`,
+    });
+  }
+
+  // Sort errors by code ascending (lexicographic order)
+  errors.sort((a, b) => a.code.localeCompare(b.code));
+
+  return {
+    valid: errors.length === 0,
+    errors,
+  };
+}
+
+export function validateManuscriptStructure(chapters: ChapterFile[]): ManuscriptValidation {
+  const errors: ManuscriptError[] = [];
+  const chapterNumbers = new Map<number, string[]>();
+
+  // Per-chapter validation
+  for (let i = 0; i < chapters.length; i++) {
+    const chapter = chapters[i]!;
+    const lines = chapter.content.split('\n');
+
+    // Extract chapter number from path using the canonical path helper format
+    const expectedChapterNumber = getChapterNumberFromPath(chapter.path);
+    if (expectedChapterNumber === null) {
+      continue;
+    }
+
+    // Find H1 heading by checking each line
+    let h1Match: RegExpExecArray | null = null;
+    let h1LineIndex = -1;
+    const h1Regex = /^#\s+Chapter\s+(\d+):\s*(.*)$/;
+
+    for (let lineIdx = 0; lineIdx < lines.length; lineIdx++) {
+      const lineMatch = h1Regex.exec(lines[lineIdx]!);
+      if (lineMatch) {
+        h1Match = lineMatch;
+        h1LineIndex = lineIdx;
+        break;
+      }
+    }
+
+    // H1_MISSING: no level-1 heading (rule 1)
+    if (!h1Match) {
+      errors.push({
+        code: 'H1_MISSING',
+        detail: `Chapter at index ${i}: No level-1 heading found.`,
+      });
+      // Continue to check H1_NOT_FIRST (rule 2), but skip rules 3 and 4
+      const firstNonEmptyLineIndex = lines.findIndex((line) => line.trim().length > 0);
+      if (firstNonEmptyLineIndex !== -1) {
+        errors.push({
+          code: 'H1_NOT_FIRST',
+          detail: `Chapter at index ${i}: The first non-empty line is not the level-1 heading.`,
+        });
+      }
+      // Track chapter number anyway for duplicate/gap check
+      if (!chapterNumbers.has(expectedChapterNumber)) {
+        chapterNumbers.set(expectedChapterNumber, []);
+      }
+      chapterNumbers.get(expectedChapterNumber)!.push(chapter.path);
+      continue;
+    }
+
+    const h1Number = parseInt(h1Match[1]!, 10);
+    const h1Title = h1Match[2]!.trim();
+
+    // H1_NOT_FIRST: first non-empty line is not H1 (rule 2)
+    let firstNonEmptyLineIndex = -1;
+    for (let lineIdx = 0; lineIdx < lines.length; lineIdx++) {
+      if (lines[lineIdx]!.trim().length > 0) {
+        firstNonEmptyLineIndex = lineIdx;
+        break;
+      }
+    }
+    if (firstNonEmptyLineIndex !== h1LineIndex) {
+      errors.push({
+        code: 'H1_NOT_FIRST',
+        detail: `Chapter at index ${i}: The first non-empty line is not the level-1 heading.`,
+      });
+    }
+
+    // H1_MALFORMED: title is empty (rule 3, skip if H1_MISSING)
+    if (h1Title.length === 0) {
+      errors.push({
+        code: 'H1_MALFORMED',
+        detail: `Chapter at index ${i}: The level-1 heading does not match the required format.`,
+      });
+    }
+
+    // H1_NUMBER_MISMATCH: chapter number in heading doesn't match path (rule 4, skip if H1_MISSING)
+    if (h1Number !== expectedChapterNumber) {
+      errors.push({
+        code: 'H1_NUMBER_MISMATCH',
+        detail: `Chapter at index ${i}: The heading chapter number (${h1Number}) does not match the expected number from path (${expectedChapterNumber}).`,
+      });
+    }
+
+    // Track chapter number for duplicate/gap check
+    if (!chapterNumbers.has(expectedChapterNumber)) {
+      chapterNumbers.set(expectedChapterNumber, []);
+    }
+    chapterNumbers.get(expectedChapterNumber)!.push(chapter.path);
+  }
+
+  // Set-level validation: CHAPTER_DUPLICATE
+  for (const [chapterNum, paths] of chapterNumbers.entries()) {
+    if (paths.length > 1) {
+      errors.push({
+        code: 'CHAPTER_DUPLICATE',
+        detail: `Chapter ${chapterNum}: Duplicate chapter number found in ${paths.length} files.`,
+      });
+    }
+  }
+
+  // Set-level validation: CHAPTER_GAP
+  if (chapterNumbers.size > 0) {
+    const sortedNumbers = Array.from(chapterNumbers.keys()).sort((a, b) => a - b);
+    const expectedSequence = Array.from({ length: sortedNumbers.length }, (_, i) => i + 1);
+    if (JSON.stringify(sortedNumbers) !== JSON.stringify(expectedSequence)) {
+      errors.push({
+        code: 'CHAPTER_GAP',
+        detail: `Manuscript chapters are not a contiguous sequence from 1 to ${sortedNumbers.length}.`,
+      });
+    }
+  }
+
+  // Sort errors by code ascending
+  errors.sort((a, b) => a.code.localeCompare(b.code));
+
+  return {
+    valid: errors.length === 0,
+    errors,
+  };
+}
