@@ -0,0 +1,93 @@
+import type { KdpListing, ListingError, ListingValidation } from './types.js';
+
+export const MAX_BLURB_LENGTH = 4000;
+export const REQUIRED_KEYWORD_COUNT = 7;
+export const REQUIRED_CATEGORY_COUNT = 3;
+export const ALLOWED_BLURB_TAGS = ['b', 'i', 'u', 'br', 'p', 'ul', 'li', 'ol', 'h4', 'h5', 'h6'];
+
+export function validateListing(listing: KdpListing): ListingValidation {
+  const errors: ListingError[] = [];
+
+  // Check for empty/whitespace-only blurb
+  if (!listing.blurb || listing.blurb.trim() === '') {
+    errors.push({
+      code: 'BLURB_EMPTY',
+      detail: 'Blurb is empty or whitespace only.',
+    });
+  }
+
+  // Check for blurb too long
+  if (listing.blurb.length > MAX_BLURB_LENGTH) {
+    errors.push({
+      code: 'BLURB_TOO_LONG',
+      detail: `Blurb exceeds maximum length of ${MAX_BLURB_LENGTH} characters (current: ${listing.blurb.length}).`,
+    });
+  }
+
+  // Check keyword count
+  if (listing.keywords.length !== REQUIRED_KEYWORD_COUNT) {
+    errors.push({
+      code: 'KEYWORD_COUNT',
+      detail: `Keywords must have exactly ${REQUIRED_KEYWORD_COUNT} entries (current: ${listing.keywords.length}).`,
+    });
+  }
+
+  // Check category count
+  if (listing.categories.length !== REQUIRED_CATEGORY_COUNT) {
+    errors.push({
+      code: 'CATEGORY_COUNT',
+      detail: `Categories must have exactly ${REQUIRED_CATEGORY_COUNT} entries (current: ${listing.categories.length}).`,
+    });
+  }
+
+  // Check for unresolved placeholders (TODO:) - one error total
+  const fieldsToCheck = [
+    listing.title,
+    listing.subtitle,
+    listing.blurb,
+    listing.author,
+    ...listing.keywords,
+    ...listing.categories,
+  ];
+  const hasPlaceholder = fieldsToCheck.some((field) => field != null && field.includes('TODO:'));
+  if (hasPlaceholder) {
+    errors.push({
+      code: 'UNRESOLVED_PLACEHOLDER',
+      detail: 'One or more fields contain unresolved placeholder text (TODO:).',
+    });
+  }
+
+  // Check for disallowed HTML tags in blurb - one error total
+  const disallowedTagsFound = findDisallowedTags(listing.blurb);
+  if (disallowedTagsFound.length > 0) {
+    errors.push({
+      code: 'DISALLOWED_HTML',
+      detail: `Blurb contains disallowed HTML tags: ${disallowedTagsFound.join(', ')}. Allowed tags: ${ALLOWED_BLURB_TAGS.join(', ')}.`,
+    });
+  }
+
+  // Sort errors by code (lexicographic order)
+  errors.sort((a, b) => a.code.localeCompare(b.code));
+
+  return {
+    valid: errors.length === 0,
+    errors,
+  };
+}
+
+function findDisallowedTags(html: string): string[] {
+  // Match all HTML tags (opening and closing)
+  const tagRegex = /<\/?([a-zA-Z][a-zA-Z0-9]*)\b[^>]*>/g;
+  const foundTags = new Set<string>();
+  const allowedTagsLower = new Set(ALLOWED_BLURB_TAGS.map((t) => t.toLowerCase()));
+
+  let match;
+  while ((match = tagRegex.exec(html)) !== null) {
+    const tagName = match[1]!.toLowerCase();
+    if (!allowedTagsLower.has(tagName)) {
+      foundTags.add(tagName);
+    }
+  }
+
+  return Array.from(foundTags).sort();
+}
