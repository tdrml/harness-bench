+import { describe, it, expect } from 'vitest';
+import {
+  validateListing,
+  type KdpListing,
+  REQUIRED_KEYWORD_COUNT,
+  REQUIRED_CATEGORY_COUNT,
+  MAX_BLURB_LENGTH,
+  ALLOWED_BLURB_TAGS,
+} from '../index.js';
+
+const validListing: KdpListing = {
+  title: 'Test Title',
+  subtitle: 'Test Subtitle',
+  blurb: 'This is a test blurb that is valid and contains no issues.',
+  keywords: ['key1', 'key2', 'key3', 'key4', 'key5', 'key6', 'key7'],
+  categories: ['cat1', 'cat2', 'cat3'],
+  author: 'John Doe',
+};
+
+describe('validateListing', () => {
+  describe('valid listing', () => {
+    it('returns valid: true with empty errors for a valid listing', () => {
+      const result = validateListing(validListing);
+      expect(result.valid).toBe(true);
+      expect(result.errors).toHaveLength(0);
+    });
+
+    it('allows optional subtitle to be undefined', () => {
+      const listing = { ...validListing, subtitle: undefined };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(true);
+      expect(result.errors).toHaveLength(0);
+    });
+
+    it('accepts blurb with allowed HTML tags', () => {
+      const listing = {
+        ...validListing,
+        blurb: 'This has <b>bold</b>, <i>italic</i>, and <br/> tags.',
+      };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(true);
+      expect(result.errors).toHaveLength(0);
+    });
+  });
+
+  describe('BLURB_TOO_LONG', () => {
+    it('detects blurb exceeding 4000 characters', () => {
+      const longBlurb = 'a'.repeat(MAX_BLURB_LENGTH + 1);
+      const listing = { ...validListing, blurb: longBlurb };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(
+        expect.objectContaining({
+          code: 'BLURB_TOO_LONG',
+        }),
+      );
+    });
+
+    it('allows blurb exactly at 4000 characters', () => {
+      const blurb = 'a'.repeat(MAX_BLURB_LENGTH);
+      const listing = { ...validListing, blurb };
+      const result = validateListing(listing);
+      const hasBlurbTooLong = result.errors.some((e) => e.code === 'BLURB_TOO_LONG');
+      expect(hasBlurbTooLong).toBe(false);
+    });
+
+    it('includes character count in error detail', () => {
+      const longBlurb = 'a'.repeat(MAX_BLURB_LENGTH + 100);
+      const listing = { ...validListing, blurb: longBlurb };
+      const result = validateListing(listing);
+      const error = result.errors.find((e) => e.code === 'BLURB_TOO_LONG');
+      expect(error?.detail).toContain('4100');
+    });
+  });
+
+  describe('BLURB_EMPTY', () => {
+    it('detects empty blurb', () => {
+      const listing = { ...validListing, blurb: '' };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(
+        expect.objectContaining({
+          code: 'BLURB_EMPTY',
+        }),
+      );
+    });
+
+    it('detects whitespace-only blurb', () => {
+      const listing = { ...validListing, blurb: '   \n\t  ' };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(
+        expect.objectContaining({
+          code: 'BLURB_EMPTY',
+        }),
+      );
+    });
+  });
+
+  describe('KEYWORD_COUNT', () => {
+    it('detects too few keywords', () => {
+      const listing = { ...validListing, keywords: ['key1', 'key2'] };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(
+        expect.objectContaining({
+          code: 'KEYWORD_COUNT',
+          detail: expect.stringContaining('Expected exactly 7'),
+        }),
+      );
+    });
+
+    it('detects too many keywords', () => {
+      const listing = {
+        ...validListing,
+        keywords: Array.from({ length: 10 }, (_, i) => `key${i}`),
+      };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(
+        expect.objectContaining({
+          code: 'KEYWORD_COUNT',
+        }),
+      );
+    });
+
+    it('accepts exactly 7 keywords', () => {
+      const listing = {
+        ...validListing,
+        keywords: Array.from({ length: REQUIRED_KEYWORD_COUNT }, (_, i) => `key${i}`),
+      };
+      const result = validateListing(listing);
+      const hasKeywordCountError = result.errors.some((e) => e.code === 'KEYWORD_COUNT');
+      expect(hasKeywordCountError).toBe(false);
+    });
+  });
+
+  describe('CATEGORY_COUNT', () => {
+    it('detects too few categories', () => {
+      const listing = { ...validListing, categories: ['cat1'] };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(
+        expect.objectContaining({
+          code: 'CATEGORY_COUNT',
+          detail: expect.stringContaining('Expected exactly 3'),
+        }),
+      );
+    });
+
+    it('detects too many categories', () => {
+      const listing = {
+        ...validListing,
+        categories: ['cat1', 'cat2', 'cat3', 'cat4', 'cat5'],
+      };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(
+        expect.objectContaining({
+          code: 'CATEGORY_COUNT',
+        }),
+      );
+    });
+
+    it('accepts exactly 3 categories', () => {
+      const listing = {
+        ...validListing,
+        categories: Array.from({ length: REQUIRED_CATEGORY_COUNT }, (_, i) => `cat${i}`),
+      };
+      const result = validateListing(listing);
+      const hasCategoryCountError = result.errors.some((e) => e.code === 'CATEGORY_COUNT');
+      expect(hasCategoryCountError).toBe(false);
+    });
+  });
+
+  describe('UNRESOLVED_PLACEHOLDER', () => {
+    it('detects TODO: in title', () => {
+      const listing = { ...validListing, title: 'TODO: Add title' };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(
+        expect.objectContaining({
+          code: 'UNRESOLVED_PLACEHOLDER',
+        }),
+      );
+    });
+
+    it('detects TODO: in subtitle', () => {
+      const listing = { ...validListing, subtitle: 'TODO: Add subtitle' };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(
+        expect.objectContaining({
+          code: 'UNRESOLVED_PLACEHOLDER',
+        }),
+      );
+    });
+
+    it('detects TODO: in blurb', () => {
+      const listing = { ...validListing, blurb: 'This is TODO: incomplete.' };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(
+        expect.objectContaining({
+          code: 'UNRESOLVED_PLACEHOLDER',
+        }),
+      );
+    });
+
+    it('detects TODO: in author', () => {
+      const listing = { ...validListing, author: 'TODO: Get author' };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(
+        expect.objectContaining({
+          code: 'UNRESOLVED_PLACEHOLDER',
+        }),
+      );
+    });
+
+    it('detects TODO: in keywords', () => {
+      const listing = {
+        ...validListing,
+        keywords: ['key1', 'TODO: Add keyword', 'key3', 'key4', 'key5', 'key6', 'key7'],
+      };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(
+        expect.objectContaining({
+          code: 'UNRESOLVED_PLACEHOLDER',
+        }),
+      );
+    });
+
+    it('detects TODO: in categories', () => {
+      const listing = {
+        ...validListing,
+        categories: ['cat1', 'TODO: Fix category', 'cat3'],
+      };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(
+        expect.objectContaining({
+          code: 'UNRESOLVED_PLACEHOLDER',
+        }),
+      );
+    });
+
+    it('reports one error total even if multiple fields have TODO:', () => {
+      const listing = {
+        ...validListing,
+        title: 'TODO: Title',
+        author: 'TODO: Author',
+        keywords: ['TODO: Key', 'k2', 'k3', 'k4', 'k5', 'k6', 'k7'],
+      };
+      const result = validateListing(listing);
+      const todoErrors = result.errors.filter((e) => e.code === 'UNRESOLVED_PLACEHOLDER');
+      expect(todoErrors).toHaveLength(1);
+    });
+  });
+
+  describe('DISALLOWED_HTML', () => {
+    it('detects disallowed HTML tag <div>', () => {
+      const listing = { ...validListing, blurb: 'This has <div>content</div>.' };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(
+        expect.objectContaining({
+          code: 'DISALLOWED_HTML',
+          detail: expect.stringContaining('div'),
+        }),
+      );
+    });
+
+    it('detects disallowed HTML tag <span>', () => {
+      const listing = { ...validListing, blurb: 'This has <span>text</span>.' };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(
+        expect.objectContaining({
+          code: 'DISALLOWED_HTML',
+        }),
+      );
+    });
+
+    it('allows all tags in the allowlist', () => {
+      const tagString = ALLOWED_BLURB_TAGS.map((tag) => `<${tag}>content</${tag}>`).join(' ');
+      const listing = { ...validListing, blurb: tagString };
+      const result = validateListing(listing);
+      const hasHtmlError = result.errors.some((e) => e.code === 'DISALLOWED_HTML');
+      expect(hasHtmlError).toBe(false);
+    });
+
+    it('is case-insensitive in tag matching', () => {
+      const listing = { ...validListing, blurb: 'This has <DIV>content</DIV>.' };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(
+        expect.objectContaining({
+          code: 'DISALLOWED_HTML',
+        }),
+      );
+    });
+
+    it('recognizes closing tags as the same tag', () => {
+      const listing = { ...validListing, blurb: 'This has </span> without opening.' };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(
+        expect.objectContaining({
+          code: 'DISALLOWED_HTML',
+        }),
+      );
+    });
+
+    it('reports only one error total even with multiple disallowed tags', () => {
+      const listing = {
+        ...validListing,
+        blurb: 'This has <div>content</div> and <span>more</span>.',
+      };
+      const result = validateListing(listing);
+      const htmlErrors = result.errors.filter((e) => e.code === 'DISALLOWED_HTML');
+      expect(htmlErrors).toHaveLength(1);
+    });
+
+    it('allows self-closing br tag', () => {
+      const listing = { ...validListing, blurb: 'Line 1<br/>Line 2' };
+      const result = validateListing(listing);
+      const hasHtmlError = result.errors.some((e) => e.code === 'DISALLOWED_HTML');
+      expect(hasHtmlError).toBe(false);
+    });
+  });
+
+  describe('error sorting', () => {
+    it('sorts errors by code in ascending lexicographic order', () => {
+      const listing = {
+        title: 'Test',
+        blurb: '', // BLURB_EMPTY, BLURB_TOO_LONG (no, empty doesn't trigger TOO_LONG)
+        keywords: [], // KEYWORD_COUNT
+        categories: [], // CATEGORY_COUNT
+        author: 'Author',
+      };
+      const result = validateListing(listing);
+      const codes = result.errors.map((e) => e.code);
+      expect(codes).toEqual([...codes].sort());
+    });
+
+    it('correctly orders BLURB_EMPTY, CATEGORY_COUNT, KEYWORD_COUNT', () => {
+      const listing = {
+        title: 'Test',
+        blurb: '',
+        keywords: ['k1'],
+        categories: ['c1'],
+        author: 'Author',
+      };
+      const result = validateListing(listing);
+      const codes = result.errors.map((e) => e.code);
+      expect(codes[0]).toBe('BLURB_EMPTY');
+      expect(codes.indexOf('CATEGORY_COUNT')).toBeLessThan(codes.indexOf('KEYWORD_COUNT'));
+    });
+  });
+
+  describe('multiple errors', () => {
+    it('reports all applicable errors', () => {
+      const longBlurb = 'a'.repeat(MAX_BLURB_LENGTH + 1);
+      const listing = {
+        title: 'Title',
+        blurb: longBlurb, // BLURB_TOO_LONG
+        keywords: ['k1', 'k2'], // KEYWORD_COUNT
+        categories: ['c1'], // CATEGORY_COUNT
+        author: 'Author',
+      };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors.length).toBeGreaterThanOrEqual(3);
+    });
+
+    it('reports all six possible error codes when all validations fail', () => {
+      const listing = {
+        title: 'TODO: Title',
+        subtitle: undefined,
+        blurb: 'a'.repeat(MAX_BLURB_LENGTH + 1) + '<div>test</div>', // BLURB_TOO_LONG, DISALLOWED_HTML
+        keywords: ['k1'], // KEYWORD_COUNT
+        categories: ['c1'], // CATEGORY_COUNT
+        author: 'Author',
+      };
+      const result = validateListing(listing);
+      const codes = result.errors.map((e) => e.code);
+      expect(result.valid).toBe(false);
+      expect(codes).toContain('BLURB_TOO_LONG');
+      expect(codes).toContain('CATEGORY_COUNT');
+      expect(codes).toContain('DISALLOWED_HTML');
+      expect(codes).toContain('KEYWORD_COUNT');
+      expect(codes).toContain('UNRESOLVED_PLACEHOLDER');
+    });
+  });
+
+  describe('error details', () => {
+    it('includes helpful error messages', () => {
+      const listing = {
+        title: 'Title',
+        blurb: '',
+        keywords: ['k1'],
+        categories: ['c1'],
+        author: 'Author',
+      };
+      const result = validateListing(listing);
+      for (const error of result.errors) {
+        expect(error.detail).toBeTruthy();
+        expect(error.detail.length).toBeGreaterThan(0);
+      }
+    });
+  });
+});
