+import {
+  createDynamoClient,
+  ProjectService,
+  AgentRunService,
+  TaskOutputService,
+  buildPackagerPrompt,
+  enqueue,
+} from '@auto-graph/core';
+import type { WorkItem } from '@auto-graph/core';
+import { withSQSHandler, launchAgentRun } from '../shared/index.js';
+import type { HandlerContext } from '../shared/index.js';
+
+export async function handle(workItem: WorkItem, context: HandlerContext): Promise<void> {
+  const { logger, config } = context;
+
+  if (workItem.type !== 'PACKAGE_MANUSCRIPT') {
+    throw new Error(`Unexpected work item type: ${workItem.type}`);
+  }
+
+  const { projectId } = workItem;
+
+  const packagerTaskDefArn = process.env['PACKAGER_TASK_DEF_ARN'];
+  if (!packagerTaskDefArn) {
+    throw new Error('PACKAGER_TASK_DEF_ARN environment variable is not set');
+  }
+
+  const dynamoClient = createDynamoClient(config.AWS_REGION);
+  const projectService = new ProjectService(dynamoClient, config.DYNAMODB_TABLE_PREFIX);
+  const agentRunService = new AgentRunService(dynamoClient, config.DYNAMODB_TABLE_PREFIX);
+  const taskOutputService = new TaskOutputService(dynamoClient, config.DYNAMODB_TABLE_PREFIX);
+
+  const project = await projectService.get(projectId);
+  if (!project) {
+    throw new Error(`Project not found: ${projectId}`);
+  }
+
+  const systemPrompt = buildPackagerPrompt({
+    title: project.config.title,
+    repoName: project.repoName,
+    chapterCount: project.config.chapterCount,
+    projectType: project.config.projectType,
+  });
+
+  const { runId, taskArn } = await launchAgentRun({
+    taskDefArn: packagerTaskDefArn,
+    workerType: 'packager',
+    systemPrompt,
+    projectId,
+    repoName: project.repoName,
+    config,
+    agentRunService,
+    taskOutputService,
+  });
+
+  await projectService.updateStatus(projectId, 'PACKAGING');
+
+  await enqueue(config.SQS_QUEUE_URL, {
+    type: 'RECONCILE',
+    projectId,
+    runId,
+  });
+
+  logger.info('Packager ECS task launched', {
+    projectId,
+    chapterCount: project.config.chapterCount,
+    runId,
+    taskArn,
+  });
+}
+
+export const handler = withSQSHandler(handle);
