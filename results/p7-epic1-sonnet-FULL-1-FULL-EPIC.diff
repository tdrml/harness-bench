+        const chapterCount = finalTaskGraph ? finalTaskGraph.nodes.length : 0;
+        const totalWordCount = project.totalWordCount ?? 0;
+
+        await projectService.setComplete(projectId, totalWordCount, chapterCount);
+        await projectService.updateStatus(projectId, 'RELEASED');
