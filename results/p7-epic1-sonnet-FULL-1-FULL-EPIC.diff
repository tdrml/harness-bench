+import { describe, it, expect } from 'vitest';
+import { validateListing } from '../index.js';
+import type { KdpListing } from '../index.js';
+
+function baseListing(overrides: Partial<KdpListing> = {}): KdpListing {
+  return {
+    title: 'The Long Night',
+    subtitle: 'A Thriller',
+    blurb: '<b>A gripping opening.</b><br><br>The rest of the story unfolds here.',
+    keywords: ['k1', 'k2', 'k3', 'k4', 'k5', 'k6', 'k7'],
+    categories: ['Fiction > Thrillers', 'Fiction > Suspense', 'Fiction > Mystery'],
+    author: 'Jane Doe',
+    ...overrides,
+  };
+}
+
+describe('validateListing', () => {
+  it('returns valid: true with no errors for a well-formed listing', () => {
+    const result = validateListing(baseListing());
+    expect(result.valid).toBe(true);
+    expect(result.errors).toHaveLength(0);
+  });
+
+  it('reports BLURB_TOO_LONG when blurb exceeds the maximum length', () => {
+    const result = validateListing(baseListing({ blurb: 'a'.repeat(4001) }));
+    expect(result.valid).toBe(false);
+    expect(result.errors).toContainEqual(expect.objectContaining({ code: 'BLURB_TOO_LONG' }));
+  });
+
+  it('reports BLURB_EMPTY when blurb is whitespace only', () => {
+    const result = validateListing(baseListing({ blurb: '   ' }));
+    expect(result.valid).toBe(false);
+    expect(result.errors).toContainEqual(expect.objectContaining({ code: 'BLURB_EMPTY' }));
+  });
+
+  it('reports KEYWORD_COUNT when there are not exactly 7 keywords', () => {
+    const result = validateListing(baseListing({ keywords: ['only', 'three', 'here'] }));
+    expect(result.valid).toBe(false);
+    expect(result.errors).toContainEqual(expect.objectContaining({ code: 'KEYWORD_COUNT' }));
+  });
+
+  it('reports CATEGORY_COUNT when there are not exactly 3 categories', () => {
+    const result = validateListing(baseListing({ categories: ['Fiction > Thrillers'] }));
+    expect(result.valid).toBe(false);
+    expect(result.errors).toContainEqual(expect.objectContaining({ code: 'CATEGORY_COUNT' }));
+  });
+
+  it('reports a single UNRESOLVED_PLACEHOLDER error even with multiple TODOs', () => {
+    const result = validateListing(
+      baseListing({
+        title: 'TODO: fix this title',
+        keywords: ['TODO: kw', 'k2', 'k3', 'k4', 'k5', 'k6', 'k7'],
+      }),
+    );
+    expect(result.valid).toBe(false);
+    const placeholderErrors = result.errors.filter((e) => e.code === 'UNRESOLVED_PLACEHOLDER');
+    expect(placeholderErrors).toHaveLength(1);
+  });
+
+  it('detects TODO placeholders inside category entries', () => {
+    const result = validateListing(
+      baseListing({ categories: ['TODO: category', 'Fiction > Suspense', 'Fiction > Mystery'] }),
+    );
+    expect(result.errors).toContainEqual(expect.objectContaining({ code: 'UNRESOLVED_PLACEHOLDER' }));
+  });
+
+  it('reports a single DISALLOWED_HTML error for disallowed tags', () => {
+    const result = validateListing(
+      baseListing({ blurb: '<div>Some copy</div><span>more</span>' }),
+    );
+    expect(result.valid).toBe(false);
+    const htmlErrors = result.errors.filter((e) => e.code === 'DISALLOWED_HTML');
+    expect(htmlErrors).toHaveLength(1);
+  });
+
+  it('allows the whitelisted HTML tags, matched case-insensitively', () => {
+    const result = validateListing(
+      baseListing({
+        blurb: '<B>Bold</B><br><P>Para</P><ul><li>item</li></ul><H4>Heading</H4>',
+      }),
+    );
+    expect(result.errors).not.toContainEqual(expect.objectContaining({ code: 'DISALLOWED_HTML' }));
+  });
+
+  it('sorts errors by code ascending', () => {
+    const result = validateListing({
+      title: 'T',
+      blurb: '   ',
+      keywords: [],
+      categories: [],
+      author: 'A',
+    });
+    const codes = result.errors.map((e) => e.code);
+    const sorted = [...codes].sort();
+    expect(codes).toEqual(sorted);
+  });
+});
