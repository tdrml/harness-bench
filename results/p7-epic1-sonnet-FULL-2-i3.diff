+describe('validateManuscriptStructure', () => {
+  it('returns valid: true with no errors for a well-formed manuscript', () => {
+    const result = validateManuscriptStructure([chapter(1), chapter(2), chapter(3)]);
+    expect(result.valid).toBe(true);
+    expect(result.errors).toEqual([]);
+  });
+
+  it('flags a chapter with no level-1 heading', () => {
+    const result = validateManuscriptStructure([chapter(1, 'Just prose, no heading anywhere.')]);
+    expect(result.errors).toContainEqual({ code: 'H1_MISSING', detail: expect.any(String) });
+  });
+
+  it('flags a level-1 heading that is not the first non-empty line', () => {
+    const result = validateManuscriptStructure([
+      chapter(1, 'An introductory line.\n\n# Chapter 1: Title 1\n\nBody text.'),
+    ]);
+    expect(result.errors).toEqual([{ code: 'H1_NOT_FIRST', detail: expect.any(String) }]);
+  });
+
+  it('does not flag H1_NOT_FIRST when leading blank lines precede the heading', () => {
+    const result = validateManuscriptStructure([chapter(1, '\n\n# Chapter 1: Title 1\n\nBody text.')]);
+    expect(result.errors).toEqual([]);
+  });
+
+  it('flags a level-1 heading that does not match "# Chapter <N>: <Title>"', () => {
+    const result = validateManuscriptStructure([chapter(1, '# Just a title\n\nBody text.')]);
+    expect(result.errors).toEqual([{ code: 'H1_MALFORMED', detail: expect.any(String) }]);
+  });
+
+  it('flags a level-1 heading with an empty title', () => {
+    const result = validateManuscriptStructure([chapter(1, '# Chapter 1: \n\nBody text.')]);
+    expect(result.errors).toEqual([{ code: 'H1_MALFORMED', detail: expect.any(String) }]);
+  });
+
+  it('flags a heading number that does not match the chapter number implied by the path', () => {
+    const result = validateManuscriptStructure([chapter(1, '# Chapter 2: Title 2\n\nBody text.')]);
+    expect(result.errors).toEqual([{ code: 'H1_NUMBER_MISMATCH', detail: expect.any(String) }]);
+  });
+
+  it('skips H1_MALFORMED and H1_NUMBER_MISMATCH once H1_MISSING has fired', () => {
+    const result = validateManuscriptStructure([chapter(1, 'Some prose without any heading at all.')]);
+    const codes = result.errors.map((e) => e.code);
+    expect(codes).toContain('H1_MISSING');
+    expect(codes).not.toContain('H1_MALFORMED');
+    expect(codes).not.toContain('H1_NUMBER_MISMATCH');
+  });
+
+  it('flags two chapters that resolve to the same chapter number', () => {
+    const duplicate: ChapterFile = { path: chapter(1).path, content: '# Chapter 1: Another Title\n\nBody.' };
+    const result = validateManuscriptStructure([chapter(1), duplicate]);
+    expect(result.errors).toContainEqual({ code: 'CHAPTER_DUPLICATE', detail: expect.any(String) });
+  });
+
+  it('flags a gap in the chapter number sequence', () => {
+    const result = validateManuscriptStructure([chapter(1), chapter(3)]);
+    expect(result.errors).toContainEqual({ code: 'CHAPTER_GAP', detail: expect.any(String) });
+  });
+
+  it('does not flag a gap for a contiguous, out-of-order sequence', () => {
+    const result = validateManuscriptStructure([chapter(2), chapter(1), chapter(3)]);
+    expect(result.errors).toEqual([]);
+  });
+
+  it('sorts multiple errors by code ascending', () => {
