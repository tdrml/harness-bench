+      ]);
+      expect(result.valid).toBe(false);
+      const codes = result.errors.map((e) => e.code);
+      expect(codes).toContain('CHAPTER_DUPLICATE');
+      expect(codes).toContain('CHAPTER_GAP');
+      expect(codes).toContain('H1_MISSING');
+    });
+
+    it('handles complex scenario with multiple issues', () => {
+      const result = validateManuscriptStructure([
+        {
+          path: 'manuscript/chapter-01.md',
