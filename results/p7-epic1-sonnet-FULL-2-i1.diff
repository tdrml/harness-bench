@@ -0,0 +1,110 @@
+import { describe, it, expect } from 'vitest';
+import { validateListing } from '../index.js';
+import type { KdpListing } from '../index.js';
+
+const validListing: KdpListing = {
+  title: 'The Last Signal',
+  subtitle: 'A Thriller',
+  blurb: '<b>Opening hook.</b><br><br>Setup paragraph.<br><br><i>For fans of</i> Author X.',
+  keywords: ['a', 'b', 'c', 'd', 'e', 'f', 'g'],
+  categories: ['Fiction > Thrillers', 'Fiction > Mystery', 'Fiction > Suspense'],
+  author: 'Jane Doe',
+};
+
+describe('validateListing', () => {
+  it('returns valid: true with no errors for a well-formed listing', () => {
+    const result = validateListing(validListing);
+    expect(result.valid).toBe(true);
+    expect(result.errors).toEqual([]);
+  });
+
+  it('flags a blurb longer than 4000 characters', () => {
+    const result = validateListing({ ...validListing, blurb: 'a'.repeat(4001) });
+    expect(result.valid).toBe(false);
+    expect(result.errors).toEqual([{ code: 'BLURB_TOO_LONG', detail: expect.any(String) }]);
+  });
+
+  it('flags an empty blurb', () => {
+    const result = validateListing({ ...validListing, blurb: '' });
+    expect(result.errors).toEqual([{ code: 'BLURB_EMPTY', detail: expect.any(String) }]);
+  });
+
+  it('flags a whitespace-only blurb as empty', () => {
+    const result = validateListing({ ...validListing, blurb: '   \n\t  ' });
+    expect(result.errors).toEqual([{ code: 'BLURB_EMPTY', detail: expect.any(String) }]);
+  });
+
+  it('flags a keyword count other than 7', () => {
+    const result = validateListing({ ...validListing, keywords: ['a', 'b'] });
+    expect(result.errors).toEqual([{ code: 'KEYWORD_COUNT', detail: expect.any(String) }]);
+  });
+
+  it('flags a category count other than 3', () => {
+    const result = validateListing({ ...validListing, categories: ['Fiction > Thrillers'] });
+    expect(result.errors).toEqual([{ code: 'CATEGORY_COUNT', detail: expect.any(String) }]);
+  });
+
+  it('flags an unresolved placeholder in any field with a single error', () => {
+    const result = validateListing({
+      ...validListing,
+      title: 'TODO: pick title',
+      author: 'TODO: pick author',
+    });
+    const placeholderErrors = result.errors.filter((e) => e.code === 'UNRESOLVED_PLACEHOLDER');
+    expect(placeholderErrors).toHaveLength(1);
+  });
+
+  it('detects an unresolved placeholder inside a keyword entry', () => {
+    const result = validateListing({ ...validListing, keywords: ['TODO: fill in', 'b', 'c', 'd', 'e', 'f', 'g'] });
+    expect(result.errors).toEqual([{ code: 'UNRESOLVED_PLACEHOLDER', detail: expect.any(String) }]);
+  });
+
+  it('detects an unresolved placeholder inside a category entry', () => {
+    const result = validateListing({
+      ...validListing,
+      categories: ['TODO: fill in', 'Fiction > Mystery', 'Fiction > Suspense'],
+    });
+    expect(result.errors).toEqual([{ code: 'UNRESOLVED_PLACEHOLDER', detail: expect.any(String) }]);
+  });
+
+  it('flags disallowed HTML tags in the blurb with a single error', () => {
+    const result = validateListing({
+      ...validListing,
+      blurb: '<div>Not allowed</div><span>Also not allowed</span>',
+    });
+    const htmlErrors = result.errors.filter((e) => e.code === 'DISALLOWED_HTML');
+    expect(htmlErrors).toHaveLength(1);
+  });
+
+  it('treats disallowed tag matching case-insensitively', () => {
+    const result = validateListing({ ...validListing, blurb: '<DIV>bad</DIV>' });
+    expect(result.errors).toEqual([{ code: 'DISALLOWED_HTML', detail: expect.any(String) }]);
+  });
+
+  it('allows the whitelisted tags, including closing tags, case-insensitively', () => {
+    const result = validateListing({
+      ...validListing,
+      blurb: '<B>bold</B><I>italic</I><U>underline</U><P>para</P><br/><H4>head</H4>',
+    });
+    expect(result.errors).toEqual([]);
+  });
+
+  it('sorts multiple errors by code ascending', () => {
+    const result = validateListing({
+      title: '',
+      blurb: '',
+      keywords: [],
+      categories: [],
+      author: '',
+    });
+    const codes = result.errors.map((e) => e.code);
+    expect(codes).toEqual([...codes].sort());
+    expect(codes).toEqual(['BLURB_EMPTY', 'CATEGORY_COUNT', 'KEYWORD_COUNT']);
+  });
+
+  it('does not require a subtitle', () => {
+    const { subtitle: _subtitle, ...withoutSubtitle } = validListing;
+    const result = validateListing(withoutSubtitle);
+    expect(result.valid).toBe(true);
+  });
+});
