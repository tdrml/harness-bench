+import { describe, it, expect } from 'vitest';
+import { validateManuscriptStructure } from '../index.js';
+import type { ChapterFile } from '../index.js';
+import { getChapterFilePath } from '../../writing/index.js';
+
+function chapter(chapterNumber: number, overrides: Partial<ChapterFile> = {}): ChapterFile {
+  return {
+    path: getChapterFilePath(chapterNumber),
+    content: `# Chapter ${chapterNumber}: A Fine Title\n\nSome body text for the chapter.\n`,
+    ...overrides,
+  };
+}
+
+describe('validateManuscriptStructure', () => {
+  it('returns valid: true with no errors for a well-formed manuscript', () => {
+    const result = validateManuscriptStructure([chapter(1), chapter(2), chapter(3)]);
+    expect(result.valid).toBe(true);
+    expect(result.errors).toHaveLength(0);
+  });
+
+  it('allows a single-chapter manuscript', () => {
+    const result = validateManuscriptStructure([chapter(1)]);
+    expect(result.valid).toBe(true);
+  });
+
+  describe('H1_MISSING', () => {
+    it('flags a chapter with no level-1 heading', () => {
+      const result = validateManuscriptStructure([chapter(1, { content: 'Just some prose.\n' })]);
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'H1_MISSING' }));
+    });
+
+    it('does not also report H1_MALFORMED or H1_NUMBER_MISMATCH', () => {
+      const result = validateManuscriptStructure([chapter(1, { content: 'Just some prose.\n' })]);
+      const codes = result.errors.map((e) => e.code);
+      expect(codes).toEqual(['H1_MISSING']);
+    });
+
+    it('flags a chapter with only a level-2 heading', () => {
+      const result = validateManuscriptStructure([
+        chapter(1, { content: '## Not a chapter heading\n\nBody.\n' }),
+      ]);
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'H1_MISSING' }));
+    });
+  });
+
+  describe('H1_NOT_FIRST', () => {
+    it('flags a heading that is not the first non-empty line', () => {
+      const result = validateManuscriptStructure([
+        chapter(1, {
+          content: 'Some preamble.\n\n# Chapter 1: A Fine Title\n\nBody.\n',
+        }),
+      ]);
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'H1_NOT_FIRST' }));
+    });
+
+    it('still checks the heading shape even when it is not first', () => {
+      const result = validateManuscriptStructure([
+        chapter(1, {
+          content: 'Some preamble.\n\n# Chapter 2: A Fine Title\n\nBody.\n',
+        }),
+      ]);
+      const codes = result.errors.map((e) => e.code);
+      expect(codes).toContain('H1_NOT_FIRST');
+      expect(codes).toContain('H1_NUMBER_MISMATCH');
+    });
+
+    it('does not flag leading blank lines before the heading', () => {
+      const result = validateManuscriptStructure([
+        chapter(1, { content: '\n\n# Chapter 1: A Fine Title\n\nBody.\n' }),
+      ]);
+      expect(result.errors.some((e) => e.code === 'H1_NOT_FIRST')).toBe(false);
+    });
+  });
+
+  describe('H1_MALFORMED', () => {
+    it('flags a heading without the "Chapter <N>: <Title>" shape', () => {
+      const result = validateManuscriptStructure([chapter(1, { content: '# Preface\n\nBody.\n' })]);
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'H1_MALFORMED' }));
+    });
+
+    it('flags a heading with a non-numeric chapter marker', () => {
+      const result = validateManuscriptStructure([
+        chapter(1, { content: '# Chapter One: A Fine Title\n\nBody.\n' }),
+      ]);
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'H1_MALFORMED' }));
+    });
+
+    it('flags a heading with an empty title', () => {
+      const result = validateManuscriptStructure([chapter(1, { content: '# Chapter 1:\n\nBody.\n' })]);
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'H1_MALFORMED' }));
+    });
+
+    it('does not also report H1_NUMBER_MISMATCH', () => {
+      const result = validateManuscriptStructure([chapter(1, { content: '# Preface\n\nBody.\n' })]);
+      const codes = result.errors.map((e) => e.code);
+      expect(codes).toEqual(['H1_MALFORMED']);
+    });
+  });
+
+  describe('H1_NUMBER_MISMATCH', () => {
+    it('flags a heading number that disagrees with the file path', () => {
+      const result = validateManuscriptStructure([
+        chapter(1, { content: '# Chapter 2: A Fine Title\n\nBody.\n' }),
+      ]);
+      expect(result.errors).toContainEqual(
+        expect.objectContaining({ code: 'H1_NUMBER_MISMATCH' }),
+      );
+    });
+
+    it('does not flag a heading number that agrees with the file path', () => {
+      const result = validateManuscriptStructure([chapter(1)]);
+      expect(result.errors.some((e) => e.code === 'H1_NUMBER_MISMATCH')).toBe(false);
+    });
+  });
+
+  describe('CHAPTER_DUPLICATE', () => {
+    it('flags two chapters that resolve to the same chapter number', () => {
+      const result = validateManuscriptStructure([
+        chapter(1, { content: '# Chapter 2: A Fine Title\n\nBody.\n' }),
+        chapter(2),
+      ]);
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'CHAPTER_DUPLICATE' }));
+    });
+
+    it('reports only one error when several chapters collide', () => {
+      const result = validateManuscriptStructure([
+        chapter(1, { content: '# Chapter 3: A Fine Title\n\nBody.\n' }),
+        chapter(2, { content: '# Chapter 3: A Fine Title\n\nBody.\n' }),
+        chapter(3),
+      ]);
+      const duplicateErrors = result.errors.filter((e) => e.code === 'CHAPTER_DUPLICATE');
+      expect(duplicateErrors).toHaveLength(1);
+    });
+  });
+
+  describe('CHAPTER_GAP', () => {
+    it('flags a manuscript missing a chapter number in the sequence', () => {
+      const result = validateManuscriptStructure([chapter(1), chapter(3)]);
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'CHAPTER_GAP' }));
+    });
+
+    it('does not flag a contiguous 1..n sequence', () => {
+      const result = validateManuscriptStructure([chapter(1), chapter(2), chapter(3)]);
+      expect(result.errors.some((e) => e.code === 'CHAPTER_GAP')).toBe(false);
+    });
+
+    it('flags a sequence that does not start at 1', () => {
+      const result = validateManuscriptStructure([chapter(2), chapter(3)]);
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'CHAPTER_GAP' }));
+    });
+  });
+
+  it('sorts errors by code ascending', () => {
+    const result = validateManuscriptStructure([
+      chapter(1, { content: 'No heading at all.\n' }),
+      chapter(2, { content: '# Chapter 5: A Fine Title\n\nBody.\n' }),
+    ]);
+    const codes = result.errors.map((e) => e.code);
+    const sorted = [...codes].sort();
+    expect(codes).toEqual(sorted);
+    expect(result.valid).toBe(false);
+  });
+
+  it('evaluates chapters in order', () => {
+    const result = validateManuscriptStructure([
+      chapter(1),
+      chapter(2, { content: 'no heading\n' }),
+      chapter(3),
+    ]);
+    expect(result.errors).toContainEqual(expect.objectContaining({ code: 'H1_MISSING' }));
+  });
+});
