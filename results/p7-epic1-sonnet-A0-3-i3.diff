+export function validateManuscriptStructure(chapters: ChapterFile[]): ManuscriptValidation {
+  const errors: ManuscriptError[] = [];
+  const pathNumbers: (number | undefined)[] = [];
+
+  for (const chapter of chapters) {
+    const lines = chapter.content.split('\n');
+    const h1Index = lines.findIndex((line) => H1_LINE_PATTERN.test(line));
+
+    pathNumbers.push(chapterNumberFromPath(chapter.path));
+
+    if (h1Index === -1) {
+      errors.push({
+        code: 'H1_MISSING',
+        detail: `Chapter file ${chapter.path} has no level-1 markdown heading.`,
+      });
+      continue;
+    }
+
+    const h1Line = lines[h1Index]!;
+    const firstNonEmptyIndex = lines.findIndex((line) => line.trim() !== '');
+    if (firstNonEmptyIndex !== h1Index) {
+      errors.push({
+        code: 'H1_NOT_FIRST',
+        detail: `Chapter file ${chapter.path} has content before its level-1 heading.`,
+      });
+    }
+
+    const headingMatch = CHAPTER_HEADING_PATTERN.exec(h1Line);
+    const title = headingMatch?.[2]?.trim();
+    if (!headingMatch || !title) {
+      errors.push({
+        code: 'H1_MALFORMED',
+        detail: `Chapter file ${chapter.path} has a level-1 heading that does not match "# Chapter <N>: <Title>".`,
+      });
+      continue;
+    }
+
+    const headingNumber = parseInt(headingMatch[1]!, 10);
+    if (getChapterFilePath(headingNumber) !== chapter.path) {
+      errors.push({
+        code: 'H1_NUMBER_MISMATCH',
+        detail: `Chapter file ${chapter.path} has heading number ${headingNumber}, which does not match its file path.`,
+      });
+    }
+  }
+
+  const resolvedNumbers = pathNumbers.filter((n): n is number => n !== undefined);
+
+  const seen = new Set<number>();
+  let hasDuplicate = false;
+  for (const n of resolvedNumbers) {
+    if (seen.has(n)) {
+      hasDuplicate = true;
+    }
+    seen.add(n);
+  }
+  if (hasDuplicate) {
+    errors.push({
+      code: 'CHAPTER_DUPLICATE',
+      detail: 'Two or more chapter files resolve to the same chapter number.',
+    });
+  }
+
+  const sortedNumbers = [...resolvedNumbers].sort((a, b) => a - b);
+  const expectedNumbers = Array.from({ length: chapters.length }, (_, i) => i + 1);
+  const isContiguous =
+    sortedNumbers.length === expectedNumbers.length &&
+    sortedNumbers.every((n, i) => n === expectedNumbers[i]);
+  if (!isContiguous) {
+    errors.push({
+      code: 'CHAPTER_GAP',
+      detail: `Chapter numbers are not a contiguous 1..${chapters.length} sequence.`,
+    });
+  }
+
+  sortByCode(errors);
 
   return { valid: errors.length === 0, errors };
 }
