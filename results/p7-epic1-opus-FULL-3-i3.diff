diff --git a/packages/core/src/release-policy/validate-manuscript.ts b/packages/core/src/release-policy/validate-manuscript.ts
new file mode 100644
index 0000000..208e07f
--- /dev/null
+++ b/packages/core/src/release-policy/validate-manuscript.ts
@@ -0,0 +1,87 @@
+import { parseChapterHeading } from '../writing/markdown.js';
+import { getChapterFilePath, getChapterNumberFromFilePath } from '../writing/paths.js';
+import type { ChapterFile, ManuscriptError, ManuscriptValidation } from './types.js';
+import { sortErrorsByCode } from './sort-errors.js';
+
+// A level-1 ATX heading: exactly one '#' followed by whitespace or nothing
+const H1_LINE_RE = /^#(?:\s|$)/;
+
+export function validateManuscriptStructure(chapters: ChapterFile[]): ManuscriptValidation {
+  const errors: ManuscriptError[] = [];
+
+  for (const chapter of chapters) {
+    const lines = chapter.content.split('\n');
+
+    const headingIndex = lines.findIndex((line) => H1_LINE_RE.test(line));
+    if (headingIndex === -1) {
+      errors.push({
+        code: 'H1_MISSING',
+        detail: `${chapter.path} has no level-1 heading.`,
+      });
+      continue;
+    }
+
+    const firstContentIndex = lines.findIndex((line) => line.trim().length > 0);
+    if (firstContentIndex !== headingIndex) {
+      errors.push({
+        code: 'H1_NOT_FIRST',
+        detail: `${chapter.path} does not open with its level-1 heading.`,
+      });
+    }
+
+    const headingLine = lines[headingIndex]!;
+    const heading = parseChapterHeading(headingLine);
+    if (heading === undefined || heading.title.length === 0) {
+      errors.push({
+        code: 'H1_MALFORMED',
+        detail: `${chapter.path} heading "${headingLine.trim()}" does not match "# Chapter <N>: <Title>".`,
+      });
+      continue;
+    }
+
+    if (getChapterNumberFromFilePath(chapter.path) !== heading.chapterNumber) {
+      errors.push({
+        code: 'H1_NUMBER_MISMATCH',
+        detail: `${chapter.path} declares chapter ${heading.chapterNumber}, which belongs at ${getChapterFilePath(heading.chapterNumber)}.`,
+      });
+    }
+  }
+
+  const numbers = chapters.map((chapter) => getChapterNumberFromFilePath(chapter.path));
+
+  const seen = new Set<number>();
+  const duplicates: number[] = [];
+  for (const number of numbers) {
+    if (number === undefined) {
+      continue;
+    }
+    if (seen.has(number) && !duplicates.includes(number)) {
+      duplicates.push(number);
+    }
+    seen.add(number);
+  }
+  if (duplicates.length > 0) {
+    errors.push({
+      code: 'CHAPTER_DUPLICATE',
+      detail: `Chapter number(s) ${duplicates
+        .slice()
+        .sort((a, b) => a - b)
+        .join(', ')} are claimed by more than one file.`,
+    });
+  }
+
+  const distinct = [...seen].sort((a, b) => a - b);
+  const contiguous =
+    numbers.every((number) => number !== undefined) &&
+    distinct.every((number, index) => number === index + 1);
+  if (!contiguous) {
+    errors.push({
+      code: 'CHAPTER_GAP',
+      detail: `Chapter numbers [${distinct.join(', ')}] are not a gapless 1..${distinct.length} range.`,
+    });
+  }
+
+  sortErrorsByCode(errors);
+
+  return { valid: errors.length === 0, errors };
+}
