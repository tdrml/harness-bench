+import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';
+import type { AgentRunService, EnvironmentConfig, TaskOutputService } from '@auto-graph/core';
+
+vi.mock('../ecs-launcher.js', async (importOriginal) => {
+  const actual = await importOriginal<typeof import('../ecs-launcher.js')>();
+  return {
+    ...actual,
+    launchECSTask: vi.fn().mockResolvedValue('arn:aws:ecs:us-east-1:123:task/test/abc123'),
+  };
+});
+
+import { launchECSTask } from '../ecs-launcher.js';
+import { launchAgentRun } from '../launch-agent-run.js';
+
+const config: EnvironmentConfig = {
+  AWS_REGION: 'us-east-1',
+  DYNAMODB_TABLE_PREFIX: 'test',
+  SQS_QUEUE_URL: 'https://sqs.us-east-1.amazonaws.com/123',
+  ECS_CLUSTER_ARN: 'arn:aws:ecs:us-east-1:123:cluster/main',
+  ECS_SUBNETS: 'subnet-aaa',
+  ECS_SECURITY_GROUPS: 'sg-aaa',
+  GITHUB_TOKEN: 'ghp_test',
+  GITHUB_ORG: 'test-org',
+  ORCHESTRATION_REPO: 'test-repo',
+  LOG_LEVEL: 'info',
+};
+
+let create: ReturnType<typeof vi.fn>;
+let save: ReturnType<typeof vi.fn>;
+
+function baseParams() {
+  return {
+    taskDefArn: 'arn:aws:ecs:us-east-1:123:task-definition/writer:1',
+    workerType: 'writer' as const,
+    systemPrompt: 'mock system prompt',
+    projectId: 'proj-123',
+    repoName: 'the-dark-tower',
+    config,
+    agentRunService: { create } as unknown as AgentRunService,
+    taskOutputService: { save } as unknown as TaskOutputService,
+  };
+}
+
+beforeEach(() => {
+  vi.clearAllMocks();
+  create = vi.fn().mockResolvedValue(undefined);
+  save = vi.fn().mockResolvedValue(undefined);
+  vi.mocked(launchECSTask).mockResolvedValue('arn:aws:ecs:us-east-1:123:task/test/abc123');
+});
+
+afterEach(() => {
+  delete process.env['STATE_MACHINE_ARN'];
+});
+
+describe('launchAgentRun', () => {
+  it('returns the generated runId and the ECS task ARN', async () => {
+    const result = await launchAgentRun(baseParams());
+
+    expect(result.taskArn).toBe('arn:aws:ecs:us-east-1:123:task/test/abc123');
+    expect(result.runId).toMatch(/^[0-9A-HJKMNP-TV-Z]{26}$/);
+  });
+
+  it('generates a distinct run id per launch', async () => {
+    const first = await launchAgentRun(baseParams());
+    const second = await launchAgentRun(baseParams());
+
+    expect(first.runId).not.toBe(second.runId);
+  });
+
+  it('saves the system prompt as a task output under the run id', async () => {
+    const { runId } = await launchAgentRun(baseParams());
+
+    expect(save).toHaveBeenCalledOnce();
+    const [outputItem] = save.mock.calls[0]!;
+    expect(outputItem.runId).toBe(runId);
+    expect(outputItem.outputType).toBe('system-prompt');
+    expect(outputItem.projectId).toBe('proj-123');
+    expect(outputItem.content).toBe('mock system prompt');
+    expect(outputItem.contentLength).toBe('mock system prompt'.length);
+  });
+
+  it('launches the ECS task with the standard environment keys', async () => {
+    const { runId } = await launchAgentRun(baseParams());
+
+    expect(vi.mocked(launchECSTask)).toHaveBeenCalledOnce();
+    const [params] = vi.mocked(launchECSTask).mock.calls[0]!;
+    expect(params.taskDefinition).toBe('arn:aws:ecs:us-east-1:123:task-definition/writer:1');
+    expect(params.command).toEqual(['claude', '-p', '$SYSTEM_PROMPT']);
+    expect(params.environment).toEqual({
+      PROJECT_ID: 'proj-123',
+      REPO_NAME: 'the-dark-tower',
+      RUN_ID: runId,
+      AWS_REGION: 'us-east-1',
+      DYNAMODB_TABLE_PREFIX: 'test',
+    });
+    expect(params.runId).toBe(runId);
+    expect(params.projectId).toBe('proj-123');
+  });
+
+  it('merges extraEnv into the standard environment keys', async () => {
+    const { runId } = await launchAgentRun({
+      ...baseParams(),
+      extraEnv: { CHAPTER_NUMBER: '3', BRANCH_NAME: 'chapter-03' },
+    });
+
+    const [params] = vi.mocked(launchECSTask).mock.calls[0]!;
+    expect(params.environment).toEqual({
+      PROJECT_ID: 'proj-123',
+      REPO_NAME: 'the-dark-tower',
+      RUN_ID: runId,
+      AWS_REGION: 'us-east-1',
+      DYNAMODB_TABLE_PREFIX: 'test',
+      CHAPTER_NUMBER: '3',
+      BRANCH_NAME: 'chapter-03',
+    });
+  });
+
+  it('forwards STATE_MACHINE_ARN when it is set', async () => {
+    process.env['STATE_MACHINE_ARN'] = 'arn:aws:states:us-east-1:123:stateMachine/run';
+
+    await launchAgentRun(baseParams());
+
+    const [params] = vi.mocked(launchECSTask).mock.calls[0]!;
+    expect(params.stateMachineArn).toBe('arn:aws:states:us-east-1:123:stateMachine/run');
+  });
+
+  it('creates the agent run record with status RUNNING', async () => {
+    const { runId, taskArn } = await launchAgentRun(baseParams());
+
+    expect(create).toHaveBeenCalledOnce();
+    const [runItem] = create.mock.calls[0]!;
+    expect(runItem.runId).toBe(runId);
+    expect(runItem.projectId).toBe('proj-123');
+    expect(runItem.taskArn).toBe(taskArn);
+    expect(runItem.workerType).toBe('writer');
+    expect(runItem.status).toBe('RUNNING');
+    expect(typeof runItem.startedAt).toBe('string');
+    expect(runItem).not.toHaveProperty('nodeId');
+  });
+
+  it('records the nodeId when one is supplied', async () => {
+    await launchAgentRun({ ...baseParams(), nodeId: 'node-5' });
+
+    const [runItem] = create.mock.calls[0]!;
+    expect(runItem.nodeId).toBe('node-5');
+  });
+
+  it('uses the same runId and timestamp for the task output and the agent run', async () => {
+    await launchAgentRun(baseParams());
+
+    const [outputItem] = save.mock.calls[0]!;
+    const [runItem] = create.mock.calls[0]!;
+    expect(runItem.runId).toBe(outputItem.runId);
+    expect(runItem.startedAt).toBe(outputItem.createdAt);
+  });
+
+  it('does not create the agent run when the ECS launch fails', async () => {
+    vi.mocked(launchECSTask).mockRejectedValueOnce(new Error('ECS error'));
+
+    await expect(launchAgentRun(baseParams())).rejects.toThrow('ECS error');
+    expect(create).not.toHaveBeenCalled();
+  });
+
+  it('does not launch the ECS task when saving the prompt fails', async () => {
+    save.mockRejectedValueOnce(new Error('DynamoDB write error'));
+
+    await expect(launchAgentRun(baseParams())).rejects.toThrow('DynamoDB write error');
+    expect(vi.mocked(launchECSTask)).not.toHaveBeenCalled();
+  });
+});
