+import { getChapterFilePath } from '../writing/paths.js';
+import { byCode } from './sort-errors.js';
+import type { ChapterFile, ManuscriptError, ManuscriptValidation } from './types.js';
+
+// A level-1 heading: a single '#' followed by whitespace, so '## ...' is not one.
+const H1_RE = /^#\s+(.+)$/;
+// The heading text every chapter must carry, i.e. 'Chapter <N>: <Title>'.
+const CHAPTER_HEADING_RE = /^Chapter\s+(\d+):\s+(.+)$/;
+// Last run of digits in a file name, e.g. 'chapter-07.md' -> '07'.
+const FILE_NUMBER_RE = /(\d+)(?!.*\d)/;
+
+function fileName(path: string): string {
+  return path.slice(path.lastIndexOf('/') + 1);
+}
+
+/**
+ * The chapter number a path implies — the inverse of the canonical
+ * `getChapterFilePath` convention. Undefined when the file name does not follow
+ * that convention (an unnumbered or unpadded file cannot be placed in the set).
+ */
+function chapterNumberFromPath(path: string): number | undefined {
+  const digits = FILE_NUMBER_RE.exec(fileName(path))?.[1];
+  if (digits === undefined) {
+    return undefined;
+  }
+  const chapterNumber = Number.parseInt(digits, 10);
+  return fileName(path) === fileName(getChapterFilePath(chapterNumber)) ? chapterNumber : undefined;
+}
+
+export function validateManuscriptStructure(chapters: ChapterFile[]): ManuscriptValidation {
+  const errors: ManuscriptError[] = [];
+  const pathNumbers: (number | undefined)[] = [];
+
+  for (const chapter of chapters) {
+    const pathNumber = chapterNumberFromPath(chapter.path);
+    pathNumbers.push(pathNumber);
+
+    const lines = chapter.content.split('\n');
+    const headingIndex = lines.findIndex((line) => H1_RE.test(line));
+
+    if (headingIndex === -1) {
+      errors.push({
+        code: 'H1_MISSING',
+        detail: `${chapter.path} has no level-1 heading.`,
+      });
+      // The remaining heading rules all describe a heading that exists.
+      continue;
+    }
+
+    const firstNonEmptyIndex = lines.findIndex((line) => line.trim().length > 0);
+    if (headingIndex !== firstNonEmptyIndex) {
+      errors.push({
+        code: 'H1_NOT_FIRST',
+        detail: `${chapter.path} does not open with its level-1 heading.`,
+      });
+    }
+
+    const headingText = (H1_RE.exec(lines[headingIndex] ?? '')?.[1] ?? '').trim();
+    const heading = CHAPTER_HEADING_RE.exec(headingText);
+    if (heading === null) {
+      errors.push({
+        code: 'H1_MALFORMED',
+        detail: `${chapter.path} has the heading "# ${headingText}", expected "# Chapter <N>: <Title>".`,
+      });
+      continue;
+    }
+
+    const headingNumber = Number.parseInt(heading[1]!, 10);
+    if (headingNumber !== pathNumber) {
+      errors.push({
+        code: 'H1_NUMBER_MISMATCH',
+        detail: `${chapter.path} declares chapter ${headingNumber}, whose path is ${getChapterFilePath(headingNumber)}.`,
+      });
+    }
+  }
+
+  const numbers = new Set<number>();
+  const duplicates = new Set<number>();
+  for (const pathNumber of pathNumbers) {
+    if (pathNumber === undefined) {
+      continue;
+    }
+    if (numbers.has(pathNumber)) {
+      duplicates.add(pathNumber);
+    } else {
+      numbers.add(pathNumber);
+    }
+  }
+
+  if (duplicates.size > 0) {
+    const listed = [...duplicates].sort((a, b) => a - b).join(', ');
+    errors.push({
+      code: 'CHAPTER_DUPLICATE',
+      detail: `More than one chapter resolves to chapter number: ${listed}.`,
+    });
+  }
+
+  const sorted = [...numbers].sort((a, b) => a - b);
+  const unnumbered = pathNumbers.some((pathNumber) => pathNumber === undefined);
+  if (unnumbered || sorted.some((chapterNumber, index) => chapterNumber !== index + 1)) {
+    errors.push({
+      code: 'CHAPTER_GAP',
+      detail: `Chapter numbers must run 1..n with no gaps; found ${sorted.length > 0 ? sorted.join(', ') : 'none'}.`,
+    });
+  }
+
+  errors.sort(byCode);
+
+  return { valid: errors.length === 0, errors };
+}
