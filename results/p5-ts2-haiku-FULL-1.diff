   });
+
+  it('acquireLock applies default grace period of 30 seconds', async () => {
+    const before = Math.floor(Date.now() / 1000);
+    const client = makeClient(() => ({}));
+    const svc = new RepoLocksService(client);
+    await svc.acquireLock('acme/app', 'owner-1');
+    const after = Math.floor(Date.now() / 1000);
+    const cmd = (client.send as ReturnType<typeof vi.fn>).mock.calls[0][0];
+    const checkTime = cmd.input.ExpressionAttributeValues[':now'] as number;
+    expect(checkTime).toBeGreaterThanOrEqual(before - 30);
+    expect(checkTime).toBeLessThanOrEqual(after - 30);
+  });
+
+  it('acquireLock respects custom grace period', async () => {
+    const before = Math.floor(Date.now() / 1000);
+    const client = makeClient(() => ({}));
+    const svc = new RepoLocksService(client);
+    await svc.acquireLock('acme/app', 'owner-1', { takeoverGraceSeconds: 45 });
+    const after = Math.floor(Date.now() / 1000);
+    const cmd = (client.send as ReturnType<typeof vi.fn>).mock.calls[0][0];
+    const checkTime = cmd.input.ExpressionAttributeValues[':now'] as number;
+    expect(checkTime).toBeGreaterThanOrEqual(before - 45);
+    expect(checkTime).toBeLessThanOrEqual(after - 45);
+  });
+
+  it('acquireLock with zero grace period reproduces original behavior', async () => {
+    const before = Math.floor(Date.now() / 1000);
+    const client = makeClient(() => ({}));
+    const svc = new RepoLocksService(client);
+    await svc.acquireLock('acme/app', 'owner-1', { takeoverGraceSeconds: 0 });
+    const after = Math.floor(Date.now() / 1000);
+    const cmd = (client.send as ReturnType<typeof vi.fn>).mock.calls[0][0];
+    const checkTime = cmd.input.ExpressionAttributeValues[':now'] as number;
+    expect(checkTime).toBeGreaterThanOrEqual(before);
+    expect(checkTime).toBeLessThanOrEqual(after);
+  });
+
+  it('acquireLock sets TTL independently of grace period', async () => {
+    const before = Math.floor(Date.now() / 1000);
+    const client = makeClient(() => ({}));
+    const svc = new RepoLocksService(client);
+    await svc.acquireLock('acme/app', 'owner-1', { takeoverGraceSeconds: 100 });
+    const after = Math.floor(Date.now() / 1000);
+    const cmd = (client.send as ReturnType<typeof vi.fn>).mock.calls[0][0];
+    const ttl = cmd.input.Item.ttl as number;
+    expect(ttl).toBeGreaterThanOrEqual(before + 1800);
+    expect(ttl).toBeLessThanOrEqual(after + 1800);
+  });
+
+  it('acquireLock can take over a lock expired longer than grace period', async () => {
+    const now = Math.floor(Date.now() / 1000);
+    const expiredLock = {
+      repoFullName: 'acme/app',
+      lockOwner: 'owner-old',
+      ttl: now - 35,
+      acquiredAt: new Date().toISOString(),
+    };
+    const client = makeClient(() => ({}));
+    const svc = new RepoLocksService(client);
+    await svc.acquireLock('acme/app', 'owner-new', { takeoverGraceSeconds: 30 });
+    const cmd = (client.send as ReturnType<typeof vi.fn>).mock.calls[0][0];
+    const checkTime = cmd.input.ExpressionAttributeValues[':now'] as number;
+    expect(expiredLock.ttl).toBeLessThan(checkTime);
+  });
+
+  it('acquireLock cannot take over a lock that expired less than grace period ago', async () => {
+    const now = Math.floor(Date.now() / 1000);
+    const recentlyExpiredLock = {
+      repoFullName: 'acme/app',
+      lockOwner: 'owner-old',
+      ttl: now - 20,
+      acquiredAt: new Date().toISOString(),
+    };
+    const client = makeClient(() => ({}));
+    const svc = new RepoLocksService(client);
+    await svc.acquireLock('acme/app', 'owner-new', { takeoverGraceSeconds: 30 });
+    const cmd = (client.send as ReturnType<typeof vi.fn>).mock.calls[0][0];
+    const checkTime = cmd.input.ExpressionAttributeValues[':now'] as number;
+    expect(recentlyExpiredLock.ttl).toBeGreaterThan(checkTime);
+  });
 });
