diff --git a/packages/core/src/word-count-policy/resolve.ts b/packages/core/src/word-count-policy/resolve.ts
new file mode 100644
index 0000000..eb1e261
--- /dev/null
+++ b/packages/core/src/word-count-policy/resolve.ts
@@ -0,0 +1,69 @@
+import { WORD_COUNT_DEFAULTS } from '../config/defaults.js';
+import type { ProjectType } from '../config/schemas.js';
+import type { WordCountBand, WordCountStage } from './types.js';
+
+const TOLERANCES: Record<WordCountStage, number> = {
+  writer: 0.05,
+  review: 0.1,
+  merge: 0.2,
+};
+
+export interface ResolveChapterTargetParams {
+  targetWordCount: number;
+  chapterCount: number;
+}
+
+export interface ResolveWordCountRangeParams extends ResolveChapterTargetParams {
+  stage: WordCountStage;
+}
+
+export interface ClampToProjectTypeParams {
+  range: WordCountBand;
+  projectType: ProjectType;
+}
+
+/** Per-chapter word count target — the whole book split evenly across chapters. */
+export function resolveChapterTarget(params: ResolveChapterTargetParams): number {
+  const { targetWordCount, chapterCount } = params;
+  if (chapterCount <= 0) {
+    throw new Error(`chapterCount must be positive, got ${chapterCount}`);
+  }
+  return Math.floor(targetWordCount / chapterCount);
+}
+
+/** Fractional tolerance the given stage allows around the per-chapter target. */
+export function resolveTolerance(stage: WordCountStage): number {
+  return TOLERANCES[stage];
+}
+
+/** The acceptable word-count band for a chapter at the given stage. */
+export function resolveWordCountRange(params: ResolveWordCountRangeParams): WordCountBand {
+  const { targetWordCount, chapterCount, stage } = params;
+  const target = resolveChapterTarget({ targetWordCount, chapterCount });
+  const tolerance = resolveTolerance(stage);
+  return {
+    min: Math.floor(target * (1 - tolerance)),
+    max: Math.ceil(target * (1 + tolerance)),
+  };
+}
+
+/** The stage's tolerance rendered for agent prompts, e.g. `±10%`. */
+export function formatToleranceForPrompt(stage: WordCountStage): string {
+  return `±${Math.round(resolveTolerance(stage) * 100)}%`;
+}
+
+/**
+ * Clamp a resolved band into the project type's per-chapter band.
+ *
+ * Both endpoints are clamped, not just the one that violates the band: a
+ * resolved band lying entirely outside the project type's band collapses onto
+ * the nearer bound instead of inverting into a `min` greater than its `max`.
+ */
+export function clampToProjectType(params: ClampToProjectTypeParams): WordCountBand {
+  const { range, projectType } = params;
+  const { chapterMin, chapterMax } = WORD_COUNT_DEFAULTS[projectType];
+  return {
+    min: Math.min(Math.max(range.min, chapterMin), chapterMax),
+    max: Math.min(Math.max(range.max, chapterMin), chapterMax),
+  };
+}
