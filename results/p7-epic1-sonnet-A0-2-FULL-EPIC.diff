+import { describe, it, expect } from 'vitest';
+import {
+  resolveChapterTarget,
+  resolveWordCountRange,
+  resolveTolerance,
+  formatToleranceForPrompt,
+  clampToProjectType,
+} from '../index.js';
+import { ProjectType } from '../../config/schemas.js';
+
+describe('resolveChapterTarget', () => {
+  it('floors targetWordCount / chapterCount', () => {
+    expect(resolveChapterTarget({ targetWordCount: 90000, chapterCount: 3 })).toBe(30000);
+    expect(resolveChapterTarget({ targetWordCount: 100000, chapterCount: 3 })).toBe(33333);
+  });
+
+  it('throws when chapterCount is zero', () => {
+    expect(() => resolveChapterTarget({ targetWordCount: 90000, chapterCount: 0 })).toThrow();
+  });
+
+  it('throws when chapterCount is negative', () => {
+    expect(() => resolveChapterTarget({ targetWordCount: 90000, chapterCount: -1 })).toThrow();
+  });
+});
+
+describe('resolveTolerance', () => {
+  it('returns 0.05 for writer', () => {
+    expect(resolveTolerance('writer')).toBe(0.05);
+  });
+
+  it('returns 0.1 for review', () => {
+    expect(resolveTolerance('review')).toBe(0.1);
+  });
+
+  it('returns 0.2 for merge', () => {
+    expect(resolveTolerance('merge')).toBe(0.2);
+  });
+});
+
+describe('formatToleranceForPrompt', () => {
+  it('formats writer tolerance', () => {
+    expect(formatToleranceForPrompt('writer')).toBe('±5%');
+  });
+
+  it('formats review tolerance', () => {
+    expect(formatToleranceForPrompt('review')).toBe('±10%');
+  });
+
+  it('formats merge tolerance', () => {
+    expect(formatToleranceForPrompt('merge')).toBe('±20%');
+  });
+});
+
+describe('resolveWordCountRange', () => {
+  it('computes a floor/ceil band around the target for the writer stage', () => {
+    // target = 4000, tolerance 5% => [3800, 4200]
+    const range = resolveWordCountRange({
+      targetWordCount: 12000,
+      chapterCount: 3,
+      stage: 'writer',
+    });
+    expect(range).toEqual({ min: 3800, max: 4200 });
+  });
+
+  it('computes a floor/ceil band around the target for the review stage', () => {
+    // target = 30000, tolerance 10% => [27000, 33000]
+    const range = resolveWordCountRange({
+      targetWordCount: 90000,
+      chapterCount: 3,
+      stage: 'review',
+    });
+    expect(range).toEqual({ min: 27000, max: 33000 });
+  });
+
+  it('computes a floor/ceil band around the target for the merge stage, using ceil for max', () => {
+    // target = 33333, tolerance 20% => min floor(26666.4)=26666, max ceil(39999.6)=40000
+    const range = resolveWordCountRange({
+      targetWordCount: 100000,
+      chapterCount: 3,
+      stage: 'merge',
+    });
+    expect(range).toEqual({ min: 26666, max: 40000 });
+  });
+});
+
+describe('clampToProjectType', () => {
+  it('leaves a range unchanged when fully inside the project type band', () => {
+    const range = clampToProjectType({
+      range: { min: 3200, max: 4800 },
+      projectType: ProjectType.NOVEL,
+    });
+    expect(range).toEqual({ min: 3200, max: 4800 });
+  });
+
+  it('raises min up to chapterMin when below it', () => {
+    const range = clampToProjectType({
+      range: { min: 1000, max: 4000 },
+      projectType: ProjectType.NOVEL,
+    });
+    expect(range).toEqual({ min: 3000, max: 4000 });
+  });
+
+  it('lowers max down to chapterMax when above it', () => {
+    const range = clampToProjectType({
+      range: { min: 4000, max: 6000 },
+      projectType: ProjectType.NOVEL,
+    });
+    expect(range).toEqual({ min: 4000, max: 5000 });
+  });
+
+  it('collapses a range lying entirely above the project type band onto chapterMax', () => {
+    const range = clampToProjectType({
+      range: { min: 24000, max: 36000 },
+      projectType: ProjectType.NOVEL,
+    });
+    expect(range).toEqual({ min: 5000, max: 5000 });
+  });
+
+  it('collapses a range lying entirely below the project type band onto chapterMin', () => {
+    const range = clampToProjectType({
+      range: { min: 100, max: 500 },
+      projectType: ProjectType.NOVEL,
+    });
+    expect(range).toEqual({ min: 3000, max: 3000 });
+  });
+});
