+async function findTaskByPrNumber(
+  prNumber: number,
+  repoOwner: string,
+  repoName: string,
+): Promise<{ projectId: string; taskId: string } | undefined> {
+  const statuses = ['IN_PROGRESS', 'COMPLETED'] as const;
+  for (const status of statuses) {
+    const projects = await projectsService.listProjectsByStatus(status);
+    for (const project of projects) {
+      if (project.repoOwner === repoOwner && project.repoName === repoName) {
+        const tasks = await taskGraphsService.getGraph(project.projectId);
+        const task = tasks.find((t) => t.prNumber === prNumber);
+        if (task) {
+          return { projectId: project.projectId, taskId: task.taskId };
+        }
+      }
+    }
+  }
+  return undefined;
+}
