+        },
+        {
+          path: 'manuscript/chapter-02.md',
+          content: '# Chapter 2: Getting Started\n\nMore content.',
+        },
+      ];
+      const result = validateManuscriptStructure(chapters);
+      expect(result.valid).toBe(true);
+      expect(result.errors).toHaveLength(0);
+    });
+
+    it('accepts chapters with empty lines before H1', () => {
+      const chapters: ChapterFile[] = [
+        {
+          path: 'manuscript/chapter-01.md',
+          content: '\n\n# Chapter 1: First Chapter\n\nContent goes here.',
+        },
+      ];
+      const result = validateManuscriptStructure(chapters);
+      expect(result.valid).toBe(true);
+      expect(result.errors).toHaveLength(0);
+    });
+
+    it('accepts chapters with content after H1', () => {
+      const chapters: ChapterFile[] = [
+        {
+          path: 'manuscript/chapter-01.md',
