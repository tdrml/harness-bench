+import { describe, it, expect } from 'vitest';
+import {
+  resolveChapterTarget,
+  resolveTolerance,
+  resolveWordCountRange,
+  formatToleranceForPrompt,
+  clampToProjectType,
+} from '../policy.js';
+import { ProjectType } from '../../config/schemas.js';
+
+describe('Word Count Policy', () => {
+  describe('resolveChapterTarget', () => {
+    it('divides total target by chapter count', () => {
+      const target = resolveChapterTarget({ targetWordCount: 90000, chapterCount: 3 });
+      expect(target).toBe(30000);
+    });
+
+    it('floors the result', () => {
+      const target = resolveChapterTarget({ targetWordCount: 91000, chapterCount: 3 });
+      expect(target).toBe(30333);
+    });
+
+    it('throws on zero chapter count', () => {
+      expect(() =>
+        resolveChapterTarget({ targetWordCount: 90000, chapterCount: 0 }),
+      ).toThrow('chapterCount must be positive');
+    });
+
+    it('throws on negative chapter count', () => {
+      expect(() =>
+        resolveChapterTarget({ targetWordCount: 90000, chapterCount: -1 }),
+      ).toThrow('chapterCount must be positive');
+    });
+  });
+
+  describe('resolveTolerance', () => {
+    it('returns 0.05 for writer stage', () => {
+      expect(resolveTolerance('writer')).toBe(0.05);
+    });
+
+    it('returns 0.10 for review stage', () => {
+      expect(resolveTolerance('review')).toBe(0.10);
+    });
+
+    it('returns 0.20 for merge stage', () => {
+      expect(resolveTolerance('merge')).toBe(0.20);
+    });
+  });
+
+  describe('resolveWordCountRange', () => {
+    it('applies writer tolerance (±5%)', () => {
+      const range = resolveWordCountRange({ targetWordCount: 90000, chapterCount: 3, stage: 'writer' });
+      const target = 30000;
+      expect(range.min).toBe(Math.floor(target * 0.95)); // 28500
+      expect(range.max).toBe(Math.ceil(target * 1.05)); // 31500
+    });
+
+    it('applies review tolerance (±10%)', () => {
+      const range = resolveWordCountRange({ targetWordCount: 90000, chapterCount: 3, stage: 'review' });
+      const target = 30000;
+      expect(range.min).toBe(Math.floor(target * 0.90)); // 27000
+      expect(range.max).toBe(Math.ceil(target * 1.10)); // 33000
+    });
+
+    it('applies merge tolerance (±20%)', () => {
+      const range = resolveWordCountRange({ targetWordCount: 90000, chapterCount: 3, stage: 'merge' });
+      const target = 30000;
+      expect(range.min).toBe(Math.floor(target * 0.80)); // 24000
+      expect(range.max).toBe(Math.ceil(target * 1.20)); // 36000
+    });
+
+    it('uses ceil for max bound', () => {
+      // When the result is fractional, ceil should round up
+      const range = resolveWordCountRange({ targetWordCount: 91000, chapterCount: 3, stage: 'merge' });
+      const target = 30333;
+      expect(range.max).toBe(Math.ceil(target * 1.20)); // ceil(36399.6) = 36400
+    });
+  });
+
+  describe('formatToleranceForPrompt', () => {
+    it('returns ±5% for writer stage', () => {
+      expect(formatToleranceForPrompt('writer')).toBe('±5%');
+    });
+
+    it('returns ±10% for review stage', () => {
+      expect(formatToleranceForPrompt('review')).toBe('±10%');
+    });
+
+    it('returns ±20% for merge stage', () => {
+      expect(formatToleranceForPrompt('merge')).toBe('±20%');
+    });
+  });
+
+  describe('clampToProjectType', () => {
+    it('clamps both bounds to project type chapter limits', () => {
+      // NOVEL has chapterMin: 3000, chapterMax: 5000
+      // Merge range is [24000, 36000], entirely outside bounds
+      const range = { min: 24000, max: 36000 };
+      const clamped = clampToProjectType({ range, projectType: ProjectType.NOVEL });
+      expect(clamped.min).toBe(5000);
+      expect(clamped.max).toBe(5000);
+    });
+
+    it('clamps min upward when below chapterMin', () => {
+      const range = { min: 1000, max: 4000 };
+      const clamped = clampToProjectType({ range, projectType: ProjectType.NOVEL });
+      expect(clamped.min).toBe(3000); // raised from 1000 to chapterMin
+      expect(clamped.max).toBe(4000); // unchanged
+    });
+
+    it('clamps max downward when above chapterMax', () => {
+      const range = { min: 4000, max: 10000 };
+      const clamped = clampToProjectType({ range, projectType: ProjectType.NOVEL });
+      expect(clamped.min).toBe(4000); // unchanged
+      expect(clamped.max).toBe(5000); // lowered from 10000 to chapterMax
+    });
+
+    it('leaves range unchanged when already within bounds', () => {
+      const range = { min: 3500, max: 4500 };
+      const clamped = clampToProjectType({ range, projectType: ProjectType.NOVEL });
+      expect(clamped).toEqual(range);
+    });
+
+    it('applies different bounds for different project types', () => {
+      // NOVELLA has chapterMin: 2500, chapterMax: 4000
+      const range = { min: 1000, max: 5000 };
+      const clamped = clampToProjectType({ range, projectType: ProjectType.NOVELLA });
+      expect(clamped.min).toBe(2500);
+      expect(clamped.max).toBe(4000);
+    });
+  });
+});
