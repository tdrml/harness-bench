+export function validateManuscriptStructure(chapters: ChapterFile[]): ManuscriptValidation {
+  const errors: ManuscriptError[] = [];
+  const chapterNumbers = new Map<number, string[]>();
+
+  // Per-chapter validation
+  for (let i = 0; i < chapters.length; i++) {
+    const chapter = chapters[i]!;
+    const lines = chapter.content.split('\n');
+
+    // Extract chapter number from path using the canonical path helper format
+    const expectedChapterNumber = getChapterNumberFromPath(chapter.path);
+    if (expectedChapterNumber === null) {
+      continue;
+    }
+
+    // Find H1 heading by checking each line
+    let h1Match: RegExpExecArray | null = null;
+    let h1LineIndex = -1;
+    const h1Regex = /^#\s+Chapter\s+(\d+):\s*(.*)$/;
+
+    for (let lineIdx = 0; lineIdx < lines.length; lineIdx++) {
+      const lineMatch = h1Regex.exec(lines[lineIdx]!);
+      if (lineMatch) {
+        h1Match = lineMatch;
+        h1LineIndex = lineIdx;
+        break;
+      }
+    }
+
+    // H1_MISSING: no level-1 heading (rule 1)
+    if (!h1Match) {
+      errors.push({
+        code: 'H1_MISSING',
+        detail: `Chapter at index ${i}: No level-1 heading found.`,
+      });
+      // Continue to check H1_NOT_FIRST (rule 2), but skip rules 3 and 4
+      const firstNonEmptyLineIndex = lines.findIndex((line) => line.trim().length > 0);
+      if (firstNonEmptyLineIndex !== -1) {
+        errors.push({
+          code: 'H1_NOT_FIRST',
+          detail: `Chapter at index ${i}: The first non-empty line is not the level-1 heading.`,
+        });
+      }
+      // Track chapter number anyway for duplicate/gap check
+      if (!chapterNumbers.has(expectedChapterNumber)) {
+        chapterNumbers.set(expectedChapterNumber, []);
+      }
+      chapterNumbers.get(expectedChapterNumber)!.push(chapter.path);
+      continue;
+    }
+
+    const h1Number = parseInt(h1Match[1]!, 10);
+    const h1Title = h1Match[2]!.trim();
+
+    // H1_NOT_FIRST: first non-empty line is not H1 (rule 2)
+    let firstNonEmptyLineIndex = -1;
+    for (let lineIdx = 0; lineIdx < lines.length; lineIdx++) {
+      if (lines[lineIdx]!.trim().length > 0) {
+        firstNonEmptyLineIndex = lineIdx;
+        break;
+      }
+    }
+    if (firstNonEmptyLineIndex !== h1LineIndex) {
+      errors.push({
+        code: 'H1_NOT_FIRST',
+        detail: `Chapter at index ${i}: The first non-empty line is not the level-1 heading.`,
+      });
+    }
+
+    // H1_MALFORMED: title is empty (rule 3, skip if H1_MISSING)
+    if (h1Title.length === 0) {
+      errors.push({
+        code: 'H1_MALFORMED',
+        detail: `Chapter at index ${i}: The level-1 heading does not match the required format.`,
+      });
+    }
+
+    // H1_NUMBER_MISMATCH: chapter number in heading doesn't match path (rule 4, skip if H1_MISSING)
+    if (h1Number !== expectedChapterNumber) {
+      errors.push({
+        code: 'H1_NUMBER_MISMATCH',
+        detail: `Chapter at index ${i}: The heading chapter number (${h1Number}) does not match the expected number from path (${expectedChapterNumber}).`,
+      });
+    }
+
+    // Track chapter number for duplicate/gap check
+    if (!chapterNumbers.has(expectedChapterNumber)) {
+      chapterNumbers.set(expectedChapterNumber, []);
+    }
+    chapterNumbers.get(expectedChapterNumber)!.push(chapter.path);
+  }
+
+  // Set-level validation: CHAPTER_DUPLICATE
+  for (const [chapterNum, paths] of chapterNumbers.entries()) {
+    if (paths.length > 1) {
+      errors.push({
+        code: 'CHAPTER_DUPLICATE',
+        detail: `Chapter ${chapterNum}: Duplicate chapter number found in ${paths.length} files.`,
+      });
+    }
+  }
+
+  // Set-level validation: CHAPTER_GAP
+  if (chapterNumbers.size > 0) {
+    const sortedNumbers = Array.from(chapterNumbers.keys()).sort((a, b) => a - b);
+    const expectedSequence = Array.from({ length: sortedNumbers.length }, (_, i) => i + 1);
+    if (JSON.stringify(sortedNumbers) !== JSON.stringify(expectedSequence)) {
+      errors.push({
+        code: 'CHAPTER_GAP',
+        detail: `Manuscript chapters are not a contiguous sequence from 1 to ${sortedNumbers.length}.`,
+      });
+    }
+  }
+
+  // Sort errors by code ascending
+  errors.sort((a, b) => a.code.localeCompare(b.code));
+
+  return {
+    valid: errors.length === 0,
+    errors,
+  };
+}
