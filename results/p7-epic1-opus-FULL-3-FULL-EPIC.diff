+    });
+
+    it('does not flag h1-h3, which are outside the allowlist', () => {
+      expect(codesOf(makeListing({ blurb: '<h1>Hook</h1>' }))).toEqual(['DISALLOWED_HTML']);
+    });
+  });
+
+  describe('multiple violations', () => {
+    it('returns errors sorted by code ascending', () => {
+      const result = validateListing({
+        title: 'TODO: title',
+        subtitle: undefined,
+        blurb: '   ',
+        keywords: [],
+        categories: [],
+        author: 'A. Writer',
+      });
+      expect(result.valid).toBe(false);
+      expect(result.errors.map((e) => e.code)).toEqual([
+        'BLURB_EMPTY',
+        'CATEGORY_COUNT',
+        'KEYWORD_COUNT',
+        'UNRESOLVED_PLACEHOLDER',
+      ]);
+    });
+
+    it('reports every rule at once', () => {
+      const result = validateListing({
+        title: 'TODO: title',
+        subtitle: undefined,
+        blurb: `<div>${'a'.repeat(MAX_BLURB_LENGTH)}</div>`,
+        keywords: [],
+        categories: [],
+        author: 'A. Writer',
+      });
+      expect(result.errors.map((e) => e.code)).toEqual([
+        'BLURB_TOO_LONG',
+        'CATEGORY_COUNT',
