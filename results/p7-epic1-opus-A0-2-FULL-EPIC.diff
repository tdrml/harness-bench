+    expect(runItem.runId.length).toBeGreaterThan(0);
+  });
+
+  it('saves the system prompt to the task-outputs table', async () => {
+    const workItem = { type: 'GENERATE_LISTING' as const, projectId: 'proj-123' };
+    const event = makeEvent([makeRecord(workItem)]);
+
+    await handler(event, {} as never, () => {});
+
+    expect(mockTaskOutputServiceMethods.save).toHaveBeenCalledOnce();
+    const [outputItem] = mockTaskOutputServiceMethods.save.mock.calls[0]!;
+    expect(outputItem.projectId).toBe('proj-123');
+    expect(outputItem.outputType).toBe('system-prompt');
+    expect(outputItem.content).toBe('mock marketer system prompt');
+    expect(outputItem.contentLength).toBe('mock marketer system prompt'.length);
+  });
+
+  it('uses the same runId for agent run and task output records', async () => {
+    const workItem = { type: 'GENERATE_LISTING' as const, projectId: 'proj-123' };
+    const event = makeEvent([makeRecord(workItem)]);
+
+    await handler(event, {} as never, () => {});
+
+    const [runItem] = mockAgentRunServiceMethods.create.mock.calls[0]!;
+    const [outputItem] = mockTaskOutputServiceMethods.save.mock.calls[0]!;
+    expect(runItem.runId).toBe(outputItem.runId);
+  });
+
+  it('sets the project status to RELEASING', async () => {
+    const workItem = { type: 'GENERATE_LISTING' as const, projectId: 'proj-123' };
+    const event = makeEvent([makeRecord(workItem)]);
+
+    await handler(event, {} as never, () => {});
+
+    expect(mockProjectServiceMethods.updateStatus).toHaveBeenCalledOnce();
+    expect(mockProjectServiceMethods.updateStatus).toHaveBeenCalledWith('proj-123', 'RELEASING');
