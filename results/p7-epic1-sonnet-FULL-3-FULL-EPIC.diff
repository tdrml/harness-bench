@@ -0,0 +1,152 @@
+import { describe, it, expect } from 'vitest';
+import { validateManuscriptStructure } from '../index.js';
+import type { ChapterFile } from '../index.js';
+
+function chapter(chapterNumber: number, overrides: Partial<ChapterFile> = {}): ChapterFile {
+  const padded = String(chapterNumber).padStart(2, '0');
+  return {
+    path: `manuscript/chapter-${padded}.md`,
+    content: `# Chapter ${chapterNumber}: A Title\n\nSome body text.`,
+    ...overrides,
+  };
+}
+
+describe('validateManuscriptStructure', () => {
+  it('returns valid: true with no errors for a well-formed manuscript', () => {
+    const result = validateManuscriptStructure([chapter(1), chapter(2), chapter(3)]);
+    expect(result.valid).toBe(true);
+    expect(result.errors).toHaveLength(0);
+  });
+
+  it('returns valid: true for an empty manuscript', () => {
+    const result = validateManuscriptStructure([]);
+    expect(result.valid).toBe(true);
+    expect(result.errors).toHaveLength(0);
+  });
+
+  describe('H1_MISSING', () => {
+    it('flags a chapter with no level-1 heading', () => {
+      const result = validateManuscriptStructure([chapter(1, { content: 'Just some prose.\n\n## Section' })]);
+      expect(result.errors.map((e) => e.code)).toContain('H1_MISSING');
+    });
+
+    it('flags an empty chapter', () => {
+      const result = validateManuscriptStructure([chapter(1, { content: '' })]);
+      expect(result.errors.map((e) => e.code)).toContain('H1_MISSING');
+    });
+
+    it('skips H1_MALFORMED and H1_NUMBER_MISMATCH when H1_MISSING fires', () => {
+      const result = validateManuscriptStructure([chapter(1, { content: 'No heading here at all.' })]);
+      expect(result.errors.map((e) => e.code)).toEqual(['H1_MISSING']);
+    });
+  });
+
+  describe('H1_NOT_FIRST', () => {
+    it('flags a heading that is not the first non-empty line', () => {
+      const result = validateManuscriptStructure([
+        chapter(1, { content: 'An epigraph.\n\n# Chapter 1: A Title\n\nBody.' }),
+      ]);
+      expect(result.errors.map((e) => e.code)).toContain('H1_NOT_FIRST');
+    });
+
+    it('does not flag when leading blank lines precede the heading', () => {
+      const result = validateManuscriptStructure([chapter(1, { content: '\n\n# Chapter 1: A Title\n\nBody.' })]);
+      expect(result.errors.map((e) => e.code)).not.toContain('H1_NOT_FIRST');
+    });
+  });
+
+  describe('H1_MALFORMED', () => {
+    it('flags a heading missing the chapter number', () => {
+      const result = validateManuscriptStructure([chapter(1, { content: '# Chapter: A Title\n\nBody.' })]);
+      expect(result.errors.map((e) => e.code)).toContain('H1_MALFORMED');
+    });
+
+    it('flags a heading with an empty title', () => {
+      const result = validateManuscriptStructure([chapter(1, { content: '# Chapter 1:\n\nBody.' })]);
+      expect(result.errors.map((e) => e.code)).toContain('H1_MALFORMED');
+    });
+
+    it('flags a heading missing the colon separator', () => {
+      const result = validateManuscriptStructure([chapter(1, { content: '# Chapter 1 A Title\n\nBody.' })]);
+      expect(result.errors.map((e) => e.code)).toContain('H1_MALFORMED');
+    });
+
+    it('does not flag a well-formed heading', () => {
+      const result = validateManuscriptStructure([chapter(1)]);
+      expect(result.errors.map((e) => e.code)).not.toContain('H1_MALFORMED');
+    });
+  });
+
+  describe('H1_NUMBER_MISMATCH', () => {
+    it('flags a heading number that does not match the path', () => {
+      const result = validateManuscriptStructure([
+        chapter(1, { content: '# Chapter 2: A Title\n\nBody.' }),
+      ]);
+      expect(result.errors.map((e) => e.code)).toContain('H1_NUMBER_MISMATCH');
+    });
+
+    it('does not flag when the heading number matches the path', () => {
+      const result = validateManuscriptStructure([chapter(1)]);
+      expect(result.errors.map((e) => e.code)).not.toContain('H1_NUMBER_MISMATCH');
+    });
+  });
+
+  describe('CHAPTER_DUPLICATE', () => {
+    it('flags two chapters that resolve to the same chapter number', () => {
+      const result = validateManuscriptStructure([
+        chapter(1),
+        chapter(1, { path: 'manuscript/chapter-01-copy.md' }),
+      ]);
+      expect(result.errors.map((e) => e.code)).toContain('CHAPTER_DUPLICATE');
+    });
+
+    it('reports only one error even with multiple duplicates', () => {
+      const result = validateManuscriptStructure([
+        chapter(1),
+        chapter(1, { path: 'manuscript/chapter-01-copy.md' }),
+      ]);
+      expect(result.errors.filter((e) => e.code === 'CHAPTER_DUPLICATE')).toHaveLength(1);
+    });
+  });
+
+  describe('CHAPTER_GAP', () => {
+    it('flags a gap in the chapter number sequence', () => {
+      const result = validateManuscriptStructure([chapter(1), chapter(3)]);
+      expect(result.errors.map((e) => e.code)).toContain('CHAPTER_GAP');
+    });
+
+    it('flags a sequence that does not start at 1', () => {
+      const result = validateManuscriptStructure([chapter(2), chapter(3)]);
+      expect(result.errors.map((e) => e.code)).toContain('CHAPTER_GAP');
+    });
+
+    it('does not flag a contiguous sequence starting at 1', () => {
+      const result = validateManuscriptStructure([chapter(1), chapter(2), chapter(3)]);
+      expect(result.errors.map((e) => e.code)).not.toContain('CHAPTER_GAP');
+    });
+
+    it('does not require chapters to be passed in order', () => {
+      const result = validateManuscriptStructure([chapter(3), chapter(1), chapter(2)]);
+      expect(result.errors.map((e) => e.code)).not.toContain('CHAPTER_GAP');
+    });
+  });
+
+  describe('errors ordering', () => {
+    it('sorts errors by code ascending', () => {
+      const result = validateManuscriptStructure([
+        chapter(1, { content: '# Chapter 2: A Title\n\nBody.' }),
+        chapter(1, { path: 'manuscript/chapter-01-copy.md', content: '# Chapter 2: A Title\n\nBody.' }),
+        chapter(5),
+      ]);
+      const codes = result.errors.map((e) => e.code);
+      const sorted = [...codes].sort();
+      expect(codes).toEqual(sorted);
+      expect(codes).toEqual([
+        'CHAPTER_DUPLICATE',
+        'CHAPTER_GAP',
+        'H1_NUMBER_MISMATCH',
+        'H1_NUMBER_MISMATCH',
+      ]);
+    });
+  });
+});
