+
+  async getTaskByPrNumber(prNumber: number): Promise<{ projectId: string; task: Task } | undefined> {
+    const result = await this.client.send(
+      new ScanCommand({
+        TableName: this.tableName,
+        FilterExpression: 'prNumber = :prNumber',
+        ExpressionAttributeValues: { ':prNumber': prNumber },
+      }),
+    );
+    const item = result.Items?.[0];
+    if (!item) return undefined;
+    const task = item as Task;
+    return { projectId: task.projectId, task };
+  }
 }
