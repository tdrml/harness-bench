new file mode 100644
index 0000000..e1b17f6
--- /dev/null
+++ b/packages/core/src/release-policy/validate.ts
@@ -0,0 +1,259 @@
+import type {
+  KdpListing,
+  ListingValidation,
+  ListingError,
+  ChapterFile,
+  ManuscriptValidation,
+  ManuscriptError,
+} from './types.js';
+import { getChapterFilePath } from '../writing/paths.js';
+
+export const MAX_BLURB_LENGTH = 4000;
+export const REQUIRED_KEYWORD_COUNT = 7;
+export const REQUIRED_CATEGORY_COUNT = 3;
+export const ALLOWED_BLURB_TAGS = ['b', 'i', 'u', 'br', 'p', 'ul', 'li', 'ol', 'h4', 'h5', 'h6'];
+
+export function validateListing(listing: KdpListing): ListingValidation {
+  const errors: ListingError[] = [];
+
+  // 1. BLURB_TOO_LONG
+  if (listing.blurb.length > MAX_BLURB_LENGTH) {
+    errors.push({
+      code: 'BLURB_TOO_LONG',
+      detail: `Blurb exceeds maximum length of ${MAX_BLURB_LENGTH} characters (current: ${listing.blurb.length})`,
+    });
+  }
+
+  // 2. BLURB_EMPTY
+  if (listing.blurb.trim().length === 0) {
+    errors.push({
+      code: 'BLURB_EMPTY',
+      detail: 'Blurb is empty or contains only whitespace',
+    });
+  }
+
+  // 3. KEYWORD_COUNT
+  if (listing.keywords.length !== REQUIRED_KEYWORD_COUNT) {
+    errors.push({
+      code: 'KEYWORD_COUNT',
+      detail: `Keywords must contain exactly ${REQUIRED_KEYWORD_COUNT} entries (current: ${listing.keywords.length})`,
+    });
+  }
+
+  // 4. CATEGORY_COUNT
+  if (listing.categories.length !== REQUIRED_CATEGORY_COUNT) {
+    errors.push({
+      code: 'CATEGORY_COUNT',
+      detail: `Categories must contain exactly ${REQUIRED_CATEGORY_COUNT} entries (current: ${listing.categories.length})`,
+    });
+  }
+
+  // 5. UNRESOLVED_PLACEHOLDER - check all string fields
+  const hasUnresolvedPlaceholder = hasTodoPlaceholder(listing);
+  if (hasUnresolvedPlaceholder) {
+    errors.push({
+      code: 'UNRESOLVED_PLACEHOLDER',
+      detail: 'Listing contains unresolved TODO: placeholders',
+    });
+  }
+
+  // 6. DISALLOWED_HTML - check blurb only
+  const disallowedTags = findDisallowedTags(listing.blurb);
+  if (disallowedTags.length > 0) {
+    errors.push({
+      code: 'DISALLOWED_HTML',
+      detail: `Blurb contains disallowed HTML tags: ${disallowedTags.join(', ')}`,
+    });
+  }
+
+  // Sort errors by code (lexicographic ascending)
+  errors.sort((a, b) => a.code.localeCompare(b.code));
+
+  return {
+    valid: errors.length === 0,
+    errors,
+  };
+}
+
+function hasTodoPlaceholder(listing: KdpListing): boolean {
+  const fields = [
+    listing.title,
+    listing.subtitle,
+    listing.blurb,
+    listing.author,
+    ...listing.keywords,
+    ...listing.categories,
+  ];
+
+  for (const field of fields) {
+    if (field && typeof field === 'string' && field.includes('TODO:')) {
+      return true;
+    }
+  }
+
+  return false;
+}
+
+function findDisallowedTags(blurb: string): string[] {
+  const htmlTagRegex = /<\/?(\w+)[^>]*>/g;
+  const tags = new Set<string>();
+  let match: RegExpExecArray | null;
+
+  while ((match = htmlTagRegex.exec(blurb)) !== null) {
+    const tagName = match[1];
+    if (tagName !== undefined) {
+      const lowerTagName = tagName.toLowerCase();
+      if (!ALLOWED_BLURB_TAGS.includes(lowerTagName)) {
+        tags.add(lowerTagName);
+      }
+    }
+  }
+
+  return Array.from(tags).sort();
+}
+
+function extractChapterNumber(path: string): number | undefined {
+  const match = /manuscript\/chapter-(\d+)\.md$/.exec(path);
+  if (!match || match[1] === undefined) {
+    return undefined;
+  }
+
+  const chapterNumber = parseInt(match[1], 10);
+
+  if (isNaN(chapterNumber)) {
+    return undefined;
+  }
+
+  // Verify by regenerating the expected path using the canonical helper
+  const expectedPath = getChapterFilePath(chapterNumber);
+  if (expectedPath === path) {
+    return chapterNumber;
+  }
+
+  return undefined;
+}
+
+export function validateManuscriptStructure(chapters: ChapterFile[]): ManuscriptValidation {
+  const errors: ManuscriptError[] = [];
+
+  // Per-chapter rules
+  const chapterNumbers: number[] = [];
+
+  for (const chapter of chapters) {
+    const expectedChapterNumber = extractChapterNumber(chapter.path);
+    const lines = chapter.content.split('\n');
+
+    // Find any H1 heading
+    let h1LineIndex = -1;
+    let h1LineText = '';
+    for (let i = 0; i < lines.length; i++) {
+      const line = lines[i];
+      if (line !== undefined && line.trim().startsWith('#')) {
+        const hashMatch = line.match(/^#+/);
+        const hashCount = hashMatch ? hashMatch[0].length : 0;
+        if (hashCount === 1) {
+          h1LineIndex = i;
+          h1LineText = line.trim();
+          break;
+        }
+      }
+    }
+
+    // Check H1_MISSING
+    if (h1LineIndex === -1) {
+      errors.push({
+        code: 'H1_MISSING',
+        detail: `Chapter at ${chapter.path} is missing a level-1 heading`,
+      });
+      continue;
+    }
+
+    // Check H1_NOT_FIRST
+    let firstNonEmptyLineIsH1 = false;
+    for (let i = 0; i < lines.length; i++) {
+      const line = lines[i];
+      if (line !== undefined) {
+        const trimmed = line.trim();
+        if (trimmed.length > 0) {
+          firstNonEmptyLineIsH1 = i === h1LineIndex;
+          break;
+        }
+      }
+    }
+
+    if (!firstNonEmptyLineIsH1) {
+      errors.push({
+        code: 'H1_NOT_FIRST',
+        detail: `Chapter at ${chapter.path} has a non-empty line before the level-1 heading`,
+      });
+    }
+
+    // Check H1_MALFORMED and H1_NUMBER_MISMATCH
+    const h1Match = /^#\s+Chapter\s+(\d+):\s+(.+)$/.exec(h1LineText);
+
+    if (!h1Match) {
+      errors.push({
+        code: 'H1_MALFORMED',
+        detail: `Chapter at ${chapter.path} has a malformed level-1 heading`,
+      });
+      continue;
+    }
+
+    const h1Title = h1Match[2];
+    if (h1Title === undefined || h1Title.trim().length === 0) {
+      errors.push({
+        code: 'H1_MALFORMED',
+        detail: `Chapter at ${chapter.path} has a malformed level-1 heading (missing or empty title)`,
+      });
+      continue;
+    }
+
+    // Check H1_NUMBER_MISMATCH
+    const h1ChapterNumber = parseInt(h1Match[1]!, 10);
+    if (expectedChapterNumber !== undefined && h1ChapterNumber !== expectedChapterNumber) {
+      errors.push({
+        code: 'H1_NUMBER_MISMATCH',
+        detail: `Chapter at ${chapter.path} has heading chapter number ${h1ChapterNumber} but path indicates chapter ${expectedChapterNumber}`,
+      });
+    }
+
+    if (expectedChapterNumber !== undefined) {
+      chapterNumbers.push(expectedChapterNumber);
+    }
+  }
+
+  // Set-level rules
+  // Check for duplicates
+  const seenNumbers = new Set<number>();
+  for (const num of chapterNumbers) {
+    if (seenNumbers.has(num)) {
+      errors.push({
+        code: 'CHAPTER_DUPLICATE',
+        detail: `Chapter number ${num} appears multiple times`,
+      });
+    }
+    seenNumbers.add(num);
+  }
+
+  // Check for gaps
+  if (chapterNumbers.length > 0) {
+    const sorted = Array.from(new Set(chapterNumbers)).sort((a, b) => a - b);
+    for (let i = 0; i < sorted.length; i++) {
+      if (sorted[i] !== i + 1) {
+        errors.push({
+          code: 'CHAPTER_GAP',
+          detail: `Chapter numbers are not contiguous starting from 1. Found: ${sorted.join(', ')}`,
+        });
+        break;
+      }
+    }
+  }
+
+  // Sort errors by code
+  errors.sort((a, b) => a.code.localeCompare(b.code));
+
+  return {
+    valid: errors.length === 0,
+    errors,
+  };
+}
