--- /dev/null
+++ b/packages/lambdas/src/handlers/__tests__/generate-listing.test.ts
@@ -0,0 +1,307 @@
+import { describe, it, expect, vi, beforeEach } from 'vitest';
+import type { SQSEvent, SQSRecord } from 'aws-lambda';
+
+vi.mock('@auto-graph/core', async (importOriginal) => {
+  const actual = await importOriginal<typeof import('@auto-graph/core')>();
+  return {
+    ...actual,
+    createDynamoClient: vi.fn().mockReturnValue({}),
+    ProjectService: vi.fn(),
+    AgentRunService: vi.fn(),
+    TaskOutputService: vi.fn(),
+    buildMarketerPrompt: vi.fn().mockReturnValue('mock marketer system prompt'),
+    enqueue: vi.fn().mockResolvedValue(undefined),
+  };
+});
+
+vi.mock('../../shared/ecs-launcher.js', async (importOriginal) => {
+  const actual = await importOriginal<typeof import('../../shared/ecs-launcher.js')>();
+  return {
+    ...actual,
+    launchECSTask: vi.fn().mockResolvedValue('arn:aws:ecs:us-east-1:123:task/test/marketer-abc'),
+  };
+});
+
+import {
+  ProjectService,
+  AgentRunService,
+  TaskOutputService,
+  buildMarketerPrompt,
+  enqueue,
+  ProjectType,
+} from '@auto-graph/core';
+import { launchECSTask } from '../../shared/index.js';
+import { handler } from '../generate-listing.js';
+
+const baseEnv = {
+  AWS_REGION: 'us-east-1',
+  DYNAMODB_TABLE_PREFIX: 'test',
+  SQS_QUEUE_URL: 'https://sqs.us-east-1.amazonaws.com/123/test.fifo',
+  ECS_CLUSTER_ARN: 'arn:aws:ecs:us-east-1:123:cluster/test',
+  ECS_SUBNETS: 'subnet-abc',
+  ECS_SECURITY_GROUPS: 'sg-abc',
+  GITHUB_TOKEN: 'ghp_test',
+  GITHUB_ORG: 'test-org',
+  ORCHESTRATION_REPO: 'orchestration-repo',
+  MARKETER_TASK_DEF_ARN: 'arn:aws:ecs:us-east-1:123:task-definition/marketer:1',
+  LOG_LEVEL: 'info',
+};
+
+const validProject = {
+  projectId: 'proj-123',
+  status: 'PACKAGING' as const,
+  repoName: 'the-dark-tower',
+  repoUrl: 'https://github.com/test-org/the-dark-tower',
+  createdAt: '2024-01-01T00:00:00.000Z',
+  updatedAt: '2024-01-01T00:00:00.000Z',
+  config: {
+    projectId: 'proj-123',
+    projectType: ProjectType.NOVEL,
+    title: 'The Dark Tower',
+    premise: 'A gunslinger pursues the Man in Black across a desert.',
+    genre: 'Dark Fantasy',
+    targetWordCount: 90000,
+    chapterCount: 3,
+    style: { voice: 'sparse and mythic', tense: 'past' as const, pov: 'third-limited' as const },
+    maxRevisionRounds: 5,
+    concurrencyLimit: 3,
+  },
+};
+
+function makeRecord(body: unknown, messageId = 'msg-1'): SQSRecord {
+  return {
+    messageId,
+    receiptHandle: 'handle',
+    body: JSON.stringify(body),
+    attributes: {
+      ApproximateReceiveCount: '1',
+      SentTimestamp: '1000',
+      SenderId: 'sender',
+      ApproximateFirstReceiveTimestamp: '1000',
+    },
+    messageAttributes: {},
+    md5OfBody: 'abc',
+    eventSource: 'aws:sqs',
+    eventSourceARN: 'arn:aws:sqs:us-east-1:123:queue',
+    awsRegion: 'us-east-1',
+  };
+}
+
+function makeEvent(records: SQSRecord[]): SQSEvent {
+  return { Records: records };
+}
+
+let mockProjectServiceMethods: {
+  get: ReturnType<typeof vi.fn>;
+  updateStatus: ReturnType<typeof vi.fn>;
+};
+let mockAgentRunServiceMethods: {
+  create: ReturnType<typeof vi.fn>;
+};
+let mockTaskOutputServiceMethods: {
+  save: ReturnType<typeof vi.fn>;
+};
+
+beforeEach(() => {
+  vi.clearAllMocks();
+
+  for (const [key, value] of Object.entries(baseEnv)) {
+    process.env[key] = value;
+  }
+
+  mockProjectServiceMethods = {
+    get: vi.fn().mockResolvedValue(validProject),
+    updateStatus: vi.fn().mockResolvedValue(undefined),
+  };
+  vi.mocked(ProjectService).mockImplementation(() => mockProjectServiceMethods as never);
+
+  mockAgentRunServiceMethods = {
+    create: vi.fn().mockResolvedValue(undefined),
+  };
+  vi.mocked(AgentRunService).mockImplementation(() => mockAgentRunServiceMethods as never);
+
+  mockTaskOutputServiceMethods = {
+    save: vi.fn().mockResolvedValue(undefined),
+  };
+  vi.mocked(TaskOutputService).mockImplementation(() => mockTaskOutputServiceMethods as never);
+
+  vi.mocked(buildMarketerPrompt).mockReturnValue('mock marketer system prompt');
+  vi.mocked(launchECSTask).mockResolvedValue('arn:aws:ecs:us-east-1:123:task/test/marketer-abc');
+  vi.mocked(enqueue).mockResolvedValue(undefined);
+});
+
+// ---------------------------------------------------------------------------
+// Happy path
+// ---------------------------------------------------------------------------
+
+describe('GENERATE_LISTING — happy path', () => {
+  it('loads the project record from DynamoDB', async () => {
+    const workItem = { type: 'GENERATE_LISTING' as const, projectId: 'proj-123' };
+
+    await handler(makeEvent([makeRecord(workItem)]), {} as never, () => {});
+
+    expect(mockProjectServiceMethods.get).toHaveBeenCalledOnce();
+    expect(mockProjectServiceMethods.get).toHaveBeenCalledWith('proj-123');
+  });
+
+  it('builds the marketer prompt from the project config', async () => {
+    const workItem = { type: 'GENERATE_LISTING' as const, projectId: 'proj-123' };
+
+    await handler(makeEvent([makeRecord(workItem)]), {} as never, () => {});
+
+    expect(vi.mocked(buildMarketerPrompt)).toHaveBeenCalledOnce();
+    const [params] = vi.mocked(buildMarketerPrompt).mock.calls[0]!;
+    expect(params.title).toBe('The Dark Tower');
+    expect(params.repoName).toBe('the-dark-tower');
+    expect(params.genre).toBe('Dark Fantasy');
+    expect(params.projectType).toBe(ProjectType.NOVEL);
+  });
+
+  it('saves the system prompt to the task-outputs table', async () => {
+    const workItem = { type: 'GENERATE_LISTING' as const, projectId: 'proj-123' };
+
+    await handler(makeEvent([makeRecord(workItem)]), {} as never, () => {});
+
+    expect(mockTaskOutputServiceMethods.save).toHaveBeenCalledOnce();
+    const [outputItem] = mockTaskOutputServiceMethods.save.mock.calls[0]!;
+    expect(outputItem.projectId).toBe('proj-123');
+    expect(outputItem.outputType).toBe('system-prompt');
+    expect(outputItem.content).toBe('mock marketer system prompt');
+    expect(outputItem.contentLength).toBe('mock marketer system prompt'.length);
+  });
+
+  it('launches the marketer ECS task with correct task definition', async () => {
+    const workItem = { type: 'GENERATE_LISTING' as const, projectId: 'proj-123' };
+
+    await handler(makeEvent([makeRecord(workItem)]), {} as never, () => {});
+
+    expect(vi.mocked(launchECSTask)).toHaveBeenCalledOnce();
+    const [params] = vi.mocked(launchECSTask).mock.calls[0]!;
+    expect(params.taskDefinition).toBe(baseEnv.MARKETER_TASK_DEF_ARN);
+    expect(params.command).toEqual(['claude', '-p', '$SYSTEM_PROMPT']);
+  });
+
+  it('passes correct environment variables to the ECS task', async () => {
+    const workItem = { type: 'GENERATE_LISTING' as const, projectId: 'proj-123' };
+
+    await handler(makeEvent([makeRecord(workItem)]), {} as never, () => {});
+
+    const [params] = vi.mocked(launchECSTask).mock.calls[0]!;
+    expect(params.environment['PROJECT_ID']).toBe('proj-123');
+    expect(params.environment['REPO_NAME']).toBe('the-dark-tower');
+    expect(typeof params.environment['RUN_ID']).toBe('string');
+    expect(params.environment['AWS_REGION']).toBe('us-east-1');
+    expect(params.environment['DYNAMODB_TABLE_PREFIX']).toBe('test');
+  });
+
+  it('creates an agent run record with workerType marketer and no nodeId', async () => {
+    const workItem = { type: 'GENERATE_LISTING' as const, projectId: 'proj-123' };
+
+    await handler(makeEvent([makeRecord(workItem)]), {} as never, () => {});
+
+    expect(mockAgentRunServiceMethods.create).toHaveBeenCalledOnce();
+    const [runItem] = mockAgentRunServiceMethods.create.mock.calls[0]!;
+    expect(runItem.projectId).toBe('proj-123');
+    expect(runItem.taskArn).toBe('arn:aws:ecs:us-east-1:123:task/test/marketer-abc');
+    expect(runItem.workerType).toBe('marketer');
+    expect(runItem.nodeId).toBeUndefined();
+    expect(runItem.status).toBe('RUNNING');
+    const [outputItem] = mockTaskOutputServiceMethods.save.mock.calls[0]!;
+    expect(runItem.runId).toBe(outputItem.runId);
+  });
+
+  it('sets the project status to RELEASING', async () => {
+    const workItem = { type: 'GENERATE_LISTING' as const, projectId: 'proj-123' };
+
+    await handler(makeEvent([makeRecord(workItem)]), {} as never, () => {});
+
+    expect(mockProjectServiceMethods.updateStatus).toHaveBeenCalledOnce();
+    expect(mockProjectServiceMethods.updateStatus).toHaveBeenCalledWith('proj-123', 'RELEASING');
+  });
+
+  it('enqueues a RECONCILE work item with the runId', async () => {
+    const workItem = { type: 'GENERATE_LISTING' as const, projectId: 'proj-123' };
+
+    await handler(makeEvent([makeRecord(workItem)]), {} as never, () => {});
+
+    expect(vi.mocked(enqueue)).toHaveBeenCalledOnce();
+    const [queueUrl, enqueuedItem] = vi.mocked(enqueue).mock.calls[0]!;
+    expect(queueUrl).toBe(baseEnv.SQS_QUEUE_URL);
+    expect(enqueuedItem.type).toBe('RECONCILE');
+    if (enqueuedItem.type === 'RECONCILE') {
+      expect(enqueuedItem.projectId).toBe('proj-123');
+      const [runItem] = mockAgentRunServiceMethods.create.mock.calls[0]!;
+      expect(enqueuedItem.runId).toBe(runItem.runId);
+    }
+  });
+
+  it('does not return batch failures on success', async () => {
+    const workItem = { type: 'GENERATE_LISTING' as const, projectId: 'proj-123' };
+
+    const result = await handler(makeEvent([makeRecord(workItem)]), {} as never, () => {});
+
+    expect(result).toBeUndefined();
+  });
+});
+
+// ---------------------------------------------------------------------------
+// Error handling
+// ---------------------------------------------------------------------------
+
+describe('GENERATE_LISTING — error handling', () => {
+  it('throws when MARKETER_TASK_DEF_ARN is not set', async () => {
+    delete process.env['MARKETER_TASK_DEF_ARN'];
+
+    const workItem = { type: 'GENERATE_LISTING' as const, projectId: 'proj-123' };
+
+    const result = await handler(
+      makeEvent([makeRecord(workItem, 'msg-no-arn')]),
+      {} as never,
+      () => {},
+    );
+
+    expect(result).toEqual({ batchItemFailures: [{ itemIdentifier: 'msg-no-arn' }] });
+    expect(vi.mocked(launchECSTask)).not.toHaveBeenCalled();
+  });
+
+  it('returns batch failure when project is not found', async () => {
+    mockProjectServiceMethods.get.mockResolvedValueOnce(undefined);
+
+    const workItem = { type: 'GENERATE_LISTING' as const, projectId: 'proj-missing' };
+
+    const result = await handler(
+      makeEvent([makeRecord(workItem, 'msg-missing')]),
+      {} as never,
+      () => {},
+    );
+
+    expect(result).toEqual({ batchItemFailures: [{ itemIdentifier: 'msg-missing' }] });
+    expect(vi.mocked(launchECSTask)).not.toHaveBeenCalled();
+  });
+
+  it('returns batch failure when ECS task launch fails', async () => {
+    vi.mocked(launchECSTask).mockRejectedValueOnce(new Error('ECS error'));
+
+    const workItem = { type: 'GENERATE_LISTING' as const, projectId: 'proj-123' };
+
+    const result = await handler(
+      makeEvent([makeRecord(workItem, 'msg-ecs-fail')]),
+      {} as never,
+      () => {},
+    );
+
+    expect(result).toEqual({ batchItemFailures: [{ itemIdentifier: 'msg-ecs-fail' }] });
+    expect(mockAgentRunServiceMethods.create).not.toHaveBeenCalled();
+  });
+
+  it('reports non-GENERATE_LISTING work items as batch failures', async () => {
+    const workItem = { type: 'FINAL_REVIEW' as const, projectId: 'proj-123' };
+
+    const result = await handler(makeEvent([makeRecord(workItem)]), {} as never, () => {});
+
+    expect(result).toEqual({ batchItemFailures: [{ itemIdentifier: 'msg-1' }] });
+    expect(mockProjectServiceMethods.get).not.toHaveBeenCalled();
+    expect(vi.mocked(launchECSTask)).not.toHaveBeenCalled();
+    expect(vi.mocked(enqueue)).not.toHaveBeenCalled();
+  });
+});
