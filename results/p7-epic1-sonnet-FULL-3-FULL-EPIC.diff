+}
+
+function buildFictionPackagerBody(title: string, chapterCount: number): string {
+  return `## Your Task
+
+### Phase 1 — Assemble the manuscript
+
+Read \`manuscript/chapter-01.md\` through \`manuscript/chapter-${String(chapterCount).padStart(2, '0')}.md\` (zero-padded) in order. Concatenate them into a single \`manuscript/manuscript.md\`:
+
+1. Start with a title page:
+
+   \`\`\`markdown
+   # ${title}
+
+   ---
+   \`\`\`
+
+2. Append each chapter in order, separated by a page break marker (\`\\n\\n---\\n\\n\`) between chapters. Preserve each chapter's \`# Chapter N: Title\` heading exactly as written — do not renumber, retitle, or edit chapter prose.
+3. Do not summarize, trim, or otherwise alter chapter content. \`manuscript/manuscript.md\` is a byte-for-byte concatenation of the source chapters, not a rewrite.
+
+### Phase 2 — Write the release manifest
+
+Write \`release/manifest.json\` describing the packaged release:
+
+\`\`\`json
+{
+  "title": "${title}",
+  "chapterCount": ${chapterCount},
+  "wordCount": <total word count across all chapters>,
+  "generatedAt": "<ISO 8601 timestamp>",
+  "files": {
+    "manuscript": "manuscript/manuscript.md",
+    "chapters": ["manuscript/chapter-01.md", "..."]
+  }
+}
+\`\`\`
+
+Compute \`wordCount\` by summing the word counts of every chapter file. List every chapter file path in \`files.chapters\`, in chapter order.
+
+### Phase 3 — Commit and push
+
+\`\`\`
+git add manuscript/manuscript.md release/manifest.json
+git commit -m "package: assemble manuscript and release manifest"
+git push
+\`\`\``;
+}
+
+function buildNonFictionPackagerBody(title: string, chapterCount: number): string {
+  return `## Your Task
