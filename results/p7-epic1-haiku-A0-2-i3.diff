+function extractChapterNumber(path: string): number | null {
+  // Extract chapter number from path like "manuscript/chapter-01.md"
+  const match = path.match(/chapter-(\d+)\.md$/);
+  if (match !== null && match[1] !== undefined) {
+    return parseInt(match[1], 10);
+  }
+  return null;
+}
+
+export function validateManuscriptStructure(chapters: ChapterFile[]): ManuscriptValidation {
+  const errors: ManuscriptError[] = [];
+  const chapterNumbers = new Map<number, number>(); // chapter number -> count
+
+  // Per-chapter validation
+  for (const chapter of chapters) {
+    const chapterNum = extractChapterNumber(chapter.path);
+    if (chapterNum === null) {
+      continue;
+    }
+
+    // Count occurrences of each chapter number for duplicate detection
+    const count = (chapterNumbers.get(chapterNum) ?? 0) + 1;
+    chapterNumbers.set(chapterNum, count);
+
+    // Find the level-1 heading
+    const lines = chapter.content.split('\n');
+    const h1Match = lines.find((line) => /^# /.test(line));
+
+    // H1_MISSING: no level-1 heading
+    if (h1Match === undefined) {
+      errors.push({
+        code: 'H1_MISSING',
+        detail: `Chapter ${chapterNum}: No level-1 markdown heading found.`,
+      });
+      continue;
+    }
+
+    // H1_NOT_FIRST: first non-empty line is not the level-1 heading
+    const firstNonEmptyLine = lines.find((line) => line.trim() !== '');
+    if (firstNonEmptyLine !== h1Match) {
+      errors.push({
+        code: 'H1_NOT_FIRST',
+        detail: `Chapter ${chapterNum}: The first non-empty line is not the level-1 heading.`,
+      });
+    }
+
+    // H1_MALFORMED and H1_NUMBER_MISMATCH (skip if H1_MISSING)
+    const h1Pattern = /^# Chapter (\d+): (.+)$/;
+    const h1PatternMatch = h1Match.match(h1Pattern);
+
+    if (h1PatternMatch === null) {
+      // H1_MALFORMED
+      errors.push({
+        code: 'H1_MALFORMED',
+        detail: `Chapter ${chapterNum}: The level-1 heading does not match the pattern "# Chapter <N>: <Title>".`,
+      });
+    } else {
+      // H1_NUMBER_MISMATCH
+      const headingNumber = parseInt(h1PatternMatch[1]!, 10);
+      if (headingNumber !== chapterNum) {
+        errors.push({
+          code: 'H1_NUMBER_MISMATCH',
+          detail: `Chapter ${chapterNum}: The heading number (${headingNumber}) does not match the chapter number from the path.`,
+        });
+      }
+    }
+  }
+
+  // Set-level validation
+  if (chapterNumbers.size > 0) {
+    const sortedNumbers = Array.from(chapterNumbers.keys()).sort((a, b) => a - b);
+
+    // CHAPTER_DUPLICATE
+    for (const [num, count] of chapterNumbers.entries()) {
+      if (count > 1) {
+        errors.push({
+          code: 'CHAPTER_DUPLICATE',
+          detail: `Multiple chapters resolve to chapter number ${num}.`,
+        });
+      }
+    }
+
+    // CHAPTER_GAP: check for gaps (should be 1..n)
+    const expectedNumbers = Array.from({ length: sortedNumbers.length }, (_, i) => i + 1);
+    const hasGap = sortedNumbers.some((num, idx) => num !== expectedNumbers[idx]);
+    if (hasGap) {
+      errors.push({
+        code: 'CHAPTER_GAP',
+        detail: `Chapters do not form a contiguous sequence from 1 to ${sortedNumbers.length}. Found: ${sortedNumbers.join(', ')}.`,
+      });
+    }
+  }
+
+  // Sort errors by code (lexicographic order)
+  errors.sort((a, b) => a.code.localeCompare(b.code));
+
+  return {
+    valid: errors.length === 0,
+    errors,
+  };
+}
