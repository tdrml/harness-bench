+import { describe, it, expect } from 'vitest';
+import { validateManuscriptStructure } from '../index.js';
+import type { ChapterFile } from '../index.js';
+
+function chapter(number: number, title: string, overrides: Partial<ChapterFile> = {}): ChapterFile {
+  const padded = String(number).padStart(2, '0');
+  return {
+    path: `manuscript/chapter-${padded}.md`,
+    content: `# Chapter ${number}: ${title}\n\nSome body text for the chapter.`,
+    ...overrides,
+  };
+}
+
+describe('validateManuscriptStructure', () => {
+  it('returns valid: true with no errors for a well-formed manuscript', () => {
+    const result = validateManuscriptStructure([chapter(1, 'Beginning'), chapter(2, 'Middle')]);
+    expect(result.valid).toBe(true);
+    expect(result.errors).toHaveLength(0);
+  });
+
+  it('reports H1_MISSING when there is no level-1 heading', () => {
+    const result = validateManuscriptStructure([
+      chapter(1, 'Beginning', { content: 'Just some prose.\n\nNo heading here.' }),
+    ]);
+    expect(result.valid).toBe(false);
+    expect(result.errors).toContainEqual(expect.objectContaining({ code: 'H1_MISSING' }));
+  });
+
+  it('does not also report H1_MALFORMED or H1_NUMBER_MISMATCH when H1_MISSING fires', () => {
+    const result = validateManuscriptStructure([
+      chapter(1, 'Beginning', { content: 'Just some prose.\n\nNo heading here.' }),
+    ]);
+    const codes = result.errors.map((e) => e.code);
+    expect(codes).toEqual(['H1_MISSING']);
+  });
+
+  it('reports H1_NOT_FIRST when content precedes the heading', () => {
+    const result = validateManuscriptStructure([
+      chapter(1, 'Beginning', {
+        content: 'An intro paragraph.\n\n# Chapter 1: Beginning\n\nBody text.',
+      }),
+    ]);
+    expect(result.valid).toBe(false);
+    expect(result.errors).toContainEqual(expect.objectContaining({ code: 'H1_NOT_FIRST' }));
+  });
+
+  it('reports H1_MALFORMED when the heading does not match "# Chapter <N>: <Title>"', () => {
+    const result = validateManuscriptStructure([
+      chapter(1, 'Beginning', { content: '# Introduction\n\nBody text.' }),
+    ]);
+    expect(result.valid).toBe(false);
+    expect(result.errors).toContainEqual(expect.objectContaining({ code: 'H1_MALFORMED' }));
+  });
+
+  it('reports H1_MALFORMED when the title is empty', () => {
+    const result = validateManuscriptStructure([
+      chapter(1, 'Beginning', { content: '# Chapter 1: \n\nBody text.' }),
+    ]);
+    expect(result.valid).toBe(false);
+    expect(result.errors).toContainEqual(expect.objectContaining({ code: 'H1_MALFORMED' }));
+  });
+
+  it('reports H1_NUMBER_MISMATCH when the heading number does not match the path', () => {
+    const result = validateManuscriptStructure([
+      { path: 'manuscript/chapter-01.md', content: '# Chapter 2: Beginning\n\nBody text.' },
+    ]);
+    expect(result.valid).toBe(false);
+    expect(result.errors).toContainEqual(expect.objectContaining({ code: 'H1_NUMBER_MISMATCH' }));
+  });
+
+  it('reports CHAPTER_DUPLICATE when two chapters resolve to the same chapter number', () => {
+    const result = validateManuscriptStructure([
+      chapter(1, 'Beginning'),
+      { path: 'manuscript/chapter-01.md', content: '# Chapter 1: Repeat\n\nBody text.' },
+    ]);
+    expect(result.valid).toBe(false);
+    expect(result.errors).toContainEqual(expect.objectContaining({ code: 'CHAPTER_DUPLICATE' }));
+  });
+
+  it('reports CHAPTER_GAP when chapter numbers are not a contiguous 1..n run', () => {
+    const result = validateManuscriptStructure([chapter(1, 'Beginning'), chapter(3, 'End')]);
+    expect(result.valid).toBe(false);
+    expect(result.errors).toContainEqual(expect.objectContaining({ code: 'CHAPTER_GAP' }));
+  });
+
+  it('does not report CHAPTER_GAP for a valid contiguous sequence', () => {
+    const result = validateManuscriptStructure([
+      chapter(1, 'Beginning'),
+      chapter(2, 'Middle'),
+      chapter(3, 'End'),
+    ]);
+    expect(result.errors).not.toContainEqual(expect.objectContaining({ code: 'CHAPTER_GAP' }));
+  });
+
+  it('sorts errors by code ascending', () => {
+    const result = validateManuscriptStructure([
+      { path: 'manuscript/chapter-01.md', content: 'No heading at all.' },
+      { path: 'manuscript/chapter-01.md', content: '# Chapter 5: Odd\n\nBody text.' },
+    ]);
+    const codes = result.errors.map((e) => e.code);
+    const sorted = [...codes].sort();
+    expect(codes).toEqual(sorted);
+    expect(result.valid).toBe(false);
+  });
+});
