diff --git a/packages/core/__tests__/dynamodb.test.ts b/packages/core/__tests__/dynamodb.test.ts
index 3699ca6..c62a871 100644
--- a/packages/core/__tests__/dynamodb.test.ts
+++ b/packages/core/__tests__/dynamodb.test.ts
@@ -560,4 +560,52 @@ describe('RepoLocksService', () => {
     const result = await svc.isLocked('acme/app');
     expect(result).toBe(false);
   });
+
+  it('acquireLock uses default grace period of 30 seconds', async () => {
+    const before = Math.floor(Date.now() / 1000);
+    const client = makeClient(() => ({}));
+    const svc = new RepoLocksService(client);
+    await svc.acquireLock('acme/app', 'owner-1');
+    const after = Math.floor(Date.now() / 1000);
+    const cmd = (client.send as ReturnType<typeof vi.fn>).mock.calls[0][0];
+    const nowValue = cmd.input.ExpressionAttributeValues[':now'] as number;
+    expect(nowValue).toBeGreaterThanOrEqual(before - 30);
+    expect(nowValue).toBeLessThanOrEqual(after - 30);
+  });
+
+  it('acquireLock uses custom grace period when provided', async () => {
+    const before = Math.floor(Date.now() / 1000);
+    const client = makeClient(() => ({}));
+    const svc = new RepoLocksService(client);
+    await svc.acquireLock('acme/app', 'owner-1', { takeoverGraceSeconds: 60 });
+    const after = Math.floor(Date.now() / 1000);
+    const cmd = (client.send as ReturnType<typeof vi.fn>).mock.calls[0][0];
+    const nowValue = cmd.input.ExpressionAttributeValues[':now'] as number;
+    expect(nowValue).toBeGreaterThanOrEqual(before - 60);
+    expect(nowValue).toBeLessThanOrEqual(after - 60);
+  });
+
+  it('acquireLock with grace period 0 reproduces original behavior', async () => {
+    const before = Math.floor(Date.now() / 1000);
+    const client = makeClient(() => ({}));
+    const svc = new RepoLocksService(client);
+    await svc.acquireLock('acme/app', 'owner-1', { takeoverGraceSeconds: 0 });
+    const after = Math.floor(Date.now() / 1000);
+    const cmd = (client.send as ReturnType<typeof vi.fn>).mock.calls[0][0];
+    const nowValue = cmd.input.ExpressionAttributeValues[':now'] as number;
+    expect(nowValue).toBeGreaterThanOrEqual(before);
+    expect(nowValue).toBeLessThanOrEqual(after);
+  });
+
+  it('acquireLock new lock TTL is unchanged by grace period', async () => {
+    const before = Math.floor(Date.now() / 1000);
+    const client = makeClient(() => ({}));
+    const svc = new RepoLocksService(client);
+    await svc.acquireLock('acme/app', 'owner-1', { takeoverGraceSeconds: 60 });
+    const after = Math.floor(Date.now() / 1000);
+    const cmd = (client.send as ReturnType<typeof vi.fn>).mock.calls[0][0];
+    const ttl = cmd.input.Item.ttl as number;
+    expect(ttl).toBeGreaterThanOrEqual(before + 1800);
+    expect(ttl).toBeLessThanOrEqual(after + 1800);
+  });
 });
