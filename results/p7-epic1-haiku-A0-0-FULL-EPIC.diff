+import { ProjectType } from '../config/schemas.js';
+import { buildSharedPreamble } from './shared.js';
+
+export interface PackagerPromptParams {
+  title: string;
+  repoName: string;
+  chapterCount: number;
+  projectType?: ProjectType | undefined;
+}
+
+function buildFictionPackageBody(chapterCount: number): string {
+  return `## Your Task
+
+Assemble the final manuscript and release manifest for publication.
+
+### Phase 1 — Assemble Manuscript
+
+Read all chapter files from \`manuscript/chapter-NN.md\` (zero-padded — \`chapter-01.md\`, \`chapter-12.md\`, etc.) from chapter 1 through chapter ${chapterCount}, in order.
+
+Create \`manuscript/manuscript.md\` that concatenates:
+- A front matter section with the book title, author, and basic metadata
+- All ${chapterCount} chapters in reading order, each preceded by a chapter heading
+
+Format each chapter heading as:
+
+\`\`\`markdown
+## Chapter N: {Chapter Title}
+\`\`\`
+
+Then include the chapter content verbatim. Do NOT modify chapter text — this assembly is read-only except for adding the front matter and chapter headings.
+
+### Phase 2 — Create Release Manifest
+
+Write \`release/manifest.json\` with this schema:
+
+\`\`\`json
+{
+  "title": "{book title}",
+  "chapterCount": ${chapterCount},
+  "estimatedWordCount": {total word count},
+  "status": "ready-for-release",
+  "assembledAt": "{ISO-8601 timestamp}",
+  "chapters": [
+    {
+      "number": 1,
+      "title": "{chapter title from outline}",
+      "wordCount": {chapter word count}
+    }
+  ]
+}
+\`\`\`
+
+Count words in each chapter by splitting on whitespace and counting non-empty tokens. Sum the counts to get \`estimatedWordCount\`.
+
+### Phase 3 — Commit and Push
+
+\`\`\`
+git add manuscript/manuscript.md release/manifest.json
+git commit -m "release: assemble final manuscript and manifest"
+git push
+\`\`\`
+
+## Self-check before completing
+
+Before you push the commit, confirm:
+
+- \`manuscript/manuscript.md\` exists and contains all ${chapterCount} chapters in order.
+- \`release/manifest.json\` is valid JSON with all required fields.
+- The manifest lists exactly ${chapterCount} chapters.
+- Word counts in the manifest match the actual chapter content.
+- All chapter content is verbatim (no modifications except for added headings).`;
+}
+
+function buildNonFictionPackageBody(chapterCount: number): string {
+  return `## Your Task
+
+Assemble the final manuscript and release manifest for publication.
+
+### Phase 1 — Assemble Manuscript
+
+Read all chapter files from \`manuscript/chapter-NN.md\` (zero-padded — \`chapter-01.md\`, \`chapter-12.md\`, etc.) from chapter 1 through chapter ${chapterCount}, in order.
+
+Create \`manuscript/manuscript.md\` that concatenates:
+- A front matter section with the book title, author, publication date, and basic metadata
+- All ${chapterCount} chapters in reading order, each preceded by a chapter heading
+- Any appendices or reference materials needed for publication
+
+Format each chapter heading as:
+
+\`\`\`markdown
+## Chapter N: {Chapter Title}
+\`\`\`
+
+Then include the chapter content verbatim. Do NOT modify chapter text — this assembly is read-only except for adding the front matter and chapter headings.
+
+### Phase 2 — Create Release Manifest
+
+Write \`release/manifest.json\` with this schema:
+
+\`\`\`json
+{
+  "title": "{book title}",
+  "chapterCount": ${chapterCount},
+  "estimatedWordCount": {total word count},
+  "status": "ready-for-release",
+  "assembledAt": "{ISO-8601 timestamp}",
+  "chapters": [
+    {
+      "number": 1,
+      "title": "{chapter title from outline}",
+      "wordCount": {chapter word count}
+    }
+  ]
+}
+\`\`\`
+
+Count words in each chapter by splitting on whitespace and counting non-empty tokens. Sum the counts to get \`estimatedWordCount\`.
+
+### Phase 3 — Commit and Push
+
+\`\`\`
+git add manuscript/manuscript.md release/manifest.json
+git commit -m "release: assemble final manuscript and manifest"
+git push
+\`\`\`
+
+## Self-check before completing
+
+Before you push the commit, confirm:
+
+- \`manuscript/manuscript.md\` exists and contains all ${chapterCount} chapters in order.
+- \`release/manifest.json\` is valid JSON with all required fields.
+- The manifest lists exactly ${chapterCount} chapters.
+- Word counts in the manifest match the actual chapter content.
+- All chapter content is verbatim (no modifications except for added headings).`;
+}
+
+export function buildPackagerPrompt(params: PackagerPromptParams): string {
+  const { title, repoName, chapterCount, projectType } = params;
+  const isNonFiction = projectType === ProjectType.NON_FICTION;
+
+  const packageBody = isNonFiction
+    ? buildNonFictionPackageBody(chapterCount)
