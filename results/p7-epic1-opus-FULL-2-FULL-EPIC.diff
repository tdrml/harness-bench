diff --git a/packages/lambdas/src/__tests__/integration/listing.test.ts b/packages/lambdas/src/__tests__/integration/listing.test.ts
new file mode 100644
index 0000000..d8c50ad
--- /dev/null
+++ b/packages/lambdas/src/__tests__/integration/listing.test.ts
@@ -0,0 +1,212 @@
+/**
+ * Integration test: store listing generation.
+ *
+ * Verifies that:
+ * 1. A GENERATE_LISTING work item reaches the marketer handler through the
+ *    harness, launches the marketer ECS task and moves the project to RELEASING.
+ * 2. Reconcile validates release/listing.json on a finished marketer run and
+ *    marks the project RELEASED when it passes, FAILED when it does not.
+ * 3. Reconcile re-enqueues GENERATE_LISTING when the marketer run failed.
+ */
+import { describe, it, expect, beforeEach, beforeAll, vi } from 'vitest';
+
+vi.mock('@auto-graph/core', async (importOriginal) => {
+  const actual = await importOriginal<typeof import('@auto-graph/core')>();
+  const mockAws = await import('./helpers/mock-aws.js');
+  const { mockGitHub } = await import('./helpers/mock-github.js');
+  const { addToQueue } = await import('./helpers/queue.js');
+
+  return {
+    ...actual,
+    createDynamoClient: vi.fn().mockReturnValue({}),
+    ProjectService: mockAws.MockProjectService,
+    TaskGraphService: mockAws.MockTaskGraphService,
+    AgentRunService: mockAws.MockAgentRunService,
+    RepoLockService: mockAws.MockRepoLockService,
+    TaskOutputService: mockAws.MockTaskOutputService,
+    RateLimitService: mockAws.MockRateLimitService,
+    createGitHubClient: vi.fn().mockReturnValue(mockGitHub),
+    enqueue: vi.fn().mockImplementation(async (_url: string, item: unknown) => {
+      addToQueue(item);
+    }),
+  };
+});
+
+vi.mock('../../shared/ecs-launcher.js', async (importOriginal) => {
+  const actual = await importOriginal<typeof import('../../shared/ecs-launcher.js')>();
+  return {
+    ...actual,
+    launchECSTask: vi.fn().mockResolvedValue(
+      'arn:aws:ecs:us-east-1:123456789:task/inttest/mock-task-id',
+    ),
+    getECSTaskStatus: vi.fn().mockResolvedValue({ status: 'STOPPED', exitCode: 0 }),
+  };
+});
+
+import { store, resetStore } from './helpers/store.js';
+import { resetQueue, pendingQueue } from './helpers/queue.js';
+import { resetMockGitHub, fileContents, mockGitHub } from './helpers/mock-github.js';
+import {
+  PROJECT_ID,
+  REPO_NAME,
+  BASE_ENV,
+  makeProjectItem,
+  makeTaskGraphItem,
+  makeChapterNode,
+  MOCK_TASK_ARN,
+} from './helpers/test-data.js';
+import { dispatch } from './helpers/pipeline-runner.js';
+import { launchECSTask, getECSTaskStatus } from '../../shared/index.js';
+
+const LISTING_PATH = 'release/listing.json';
+
+const VALID_LISTING = {
+  title: 'The Test Novel',
+  blurb: 'A gunslinger follows the Man in Black across the desert, and the desert follows back.',
+  keywords: ['dark fantasy', 'western fantasy', 'quest novel', 'gunslinger', 'epic fantasy', 'weird west', 'series starter'],
+  categories: ['Fiction > Fantasy > Epic', 'Fiction > Fantasy > Dark', 'Fiction > Westerns'],
+  author: 'Jordan Vale',
+};
+
+/** Seed a marketer run that reconcile will pick up. */
+function seedMarketerRun(runId: string): void {
+  store.agentRuns.set(runId, {
+    runId,
+    projectId: PROJECT_ID,
+    taskArn: MOCK_TASK_ARN,
+    workerType: 'marketer',
+    status: 'RUNNING',
+    startedAt: new Date().toISOString(),
+  });
+}
+
+beforeAll(() => {
+  for (const [key, value] of Object.entries(BASE_ENV)) {
+    process.env[key] = value;
+  }
+});
+
+beforeEach(() => {
+  resetStore();
+  resetQueue();
+  resetMockGitHub();
+  vi.clearAllMocks();
+  vi.mocked(launchECSTask).mockResolvedValue(MOCK_TASK_ARN);
+  vi.mocked(getECSTaskStatus).mockResolvedValue({ status: 'STOPPED', exitCode: 0 });
+
+  fileContents.set(LISTING_PATH, JSON.stringify(VALID_LISTING));
+
+  store.projects.set(PROJECT_ID, makeProjectItem({ status: 'PACKAGING' }));
+  const node1 = makeChapterNode('node-1', 1, { status: 'MERGED' });
+  store.taskGraphsByProjectVersion.set(PROJECT_ID, new Map([[2, makeTaskGraphItem([node1])]]));
+  store.taskGraphLatestVersion.set(PROJECT_ID, 2);
+});
+
+describe('GENERATE_LISTING dispatch', () => {
+  it('launches the marketer ECS task and enqueues RECONCILE', async () => {
+    await dispatch({ type: 'GENERATE_LISTING', projectId: PROJECT_ID });
+
+    expect(vi.mocked(launchECSTask)).toHaveBeenCalledOnce();
+    const [params] = vi.mocked(launchECSTask).mock.calls[0]!;
+    expect(params.taskDefinition).toBe(BASE_ENV['MARKETER_TASK_DEF_ARN']);
+    expect(params.environment['REPO_NAME']).toBe(REPO_NAME);
+
+    expect(pendingQueue).toHaveLength(1);
+    expect((pendingQueue[0] as { type: string }).type).toBe('RECONCILE');
+
+    const runId = (pendingQueue[0] as { runId: string }).runId;
+    const agentRun = store.agentRuns.get(runId)!;
+    expect(agentRun.workerType).toBe('marketer');
+    expect(agentRun.status).toBe('RUNNING');
+
+    expect(store.projects.get(PROJECT_ID)!.status).toBe('RELEASING');
+  });
+
+  it('stores the marketer system prompt as a task output', async () => {
+    await dispatch({ type: 'GENERATE_LISTING', projectId: PROJECT_ID });
+
+    const output = store.taskOutputs.find((o) => o.outputType === 'system-prompt');
+    expect(output).toBeDefined();
+    expect(output!.content).toContain('release/listing.json');
+    expect(output!.content).toContain('exactly 7');
+  });
+});
+
+describe('Reconcile — marketer run', () => {
+  it('marks the project RELEASED when the listing is valid', async () => {
+    const runId = 'run-marketer-ok';
+    seedMarketerRun(runId);
+
+    await dispatch({ type: 'RECONCILE', projectId: PROJECT_ID, runId });
+
+    expect(store.agentRuns.get(runId)!.status).toBe('SUCCEEDED');
+    expect(store.projects.get(PROJECT_ID)!.status).toBe('RELEASED');
+    expect(pendingQueue).toHaveLength(0);
+  });
+
+  it('reads release/listing.json from the main branch', async () => {
+    const runId = 'run-marketer-read';
+    seedMarketerRun(runId);
+
+    await dispatch({ type: 'RECONCILE', projectId: PROJECT_ID, runId });
+
+    expect(mockGitHub.getFileContent).toHaveBeenCalledWith(
+      expect.objectContaining({ repo: REPO_NAME }),
+      LISTING_PATH,
+      'main',
+    );
+  });
+
+  it('marks the project FAILED when the listing fails validation', async () => {
+    fileContents.set(
+      LISTING_PATH,
+      JSON.stringify({ ...VALID_LISTING, keywords: ['too', 'few'], categories: ['only one'] }),
+    );
+
+    const runId = 'run-marketer-invalid';
+    seedMarketerRun(runId);
+
+    await dispatch({ type: 'RECONCILE', projectId: PROJECT_ID, runId });
+
+    expect(store.agentRuns.get(runId)!.status).toBe('SUCCEEDED');
+    expect(store.projects.get(PROJECT_ID)!.status).toBe('FAILED');
+    expect(pendingQueue).toHaveLength(0);
+  });
+
+  it('marks the project FAILED when the listing is not valid JSON', async () => {
+    fileContents.set(LISTING_PATH, 'not json at all');
+
+    const runId = 'run-marketer-unparseable';
+    seedMarketerRun(runId);
+
+    await dispatch({ type: 'RECONCILE', projectId: PROJECT_ID, runId });
+
+    expect(store.projects.get(PROJECT_ID)!.status).toBe('FAILED');
+  });
+
+  it('marks the project FAILED when release/listing.json is missing', async () => {
+    mockGitHub.getFileContent.mockRejectedValueOnce(new Error('Not Found'));
+
+    const runId = 'run-marketer-missing';
+    seedMarketerRun(runId);
+
+    await dispatch({ type: 'RECONCILE', projectId: PROJECT_ID, runId });
+
+    expect(store.projects.get(PROJECT_ID)!.status).toBe('FAILED');
+  });
+
+  it('re-enqueues GENERATE_LISTING when the marketer run failed', async () => {
+    vi.mocked(getECSTaskStatus).mockResolvedValueOnce({ status: 'STOPPED', exitCode: 1 });
+
+    const runId = 'run-marketer-fail';
+    seedMarketerRun(runId);
+
+    await dispatch({ type: 'RECONCILE', projectId: PROJECT_ID, runId });
+
+    expect(store.agentRuns.get(runId)!.status).toBe('FAILED');
+    expect(pendingQueue).toHaveLength(1);
+    const retried = pendingQueue[0] as { type: string; projectId: string };
+    expect(retried.type).toBe('GENERATE_LISTING');
+    expect(retried.projectId).toBe(PROJECT_ID);
+  });
+});
