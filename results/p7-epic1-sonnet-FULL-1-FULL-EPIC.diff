+let mockAgentRunService: { create: ReturnType<typeof vi.fn> };
+let mockTaskOutputService: { save: ReturnType<typeof vi.fn> };
+
+beforeEach(() => {
+  vi.clearAllMocks();
+  vi.mocked(launchECSTask).mockResolvedValue('arn:aws:ecs:us-east-1:123:task/test/abc123');
+
+  mockAgentRunService = { create: vi.fn().mockResolvedValue(undefined) };
+  mockTaskOutputService = { save: vi.fn().mockResolvedValue(undefined) };
+});
+
+describe('launchAgentRun', () => {
+  it('saves the system prompt as a task output before launching', async () => {
+    await launchAgentRun({
+      taskDefArn: 'arn:aws:ecs:us-east-1:123:task-definition/writer:1',
