+/**
+ * Parses release/listing.json into a KdpListing. Throws when the file is not
+ * JSON, or is JSON without the fields the listing validator reads — the
+ * validator reports *which rules* a listing breaks, not whether it is a
+ * listing at all, so the shape check has to happen before it runs.
+ */
+function parseListingJson(content: string): KdpListing {
+  const raw: unknown = JSON.parse(content);
+
+  if (raw === null || typeof raw !== 'object') {
+    throw new Error('listing.json must contain a JSON object');
+  }
+
+  const candidate = raw as Partial<KdpListing>;
+  if (
+    typeof candidate.title !== 'string' ||
+    typeof candidate.blurb !== 'string' ||
+    typeof candidate.author !== 'string' ||
+    !Array.isArray(candidate.keywords) ||
+    !Array.isArray(candidate.categories)
+  ) {
+    throw new Error(
+      'listing.json must have string title, blurb and author plus keywords and categories arrays',
+    );
+  }
+
+  return candidate as KdpListing;
+}
