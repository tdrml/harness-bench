+import type { WordCountStage } from './types.js';
+
+const TOLERANCE: Record<WordCountStage, number> = {
+  writer: 0.05,
+  review: 0.10,
+  merge: 0.20,
+};
+
+const TOLERANCE_LABEL: Record<WordCountStage, string> = {
+  writer: '±5%',
+  review: '±10%',
+  merge: '±20%',
+};
+
+export function resolveTolerance(stage: WordCountStage): number {
+  return TOLERANCE[stage];
+}
+
+export function formatToleranceForPrompt(stage: WordCountStage): string {
+  return TOLERANCE_LABEL[stage];
+}
+
+export function resolveChapterTarget(params: {
+  targetWordCount: number;
+  chapterCount: number;
+}): number {
+  const { targetWordCount, chapterCount } = params;
+  if (chapterCount <= 0) {
+    throw new Error(`chapterCount must be positive, got ${chapterCount}`);
+  }
+  return Math.floor(targetWordCount / chapterCount);
+}
+
+export function resolveWordCountRange(params: {
+  targetWordCount: number;
+  chapterCount: number;
+  stage: WordCountStage;
+}): { min: number; max: number } {
+  const { targetWordCount, chapterCount, stage } = params;
+  const target = resolveChapterTarget({ targetWordCount, chapterCount });
+  const tolerance = resolveTolerance(stage);
+  return {
+    min: Math.floor(target * (1 - tolerance)),
+    max: Math.ceil(target * (1 + tolerance)),
+  };
+}
