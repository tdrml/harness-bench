index 0000000..2f0b5ef
--- /dev/null
+++ b/packages/core/src/release-policy/validate-manuscript.ts
@@ -0,0 +1,92 @@
+import { getChapterFilePath } from '../writing/index.js';
+import type { ChapterFile, ManuscriptError, ManuscriptValidation } from './types.js';
+
+const H1_LINE_PATTERN = /^#(?!#)\s+\S/;
+const H1_HEADING_PATTERN = /^#\s+Chapter\s+(\d+):\s*(.*)$/;
+
+function findChapterErrors(
+  chapter: ChapterFile,
+): { errors: ManuscriptError[]; resolvedNumber: number | undefined } {
+  const errors: ManuscriptError[] = [];
+  const lines = chapter.content.split('\n');
+
+  const firstNonEmptyIndex = lines.findIndex((line) => line.trim().length > 0);
+  const h1Index = lines.findIndex((line) => H1_LINE_PATTERN.test(line));
+
+  if (h1Index === -1) {
+    errors.push({
+      code: 'H1_MISSING',
+      detail: `${chapter.path} has no level-1 markdown heading.`,
+    });
+    return { errors, resolvedNumber: undefined };
+  }
+
+  if (h1Index !== firstNonEmptyIndex) {
+    errors.push({
+      code: 'H1_NOT_FIRST',
+      detail: `${chapter.path} has content before its level-1 heading.`,
+    });
+  }
+
+  const h1Line = lines[h1Index]!;
+  const match = H1_HEADING_PATTERN.exec(h1Line);
+  if (!match || match[2]!.trim().length === 0) {
+    errors.push({
+      code: 'H1_MALFORMED',
+      detail: `${chapter.path} heading "${h1Line}" does not match "# Chapter <N>: <Title>".`,
+    });
+    return { errors, resolvedNumber: undefined };
+  }
+
+  const headingNumber = parseInt(match[1]!, 10);
+  if (getChapterFilePath(headingNumber) !== chapter.path) {
+    errors.push({
+      code: 'H1_NUMBER_MISMATCH',
+      detail: `${chapter.path} heading declares chapter ${headingNumber}, which does not match its file path.`,
+    });
+  }
+
+  return { errors, resolvedNumber: headingNumber };
+}
+
+export function validateManuscriptStructure(chapters: ChapterFile[]): ManuscriptValidation {
+  const errors: ManuscriptError[] = [];
+  const resolvedNumbers: number[] = [];
+
+  for (const chapter of chapters) {
+    const { errors: chapterErrors, resolvedNumber } = findChapterErrors(chapter);
+    errors.push(...chapterErrors);
+    if (resolvedNumber !== undefined) {
+      resolvedNumbers.push(resolvedNumber);
+    }
+  }
+
+  const duplicates = new Set<number>();
+  const seen = new Set<number>();
+  for (const number of resolvedNumbers) {
+    if (seen.has(number)) {
+      duplicates.add(number);
+    }
+    seen.add(number);
+  }
+  if (duplicates.size > 0) {
+    const sortedDuplicates = [...duplicates].sort((a, b) => a - b);
+    errors.push({
+      code: 'CHAPTER_DUPLICATE',
+      detail: `Chapter number(s) ${sortedDuplicates.join(', ')} are used by more than one chapter.`,
+    });
+  }
+
+  const uniqueSorted = [...seen].sort((a, b) => a - b);
+  const hasGap = uniqueSorted.some((number, index) => number !== index + 1);
+  if (hasGap) {
+    errors.push({
+      code: 'CHAPTER_GAP',
+      detail: `Chapter numbers ${uniqueSorted.join(', ')} are not a contiguous sequence starting at 1.`,
+    });
+  }
+
+  errors.sort((a, b) => (a.code < b.code ? -1 : a.code > b.code ? 1 : 0));
+
+  return { valid: errors.length === 0, errors };
+}
