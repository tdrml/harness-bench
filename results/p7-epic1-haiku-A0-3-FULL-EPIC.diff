+          content: '# Chapter 1: First\n\nContent.',
+        },
+        {
+          path: 'other/chapter-01.md',
+          content: '# Chapter 1: Duplicate 1\n\nContent.',
+        },
+        {
+          path: 'another/chapter-01.md',
+          content: '# Chapter 1: Duplicate 2\n\nContent.',
+        },
+      ]);
+      const duplicateErrors = result.errors.filter((e) => e.code === 'CHAPTER_DUPLICATE');
+      expect(duplicateErrors).toHaveLength(1);
+    });
+  });
+
+  describe('CHAPTER_GAP', () => {
+    it('detects gap when chapters are not sequential from 1', () => {
+      const result = validateManuscriptStructure([
+        {
+          path: 'manuscript/chapter-01.md',
+          content: '# Chapter 1: Introduction\n\nContent.',
+        },
+        {
+          path: 'manuscript/chapter-03.md',
+          content: '# Chapter 3: Conclusion\n\nContent.',
+        },
+      ]);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(
+        expect.objectContaining({ code: 'CHAPTER_GAP' })
+      );
+    });
+
+    it('detects gap when starting from number other than 1', () => {
+      const result = validateManuscriptStructure([
+        {
+          path: 'manuscript/chapter-02.md',
+          content: '# Chapter 2: Intro\n\nContent.',
+        },
+        {
+          path: 'manuscript/chapter-03.md',
+          content: '# Chapter 3: Conclusion\n\nContent.',
+        },
+      ]);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(
+        expect.objectContaining({ code: 'CHAPTER_GAP' })
+      );
+    });
+
+    it('accepts sequential chapters from 1 to n', () => {
+      const result = validateManuscriptStructure([
+        {
+          path: 'manuscript/chapter-01.md',
+          content: '# Chapter 1: One\n\nContent.',
+        },
+        {
+          path: 'manuscript/chapter-02.md',
+          content: '# Chapter 2: Two\n\nContent.',
+        },
+        {
+          path: 'manuscript/chapter-03.md',
+          content: '# Chapter 3: Three\n\nContent.',
+        },
+      ]);
+      expect(result.errors.some((e) => e.code === 'CHAPTER_GAP')).toBe(false);
+    });
+
+    it('allows chapters in any order as long as they form 1..n', () => {
+      const result = validateManuscriptStructure([
+        {
+          path: 'manuscript/chapter-03.md',
+          content: '# Chapter 3: Three\n\nContent.',
+        },
+        {
+          path: 'manuscript/chapter-01.md',
+          content: '# Chapter 1: One\n\nContent.',
+        },
+        {
+          path: 'manuscript/chapter-02.md',
+          content: '# Chapter 2: Two\n\nContent.',
+        },
+      ]);
+      expect(result.errors.some((e) => e.code === 'CHAPTER_GAP')).toBe(false);
+    });
+
+    it('handles empty manuscript', () => {
+      const result = validateManuscriptStructure([]);
+      expect(result.valid).toBe(true);
+      expect(result.errors).toHaveLength(0);
+    });
+  });
+
+  describe('error sorting', () => {
+    it('sorts errors by code in lexicographic order', () => {
+      const result = validateManuscriptStructure([
+        {
+          path: 'manuscript/chapter-01.md',
+          content: 'No heading',
+        },
+        {
+          path: 'manuscript/chapter-01.md',
+          content: '# Chapter 1: First\n\nContent.',
+        },
+      ]);
+      const codes = result.errors.map((e) => e.code);
+      const sorted = [...codes].sort();
+      expect(codes).toEqual(sorted);
+    });
+
+    it('maintains stable ordering with multiple error types', () => {
+      const result = validateManuscriptStructure([
+        {
+          path: 'manuscript/chapter-02.md',
+          content: '# Chapter 1: Wrong number\n\nContent.',
+        },
+        {
+          path: 'manuscript/chapter-01.md',
+          content: '# Chapter 1: Duplicate\n\nContent.',
+        },
+      ]);
+      const codes = result.errors.map((e) => e.code);
+      const sorted = [...codes].sort();
+      expect(codes).toEqual(sorted);
+    });
+  });
+
+  describe('multiple errors', () => {
+    it('collects per-chapter and set-level errors', () => {
+      const result = validateManuscriptStructure([
+        {
+          path: 'manuscript/chapter-01.md',
+          content: 'No heading - missing',
+        },
+        {
+          path: 'manuscript/chapter-01.md',
+          content: '# Chapter 1: Duplicate\n\nContent.',
