+
+function makeRecord(body: unknown, messageId = 'msg-1'): SQSRecord {
+  return {
+    messageId,
+    receiptHandle: 'handle',
+    body: JSON.stringify(body),
+    attributes: {
+      ApproximateReceiveCount: '1',
