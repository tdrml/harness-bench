   UpdateCommand,
   type DynamoDBDocumentClient,
 } from '@aws-sdk/lib-dynamodb';
@@ -112,4 +113,58 @@ export class TaskGraphsService {
       (t) => t.status === 'PENDING' && t.dependsOn.every((dep) => completedIds.has(dep)),
     );
   }
+
+  async findTaskByRepoAndPrNumber(
+    repoFullName: string,
+    prNumber: number,
+  ): Promise<{ projectId: string; task: Task } | undefined> {
+    const parts = repoFullName.split('/');
+    if (parts.length !== 2 || !parts[0] || !parts[1]) {
+      return undefined;
+    }
+    const [repoOwner, repoName] = parts;
+
+    const projectsTableName = getConfig().DYNAMODB_TABLE_PROJECTS;
+    let lastEvaluatedKey: Record<string, unknown> | undefined;
+    const matchingProjects: string[] = [];
+
+    do {
+      const result = await this.client.send(
+        new ScanCommand({
+          TableName: projectsTableName,
+          FilterExpression: '#repoOwner = :repoOwner AND #repoName = :repoName',
+          ExpressionAttributeNames: {
+            '#repoOwner': 'repoOwner',
+            '#repoName': 'repoName',
+          },
+          ExpressionAttributeValues: {
+            ':repoOwner': repoOwner,
+            ':repoName': repoName,
+          },
+          ExclusiveStartKey: lastEvaluatedKey,
+        }),
+      );
+
+      if (result.Items) {
+        for (const item of result.Items) {
+          const projectId = (item as Record<string, unknown>)['projectId'];
+          if (typeof projectId === 'string') {
+            matchingProjects.push(projectId);
+          }
+        }
+      }
+
+      lastEvaluatedKey = result.LastEvaluatedKey as Record<string, unknown> | undefined;
+    } while (lastEvaluatedKey);
+
+    for (const projectId of matchingProjects) {
+      const tasks = await this.getGraph(projectId);
+      const matchingTask = tasks.find((t) => t.prNumber === prNumber);
+      if (matchingTask) {
+        return { projectId, task: matchingTask };
+      }
+    }
+
+    return undefined;
+  }
 }
