+
+  it('builds the packager prompt with title, repo name, chapter count and project type', async () => {
+    const workItem = { type: 'PACKAGE_MANUSCRIPT' as const, projectId: 'proj-123' };
+    const event = makeEvent([makeRecord(workItem)]);
+
+    await handler(event, {} as never, () => {});
+
+    expect(vi.mocked(buildPackagerPrompt)).toHaveBeenCalledOnce();
+    const [params] = vi.mocked(buildPackagerPrompt).mock.calls[0]!;
+    expect(params.title).toBe('The Dark Tower');
+    expect(params.repoName).toBe('the-dark-tower');
+    expect(params.chapterCount).toBe(3);
+    expect(params.projectType).toBe(ProjectType.NOVEL);
+  });
