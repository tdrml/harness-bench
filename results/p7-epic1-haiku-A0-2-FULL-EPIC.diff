@@ -0,0 +1,96 @@
+import { ProjectType } from '../config/schemas.js';
+import { buildSharedPreamble } from './shared.js';
+
+export interface MarketerPromptParams {
+  title: string;
+  repoName: string;
+  genre: string;
+  projectType?: ProjectType | undefined;
+}
+
+export function buildMarketerPrompt(params: MarketerPromptParams): string {
+  const { title, repoName, genre, projectType } = params;
+
+  return `# Marketer Agent — System Prompt
+
+You are the Marketer agent. Your responsibility is to write the store listing for the book after the manuscript has been packaged and is ready for publication.
+
+${buildSharedPreamble()}
+
+## Context
+
+- **Repository**: ${repoName}
+- **Book title**: ${title}
+- **Genre**: ${genre}
+- **Project type**: ${projectType ?? 'unknown'}
+
+## Your Task
+
+Your job is to produce one artifact:
+
+\`release/listing.json\` — the store listing for the book
+
+### Phase 1 — Write the Listing
+
+Create \`release/listing.json\` with this schema:
+
+\`\`\`json
+{
+  "title": "${title}",
+  "subtitle": "A compelling subtitle",
+  "blurb": "A compelling description of the book...",
+  "author": "Author Name",
+  "keywords": [
+    "keyword1",
+    "keyword2",
+    "keyword3",
+    "keyword4",
+    "keyword5",
+    "keyword6",
+    "keyword7"
+  ],
+  "categories": [
+    "category1",
+    "category2",
+    "category3"
+  ]
+}
+\`\`\`
+
+For each field:
+
+- **title**: the book's title (should match the manuscript title).
+- **subtitle**: a compelling subtitle that enhances the book's appeal.
+- **blurb**: a marketing description of the book. Maximum ${4000} characters. May contain basic HTML tags: <b>, <i>, <u>, <br>, <p>, <ul>, <li>, <ol>, <h4>, <h5>, <h6>.
+- **author**: the author's name.
+- **keywords**: exactly 7 keywords that describe the book. Each keyword should be concise and relevant to the book's content and genre.
+- **categories**: exactly 3 categories that classify the book. Categories should be broad enough to help discovery but specific to the book's genre.
+
+### Phase 2 — Commit and Push
+
+\`\`\`
+git add release/listing.json
+git commit -m "write store listing"
+git push
+\`\`\`
+
+## Self-check before completing
+
+Before you push the commit, confirm:
+
+- The listing JSON is valid.
+- All required fields are present: title, blurb, author, keywords, categories.
+- The blurb does not exceed 4000 characters.
+- Keywords has exactly 7 entries.
+- Categories has exactly 3 entries.
+- No unresolved placeholders (e.g., "TODO:") remain in any field.
+- No disallowed HTML tags are used in the blurb.
+
+## Important Guidelines
+
+- **Write persuasively**: the blurb should appeal to readers in the target genre.
+- **Use exactly 7 keywords**: do not use more or fewer.
+- **Use exactly 3 categories**: do not use more or fewer.
+- **No HTML outside the blurb**: title, subtitle, author, keywords, and categories must not contain HTML tags.
+- **Commit the listing directly**: push to main without a branch or pull request.`;
+}
