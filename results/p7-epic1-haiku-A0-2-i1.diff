+import { describe, it, expect } from 'vitest';
+import {
+  validateListing,
+  type KdpListing,
+  MAX_BLURB_LENGTH,
+  REQUIRED_KEYWORD_COUNT,
+  REQUIRED_CATEGORY_COUNT,
+} from '../index.js';
+
+const validListing: KdpListing = {
+  title: 'A Great Book',
+  subtitle: 'Subtitle',
+  blurb: 'This is a great book that tells an amazing story.',
+  keywords: ['keyword1', 'keyword2', 'keyword3', 'keyword4', 'keyword5', 'keyword6', 'keyword7'],
+  categories: ['Fiction', 'Adventure', 'Fantasy'],
+  author: 'John Doe',
+};
+
+describe('validateListing', () => {
+  describe('valid listing', () => {
+    it('returns valid: true with no errors for a complete valid listing', () => {
+      const result = validateListing(validListing);
+      expect(result.valid).toBe(true);
+      expect(result.errors).toHaveLength(0);
+    });
+
+    it('accepts optional subtitle', () => {
+      const listing = { ...validListing, subtitle: undefined };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(true);
+    });
+
+    it('accepts subtitle without value', () => {
+      const listing: KdpListing = {
+        title: 'A Great Book',
+        blurb: 'This is a great book that tells an amazing story.',
+        keywords: ['keyword1', 'keyword2', 'keyword3', 'keyword4', 'keyword5', 'keyword6', 'keyword7'],
+        categories: ['Fiction', 'Adventure', 'Fantasy'],
+        author: 'John Doe',
+      };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(true);
+    });
+  });
+
+  describe('BLURB_EMPTY', () => {
+    it('reports error when blurb is empty string', () => {
+      const listing = { ...validListing, blurb: '' };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'BLURB_EMPTY' }));
+    });
+
+    it('reports error when blurb is whitespace only', () => {
+      const listing = { ...validListing, blurb: '   \n\t  ' };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'BLURB_EMPTY' }));
+    });
+  });
+
+  describe('BLURB_TOO_LONG', () => {
+    it('reports error when blurb exceeds max length', () => {
+      const longBlurb = 'a'.repeat(MAX_BLURB_LENGTH + 1);
+      const listing = { ...validListing, blurb: longBlurb };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'BLURB_TOO_LONG' }));
+    });
+
+    it('accepts blurb at exactly max length', () => {
+      const blurbAtMax = 'a'.repeat(MAX_BLURB_LENGTH);
+      const listing = { ...validListing, blurb: blurbAtMax };
+      const result = validateListing(listing);
+      expect(result.errors.some((e) => e.code === 'BLURB_TOO_LONG')).toBe(false);
+    });
+  });
+
+  describe('KEYWORD_COUNT', () => {
+    it('reports error when keyword count is less than required', () => {
+      const listing = { ...validListing, keywords: ['kw1', 'kw2', 'kw3'] };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'KEYWORD_COUNT' }));
+    });
+
+    it('reports error when keyword count is more than required', () => {
+      const listing = {
+        ...validListing,
+        keywords: ['kw1', 'kw2', 'kw3', 'kw4', 'kw5', 'kw6', 'kw7', 'kw8'],
+      };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'KEYWORD_COUNT' }));
+    });
+
+    it('accepts exactly required keyword count', () => {
+      const listing = {
+        ...validListing,
+        keywords: Array.from({ length: REQUIRED_KEYWORD_COUNT }, (_, i) => `keyword${i + 1}`),
+      };
+      const result = validateListing(listing);
+      expect(result.errors.some((e) => e.code === 'KEYWORD_COUNT')).toBe(false);
+    });
+  });
+
+  describe('CATEGORY_COUNT', () => {
+    it('reports error when category count is less than required', () => {
+      const listing = { ...validListing, categories: ['Fiction', 'Adventure'] };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'CATEGORY_COUNT' }));
+    });
+
+    it('reports error when category count is more than required', () => {
+      const listing = {
+        ...validListing,
+        categories: ['Fiction', 'Adventure', 'Fantasy', 'Mystery'],
+      };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'CATEGORY_COUNT' }));
+    });
+
+    it('accepts exactly required category count', () => {
+      const listing = {
+        ...validListing,
+        categories: Array.from({ length: REQUIRED_CATEGORY_COUNT }, (_, i) => `category${i + 1}`),
+      };
+      const result = validateListing(listing);
+      expect(result.errors.some((e) => e.code === 'CATEGORY_COUNT')).toBe(false);
+    });
+  });
+
+  describe('UNRESOLVED_PLACEHOLDER', () => {
+    it('reports error when title contains TODO:', () => {
+      const listing = { ...validListing, title: 'TODO: Add title later' };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'UNRESOLVED_PLACEHOLDER' }));
+    });
+
+    it('reports error when subtitle contains TODO:', () => {
+      const listing = { ...validListing, subtitle: 'TODO: Add subtitle' };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'UNRESOLVED_PLACEHOLDER' }));
+    });
+
+    it('reports error when blurb contains TODO:', () => {
+      const listing = { ...validListing, blurb: 'This is TODO: incomplete' };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'UNRESOLVED_PLACEHOLDER' }));
+    });
+
+    it('reports error when author contains TODO:', () => {
+      const listing = { ...validListing, author: 'TODO: Author name' };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'UNRESOLVED_PLACEHOLDER' }));
+    });
+
+    it('reports error when keyword contains TODO:', () => {
+      const keywords = validListing.keywords.slice();
+      keywords[0] = 'TODO: keyword';
+      const listing = { ...validListing, keywords };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'UNRESOLVED_PLACEHOLDER' }));
+    });
+
+    it('reports error when category contains TODO:', () => {
+      const categories = validListing.categories.slice();
+      categories[0] = 'TODO: Category';
+      const listing = { ...validListing, categories };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'UNRESOLVED_PLACEHOLDER' }));
+    });
+
+    it('reports only one error when multiple fields contain TODO:', () => {
+      const listing = {
+        ...validListing,
+        title: 'TODO: Title',
+        blurb: 'TODO: Blurb',
+      };
+      const result = validateListing(listing);
+      const todoErrors = result.errors.filter((e) => e.code === 'UNRESOLVED_PLACEHOLDER');
+      expect(todoErrors).toHaveLength(1);
+    });
+  });
+
+  describe('DISALLOWED_HTML', () => {
+    it('reports error when blurb contains disallowed HTML tag', () => {
+      const listing = { ...validListing, blurb: 'This has <script>alert(1)</script> code.' };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'DISALLOWED_HTML' }));
+    });
+
+    it('accepts allowed tags in blurb', () => {
+      const listing = {
+        ...validListing,
+        blurb: 'This has <b>bold</b> and <i>italic</i> and <br/> line break.',
+      };
+      const result = validateListing(listing);
+      expect(result.errors.some((e) => e.code === 'DISALLOWED_HTML')).toBe(false);
+    });
+
+    it('accepts all allowed tags case-insensitively', () => {
+      const listing = {
+        ...validListing,
+        blurb:
+          'Text with <B>bold</B>, <I>italic</I>, <U>underline</U>, <BR/>, <P>paragraph</P>, <UL><LI>item</LI></UL>, <OL><LI>ordered</LI></OL>, <H4>heading4</H4>, <H5>heading5</H5>, <H6>heading6</H6>.',
+      };
+      const result = validateListing(listing);
+      expect(result.errors.some((e) => e.code === 'DISALLOWED_HTML')).toBe(false);
+    });
+
+    it('reports error for disallowed tags like span', () => {
+      const listing = { ...validListing, blurb: 'Text with <span>span</span> tag.' };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'DISALLOWED_HTML' }));
+    });
+
+    it('reports error for disallowed tags like div', () => {
+      const listing = { ...validListing, blurb: 'Text with <div>div</div> tag.' };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'DISALLOWED_HTML' }));
+    });
+
+    it('reports only one error when multiple disallowed tags present', () => {
+      const listing = {
+        ...validListing,
+        blurb: 'Text with <div>div</div> and <span>span</span> tags.',
+      };
+      const result = validateListing(listing);
+      const htmlErrors = result.errors.filter((e) => e.code === 'DISALLOWED_HTML');
+      expect(htmlErrors).toHaveLength(1);
+    });
+
+    it('accepts self-closing tags with attributes', () => {
+      const listing = { ...validListing, blurb: 'Text with <br class="test"/> tag.' };
+      const result = validateListing(listing);
+      expect(result.errors.some((e) => e.code === 'DISALLOWED_HTML')).toBe(false);
+    });
+
+    it('accepts tags with attributes', () => {
+      const listing = { ...validListing, blurb: 'Text with <p class="intro">paragraph</p> tag.' };
+      const result = validateListing(listing);
+      expect(result.errors.some((e) => e.code === 'DISALLOWED_HTML')).toBe(false);
+    });
+
+    it('rejects disallowed tags with attributes', () => {
+      const listing = { ...validListing, blurb: 'Text with <div class="container">content</div> tag.' };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'DISALLOWED_HTML' }));
+    });
+
+    it('detects closing tags of disallowed elements', () => {
+      const listing = { ...validListing, blurb: 'Text with closing </div> tag.' };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'DISALLOWED_HTML' }));
+    });
+  });
+
+  describe('error sorting', () => {
+    it('sorts errors lexicographically by code', () => {
+      const listing = {
+        title: 'TODO: Title',
+        subtitle: 'Subtitle',
+        blurb: '<div>short blurb</div>',
+        keywords: ['kw1', 'kw2'],
+        categories: ['cat1'],
+        author: 'Author',
+      };
+      const result = validateListing(listing);
+      const codes = result.errors.map((e) => e.code);
+      const sortedCodes = [...codes].sort();
+      expect(codes).toEqual(sortedCodes);
+    });
+
+    it('maintains sorted order with multiple errors', () => {
+      const listing = {
+        title: 'Valid',
+        subtitle: 'Valid',
+        blurb: '<script>alert(1)</script>',
+        keywords: ['only', 'two'],
+        categories: [],
+        author: 'Author',
+      };
+      const result = validateListing(listing);
+      const codes = result.errors.map((e) => e.code);
+      const sortedCodes = [...codes].sort();
+      expect(codes).toEqual(sortedCodes);
+    });
+  });
+
+  describe('multiple errors', () => {
+    it('reports all errors when multiple validations fail', () => {
+      const listing = {
+        title: 'Title',
+        subtitle: undefined,
+        blurb: '',
+        keywords: ['one', 'two'],
+        categories: ['cat1', 'cat2', 'cat3', 'cat4'],
+        author: 'Author',
+      };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors.length).toBeGreaterThan(1);
+      expect(result.errors.map((e) => e.code)).toContain('BLURB_EMPTY');
+      expect(result.errors.map((e) => e.code)).toContain('KEYWORD_COUNT');
+      expect(result.errors.map((e) => e.code)).toContain('CATEGORY_COUNT');
+    });
+
+    it('reports all errors independently', () => {
+      const listing = {
+        title: 'TODO: Title',
+        subtitle: 'TODO: Subtitle',
+        blurb: '<script>test</script>',
+        keywords: Array.from({ length: REQUIRED_KEYWORD_COUNT }, (_, i) => `kw${i}`),
+        categories: Array.from({ length: REQUIRED_CATEGORY_COUNT }, (_, i) => `cat${i}`),
+        author: 'Author',
+      };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      const codes = result.errors.map((e) => e.code);
+      expect(codes).toContain('UNRESOLVED_PLACEHOLDER');
+      expect(codes).toContain('DISALLOWED_HTML');
+    });
+  });
+
+  describe('edge cases', () => {
+    it('does not report BLURB_EMPTY and BLURB_TOO_LONG together if both apply', () => {
+      const listing = { ...validListing, blurb: '   ' };
+      const result = validateListing(listing);
+      expect(result.errors.filter((e) => e.code === 'BLURB_EMPTY')).toHaveLength(1);
+      expect(result.errors.filter((e) => e.code === 'BLURB_TOO_LONG')).toHaveLength(0);
+    });
+
+    it('accepts empty subtitle', () => {
+      const listing = { ...validListing, subtitle: undefined };
+      const result = validateListing(listing);
+      expect(result.errors.length === 0);
+    });
+
+    it('rejects TODO: in empty subtitle if it exists', () => {
+      const listing = { ...validListing, subtitle: 'TODO: subtitle' };
+      const result = validateListing(listing);
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'UNRESOLVED_PLACEHOLDER' }));
+    });
+  });
+});
