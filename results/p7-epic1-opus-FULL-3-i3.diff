+import { describe, it, expect } from 'vitest';
+import { validateManuscriptStructure } from '../index.js';
+import type { ChapterFile } from '../index.js';
+import { getChapterFilePath } from '../../writing/index.js';
+
+function chapter(chapterNumber: number, content: string): ChapterFile {
+  return { path: getChapterFilePath(chapterNumber), content };
+}
+
+function body(chapterNumber: number, title: string): string {
+  return `# Chapter ${chapterNumber}: ${title}\n\nThe harbor was quiet that morning.\n`;
+}
+
+function codesOf(chapters: ChapterFile[]): string[] {
+  return validateManuscriptStructure(chapters).errors.map((e) => e.code);
+}
+
+describe('validateManuscriptStructure', () => {
+  describe('valid manuscripts', () => {
+    it('accepts a gapless, well-formed manuscript', () => {
+      const result = validateManuscriptStructure([
+        chapter(1, body(1, 'Arrival')),
+        chapter(2, body(2, 'The Harbor')),
+        chapter(3, body(3, 'Departure')),
+      ]);
+      expect(result.valid).toBe(true);
+      expect(result.errors).toHaveLength(0);
+    });
+
+    it('accepts a heading preceded only by blank lines', () => {
+      expect(validateManuscriptStructure([chapter(1, `\n\n  \n${body(1, 'Arrival')}`)]).valid).toBe(
+        true,
+      );
+    });
+
+    it('accepts chapters past the zero-padding boundary', () => {
+      const chapters = Array.from({ length: 11 }, (_, i) => chapter(i + 1, body(i + 1, `T${i}`)));
+      expect(validateManuscriptStructure(chapters).valid).toBe(true);
+    });
+
+    it('accepts an empty manuscript', () => {
+      const result = validateManuscriptStructure([]);
+      expect(result.valid).toBe(true);
+      expect(result.errors).toHaveLength(0);
+    });
+  });
+
+  describe('H1_MISSING', () => {
+    it('flags content with no level-1 heading', () => {
+      const result = validateManuscriptStructure([chapter(1, 'Just prose, no heading.\n')]);
+      expect(result.valid).toBe(false);
+      expect(result.errors.map((e) => e.code)).toEqual(['H1_MISSING']);
+      expect(result.errors[0]?.detail).toContain('manuscript/chapter-01.md');
+    });
+
+    it('does not treat a level-2 heading as a level-1 heading', () => {
+      expect(codesOf([chapter(1, '## Chapter 1: Arrival\n\nProse.\n')])).toEqual(['H1_MISSING']);
+    });
+
+    it('skips H1_MALFORMED and H1_NUMBER_MISMATCH for a chapter with no heading', () => {
+      expect(codesOf([chapter(1, 'Prose only.\n')])).toEqual(['H1_MISSING']);
+    });
+  });
+
+  describe('H1_NOT_FIRST', () => {
+    it('flags a heading that does not come first', () => {
+      const content = `A stray epigraph.\n\n${body(1, 'Arrival')}`;
+      expect(codesOf([chapter(1, content)])).toEqual(['H1_NOT_FIRST']);
+    });
+
+    it('reports H1_NOT_FIRST alongside H1_MALFORMED', () => {
+      const content = 'A stray epigraph.\n\n# Arrival\n\nProse.\n';
+      expect(codesOf([chapter(1, content)])).toEqual(['H1_MALFORMED', 'H1_NOT_FIRST']);
+    });
+  });
+
+  describe('H1_MALFORMED', () => {
+    it.each([
+      ['no "Chapter" keyword', '# Arrival'],
+      ['no number', '# Chapter: Arrival'],
+      ['a non-numeric number', '# Chapter one: Arrival'],
+      ['no colon', '# Chapter 1 Arrival'],
+      ['an empty title', '# Chapter 1: '],
+      ['a whitespace-only title', '# Chapter 1: \t'],
+    ])('flags a heading with %s', (_case, heading) => {
+      const result = validateManuscriptStructure([chapter(1, `${heading}\n\nProse.\n`)]);
+      expect(result.errors.map((e) => e.code)).toEqual(['H1_MALFORMED']);
+      expect(result.errors[0]?.detail).toContain('# Chapter <N>: <Title>');
+    });
+
+    it('skips H1_NUMBER_MISMATCH for a malformed heading', () => {
+      expect(codesOf([chapter(1, '# Chapter: Arrival\n\nProse.\n')])).toEqual(['H1_MALFORMED']);
+    });
+  });
+
+  describe('H1_NUMBER_MISMATCH', () => {
+    it('flags a heading number that disagrees with the path', () => {
+      const result = validateManuscriptStructure([chapter(1, body(2, 'Arrival'))]);
+      expect(result.errors.map((e) => e.code)).toEqual(['H1_NUMBER_MISMATCH']);
+      expect(result.errors[0]?.detail).toContain('manuscript/chapter-02.md');
+    });
+
+    it('reads the chapter number through the path zero-padding', () => {
+      const chapters = Array.from({ length: 7 }, (_, i) => chapter(i + 1, body(i + 1, `T${i}`)));
+      expect(codesOf(chapters)).toEqual([]);
+    });
+
+    it('flags a path that carries no chapter number at all', () => {
+      const codes = codesOf([{ path: 'manuscript/prologue.md', content: body(1, 'Arrival') }]);
+      expect(codes).toContain('H1_NUMBER_MISMATCH');
+    });
+
+    it('reports one error per offending chapter', () => {
+      const codes = codesOf([chapter(1, body(2, 'A')), chapter(2, body(1, 'B'))]);
+      expect(codes).toEqual(['H1_NUMBER_MISMATCH', 'H1_NUMBER_MISMATCH']);
+    });
+  });
+
+  describe('CHAPTER_DUPLICATE', () => {
+    it('flags two files resolving to the same chapter number', () => {
+      const result = validateManuscriptStructure([
+        chapter(1, body(1, 'Arrival')),
+        { path: 'drafts/chapter-01.md', content: body(1, 'Arrival, again') },
+      ]);
+      expect(result.errors.map((e) => e.code)).toEqual(['CHAPTER_DUPLICATE']);
+      expect(result.errors[0]?.detail).toContain('1');
+    });
+
+    it('reports one error listing every duplicated number', () => {
+      const codes = codesOf([
+        chapter(1, body(1, 'A')),
+        { path: 'drafts/chapter-01.md', content: body(1, 'A2') },
+        chapter(2, body(2, 'B')),
+        { path: 'drafts/chapter-02.md', content: body(2, 'B2') },
+      ]);
+      expect(codes.filter((c) => c === 'CHAPTER_DUPLICATE')).toHaveLength(1);
+    });
+  });
+
+  describe('CHAPTER_GAP', () => {
+    it('flags a missing chapter in the middle', () => {
+      const result = validateManuscriptStructure([
+        chapter(1, body(1, 'A')),
+        chapter(3, body(3, 'C')),
+      ]);
+      expect(result.errors.map((e) => e.code)).toEqual(['CHAPTER_GAP']);
+      expect(result.errors[0]?.detail).toContain('1, 3');
+    });
+
+    it('flags a manuscript that does not start at chapter 1', () => {
+      expect(codesOf([chapter(2, body(2, 'B')), chapter(3, body(3, 'C'))])).toEqual([
+        'CHAPTER_GAP',
+      ]);
+    });
+
+    it('ignores the order chapters are supplied in', () => {
+      expect(
+        validateManuscriptStructure([chapter(2, body(2, 'B')), chapter(1, body(1, 'A'))]).valid,
+      ).toBe(true);
+    });
+
+    it('flags a file whose path carries no chapter number', () => {
+      const codes = codesOf([
+        chapter(1, body(1, 'A')),
+        { path: 'manuscript/prologue.md', content: body(1, 'P') },
+      ]);
+      expect(codes).toContain('CHAPTER_GAP');
+    });
+  });
+
+  describe('ordering and shape', () => {
+    it('returns errors sorted by code ascending', () => {
+      const result = validateManuscriptStructure([
+        chapter(1, 'Prose without a heading.\n'),
+        chapter(3, `Epigraph.\n\n${body(4, 'Wrong number')}`),
+      ]);
+      expect(result.valid).toBe(false);
+      expect(result.errors.map((e) => e.code)).toEqual([
+        'CHAPTER_GAP',
+        'H1_MISSING',
+        'H1_NOT_FIRST',
+        'H1_NUMBER_MISMATCH',
+      ]);
+    });
+
+    it('keeps chapters order within a single code', () => {
+      const result = validateManuscriptStructure([
+        chapter(1, 'No heading here.\n'),
+        chapter(2, 'None here either.\n'),
+      ]);
+      expect(result.errors.map((e) => e.detail)).toEqual([
+        'manuscript/chapter-01.md has no level-1 heading.',
+        'manuscript/chapter-02.md has no level-1 heading.',
+      ]);
+    });
+
+    it('every error carries a non-empty detail', () => {
+      const result = validateManuscriptStructure([chapter(2, '## Not a heading\n')]);
+      expect(result.errors.length).toBeGreaterThan(0);
+      for (const error of result.errors) {
+        expect(error.detail.length).toBeGreaterThan(0);
+      }
+    });
+  });
+});
