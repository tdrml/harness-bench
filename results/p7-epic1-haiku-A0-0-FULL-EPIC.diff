@@ -0,0 +1,87 @@
+import type { KdpListing, ListingError, ListingValidation } from './types.js';
+import {
+  MAX_BLURB_LENGTH,
+  REQUIRED_KEYWORD_COUNT,
+  REQUIRED_CATEGORY_COUNT,
+  ALLOWED_BLURB_TAGS,
+} from './types.js';
+
+export function validateListing(listing: KdpListing): ListingValidation {
+  const errors: ListingError[] = [];
+
+  // BLURB_EMPTY: blurb is empty or whitespace only
+  if (listing.blurb.trim() === '') {
+    errors.push({ code: 'BLURB_EMPTY', detail: 'Blurb cannot be empty or contain only whitespace.' });
+  }
+
+  // BLURB_TOO_LONG: blurb longer than 4000 characters
+  if (listing.blurb.length > MAX_BLURB_LENGTH) {
+    errors.push({
+      code: 'BLURB_TOO_LONG',
+      detail: `Blurb length ${listing.blurb.length} exceeds maximum of ${MAX_BLURB_LENGTH}.`,
+    });
+  }
+
+  // KEYWORD_COUNT: keywords.length is not exactly 7
+  if (listing.keywords.length !== REQUIRED_KEYWORD_COUNT) {
+    errors.push({
+      code: 'KEYWORD_COUNT',
+      detail: `Expected exactly ${REQUIRED_KEYWORD_COUNT} keywords, got ${listing.keywords.length}.`,
+    });
+  }
+
+  // CATEGORY_COUNT: categories.length is not exactly 3
+  if (listing.categories.length !== REQUIRED_CATEGORY_COUNT) {
+    errors.push({
+      code: 'CATEGORY_COUNT',
+      detail: `Expected exactly ${REQUIRED_CATEGORY_COUNT} categories, got ${listing.categories.length}.`,
+    });
+  }
+
+  // UNRESOLVED_PLACEHOLDER: any string field contains "TODO:"
+  const stringFields = [
+    listing.title,
+    listing.subtitle ?? '',
+    listing.blurb,
+    listing.author,
+    ...listing.keywords,
+    ...listing.categories,
+  ];
+  if (stringFields.some((field) => field.includes('TODO:'))) {
+    errors.push({
+      code: 'UNRESOLVED_PLACEHOLDER',
+      detail: 'One or more fields contain unresolved placeholder "TODO:".',
+    });
+  }
+
+  // DISALLOWED_HTML: blurb contains HTML tags outside allowlist
+  const disallowedHtmlError = checkDisallowedHtml(listing.blurb);
+  if (disallowedHtmlError) {
+    errors.push(disallowedHtmlError);
+  }
+
+  // Sort errors by code ascending
+  errors.sort((a, b) => a.code.localeCompare(b.code));
+
+  return {
+    valid: errors.length === 0,
+    errors,
+  };
+}
+
+function checkDisallowedHtml(blurb: string): ListingError | null {
+  const tagPattern = /<\/?(\w+)[^>]*>/g;
+  const matches = blurb.matchAll(tagPattern);
+
+  for (const match of matches) {
+    const tagName = match[1]?.toLowerCase();
+    if (tagName && !ALLOWED_BLURB_TAGS.includes(tagName)) {
+      return {
+        code: 'DISALLOWED_HTML',
+        detail: `Disallowed HTML tag found: ${tagName}. Allowed tags: ${ALLOWED_BLURB_TAGS.join(', ')}.`,
+      };
+    }
+  }
+
+  return null;
+}
