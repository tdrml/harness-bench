--- /dev/null
+++ b/packages/core/src/release-policy/sort-errors.ts
@@ -0,0 +1,5 @@
+// Every release-policy validation returns its errors sorted by code ascending,
+// so callers can compare results across validators uniformly.
+export function sortErrorsByCode<T extends { code: string }>(errors: T[]): T[] {
+  return errors.sort((a, b) => (a.code < b.code ? -1 : a.code > b.code ? 1 : 0));
+}
