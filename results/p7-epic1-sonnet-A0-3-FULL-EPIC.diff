+++ b/packages/core/src/release-policy/validate.ts
@@ -0,0 +1,176 @@
+import {
+  ALLOWED_BLURB_TAGS,
+  MAX_BLURB_LENGTH,
+  REQUIRED_CATEGORY_COUNT,
+  REQUIRED_KEYWORD_COUNT,
+} from './types.js';
+import type {
+  ChapterFile,
+  KdpListing,
+  ListingError,
+  ListingValidation,
+  ManuscriptError,
+  ManuscriptValidation,
+} from './types.js';
+import { getChapterFilePath } from '../writing/paths.js';
+
+const ALLOWED_BLURB_TAG_SET = new Set(ALLOWED_BLURB_TAGS);
+const HTML_TAG_PATTERN = /<\/?\s*([a-zA-Z][a-zA-Z0-9]*)[^>]*>/g;
+const PLACEHOLDER = 'TODO:';
+const H1_LINE_PATTERN = /^#\s+\S/;
+const CHAPTER_HEADING_PATTERN = /^#\s+Chapter\s+(\d+):\s+(.+)$/;
+const CHAPTER_NUMBER_IN_PATH_PATTERN = /chapter-(\d+)/;
+
+function sortByCode<T extends { code: string }>(errors: T[]): T[] {
+  return errors.sort((a, b) => (a.code < b.code ? -1 : a.code > b.code ? 1 : 0));
+}
+
+function chapterNumberFromPath(path: string): number | undefined {
+  const match = CHAPTER_NUMBER_IN_PATH_PATTERN.exec(path);
+  return match ? parseInt(match[1]!, 10) : undefined;
+}
+
+function containsDisallowedHtml(blurb: string): boolean {
+  for (const match of blurb.matchAll(HTML_TAG_PATTERN)) {
+    const tagName = match[1]?.toLowerCase();
+    if (tagName !== undefined && !ALLOWED_BLURB_TAG_SET.has(tagName)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+export function validateListing(listing: KdpListing): ListingValidation {
+  const errors: ListingError[] = [];
+
+  if (listing.blurb.trim().length === 0) {
+    errors.push({ code: 'BLURB_EMPTY', detail: 'Blurb is empty or contains only whitespace.' });
+  }
+
+  if (listing.blurb.length > MAX_BLURB_LENGTH) {
+    errors.push({
+      code: 'BLURB_TOO_LONG',
+      detail: `Blurb is ${listing.blurb.length} characters, exceeds the ${MAX_BLURB_LENGTH} character limit.`,
+    });
+  }
+
+  if (listing.keywords.length !== REQUIRED_KEYWORD_COUNT) {
+    errors.push({
+      code: 'KEYWORD_COUNT',
+      detail: `Expected exactly ${REQUIRED_KEYWORD_COUNT} keywords, got ${listing.keywords.length}.`,
+    });
+  }
+
+  if (listing.categories.length !== REQUIRED_CATEGORY_COUNT) {
+    errors.push({
+      code: 'CATEGORY_COUNT',
+      detail: `Expected exactly ${REQUIRED_CATEGORY_COUNT} categories, got ${listing.categories.length}.`,
+    });
+  }
+
+  const stringFields = [
+    listing.title,
+    listing.subtitle,
+    listing.blurb,
+    listing.author,
+    ...listing.keywords,
+    ...listing.categories,
+  ];
+  if (stringFields.some((field) => field !== undefined && field.includes(PLACEHOLDER))) {
+    errors.push({
+      code: 'UNRESOLVED_PLACEHOLDER',
+      detail: 'One or more fields contain an unresolved "TODO:" placeholder.',
+    });
+  }
+
+  if (containsDisallowedHtml(listing.blurb)) {
+    errors.push({
+      code: 'DISALLOWED_HTML',
+      detail: `Blurb contains HTML tags outside the allowed set: ${ALLOWED_BLURB_TAGS.join(', ')}.`,
+    });
+  }
+
+  sortByCode(errors);
+
+  return { valid: errors.length === 0, errors };
+}
+
+export function validateManuscriptStructure(chapters: ChapterFile[]): ManuscriptValidation {
+  const errors: ManuscriptError[] = [];
+  const pathNumbers: (number | undefined)[] = [];
+
+  for (const chapter of chapters) {
+    const lines = chapter.content.split('\n');
+    const h1Index = lines.findIndex((line) => H1_LINE_PATTERN.test(line));
+
+    pathNumbers.push(chapterNumberFromPath(chapter.path));
+
+    if (h1Index === -1) {
+      errors.push({
+        code: 'H1_MISSING',
+        detail: `Chapter file ${chapter.path} has no level-1 markdown heading.`,
+      });
+      continue;
+    }
+
+    const h1Line = lines[h1Index]!;
+    const firstNonEmptyIndex = lines.findIndex((line) => line.trim() !== '');
+    if (firstNonEmptyIndex !== h1Index) {
+      errors.push({
+        code: 'H1_NOT_FIRST',
+        detail: `Chapter file ${chapter.path} has content before its level-1 heading.`,
+      });
+    }
+
+    const headingMatch = CHAPTER_HEADING_PATTERN.exec(h1Line);
+    const title = headingMatch?.[2]?.trim();
+    if (!headingMatch || !title) {
+      errors.push({
+        code: 'H1_MALFORMED',
+        detail: `Chapter file ${chapter.path} has a level-1 heading that does not match "# Chapter <N>: <Title>".`,
+      });
+      continue;
+    }
+
+    const headingNumber = parseInt(headingMatch[1]!, 10);
+    if (getChapterFilePath(headingNumber) !== chapter.path) {
+      errors.push({
+        code: 'H1_NUMBER_MISMATCH',
+        detail: `Chapter file ${chapter.path} has heading number ${headingNumber}, which does not match its file path.`,
+      });
+    }
+  }
+
+  const resolvedNumbers = pathNumbers.filter((n): n is number => n !== undefined);
+
+  const seen = new Set<number>();
+  let hasDuplicate = false;
+  for (const n of resolvedNumbers) {
+    if (seen.has(n)) {
+      hasDuplicate = true;
+    }
+    seen.add(n);
+  }
+  if (hasDuplicate) {
+    errors.push({
+      code: 'CHAPTER_DUPLICATE',
+      detail: 'Two or more chapter files resolve to the same chapter number.',
+    });
+  }
+
+  const sortedNumbers = [...resolvedNumbers].sort((a, b) => a - b);
+  const expectedNumbers = Array.from({ length: chapters.length }, (_, i) => i + 1);
+  const isContiguous =
+    sortedNumbers.length === expectedNumbers.length &&
+    sortedNumbers.every((n, i) => n === expectedNumbers[i]);
+  if (!isContiguous) {
+    errors.push({
+      code: 'CHAPTER_GAP',
+      detail: `Chapter numbers are not a contiguous 1..${chapters.length} sequence.`,
+    });
+  }
+
+  sortByCode(errors);
+
+  return { valid: errors.length === 0, errors };
+}
