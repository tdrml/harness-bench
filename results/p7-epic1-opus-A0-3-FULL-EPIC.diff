+    });
+
+    it('does not treat a level-2 heading as a level-1 heading', () => {
+      const chapters = [makeChapter(1), makeChapter(2, '## Chapter 2: The Long Way Down\n')];
+      expect(structureCodes(chapters)).toEqual(['H1_MISSING', 'H1_NOT_FIRST']);
+    });
+
+    it('skips the malformed and mismatch checks when the heading is missing', () => {
+      const codes = structureCodes([makeChapter(1), makeChapter(2, 'No heading here.\n')]);
