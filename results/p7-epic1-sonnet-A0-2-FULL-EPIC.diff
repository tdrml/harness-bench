+    expect(result.valid).toBe(false);
+    expect(result.errors).toEqual([{ code: 'BLURB_TOO_LONG', detail: expect.any(String) }]);
+  });
+
+  it('flags an empty blurb', () => {
+    const result = validateListing(makeListing({ blurb: '   ' }));
+    expect(result.valid).toBe(false);
+    expect(result.errors).toEqual([{ code: 'BLURB_EMPTY', detail: expect.any(String) }]);
+  });
+
+  it('flags a keyword count that is not exactly 7', () => {
+    const result = validateListing(makeListing({ keywords: ['a', 'b'] }));
+    expect(result.valid).toBe(false);
+    expect(result.errors).toEqual([{ code: 'KEYWORD_COUNT', detail: expect.any(String) }]);
+  });
+
+  it('flags a category count that is not exactly 3', () => {
+    const result = validateListing(makeListing({ categories: ['Fiction > A > B'] }));
+    expect(result.valid).toBe(false);
+    expect(result.errors).toEqual([{ code: 'CATEGORY_COUNT', detail: expect.any(String) }]);
+  });
+
+  it('flags an unresolved placeholder in any string field, once', () => {
+    const result = validateListing(
+      makeListing({
+        title: 'TODO: pick a title',
+        keywords: ['TODO: fill in', 'b', 'c', 'd', 'e', 'f', 'g'],
+      }),
+    );
+    expect(result.valid).toBe(false);
+    expect(result.errors).toEqual([{ code: 'UNRESOLVED_PLACEHOLDER', detail: expect.any(String) }]);
+  });
+
+  it('flags disallowed HTML in the blurb, once regardless of how many disallowed tags appear', () => {
+    const result = validateListing(
+      makeListing({ blurb: '<div>Hook.</div><span>Setup.</span>' }),
+    );
+    expect(result.valid).toBe(false);
+    expect(result.errors).toEqual([{ code: 'DISALLOWED_HTML', detail: expect.any(String) }]);
+  });
+
+  it('allows the documented HTML allowlist in the blurb', () => {
+    const result = validateListing(
+      makeListing({
+        blurb: '<b>a</b><i>b</i><u>c</u><br><p>d</p><ul><li>e</li></ul><ol><li>f</li></ol><h4>g</h4><h5>h</h5><h6>i</h6>',
+      }),
+    );
+    expect(result.valid).toBe(true);
+  });
+
+  it('treats HTML tag matching case-insensitively', () => {
+    const result = validateListing(makeListing({ blurb: '<B>Hook.</B>' }));
+    expect(result.valid).toBe(true);
+
+    const disallowed = validateListing(makeListing({ blurb: '<DIV>Hook.</DIV>' }));
+    expect(disallowed.valid).toBe(false);
+    expect(disallowed.errors).toEqual([{ code: 'DISALLOWED_HTML', detail: expect.any(String) }]);
+  });
+
+  it('sorts multiple errors by code ascending', () => {
+    const result = validateListing(
+      makeListing({
+        blurb: '<div>TODO: write blurb</div>',
+        keywords: ['a'],
+        categories: [],
+      }),
+    );
+    expect(result.valid).toBe(false);
+    expect(result.errors.map((e) => e.code)).toEqual([
+      'CATEGORY_COUNT',
+      'DISALLOWED_HTML',
+      'KEYWORD_COUNT',
+      'UNRESOLVED_PLACEHOLDER',
+    ]);
+  });
+});
