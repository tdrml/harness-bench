+      expect(result.errors).toHaveLength(1);
+      expect(result.errors[0]?.detail).toContain('8');
+    });
+
+    it('flags no keywords at all', () => {
+      expect(codesOf(makeListing({ keywords: [] }))).toEqual(['KEYWORD_COUNT']);
+    });
+  });
+
+  describe('CATEGORY_COUNT', () => {
+    it('flags too few categories', () => {
+      expect(codesOf(makeListing({ categories: ['Fiction > Thriller'] }))).toEqual(['CATEGORY_COUNT']);
+    });
+
+    it('flags too many categories', () => {
