+++ b/packages/lambdas/src/shared/__tests__/launch-agent-run.test.ts
@@ -0,0 +1,156 @@
+import { describe, it, expect, vi, beforeEach } from 'vitest';
+import { mockClient } from 'aws-sdk-client-mock';
+import { ECSClient, RunTaskCommand } from '@aws-sdk/client-ecs';
+import type { EnvironmentConfig, AgentRunItem, TaskOutputItem } from '@auto-graph/core';
+import { launchAgentRun } from '../launch-agent-run.js';
+
+const ecsMock = mockClient(ECSClient);
+
+beforeEach(() => {
+  ecsMock.reset();
+});
+
+const config: EnvironmentConfig = {
+  AWS_REGION: 'us-east-1',
+  DYNAMODB_TABLE_PREFIX: 'test',
+  SQS_QUEUE_URL: 'https://sqs.us-east-1.amazonaws.com/123',
+  ECS_CLUSTER_ARN: 'arn:aws:ecs:us-east-1:123:cluster/main',
+  ECS_SUBNETS: 'subnet-aaa',
+  ECS_SECURITY_GROUPS: 'sg-aaa',
+  GITHUB_TOKEN: 'ghp_test',
+  GITHUB_ORG: 'test-org',
+  ORCHESTRATION_REPO: 'test-repo',
+  LOG_LEVEL: 'info',
+};
+
+const ecsClient = new ECSClient({ region: 'us-east-1' });
+
+function makeMockServices() {
+  const savedOutputs: TaskOutputItem[] = [];
+  const createdRuns: AgentRunItem[] = [];
+  const taskOutputService = { save: vi.fn(async (item: TaskOutputItem) => { savedOutputs.push(item); }) };
+  const agentRunService = { create: vi.fn(async (item: AgentRunItem) => { createdRuns.push(item); }) };
+  return { savedOutputs, createdRuns, taskOutputService, agentRunService };
+}
+
+describe('launchAgentRun', () => {
+  it('generates a ulid-format run id', async () => {
+    ecsMock.on(RunTaskCommand).resolves({ tasks: [{ taskArn: 'arn:aws:ecs:us-east-1:123:task/abc' }], failures: [] });
+    const { taskOutputService, agentRunService } = makeMockServices();
+
+    const result = await launchAgentRun({
+      taskDefArn: 'outliner:1',
+      workerType: 'outliner',
+      systemPrompt: 'do the thing',
+      projectId: 'proj-1',
+      repoName: 'the-repo',
+      config,
+      agentRunService: agentRunService as never,
+      taskOutputService: taskOutputService as never,
+    });
+
+    expect(result.runId).toMatch(/^[0-9A-HJKMNP-TV-Z]{26}$/);
+    expect(result.taskArn).toBe('arn:aws:ecs:us-east-1:123:task/abc');
+  });
+
+  it('saves the system prompt as a system-prompt task output before launching', async () => {
+    ecsMock.on(RunTaskCommand).resolves({ tasks: [{ taskArn: 'arn:aws:ecs:us-east-1:123:task/abc' }], failures: [] });
+    const { savedOutputs, taskOutputService, agentRunService } = makeMockServices();
+
+    const { runId } = await launchAgentRun({
+      taskDefArn: 'outliner:1',
+      workerType: 'outliner',
+      systemPrompt: 'do the thing',
+      projectId: 'proj-1',
+      repoName: 'the-repo',
+      config,
+      agentRunService: agentRunService as never,
+      taskOutputService: taskOutputService as never,
+    });
+
+    expect(savedOutputs).toHaveLength(1);
+    expect(savedOutputs[0]).toMatchObject({
+      runId,
+      outputType: 'system-prompt',
+      projectId: 'proj-1',
+      content: 'do the thing',
+      contentLength: 'do the thing'.length,
+    });
+  });
+
+  it('launches the ECS task with the standard environment keys merged with extraEnv', async () => {
+    ecsMock.on(RunTaskCommand).resolves({ tasks: [{ taskArn: 'arn:aws:ecs:us-east-1:123:task/abc' }], failures: [] });
+    const { taskOutputService, agentRunService } = makeMockServices();
+
+    const { runId } = await launchAgentRun({
+      taskDefArn: 'arn:aws:ecs:us-east-1:123:task-definition/auto-graph-editor:1',
+      workerType: 'editor',
+      systemPrompt: 'edit it',
+      projectId: 'proj-1',
+      repoName: 'the-repo',
+      extraEnv: { CHAPTER_NUMBER: '3', BRANCH_NAME: 'chapter-03' },
+      config,
+      agentRunService: agentRunService as never,
+      taskOutputService: taskOutputService as never,
+    });
+
+    const calls = ecsMock.commandCalls(RunTaskCommand);
+    expect(calls).toHaveLength(1);
+    expect(calls[0]!.args[0].input.taskDefinition).toBe(
+      'arn:aws:ecs:us-east-1:123:task-definition/auto-graph-editor:1',
+    );
+    const overrides = calls[0]!.args[0].input.overrides?.containerOverrides?.[0];
+    expect(overrides?.environment).toContainEqual({ name: 'PROJECT_ID', value: 'proj-1' });
+    expect(overrides?.environment).toContainEqual({ name: 'REPO_NAME', value: 'the-repo' });
+    expect(overrides?.environment).toContainEqual({ name: 'RUN_ID', value: runId });
+    expect(overrides?.environment).toContainEqual({ name: 'AWS_REGION', value: 'us-east-1' });
+    expect(overrides?.environment).toContainEqual({ name: 'DYNAMODB_TABLE_PREFIX', value: 'test' });
+    expect(overrides?.environment).toContainEqual({ name: 'CHAPTER_NUMBER', value: '3' });
+    expect(overrides?.environment).toContainEqual({ name: 'BRANCH_NAME', value: 'chapter-03' });
+  });
+
+  it('creates the agent run record with status RUNNING', async () => {
+    ecsMock.on(RunTaskCommand).resolves({ tasks: [{ taskArn: 'arn:aws:ecs:us-east-1:123:task/abc' }], failures: [] });
+    const { createdRuns, taskOutputService, agentRunService } = makeMockServices();
+
+    const { runId, taskArn } = await launchAgentRun({
+      taskDefArn: 'outliner:1',
+      workerType: 'outliner',
+      systemPrompt: 'do the thing',
+      projectId: 'proj-1',
+      repoName: 'the-repo',
+      config,
+      agentRunService: agentRunService as never,
+      taskOutputService: taskOutputService as never,
+    });
+
+    expect(createdRuns).toHaveLength(1);
+    expect(createdRuns[0]).toMatchObject({
+      runId,
+      projectId: 'proj-1',
+      taskArn,
+      workerType: 'outliner',
+      status: 'RUNNING',
+    });
+    expect(createdRuns[0]).not.toHaveProperty('nodeId');
+  });
+
+  it('includes nodeId on the agent run record when supplied', async () => {
+    ecsMock.on(RunTaskCommand).resolves({ tasks: [{ taskArn: 'arn:aws:ecs:us-east-1:123:task/abc' }], failures: [] });
+    const { createdRuns, taskOutputService, agentRunService } = makeMockServices();
+
+    await launchAgentRun({
+      taskDefArn: 'writer:1',
+      workerType: 'writer',
+      systemPrompt: 'write it',
+      projectId: 'proj-1',
+      repoName: 'the-repo',
+      config,
+      agentRunService: agentRunService as never,
+      taskOutputService: taskOutputService as never,
+      nodeId: 'node-5',
+    });
+
+    expect(createdRuns[0]?.nodeId).toBe('node-5');
+  });
+});
