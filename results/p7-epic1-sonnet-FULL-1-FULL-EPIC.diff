+import { describe, it, expect } from 'vitest';
+import { ProjectType } from '../../config/schemas.js';
+import {
+  resolveChapterTarget,
+  resolveWordCountRange,
+  resolveTolerance,
+  formatToleranceForPrompt,
+  clampToProjectType,
+} from '../index.js';
+
+describe('resolveChapterTarget', () => {
+  it('floors targetWordCount / chapterCount', () => {
+    expect(resolveChapterTarget({ targetWordCount: 90000, chapterCount: 3 })).toBe(30000);
+    expect(resolveChapterTarget({ targetWordCount: 100000, chapterCount: 3 })).toBe(33333);
+  });
+
+  it('throws when chapterCount is zero', () => {
+    expect(() => resolveChapterTarget({ targetWordCount: 90000, chapterCount: 0 })).toThrow();
+  });
+
+  it('throws when chapterCount is negative', () => {
+    expect(() => resolveChapterTarget({ targetWordCount: 90000, chapterCount: -1 })).toThrow();
+  });
+});
+
+describe('resolveTolerance', () => {
+  it('returns the pinned tolerance per stage', () => {
+    expect(resolveTolerance('writer')).toBe(0.05);
+    expect(resolveTolerance('review')).toBe(0.10);
+    expect(resolveTolerance('merge')).toBe(0.20);
+  });
+});
+
+describe('formatToleranceForPrompt', () => {
+  it('returns the pinned prose label per stage', () => {
+    expect(formatToleranceForPrompt('writer')).toBe('±5%');
+    expect(formatToleranceForPrompt('review')).toBe('±10%');
+    expect(formatToleranceForPrompt('merge')).toBe('±20%');
+  });
+});
+
+describe('resolveWordCountRange', () => {
+  it('floors the min and ceils the max for the writer stage', () => {
+    const range = resolveWordCountRange({ targetWordCount: 90000, chapterCount: 3, stage: 'writer' });
+    // target = 30000, tolerance = 0.05 -> [28500, 31500]
+    expect(range).toEqual({ min: 28500, max: 31500 });
+  });
+
+  it('floors the min and ceils the max for the review stage', () => {
+    const range = resolveWordCountRange({ targetWordCount: 90000, chapterCount: 3, stage: 'review' });
+    // target = 30000, tolerance = 0.10 -> [27000, 33000]
+    expect(range).toEqual({ min: 27000, max: 33000 });
+  });
+
+  it('floors the min and ceils the max for the merge stage', () => {
+    const range = resolveWordCountRange({ targetWordCount: 90000, chapterCount: 3, stage: 'merge' });
+    // target = 30000, tolerance = 0.20 -> [24000, 36000]
+    expect(range).toEqual({ min: 24000, max: 36000 });
+  });
+
+  it('rounds up the max rather than down when the tolerance produces a fraction', () => {
+    const range = resolveWordCountRange({ targetWordCount: 100000, chapterCount: 3, stage: 'merge' });
+    // target = floor(100000/3) = 33333, tolerance 0.20 -> max = ceil(33333 * 1.2) = ceil(39999.6) = 40000
+    expect(range.max).toBe(40000);
+  });
+});
+
+describe('clampToProjectType', () => {
+  it('leaves a range untouched when it already sits within the project type band', () => {
+    const clamped = clampToProjectType({
+      range: { min: 3200, max: 4800 },
+      projectType: ProjectType.NOVEL,
+    });
+    expect(clamped).toEqual({ min: 3200, max: 4800 });
+  });
+
+  it('raises a min that falls below the project type band', () => {
+    const clamped = clampToProjectType({
+      range: { min: 1000, max: 4000 },
+      projectType: ProjectType.NOVEL,
+    });
+    // NOVEL band is [3000, 5000]
+    expect(clamped).toEqual({ min: 3000, max: 4000 });
+  });
+
+  it('lowers a max that exceeds the project type band', () => {
+    const clamped = clampToProjectType({
+      range: { min: 4000, max: 8000 },
+      projectType: ProjectType.NOVEL,
+    });
+    expect(clamped).toEqual({ min: 4000, max: 5000 });
+  });
+
+  it('collapses a range lying entirely above the band onto the upper bound instead of inverting', () => {
+    const clamped = clampToProjectType({
+      range: { min: 24000, max: 36000 },
+      projectType: ProjectType.NOVEL,
+    });
+    expect(clamped).toEqual({ min: 5000, max: 5000 });
+    expect(clamped.min).toBeLessThanOrEqual(clamped.max);
+  });
+
+  it('collapses a range lying entirely below the band onto the lower bound instead of inverting', () => {
+    const clamped = clampToProjectType({
+      range: { min: 100, max: 500 },
+      projectType: ProjectType.NOVEL,
+    });
+    expect(clamped).toEqual({ min: 3000, max: 3000 });
+    expect(clamped.min).toBeLessThanOrEqual(clamped.max);
+  });
+});
