+function extractChapterNumberFromPath(path: string): number | null {
+  const match = path.match(/chapter-(\d+)\.md$/);
+  if (!match || match[1] === undefined) {
+    return null;
+  }
+  return parseInt(match[1], 10);
+}
+
+function getFirstNonEmptyLine(content: string): string | null {
+  const lines = content.split('\n');
+  for (const line of lines) {
+    if (line.trim() !== '') {
+      return line;
+    }
+  }
+  return null;
+}
+
+function getFirstHeading(content: string): string | null {
+  const lines = content.split('\n');
+  for (const line of lines) {
+    if (line.trim().startsWith('#')) {
+      return line;
+    }
+  }
+  return null;
+}
+
+export function validateManuscriptStructure(chapters: ChapterFile[]): ManuscriptValidation {
+  const errors: ManuscriptError[] = [];
+  const chapterNumbers: number[] = [];
+  const chapterNumberMap = new Map<number, string[]>();
+
+  for (let i = 0; i < chapters.length; i++) {
+    const chapter = chapters[i];
+    const chapterNumber = extractChapterNumberFromPath(chapter.path);
+
+    if (chapterNumber === null) {
+      continue;
+    }
+
+    chapterNumbers.push(chapterNumber);
+    if (!chapterNumberMap.has(chapterNumber)) {
+      chapterNumberMap.set(chapterNumber, []);
+    }
+    const paths = chapterNumberMap.get(chapterNumber);
+    if (paths) {
+      paths.push(chapter.path);
+    }
+
+    const firstNonEmptyLine = getFirstNonEmptyLine(chapter.content);
+    const firstHeading = getFirstHeading(chapter.content);
+
+    if (!firstHeading) {
+      errors.push({
+        code: 'H1_MISSING',
+        detail: `Chapter ${chapterNumber}: Missing level-1 heading`,
+      });
+      continue;
+    }
+
+    if (!firstNonEmptyLine || firstNonEmptyLine !== firstHeading) {
+      errors.push({
+        code: 'H1_NOT_FIRST',
+        detail: `Chapter ${chapterNumber}: First non-empty line is not a level-1 heading`,
+      });
+    }
+
+    const h1Match = firstHeading.match(/^#\s+Chapter\s+(\d+):\s+(.+)$/);
+    if (!h1Match) {
+      errors.push({
+        code: 'H1_MALFORMED',
+        detail: `Chapter ${chapterNumber}: Level-1 heading does not match "# Chapter <N>: <Title>" format`,
+      });
+      continue;
+    }
+
+    const headingNumber = h1Match[1];
+    const title = h1Match[2];
+
+    if (!headingNumber || !title || title.trim() === '') {
+      errors.push({
+        code: 'H1_MALFORMED',
+        detail: `Chapter ${chapterNumber}: Level-1 heading does not match "# Chapter <N>: <Title>" format`,
+      });
+      continue;
+    }
+
+    const parsedHeadingNumber = parseInt(headingNumber, 10);
+    if (parsedHeadingNumber !== chapterNumber || headingNumber !== String(parsedHeadingNumber)) {
+      errors.push({
+        code: 'H1_NUMBER_MISMATCH',
+        detail: `Chapter ${chapterNumber}: Heading number ${headingNumber} does not match path chapter number`,
+      });
+    }
+  }
+
+  for (const [chapterNumber, paths] of chapterNumberMap.entries()) {
+    if (paths.length > 1) {
+      errors.push({
+        code: 'CHAPTER_DUPLICATE',
+        detail: `Duplicate chapters: ${paths.length} files resolve to chapter number ${chapterNumber}`,
+      });
+    }
+  }
+
+  if (chapterNumbers.length > 0) {
+    const sortedNumbers = [...new Set(chapterNumbers)].sort((a, b) => a - b);
+    const expectedNumbers = Array.from({ length: sortedNumbers.length }, (_, i) => i + 1);
+
+    for (let i = 0; i < sortedNumbers.length; i++) {
+      const sorted = sortedNumbers[i];
+      const expected = expectedNumbers[i];
+      if (sorted !== undefined && expected !== undefined && sorted !== expected) {
+        errors.push({
+          code: 'CHAPTER_GAP',
+          detail: `Chapter numbers are not sequential from 1 to ${sortedNumbers.length}`,
+        });
+        break;
+      }
+    }
+  }
+
+  errors.sort((a, b) => a.code.localeCompare(b.code));
+
+  return {
+    valid: errors.length === 0,
+    errors,
+  };
+}
