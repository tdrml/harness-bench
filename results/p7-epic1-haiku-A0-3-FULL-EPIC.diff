+import { describe, it, expect } from 'vitest';
+import {
+  resolveChapterTarget,
+  resolveTolerance,
+  resolveWordCountRange,
+  formatToleranceForPrompt,
+  clampToProjectType,
+} from '../index.js';
+import { ProjectType } from '../../config/schemas.js';
+
+describe('word-count-policy', () => {
+  describe('resolveChapterTarget', () => {
+    it('floors the division of targetWordCount by chapterCount', () => {
+      expect(resolveChapterTarget({ targetWordCount: 90000, chapterCount: 3 })).toBe(30000);
+      expect(resolveChapterTarget({ targetWordCount: 100000, chapterCount: 3 })).toBe(33333);
+      expect(resolveChapterTarget({ targetWordCount: 50000, chapterCount: 7 })).toBe(7142);
+    });
+
+    it('throws when chapterCount is 0', () => {
+      expect(() => resolveChapterTarget({ targetWordCount: 90000, chapterCount: 0 })).toThrow(
+        'chapterCount must be positive',
+      );
+    });
+
+    it('throws when chapterCount is negative', () => {
+      expect(() => resolveChapterTarget({ targetWordCount: 90000, chapterCount: -5 })).toThrow(
+        'chapterCount must be positive',
+      );
+    });
+  });
+
+  describe('resolveTolerance', () => {
+    it('returns 0.05 for writer stage', () => {
+      expect(resolveTolerance('writer')).toBe(0.05);
+    });
+
+    it('returns 0.10 for review stage', () => {
+      expect(resolveTolerance('review')).toBe(0.10);
+    });
+
+    it('returns 0.20 for merge stage', () => {
+      expect(resolveTolerance('merge')).toBe(0.20);
+    });
+  });
+
+  describe('resolveWordCountRange', () => {
+    it('returns correct range for writer stage', () => {
+      const range = resolveWordCountRange({
+        targetWordCount: 90000,
+        chapterCount: 3,
+        stage: 'writer',
+      });
+      // target = floor(90000 / 3) = 30000
+      // tolerance = 0.05
+      // min = floor(30000 * 0.95) = 28500
+      // max = ceil(30000 * 1.05) = 31500
+      expect(range.min).toBe(28500);
+      expect(range.max).toBe(31500);
+    });
+
+    it('returns correct range for review stage', () => {
+      const range = resolveWordCountRange({
+        targetWordCount: 90000,
+        chapterCount: 3,
+        stage: 'review',
+      });
+      // target = floor(90000 / 3) = 30000
+      // tolerance = 0.10
+      // min = floor(30000 * 0.90) = 27000
+      // max = ceil(30000 * 1.10) = 33000
+      expect(range.min).toBe(27000);
+      expect(range.max).toBe(33000);
+    });
+
+    it('returns correct range for merge stage', () => {
+      const range = resolveWordCountRange({
+        targetWordCount: 90000,
+        chapterCount: 3,
+        stage: 'merge',
+      });
+      // target = floor(90000 / 3) = 30000
+      // tolerance = 0.20
+      // min = floor(30000 * 0.80) = 24000
+      // max = ceil(30000 * 1.20) = 36000
+      expect(range.min).toBe(24000);
+      expect(range.max).toBe(36000);
+    });
+
+    it('uses ceil for max even when result would be exact', () => {
+      const range = resolveWordCountRange({
+        targetWordCount: 100000,
+        chapterCount: 10,
+        stage: 'writer',
+      });
+      // target = floor(100000 / 10) = 10000
+      // tolerance = 0.05
+      // min = floor(10000 * 0.95) = 9500
+      // max = ceil(10000 * 1.05) = 10500
+      expect(range.min).toBe(9500);
+      expect(range.max).toBe(10500);
+    });
+  });
+
+  describe('formatToleranceForPrompt', () => {
+    it('returns ±5% for writer stage', () => {
+      expect(formatToleranceForPrompt('writer')).toBe('±5%');
+    });
+
+    it('returns ±10% for review stage', () => {
+      expect(formatToleranceForPrompt('review')).toBe('±10%');
+    });
+
+    it('returns ±20% for merge stage', () => {
+      expect(formatToleranceForPrompt('merge')).toBe('±20%');
+    });
+  });
+
+  describe('clampToProjectType', () => {
+    it('returns unclamped range when entirely within bounds', () => {
+      const range = { min: 3000, max: 5000 };
+      const clamped = clampToProjectType({
+        range,
+        projectType: ProjectType.NOVEL,
+      });
+      expect(clamped.min).toBe(3000);
+      expect(clamped.max).toBe(5000);
+    });
+
+    it('clamps both endpoints when range is below project bounds', () => {
+      // NOVEL bounds: chapterMin=3000, chapterMax=5000
+      const range = { min: 1000, max: 2000 };
+      const clamped = clampToProjectType({
+        range,
+        projectType: ProjectType.NOVEL,
+      });
+      // min = min(max(1000, 3000), 5000) = 3000
+      // max = min(max(2000, 3000), 5000) = 3000
+      expect(clamped.min).toBe(3000);
+      expect(clamped.max).toBe(3000);
+    });
+
+    it('clamps both endpoints when range is above project bounds', () => {
+      const range = { min: 6000, max: 7000 };
+      const clamped = clampToProjectType({
+        range,
+        projectType: ProjectType.NOVEL,
+      });
+      // min = min(max(6000, 3000), 5000) = 5000
+      // max = min(max(7000, 3000), 5000) = 5000
+      expect(clamped.min).toBe(5000);
+      expect(clamped.max).toBe(5000);
+    });
+
+    it('clamps min when below bounds but max within bounds', () => {
+      const range = { min: 2000, max: 4000 };
+      const clamped = clampToProjectType({
+        range,
+        projectType: ProjectType.NOVEL,
+      });
+      expect(clamped.min).toBe(3000);
+      expect(clamped.max).toBe(4000);
+    });
+
+    it('clamps max when above bounds but min within bounds', () => {
+      const range = { min: 4000, max: 6000 };
+      const clamped = clampToProjectType({
+        range,
+        projectType: ProjectType.NOVEL,
+      });
+      expect(clamped.min).toBe(4000);
+      expect(clamped.max).toBe(5000);
+    });
+
+    it('works with different project types', () => {
+      // NOVELLA bounds: chapterMin=2500, chapterMax=4000
+      const range = { min: 1000, max: 5000 };
+      const clamped = clampToProjectType({
+        range,
+        projectType: ProjectType.NOVELLA,
+      });
+      expect(clamped.min).toBe(2500);
+      expect(clamped.max).toBe(4000);
+    });
+
+    it('throws for unknown project type', () => {
+      expect(() =>
+        clampToProjectType({
+          range: { min: 3000, max: 5000 },
+          projectType: 'unknown' as any,
+        }),
+      ).toThrow('Unknown project type');
+    });
+  });
+});
