diff --git a/packages/lambdas/src/shared/__tests__/launch-agent-run.test.ts b/packages/lambdas/src/shared/__tests__/launch-agent-run.test.ts
new file mode 100644
index 0000000..7f41d84
--- /dev/null
+++ b/packages/lambdas/src/shared/__tests__/launch-agent-run.test.ts
@@ -0,0 +1,254 @@
+import { describe, it, expect, beforeEach, vi } from 'vitest';
+import { mockClient } from 'aws-sdk-client-mock';
+import { ECSClient, RunTaskCommand } from '@aws-sdk/client-ecs';
+import type { AgentRunService, TaskOutputService } from '@auto-graph/core';
+import type { EnvironmentConfig } from '@auto-graph/core';
+import { launchAgentRun } from '../launch-agent-run.js';
+
+const ecsMock = mockClient(ECSClient);
+
+beforeEach(() => {
+  ecsMock.reset();
+});
+
+const config: EnvironmentConfig = {
+  AWS_REGION: 'us-east-1',
+  DYNAMODB_TABLE_PREFIX: 'test',
+  SQS_QUEUE_URL: 'https://sqs.us-east-1.amazonaws.com/123',
+  ECS_CLUSTER_ARN: 'arn:aws:ecs:us-east-1:123:cluster/main',
+  ECS_SUBNETS: 'subnet-aaa',
+  ECS_SECURITY_GROUPS: 'sg-aaa',
+  GITHUB_TOKEN: 'ghp_test',
+  GITHUB_ORG: 'test-org',
+  ORCHESTRATION_REPO: 'test-repo',
+  LOG_LEVEL: 'info',
+};
+
+function makeServices() {
+  const agentRunService = { create: vi.fn().mockResolvedValue(undefined) } as unknown as AgentRunService;
+  const taskOutputService = { save: vi.fn().mockResolvedValue(undefined) } as unknown as TaskOutputService;
+  return { agentRunService, taskOutputService };
+}
+
+describe('launchAgentRun', () => {
+  it('generates a ULID run id', async () => {
+    const taskArn = 'arn:aws:ecs:us-east-1:123:task/abc';
+    ecsMock.on(RunTaskCommand).resolves({ tasks: [{ taskArn }], failures: [] });
+    const { agentRunService, taskOutputService } = makeServices();
+
+    const result = await launchAgentRun({
+      taskDefArn: 'worker:1',
+      workerType: 'outliner',
+      systemPrompt: 'prompt text',
+      projectId: 'proj-1',
+      repoName: 'the-repo',
+      config,
+      agentRunService,
+      taskOutputService,
+    });
+
+    expect(result.runId).toMatch(/^[0-9A-HJKMNP-TV-Z]{26}$/);
+    expect(result.taskArn).toBe(taskArn);
+  });
+
+  it('saves the system prompt as a system-prompt task output', async () => {
+    ecsMock.on(RunTaskCommand).resolves({
+      tasks: [{ taskArn: 'arn:aws:ecs:us-east-1:123:task/xyz' }],
+      failures: [],
+    });
+    const { agentRunService, taskOutputService } = makeServices();
+
+    const result = await launchAgentRun({
+      taskDefArn: 'worker:1',
+      workerType: 'planner',
+      systemPrompt: 'the system prompt',
+      projectId: 'proj-1',
+      repoName: 'the-repo',
+      config,
+      agentRunService,
+      taskOutputService,
+    });
+
+    expect(taskOutputService.save).toHaveBeenCalledOnce();
