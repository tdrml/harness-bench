+import { describe, it, expect } from 'vitest';
+import {
+  validateListing,
+  MAX_BLURB_LENGTH,
+  REQUIRED_KEYWORD_COUNT,
+  REQUIRED_CATEGORY_COUNT,
+  ALLOWED_BLURB_TAGS,
+} from '../index.js';
+import type { KdpListing } from '../index.js';
+
+const validListing: KdpListing = {
+  title: 'Valid Title',
+  subtitle: 'A valid subtitle',
+  blurb: 'This is a valid blurb with proper content.',
+  keywords: ['key1', 'key2', 'key3', 'key4', 'key5', 'key6', 'key7'],
+  categories: ['cat1', 'cat2', 'cat3'],
+  author: 'John Doe',
+};
+
+describe('validateListing', () => {
+  describe('valid listing', () => {
+    it('returns valid: true for a properly formed listing', () => {
+      const result = validateListing(validListing);
+      expect(result.valid).toBe(true);
+      expect(result.errors).toHaveLength(0);
+    });
+
+    it('allows listing without optional subtitle', () => {
+      const listing: KdpListing = {
+        title: 'Title',
+        blurb: 'Valid blurb content.',
+        keywords: ['key1', 'key2', 'key3', 'key4', 'key5', 'key6', 'key7'],
+        categories: ['cat1', 'cat2', 'cat3'],
+        author: 'Author',
+      };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(true);
+      expect(result.errors).toHaveLength(0);
+    });
+  });
+
+  describe('BLURB_EMPTY', () => {
+    it('fails when blurb is empty string', () => {
+      const listing = { ...validListing, blurb: '' };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors.some((e) => e.code === 'BLURB_EMPTY')).toBe(true);
+    });
+
+    it('fails when blurb is whitespace only', () => {
+      const listing = { ...validListing, blurb: '   \n\t  ' };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors.some((e) => e.code === 'BLURB_EMPTY')).toBe(true);
+    });
+  });
+
+  describe('BLURB_TOO_LONG', () => {
+    it('passes when blurb is exactly at max length', () => {
+      const listing = {
+        ...validListing,
+        blurb: 'a'.repeat(MAX_BLURB_LENGTH),
+      };
+      const result = validateListing(listing);
+      expect(result.errors.some((e) => e.code === 'BLURB_TOO_LONG')).toBe(false);
+    });
+
+    it('fails when blurb exceeds max length', () => {
+      const listing = {
+        ...validListing,
+        blurb: 'a'.repeat(MAX_BLURB_LENGTH + 1),
+      };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors.some((e) => e.code === 'BLURB_TOO_LONG')).toBe(true);
+    });
+  });
+
+  describe('KEYWORD_COUNT', () => {
+    it('passes with exactly 7 keywords', () => {
+      const listing = {
+        ...validListing,
+        keywords: ['k1', 'k2', 'k3', 'k4', 'k5', 'k6', 'k7'],
+      };
+      const result = validateListing(listing);
+      expect(result.errors.some((e) => e.code === 'KEYWORD_COUNT')).toBe(false);
+    });
+
+    it('fails with fewer than 7 keywords', () => {
+      const listing = {
+        ...validListing,
+        keywords: ['k1', 'k2', 'k3', 'k4', 'k5', 'k6'],
+      };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors.some((e) => e.code === 'KEYWORD_COUNT')).toBe(true);
+    });
+
+    it('fails with more than 7 keywords', () => {
+      const listing = {
+        ...validListing,
+        keywords: ['k1', 'k2', 'k3', 'k4', 'k5', 'k6', 'k7', 'k8'],
+      };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors.some((e) => e.code === 'KEYWORD_COUNT')).toBe(true);
+    });
+  });
+
+  describe('CATEGORY_COUNT', () => {
+    it('passes with exactly 3 categories', () => {
+      const listing = {
+        ...validListing,
+        categories: ['cat1', 'cat2', 'cat3'],
+      };
+      const result = validateListing(listing);
+      expect(result.errors.some((e) => e.code === 'CATEGORY_COUNT')).toBe(false);
+    });
+
+    it('fails with fewer than 3 categories', () => {
+      const listing = {
+        ...validListing,
+        categories: ['cat1', 'cat2'],
+      };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors.some((e) => e.code === 'CATEGORY_COUNT')).toBe(true);
+    });
+
+    it('fails with more than 3 categories', () => {
+      const listing = {
+        ...validListing,
+        categories: ['cat1', 'cat2', 'cat3', 'cat4'],
+      };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors.some((e) => e.code === 'CATEGORY_COUNT')).toBe(true);
+    });
+  });
+
+  describe('UNRESOLVED_PLACEHOLDER', () => {
+    it('fails when title contains TODO:', () => {
+      const listing = { ...validListing, title: 'TODO: Complete title' };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors.some((e) => e.code === 'UNRESOLVED_PLACEHOLDER')).toBe(true);
+    });
+
+    it('fails when subtitle contains TODO:', () => {
+      const listing = { ...validListing, subtitle: 'TODO: Complete subtitle' };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors.some((e) => e.code === 'UNRESOLVED_PLACEHOLDER')).toBe(true);
+    });
+
+    it('fails when blurb contains TODO:', () => {
+      const listing = { ...validListing, blurb: 'This is TODO: incomplete' };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors.some((e) => e.code === 'UNRESOLVED_PLACEHOLDER')).toBe(true);
+    });
+
+    it('fails when author contains TODO:', () => {
+      const listing = { ...validListing, author: 'TODO: Author Name' };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors.some((e) => e.code === 'UNRESOLVED_PLACEHOLDER')).toBe(true);
+    });
+
+    it('fails when a keyword contains TODO:', () => {
+      const listing = {
+        ...validListing,
+        keywords: ['k1', 'k2', 'TODO: keyword', 'k4', 'k5', 'k6', 'k7'],
+      };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors.some((e) => e.code === 'UNRESOLVED_PLACEHOLDER')).toBe(true);
+    });
+
+    it('fails when a category contains TODO:', () => {
+      const listing = {
+        ...validListing,
+        categories: ['cat1', 'TODO: category', 'cat3'],
+      };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors.some((e) => e.code === 'UNRESOLVED_PLACEHOLDER')).toBe(true);
+    });
+
+    it('reports only one placeholder error even with multiple placeholders', () => {
+      const listing = {
+        ...validListing,
+        title: 'TODO: title',
+        blurb: 'TODO: blurb content',
+        author: 'TODO: author',
+      };
+      const result = validateListing(listing);
+      const placeholderErrors = result.errors.filter((e) => e.code === 'UNRESOLVED_PLACEHOLDER');
+      expect(placeholderErrors).toHaveLength(1);
+    });
+  });
+
+  describe('DISALLOWED_HTML', () => {
+    it('passes with allowed HTML tags', () => {
+      const blurb = 'This is <b>bold</b> and <i>italic</i> and <u>underlined</u>. <br/> <p>Paragraph</p> <ul><li>Item</li></ul> <ol><li>Item</li></ol> <h4>Heading</h4> <h5>Heading</h5> <h6>Heading</h6>';
+      const listing = { ...validListing, blurb };
+      const result = validateListing(listing);
+      expect(result.errors.some((e) => e.code === 'DISALLOWED_HTML')).toBe(false);
+    });
+
+    it('fails with disallowed HTML tag', () => {
+      const listing = { ...validListing, blurb: 'Text with <span>disallowed</span> tag' };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors.some((e) => e.code === 'DISALLOWED_HTML')).toBe(true);
+    });
+
+    it('fails with multiple disallowed HTML tags (reports first one)', () => {
+      const listing = {
+        ...validListing,
+        blurb: 'Text with <div>div</div> and <section>section</section>',
+      };
+      const result = validateListing(listing);
+      const htmlErrors = result.errors.filter((e) => e.code === 'DISALLOWED_HTML');
+      expect(htmlErrors).toHaveLength(1);
+    });
+
+    it('matches HTML tags case-insensitively', () => {
+      const listing = { ...validListing, blurb: 'Text with <SPAN>uppercase tag</SPAN>' };
+      const result = validateListing(listing);
+      expect(result.errors.some((e) => e.code === 'DISALLOWED_HTML')).toBe(true);
+    });
+
+    it('checks closing tags against allowlist', () => {
+      const listing = { ...validListing, blurb: 'Text with </b> closing tag' };
+      const result = validateListing(listing);
+      expect(result.errors.some((e) => e.code === 'DISALLOWED_HTML')).toBe(false);
+    });
+
+    it('fails with h1, h2, h3 (outside allowlist)', () => {
+      const listing = { ...validListing, blurb: 'Text with <h1>heading</h1>' };
+      const result = validateListing(listing);
+      expect(result.errors.some((e) => e.code === 'DISALLOWED_HTML')).toBe(true);
+    });
+
+    it('passes with h4, h5, h6 (in allowlist)', () => {
+      const listing = {
+        ...validListing,
+        blurb: 'Text with <h4>h4</h4> <h5>h5</h5> <h6>h6</h6>',
+      };
+      const result = validateListing(listing);
+      expect(result.errors.some((e) => e.code === 'DISALLOWED_HTML')).toBe(false);
+    });
+  });
+
+  describe('multiple validation errors', () => {
+    it('reports multiple errors when present', () => {
+      const listing: KdpListing = {
+        title: 'Too many keywords',
+        blurb: '',
+        keywords: ['k1', 'k2', 'k3', 'k4', 'k5', 'k6', 'k7', 'k8'],
+        categories: ['cat1'],
+        author: 'Author',
+      };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors.length).toBeGreaterThan(1);
+    });
+
+    it('sorts errors by code ascending', () => {
+      const listing: KdpListing = {
+        title: 'Title',
+        blurb: 'Valid blurb with <span>disallowed tag</span> and TODO: placeholder.',
+        keywords: [],
+        categories: [],
+        author: 'Author',
+      };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+
+      const codes = result.errors.map((e) => e.code);
+      for (let i = 1; i < codes.length; i++) {
+        const currentCode = codes[i];
+        const previousCode = codes[i - 1];
+        if (currentCode !== undefined && previousCode !== undefined) {
+          expect(currentCode.localeCompare(previousCode)).toBeGreaterThanOrEqual(0);
+        }
+      }
+    });
+  });
+
+  describe('constants', () => {
+    it('exports MAX_BLURB_LENGTH = 4000', () => {
+      expect(MAX_BLURB_LENGTH).toBe(4000);
+    });
+
+    it('exports REQUIRED_KEYWORD_COUNT = 7', () => {
+      expect(REQUIRED_KEYWORD_COUNT).toBe(7);
+    });
+
+    it('exports REQUIRED_CATEGORY_COUNT = 3', () => {
+      expect(REQUIRED_CATEGORY_COUNT).toBe(3);
+    });
+
+    it('exports ALLOWED_BLURB_TAGS with correct values', () => {
+      expect(ALLOWED_BLURB_TAGS).toEqual(['b', 'i', 'u', 'br', 'p', 'ul', 'li', 'ol', 'h4', 'h5', 'h6']);
+    });
+  });
+});
