+export interface KdpListing {
+  title: string;
+  subtitle?: string | undefined;
+  blurb: string;
+  keywords: string[];
+  categories: string[];
+  author: string;
+}
+
+export interface ListingError {
+  code: string;
+  detail: string;
+}
+
+export interface ListingValidation {
+  valid: boolean;
+  errors: ListingError[];
+}
+
+export const MAX_BLURB_LENGTH = 4000;
+export const REQUIRED_KEYWORD_COUNT = 7;
+export const REQUIRED_CATEGORY_COUNT = 3;
+export const ALLOWED_BLURB_TAGS = ['b', 'i', 'u', 'br', 'p', 'ul', 'li', 'ol', 'h4', 'h5', 'h6'];
