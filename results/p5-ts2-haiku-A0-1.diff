+    expect(checkTime).toBeGreaterThanOrEqual(before);
+    expect(checkTime).toBeLessThanOrEqual(after);
+  });
+
+  it('acquireLock still sets TTL independently of grace period', async () => {
+    const before = Math.floor(Date.now() / 1000);
+    const client = makeClient(() => ({}));
