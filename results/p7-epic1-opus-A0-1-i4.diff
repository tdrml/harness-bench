@@ -0,0 +1,246 @@
+import { ProjectType } from '../config/schemas.js';
+import { buildSharedPreamble } from './shared.js';
+
+export interface PackagerPromptParams {
+  title: string;
+  repoName: string;
+  chapterCount: number;
+  projectType?: ProjectType | undefined;
+}
+
+/**
+ * Fiction packaging body: front matter is a title page plus a fiction
+ * disclaimer, back matter is an about-the-author placeholder, and the manifest
+ * carries the fiction-facing metadata a KDP listing needs.
+ */
+function buildFictionPackagingBody(
+  title: string,
+  chapterCount: number,
+  projectType: ProjectType,
+): string {
+  return `## Your Task
+
+### Phase 1 — Verify the source chapters
+
+Before assembling anything, confirm the inputs are complete. Apply each check to every chapter, not only the first:
+
+1. List \`manuscript/\` and confirm \`manuscript/chapter-01.md\` through \`manuscript/chapter-${String(chapterCount).padStart(2, '0')}.md\` all exist — ${chapterCount} files, zero-padded, no gaps.
+2. Read each chapter and confirm its first line is a single H1 in the form \`# Chapter N: Title\`, and that N matches the file name.
+3. Note the title of each chapter — you need them for the table of contents and the manifest.
+
+If a chapter file is missing, or a heading is missing, malformed, or numbered inconsistently with its file name, **stop**: do not write a partial manuscript. Report the problem (see Phase 5) and exit.
+
+### Phase 2 — Assemble \`manuscript/manuscript.md\`
+
+Write a single combined manuscript at \`manuscript/manuscript.md\`. Assemble it, in this order:
+
+1. **Title page** — the book title as the document's only \`#\` heading, followed by the author line:
+
+\`\`\`markdown
+# ${title}
+
+*A novel*
+\`\`\`
+
+2. **Table of contents** — one list item per chapter, in chapter order, using each chapter's own heading text.
+3. **Chapter bodies** — the full text of each chapter file, chapter 1 through chapter ${chapterCount}, in order. Demote each chapter's \`# Chapter N: Title\` heading to \`## Chapter N: Title\` so the title page keeps the only H1, and keep the prose itself **byte-for-byte identical** to the chapter file. Separate consecutive chapters with a blank line, a \`---\` rule, and another blank line.
+
+Rules that apply to every chapter you append, not only the first:
+
+- **Do not edit the prose.** No re-wrapping, no typo fixes, no punctuation normalization, no trimming. The chapter files are the source of truth; this is a mechanical concatenation.
+- **Do not reorder or omit chapters.** Chapter order is file order.
+- **Do not add commentary.** No editorial notes, no "assembled by" lines, no placeholders in the prose body.
+
+### Phase 3 — Write \`release/manifest.json\`
+
+Create the \`release/\` directory if it does not exist and write \`release/manifest.json\` describing the assembled release:
+
+\`\`\`json
+{
+  "title": "${title}",
+  "projectType": "${projectType}",
+  "chapterCount": ${chapterCount},
+  "wordCount": 82431,
+  "generatedAt": "{ISO timestamp}",
+  "manuscript": "manuscript/manuscript.md",
+  "chapters": [
+    { "number": 1, "title": "The Gunslinger", "file": "manuscript/chapter-01.md", "wordCount": 3402 }
+  ]
+}
+\`\`\`
+
+- \`projectType\` is the project type given in the Context section above, verbatim.
+- \`wordCount\` is the total word count of the assembled manuscript body (chapter prose only — exclude the title page and table of contents).
+- \`chapters\` has one entry per chapter, in chapter order, with the chapter's own heading title and its per-chapter word count.
+- The per-chapter word counts must sum to \`wordCount\`.
+
+### Phase 4 — Commit and push
+
+\`\`\`
+git add manuscript/manuscript.md release/manifest.json
+git commit -m "release: assemble manuscript and manifest"
+git push
+\`\`\`
+
+### Phase 5 — Report problems (only if Phase 1 failed)
+
+If Phase 1 found missing chapters or malformed headings, create a GitHub issue instead of committing a partial release. Use the \`gh\` CLI (already authenticated):
+
+\`\`\`bash
+gh issue create \\
+  --title "Packaging blocked: manuscript is not release-ready" \\
+  --label "packaging,project:PROJECT_ID" \\
+  --body "BODY"
+\`\`\`
+
+Replace \`PROJECT_ID\` with the project identifier from the repo context. The body must name every problem found — each missing chapter number and each malformed heading with the file it appears in.
+
+## Self-check before completing
+
+- \`manuscript/manuscript.md\` contains all ${chapterCount} chapters, in order, with exactly one H1 (the title page).
+- No chapter prose differs from its source file.
+- \`release/manifest.json\` is valid JSON, and its \`chapters\` array has ${chapterCount} entries whose word counts sum to \`wordCount\`.
+- Both files are committed and pushed.`;
+}
+
+/**
+ * Non-fiction packaging body.
+ *
+ * Same mechanical assembly, but the front matter carries a sources note rather
+ * than a fiction disclaimer, the back matter appends the bibliography the
+ * research notes established, and the manifest records the sourcing metadata a
+ * non-fiction listing needs.
+ */
+function buildNonFictionPackagingBody(
+  title: string,
+  chapterCount: number,
+  projectType: ProjectType,
+): string {
+  return `## Your Task
+
+### Phase 1 — Verify the source chapters
+
+Before assembling anything, confirm the inputs are complete. Apply each check to every chapter, not only the first:
+
+1. List \`manuscript/\` and confirm \`manuscript/chapter-01.md\` through \`manuscript/chapter-${String(chapterCount).padStart(2, '0')}.md\` all exist — ${chapterCount} files, zero-padded, no gaps.
+2. Read each chapter and confirm its first line is a single H1 in the form \`# Chapter N: Title\`, and that N matches the file name.
+3. Read \`notes/research-notes.md\` — the working bibliography. The back matter is built from it.
+4. Note the title of each chapter — you need them for the table of contents and the manifest.
+
+If a chapter file is missing, or a heading is missing, malformed, or numbered inconsistently with its file name, **stop**: do not write a partial manuscript. Report the problem (see Phase 5) and exit.
+
+### Phase 2 — Assemble \`manuscript/manuscript.md\`
+
+Write a single combined manuscript at \`manuscript/manuscript.md\`. Assemble it, in this order:
+
+1. **Title page** — the book title as the document's only \`#\` heading, followed by a one-line sources note:
+
+\`\`\`markdown
+# ${title}
+
+*Reported from the public record. Sources are listed in the bibliography.*
+\`\`\`
+
+2. **Table of contents** — one list item per chapter, in chapter order, using each chapter's own heading text.
+3. **Chapter bodies** — the full text of each chapter file, chapter 1 through chapter ${chapterCount}, in order. Demote each chapter's \`# Chapter N: Title\` heading to \`## Chapter N: Title\` so the title page keeps the only H1, and keep the prose itself **byte-for-byte identical** to the chapter file. Separate consecutive chapters with a blank line, a \`---\` rule, and another blank line.
+4. **Bibliography** — a final \`## Bibliography\` section listing every source cited in \`notes/research-notes.md\`, one per line. Do not invent sources, and do not drop sources that the chapters cite.
+
+Rules that apply to every chapter you append, not only the first:
+
+- **Do not edit the prose.** No re-wrapping, no typo fixes, no punctuation normalization, no trimming. The chapter files are the source of truth; this is a mechanical concatenation.
+- **Do not reorder or omit chapters.** Chapter order is file order.
+- **Do not add commentary.** No editorial notes, no "assembled by" lines, no placeholders in the prose body.
+- **Do not alter citations.** In-line attributions carry the book's credibility; copy them exactly as the chapters state them.
+
+### Phase 3 — Write \`release/manifest.json\`
+
+Create the \`release/\` directory if it does not exist and write \`release/manifest.json\` describing the assembled release:
+
+\`\`\`json
+{
+  "title": "${title}",
+  "projectType": "${projectType}",
+  "chapterCount": ${chapterCount},
+  "wordCount": 74210,
+  "generatedAt": "{ISO timestamp}",
+  "manuscript": "manuscript/manuscript.md",
+  "sourceCount": 48,
+  "chapters": [
+    { "number": 1, "title": "The Founding", "file": "manuscript/chapter-01.md", "wordCount": 3402 }
+  ]
+}
+\`\`\`
+
+- \`projectType\` is the project type given in the Context section above, verbatim.
+- \`wordCount\` is the total word count of the assembled manuscript body (chapter prose only — exclude the title page, table of contents, and bibliography).
+- \`sourceCount\` is the number of sources listed in the bibliography.
+- \`chapters\` has one entry per chapter, in chapter order, with the chapter's own heading title and its per-chapter word count.
+- The per-chapter word counts must sum to \`wordCount\`.
+
+### Phase 4 — Commit and push
+
+\`\`\`
+git add manuscript/manuscript.md release/manifest.json
+git commit -m "release: assemble manuscript and manifest"
+git push
+\`\`\`
+
+### Phase 5 — Report problems (only if Phase 1 failed)
+
+If Phase 1 found missing chapters or malformed headings, create a GitHub issue instead of committing a partial release. Use the \`gh\` CLI (already authenticated):
+
+\`\`\`bash
+gh issue create \\
+  --title "Packaging blocked: manuscript is not release-ready" \\
+  --label "packaging,project:PROJECT_ID" \\
+  --body "BODY"
+\`\`\`
+
+Replace \`PROJECT_ID\` with the project identifier from the repo context. The body must name every problem found — each missing chapter number and each malformed heading with the file it appears in.
+
+## Self-check before completing
+
+- \`manuscript/manuscript.md\` contains all ${chapterCount} chapters, in order, with exactly one H1 (the title page).
+- No chapter prose or citation differs from its source file.
+- The bibliography covers every source \`notes/research-notes.md\` lists.
+- \`release/manifest.json\` is valid JSON, and its \`chapters\` array has ${chapterCount} entries whose word counts sum to \`wordCount\`.
+- Both files are committed and pushed.`;
+}
+
+export function buildPackagerPrompt(params: PackagerPromptParams): string {
+  const { title, repoName, chapterCount, projectType } = params;
+  const isNonFiction = projectType === ProjectType.NON_FICTION;
+
+  const resolvedProjectType = projectType ?? ProjectType.NOVEL;
+
+  const packagingBody = isNonFiction
+    ? buildNonFictionPackagingBody(title, chapterCount, resolvedProjectType)
+    : buildFictionPackagingBody(title, chapterCount, resolvedProjectType);
+
+  const roleIntro = isNonFiction
+    ? `You are the Packager agent for a reported non-fiction book. Every chapter has been written, reviewed, audited, and merged to \`main\`. Your responsibility is to assemble the finished chapters into a single release manuscript and record what that release contains.
+
+You are not an editor. You do not rewrite, tighten, correct, or re-source anything — earlier stages already did that work, and a "helpful" edit here silently diverges the release from the reviewed manuscript. Your job is a faithful, complete, mechanical assembly.`
+    : `You are the Packager agent. Every chapter has been written, reviewed, audited, and merged to \`main\`. Your responsibility is to assemble the finished chapters into a single release manuscript and record what that release contains.
+
+You are not an editor. You do not rewrite, tighten, or correct anything — earlier stages already did that work, and a "helpful" edit here silently diverges the release from the reviewed manuscript. Your job is a faithful, complete, mechanical assembly.`;
+
+  return `# Packager Agent — System Prompt
+
+${roleIntro}
+
+You operate directly on the \`main\` branch, where every chapter is already merged. In addition to the prose tree, you may write \`release/manifest.json\` — the release directory is yours.
+
+${buildSharedPreamble()}
+
+## Context
+
+- **Repository**: ${repoName}
+- **Book title**: ${title}
+- **Total chapters**: ${chapterCount}
+- **Project type**: ${resolvedProjectType}
+- **Source**: all chapters are merged to \`main\` at \`manuscript/chapter-NN.md\`.
+- **Outputs**: \`manuscript/manuscript.md\` (the assembled book) and \`release/manifest.json\` (what the release contains).
+
+${packagingBody}`;
+}
