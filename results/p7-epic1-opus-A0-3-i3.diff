+++ b/packages/core/src/release-policy/structure.ts
@@ -0,0 +1,103 @@
+import { getChapterFilePath } from '../writing/paths.js';
+import { sortErrorsByCode } from './errors.js';
+import type { ChapterFile, ManuscriptError, ManuscriptValidation } from './types.js';
+
+/** Any level-1 markdown heading, e.g. `# Anything`. */
+const H1_PATTERN = /^#\s+(.+)$/;
+
+/** The heading a chapter file is required to open with, e.g. `# Chapter 7: The Long Way Down`. */
+const CHAPTER_HEADING_PATTERN = /^#\s+Chapter\s+(\d+):\s+(.+)$/;
+
+/**
+ * The chapter number a path encodes, or `undefined` when the path is not the canonical
+ * path for any chapter. Derived from {@link getChapterFilePath} so the naming convention
+ * stays defined in exactly one place.
+ */
+function chapterNumberFromPath(path: string): number | undefined {
+  const digits = /\d+/.exec(path)?.[0];
+  if (digits === undefined) {
+    return undefined;
+  }
+  const chapterNumber = Number.parseInt(digits, 10);
+  return getChapterFilePath(chapterNumber) === path ? chapterNumber : undefined;
+}
+
+function validateChapter(chapter: ChapterFile): ManuscriptError[] {
+  const errors: ManuscriptError[] = [];
+  const lines = chapter.content.split('\n');
+
+  const headingIndex = lines.findIndex((line) => H1_PATTERN.test(line));
+  const heading = headingIndex === -1 ? undefined : lines[headingIndex];
+  const firstContentIndex = lines.findIndex((line) => line.trim().length > 0);
+
+  if (heading === undefined) {
+    errors.push({ code: 'H1_MISSING', detail: `${chapter.path} has no level-1 heading.` });
+  }
+
+  if (firstContentIndex !== -1 && firstContentIndex !== headingIndex) {
+    errors.push({
+      code: 'H1_NOT_FIRST',
+      detail: `${chapter.path} does not open with its level-1 heading.`,
+    });
+  }
+
+  if (heading === undefined) {
+    return errors;
+  }
+
+  const match = CHAPTER_HEADING_PATTERN.exec(heading);
+  const title = match?.[2] ?? '';
+  if (match === null || title.trim().length === 0) {
+    errors.push({
+      code: 'H1_MALFORMED',
+      detail: `${chapter.path} has heading "${heading.trim()}", expected "# Chapter <N>: <Title>".`,
+    });
+    return errors;
+  }
+
+  const headingNumber = Number.parseInt(match[1] ?? '', 10);
+  const pathNumber = chapterNumberFromPath(chapter.path);
+  if (pathNumber !== undefined && headingNumber !== pathNumber) {
+    errors.push({
+      code: 'H1_NUMBER_MISMATCH',
+      detail: `${chapter.path} declares chapter ${headingNumber}, expected chapter ${pathNumber}.`,
+    });
+  }
+
+  return errors;
+}
+
+function validateChapterNumbers(chapters: ChapterFile[]): ManuscriptError[] {
+  const errors: ManuscriptError[] = [];
+  const numbers = chapters
+    .map((chapter) => chapterNumberFromPath(chapter.path))
+    .filter((chapterNumber): chapterNumber is number => chapterNumber !== undefined);
+
+  const duplicates = [...new Set(numbers.filter((n, i) => numbers.indexOf(n) !== i))].sort((a, b) => a - b);
+  if (duplicates.length > 0) {
+    errors.push({
+      code: 'CHAPTER_DUPLICATE',
+      detail: `More than one file resolves to chapter ${duplicates.join(', ')}.`,
+    });
+  }
+
+  const sorted = [...numbers].sort((a, b) => a - b);
+  if (sorted.length !== chapters.length || sorted.some((n, i) => n !== i + 1)) {
+    errors.push({
+      code: 'CHAPTER_GAP',
+      detail: `Chapter numbers [${sorted.join(', ')}] are not a gapless 1..${chapters.length} range.`,
+    });
+  }
+
+  return errors;
+}
+
+export function validateManuscriptStructure(chapters: ChapterFile[]): ManuscriptValidation {
+  const errors: ManuscriptError[] = chapters.flatMap(validateChapter);
+
+  errors.push(...validateChapterNumbers(chapters));
+
+  sortErrorsByCode(errors);
+
+  return { valid: errors.length === 0, errors };
+}
