+import { describe, it, expect } from 'vitest';
+import { validateListing } from '../index.js';
+import type { KdpListing } from '../index.js';
+
+function validListing(overrides: Partial<KdpListing> = {}): KdpListing {
+  return {
+    title: 'The Last Signal',
+    subtitle: 'A Thriller',
+    blurb: '<b>Opening hook.</b><br><br>Setup paragraph.',
+    keywords: ['a', 'b', 'c', 'd', 'e', 'f', 'g'],
+    categories: ['Fiction > Thrillers', 'Fiction > Mystery', 'Fiction > Suspense'],
+    author: 'Jane Doe',
+    ...overrides,
+  };
+}
+
+describe('validateListing', () => {
+  it('returns valid: true and no errors for a well-formed listing', () => {
+    const result = validateListing(validListing());
+    expect(result.valid).toBe(true);
+    expect(result.errors).toHaveLength(0);
+  });
+
+  describe('BLURB_TOO_LONG', () => {
+    it('flags a blurb longer than 4000 characters', () => {
+      const result = validateListing(validListing({ blurb: 'a'.repeat(4001) }));
+      expect(result.valid).toBe(false);
+      expect(result.errors.map((e) => e.code)).toContain('BLURB_TOO_LONG');
+    });
+
+    it('does not flag a blurb exactly at the 4000 character limit', () => {
+      const result = validateListing(validListing({ blurb: 'a'.repeat(4000) }));
+      expect(result.errors.map((e) => e.code)).not.toContain('BLURB_TOO_LONG');
+    });
+  });
+
+  describe('BLURB_EMPTY', () => {
+    it('flags an empty blurb', () => {
+      const result = validateListing(validListing({ blurb: '' }));
+      expect(result.errors.map((e) => e.code)).toContain('BLURB_EMPTY');
+    });
+
+    it('flags a whitespace-only blurb', () => {
+      const result = validateListing(validListing({ blurb: '   \n\t  ' }));
+      expect(result.errors.map((e) => e.code)).toContain('BLURB_EMPTY');
+    });
+  });
+
+  describe('KEYWORD_COUNT', () => {
+    it('flags too few keywords', () => {
+      const result = validateListing(validListing({ keywords: ['a', 'b'] }));
+      expect(result.errors.map((e) => e.code)).toContain('KEYWORD_COUNT');
+    });
+
+    it('flags too many keywords', () => {
+      const result = validateListing(validListing({ keywords: Array(8).fill('kw') }));
+      expect(result.errors.map((e) => e.code)).toContain('KEYWORD_COUNT');
+    });
+
+    it('does not flag exactly 7 keywords', () => {
+      const result = validateListing(validListing());
+      expect(result.errors.map((e) => e.code)).not.toContain('KEYWORD_COUNT');
+    });
+  });
+
+  describe('CATEGORY_COUNT', () => {
+    it('flags a category count other than 3', () => {
+      const result = validateListing(validListing({ categories: ['Fiction > A'] }));
+      expect(result.errors.map((e) => e.code)).toContain('CATEGORY_COUNT');
+    });
+  });
+
+  describe('UNRESOLVED_PLACEHOLDER', () => {
+    it('flags a TODO: placeholder in a scalar field', () => {
+      const result = validateListing(validListing({ title: 'TODO: pick a title' }));
+      expect(result.errors.map((e) => e.code)).toContain('UNRESOLVED_PLACEHOLDER');
+    });
+
+    it('flags a TODO: placeholder inside a keyword entry', () => {
+      const result = validateListing(
+        validListing({ keywords: ['a', 'b', 'c', 'd', 'e', 'f', 'TODO: keyword'] }),
+      );
+      expect(result.errors.map((e) => e.code)).toContain('UNRESOLVED_PLACEHOLDER');
+    });
+
+    it('flags a TODO: placeholder inside a category entry', () => {
+      const result = validateListing(
+        validListing({ categories: ['TODO: category', 'Fiction > B', 'Fiction > C'] }),
+      );
+      expect(result.errors.map((e) => e.code)).toContain('UNRESOLVED_PLACEHOLDER');
+    });
+
+    it('reports only one error even when multiple fields have placeholders', () => {
+      const result = validateListing(
+        validListing({ title: 'TODO: title', author: 'TODO: author' }),
+      );
+      expect(result.errors.filter((e) => e.code === 'UNRESOLVED_PLACEHOLDER')).toHaveLength(1);
+    });
+  });
+
+  describe('DISALLOWED_HTML', () => {
+    it('flags a disallowed tag in the blurb', () => {
+      const result = validateListing(validListing({ blurb: '<div>hello</div>' }));
+      expect(result.errors.map((e) => e.code)).toContain('DISALLOWED_HTML');
+    });
+
+    it('allows tags from the allowlist', () => {
+      const result = validateListing(
+        validListing({
+          blurb: '<b>x</b><i>y</i><u>z</u><br><p>p</p><ul><li>i</li></ul><ol><li>i</li></ol><h4>h</h4><h5>h</h5><h6>h</h6>',
+        }),
+      );
+      expect(result.errors.map((e) => e.code)).not.toContain('DISALLOWED_HTML');
+    });
+
+    it('is case-insensitive when matching tags', () => {
+      const result = validateListing(validListing({ blurb: '<B>hello</B>' }));
+      expect(result.errors.map((e) => e.code)).not.toContain('DISALLOWED_HTML');
+    });
+
+    it('flags disallowed closing tags the same as opening tags', () => {
+      const result = validateListing(validListing({ blurb: 'text</span>' }));
+      expect(result.errors.map((e) => e.code)).toContain('DISALLOWED_HTML');
+    });
+
+    it('reports only one error even when multiple disallowed tags are present', () => {
+      const result = validateListing(validListing({ blurb: '<div>a</div><span>b</span>' }));
+      expect(result.errors.filter((e) => e.code === 'DISALLOWED_HTML')).toHaveLength(1);
+    });
+  });
+
+  describe('ordering and combination', () => {
+    it('sorts errors by code ascending', () => {
+      const result = validateListing({
+        title: 'TODO: title',
+        blurb: '',
+        keywords: [],
+        categories: [],
+        author: 'A',
+      });
+      const codes = result.errors.map((e) => e.code);
+      const sorted = [...codes].sort();
+      expect(codes).toEqual(sorted);
+    });
+
+    it('sets valid to false when any error is present', () => {
+      const result = validateListing(validListing({ keywords: [] }));
+      expect(result.valid).toBe(false);
+    });
+  });
+});
