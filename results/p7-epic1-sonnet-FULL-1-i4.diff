+
+  it('loads the latest task graph from DynamoDB', async () => {
+    const workItem = { type: 'PACKAGE_MANUSCRIPT' as const, projectId: 'proj-123' };
+    const event = makeEvent([makeRecord(workItem)]);
+
+    await handler(event, {} as never, () => {});
+
+    expect(mockTaskGraphServiceMethods.getLatest).toHaveBeenCalledOnce();
+    expect(mockTaskGraphServiceMethods.getLatest).toHaveBeenCalledWith('proj-123');
