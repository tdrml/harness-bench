+
+  describe('multiple errors', () => {
+    it('reports every violation, sorted by code', () => {
+      const chapters: ChapterFile[] = [
+        chapter(1, `${chapterBody}\n\n# Chapter 1: Arrival\n`),
+        chapter(3, '# Arrival\n'),
+        chapter(5, `# Chapter 4: Departure\n\n${chapterBody}\n`),
+      ];
+      const result = validateManuscriptStructure(chapters);
+      expect(result.valid).toBe(false);
+      expect(result.errors.map((error) => error.code)).toEqual([
