+}
+
+// The canonical chapter heading: "# Chapter <N>: <Title>"
+const CHAPTER_H1_RE = /^#\s+Chapter\s+(\d+):\s+(.+)$/;
+
+export function parseChapterHeading(line: string): ChapterHeading | undefined {
+  const match = CHAPTER_H1_RE.exec(line);
+  if (!match) {
+    return undefined;
+  }
+  return { chapterNumber: parseInt(match[1]!, 10), title: match[2]!.trim() };
+}
