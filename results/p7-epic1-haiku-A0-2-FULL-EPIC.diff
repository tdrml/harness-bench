+} from '../index.js';
+
+const validListing: KdpListing = {
+  title: 'A Great Book',
+  subtitle: 'Subtitle',
+  blurb: 'This is a great book that tells an amazing story.',
+  keywords: ['keyword1', 'keyword2', 'keyword3', 'keyword4', 'keyword5', 'keyword6', 'keyword7'],
+  categories: ['Fiction', 'Adventure', 'Fantasy'],
+  author: 'John Doe',
+};
+
+describe('validateListing', () => {
+  describe('valid listing', () => {
+    it('returns valid: true with no errors for a complete valid listing', () => {
+      const result = validateListing(validListing);
+      expect(result.valid).toBe(true);
+      expect(result.errors).toHaveLength(0);
+    });
+
+    it('accepts optional subtitle', () => {
+      const listing = { ...validListing, subtitle: undefined };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(true);
+    });
+
+    it('accepts subtitle without value', () => {
+      const listing: KdpListing = {
+        title: 'A Great Book',
+        blurb: 'This is a great book that tells an amazing story.',
+        keywords: ['keyword1', 'keyword2', 'keyword3', 'keyword4', 'keyword5', 'keyword6', 'keyword7'],
+        categories: ['Fiction', 'Adventure', 'Fantasy'],
+        author: 'John Doe',
+      };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(true);
+    });
+  });
+
+  describe('BLURB_EMPTY', () => {
+    it('reports error when blurb is empty string', () => {
+      const listing = { ...validListing, blurb: '' };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'BLURB_EMPTY' }));
+    });
+
+    it('reports error when blurb is whitespace only', () => {
+      const listing = { ...validListing, blurb: '   \n\t  ' };
+      const result = validateListing(listing);
