diff --git a/packages/core/src/release-policy/manuscript.ts b/packages/core/src/release-policy/manuscript.ts
new file mode 100644
index 0000000..48102ff
--- /dev/null
+++ b/packages/core/src/release-policy/manuscript.ts
@@ -0,0 +1,100 @@
+import { getChapterFilePath } from '../writing/index.js';
+import type { ChapterFile, ManuscriptError, ManuscriptValidation } from './types.js';
+
+const H1_LINE_PATTERN = /^#\s+/;
+const H1_CONTENT_PATTERN = /^#\s+Chapter\s+(\d+):\s+(.+)$/;
+const PATH_NUMBER_PATTERN = /(\d+)/;
+
+function isH1Line(line: string): boolean {
+  return H1_LINE_PATTERN.test(line);
+}
+
+function resolveChapterNumberFromPath(path: string): number | undefined {
+  const match = PATH_NUMBER_PATTERN.exec(path);
+  if (!match) {
+    return undefined;
+  }
+  const candidate = Number(match[1]);
+  return getChapterFilePath(candidate) === path ? candidate : undefined;
+}
+
+export function validateManuscriptStructure(chapters: ChapterFile[]): ManuscriptValidation {
+  const errors: ManuscriptError[] = [];
+  const chapterNumbers: number[] = [];
+
+  for (const chapter of chapters) {
+    const lines = chapter.content.split('\n');
+    const h1Index = lines.findIndex(isH1Line);
+    const hasH1 = h1Index !== -1;
+
+    if (!hasH1) {
+      errors.push({
+        code: 'H1_MISSING',
+        detail: `${chapter.path} has no level-1 markdown heading.`,
+      });
+    }
+
+    const firstNonEmptyIndex = lines.findIndex((line) => line.trim().length > 0);
+    if (firstNonEmptyIndex === -1 || firstNonEmptyIndex !== h1Index) {
+      errors.push({
+        code: 'H1_NOT_FIRST',
+        detail: `${chapter.path} has content before its level-1 heading.`,
+      });
+    }
+
+    if (hasH1) {
+      const h1Line = lines[h1Index]!;
+      const match = H1_CONTENT_PATTERN.exec(h1Line);
+      const title = match?.[2]?.trim();
+
+      if (!match || !title) {
+        errors.push({
+          code: 'H1_MALFORMED',
+          detail: `${chapter.path} heading "${h1Line.trim()}" does not match "# Chapter <N>: <Title>".`,
+        });
+      } else {
+        const headingNumber = Number(match[1]);
+        if (getChapterFilePath(headingNumber) !== chapter.path) {
+          errors.push({
+            code: 'H1_NUMBER_MISMATCH',
+            detail: `${chapter.path} heading number ${headingNumber} does not match the chapter number implied by its path.`,
+          });
+        }
+      }
+    }
+
+    const resolvedNumber = resolveChapterNumberFromPath(chapter.path);
+    if (resolvedNumber !== undefined) {
+      chapterNumbers.push(resolvedNumber);
+    }
+  }
+
+  const seen = new Set<number>();
+  const duplicates = new Set<number>();
+  for (const chapterNumber of chapterNumbers) {
+    if (seen.has(chapterNumber)) {
+      duplicates.add(chapterNumber);
+    }
+    seen.add(chapterNumber);
+  }
+  if (duplicates.size > 0) {
+    const sortedDuplicates = [...duplicates].sort((a, b) => a - b);
+    errors.push({
+      code: 'CHAPTER_DUPLICATE',
+      detail: `Chapter number(s) ${sortedDuplicates.join(', ')} are used by more than one chapter.`,
+    });
+  }
+
+  const uniqueSorted = [...seen].sort((a, b) => a - b);
+  const hasGap = uniqueSorted.some((chapterNumber, index) => chapterNumber !== index + 1);
+  if (hasGap) {
+    errors.push({
+      code: 'CHAPTER_GAP',
+      detail: `Chapter numbers must form a contiguous sequence from 1 to ${uniqueSorted.length}, got: ${uniqueSorted.join(', ')}.`,
+    });
+  }
+
+  errors.sort((a, b) => (a.code < b.code ? -1 : a.code > b.code ? 1 : 0));
+
+  return { valid: errors.length === 0, errors };
+}
