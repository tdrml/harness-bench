+vi.mock('../../shared/index.js', async (importOriginal) => {
+  const actual = await importOriginal<typeof import('../../shared/index.js')>();
+  return {
+    ...actual,
+    launchAgentRun: vi.fn().mockResolvedValue({
+      runId: 'run-01test',
+      taskArn: 'arn:aws:ecs:us-east-1:123:task/test/packager-abc',
+    }),
+  };
+});
+
+import {
+  ProjectService,
+  AgentRunService,
+  TaskOutputService,
+  buildPackagerPrompt,
+  enqueue,
+  ProjectType,
+} from '@auto-graph/core';
+import { launchAgentRun } from '../../shared/index.js';
+import { handler } from '../package-manuscript.js';
+
+const baseEnv = {
+  AWS_REGION: 'us-east-1',
+  DYNAMODB_TABLE_PREFIX: 'test',
+  SQS_QUEUE_URL: 'https://sqs.us-east-1.amazonaws.com/123/test.fifo',
+  ECS_CLUSTER_ARN: 'arn:aws:ecs:us-east-1:123:cluster/test',
+  ECS_SUBNETS: 'subnet-abc',
+  ECS_SECURITY_GROUPS: 'sg-abc',
+  GITHUB_TOKEN: 'ghp_test',
+  GITHUB_ORG: 'test-org',
+  ORCHESTRATION_REPO: 'orchestration-repo',
+  PACKAGER_TASK_DEF_ARN: 'arn:aws:ecs:us-east-1:123:task-definition/packager:1',
+  LOG_LEVEL: 'info',
+};
+
+const validProject = {
+  projectId: 'proj-123',
+  status: 'REVIEWING' as const,
+  repoName: 'the-dark-tower',
+  repoUrl: 'https://github.com/test-org/the-dark-tower',
+  createdAt: '2024-01-01T00:00:00.000Z',
+  updatedAt: '2024-01-01T00:00:00.000Z',
+  config: {
+    projectId: 'proj-123',
+    projectType: ProjectType.NOVEL,
+    title: 'The Dark Tower',
+    premise: 'A gunslinger pursues the Man in Black across a desert.',
+    genre: 'Dark Fantasy',
+    targetWordCount: 90000,
+    chapterCount: 25,
+    style: { voice: 'sparse and mythic', tense: 'past' as const, pov: 'third-limited' as const },
+    maxRevisionRounds: 5,
+    concurrencyLimit: 3,
+  },
+};
+
+function makeRecord(body: unknown, messageId = 'msg-1'): SQSRecord {
+  return {
+    messageId,
+    receiptHandle: 'handle',
+    body: JSON.stringify(body),
+    attributes: {
+      ApproximateReceiveCount: '1',
+      SentTimestamp: '1000',
+      SenderId: 'sender',
+      ApproximateFirstReceiveTimestamp: '1000',
+    },
+    messageAttributes: {},
+    md5OfBody: 'abc',
+    eventSource: 'aws:sqs',
+    eventSourceARN: 'arn:aws:sqs:us-east-1:123:queue',
+    awsRegion: 'us-east-1',
+  };
+}
+
+function makeEvent(records: SQSRecord[]): SQSEvent {
+  return { Records: records };
+}
+
+let mockProjectServiceMethods: {
+  get: ReturnType<typeof vi.fn>;
+  updateStatus: ReturnType<typeof vi.fn>;
+};
+let mockAgentRunServiceMethods: {
+  create: ReturnType<typeof vi.fn>;
+};
+let mockTaskOutputServiceMethods: {
+  save: ReturnType<typeof vi.fn>;
+};
+
+beforeEach(() => {
+  vi.clearAllMocks();
+
+  for (const [key, value] of Object.entries(baseEnv)) {
+    process.env[key] = value;
+  }
+
+  mockProjectServiceMethods = {
+    get: vi.fn().mockResolvedValue(validProject),
+    updateStatus: vi.fn().mockResolvedValue(undefined),
+  };
+  vi.mocked(ProjectService).mockImplementation(() => mockProjectServiceMethods as never);
+
+  mockAgentRunServiceMethods = {
+    create: vi.fn().mockResolvedValue(undefined),
+  };
+  vi.mocked(AgentRunService).mockImplementation(() => mockAgentRunServiceMethods as never);
+
+  mockTaskOutputServiceMethods = {
+    save: vi.fn().mockResolvedValue(undefined),
+  };
+  vi.mocked(TaskOutputService).mockImplementation(() => mockTaskOutputServiceMethods as never);
+
+  vi.mocked(buildPackagerPrompt).mockReturnValue('mock packager system prompt');
+  vi.mocked(launchAgentRun).mockResolvedValue({
+    runId: 'run-01test',
+    taskArn: 'arn:aws:ecs:us-east-1:123:task/test/packager-abc',
+  });
+  vi.mocked(enqueue).mockResolvedValue(undefined);
+});
+
+// ---------------------------------------------------------------------------
+// Happy path
+// ---------------------------------------------------------------------------
+
+describe('PACKAGE_MANUSCRIPT — happy path', () => {
+  it('loads the project record from DynamoDB', async () => {
+    const workItem = { type: 'PACKAGE_MANUSCRIPT' as const, projectId: 'proj-123' };
+    const event = makeEvent([makeRecord(workItem)]);
+
+    await handler(event, {} as never, () => {});
+
+    expect(mockProjectServiceMethods.get).toHaveBeenCalledOnce();
+    expect(mockProjectServiceMethods.get).toHaveBeenCalledWith('proj-123');
+  });
+
+  it('builds the packager prompt from the project config', async () => {
+    const workItem = { type: 'PACKAGE_MANUSCRIPT' as const, projectId: 'proj-123' };
+    const event = makeEvent([makeRecord(workItem)]);
+
+    await handler(event, {} as never, () => {});
+
+    expect(vi.mocked(buildPackagerPrompt)).toHaveBeenCalledOnce();
+    const [params] = vi.mocked(buildPackagerPrompt).mock.calls[0]!;
+    expect(params.title).toBe('The Dark Tower');
+    expect(params.repoName).toBe('the-dark-tower');
+    expect(params.chapterCount).toBe(25);
+    expect(params.projectType).toBe('NOVEL');
+  });
+
+  it('launches the agent run via the shared helper with correct parameters', async () => {
+    const workItem = { type: 'PACKAGE_MANUSCRIPT' as const, projectId: 'proj-123' };
+    const event = makeEvent([makeRecord(workItem)]);
+
+    await handler(event, {} as never, () => {});
+
+    expect(vi.mocked(launchAgentRun)).toHaveBeenCalledOnce();
+    const [params] = vi.mocked(launchAgentRun).mock.calls[0]!;
+    expect(params.taskDefArn).toBe(baseEnv.PACKAGER_TASK_DEF_ARN);
+    expect(params.workerType).toBe('packager');
+    expect(params.systemPrompt).toBe('mock packager system prompt');
+    expect(params.projectId).toBe('proj-123');
+    expect(params.repoName).toBe('the-dark-tower');
+    expect(params.agentRunService).toBe(mockAgentRunServiceMethods);
+    expect(params.taskOutputService).toBe(mockTaskOutputServiceMethods);
+  });
+
+  it('updates the project status to PACKAGING', async () => {
+    const workItem = { type: 'PACKAGE_MANUSCRIPT' as const, projectId: 'proj-123' };
+    const event = makeEvent([makeRecord(workItem)]);
+
+    await handler(event, {} as never, () => {});
+
+    expect(mockProjectServiceMethods.updateStatus).toHaveBeenCalledOnce();
+    expect(mockProjectServiceMethods.updateStatus).toHaveBeenCalledWith('proj-123', 'PACKAGING');
+  });
+
+  it('enqueues a RECONCILE work item with the runId', async () => {
+    const workItem = { type: 'PACKAGE_MANUSCRIPT' as const, projectId: 'proj-123' };
+    const event = makeEvent([makeRecord(workItem)]);
+
+    await handler(event, {} as never, () => {});
+
+    expect(vi.mocked(enqueue)).toHaveBeenCalledOnce();
+    const [queueUrl, enqueuedItem] = vi.mocked(enqueue).mock.calls[0]!;
+    expect(queueUrl).toBe(baseEnv.SQS_QUEUE_URL);
+    expect(enqueuedItem.type).toBe('RECONCILE');
+    if (enqueuedItem.type === 'RECONCILE') {
+      expect(enqueuedItem.projectId).toBe('proj-123');
+      expect(enqueuedItem.runId).toBe('run-01test');
+    }
+  });
+
+  it('does not return batch failures on success', async () => {
+    const workItem = { type: 'PACKAGE_MANUSCRIPT' as const, projectId: 'proj-123' };
+    const event = makeEvent([makeRecord(workItem)]);
+
+    const result = await handler(event, {} as never, () => {});
+
+    expect(result).toBeUndefined();
+  });
+});
+
+// ---------------------------------------------------------------------------
+// Error handling
+// ---------------------------------------------------------------------------
+
+describe('PACKAGE_MANUSCRIPT — error handling', () => {
+  it('throws when PACKAGER_TASK_DEF_ARN is not set', async () => {
+    delete process.env['PACKAGER_TASK_DEF_ARN'];
+
+    const workItem = { type: 'PACKAGE_MANUSCRIPT' as const, projectId: 'proj-123' };
+    const event = makeEvent([makeRecord(workItem, 'msg-no-arn')]);
+
+    const result = await handler(event, {} as never, () => {});
+
+    expect(result).toEqual({ batchItemFailures: [{ itemIdentifier: 'msg-no-arn' }] });
+    expect(vi.mocked(launchAgentRun)).not.toHaveBeenCalled();
+  });
+
+  it('returns batch failure when project is not found', async () => {
+    mockProjectServiceMethods.get.mockResolvedValueOnce(undefined);
+
+    const workItem = { type: 'PACKAGE_MANUSCRIPT' as const, projectId: 'proj-missing' };
+    const event = makeEvent([makeRecord(workItem, 'msg-missing')]);
+
+    const result = await handler(event, {} as never, () => {});
+
+    expect(result).toEqual({ batchItemFailures: [{ itemIdentifier: 'msg-missing' }] });
+    expect(vi.mocked(launchAgentRun)).not.toHaveBeenCalled();
+  });
+
+  it('returns batch failure when launchAgentRun fails', async () => {
