@@ -19,24 +20,55 @@ export type {
   QuickTaskWorkItem,
 } from './work-items.js';
 
+export interface QueueBackend {
+  sendBatch(entries: Array<{ id: string; body: string; groupId: string }>): Promise<{ failedIds: string[] }>;
+}
+
 const BATCH_SIZE = 10;
 
-export async function enqueueWorkItems(items: WorkItem[], sqsClient: SQSClient): Promise<void> {
-  const queueUrl = process.env['SQS_QUEUE_URL'];
-  if (!queueUrl) {
-    throw new Error('SQS_QUEUE_URL environment variable is not set');
-  }
+export class SqsQueueBackend implements QueueBackend {
+  constructor(private sqsClient: SQSClient) {}
+
+  async sendBatch(entries: Array<{ id: string; body: string; groupId: string }>): Promise<{ failedIds: string[] }> {
+    const queueUrl = process.env['SQS_QUEUE_URL'];
+    if (!queueUrl) {
+      throw new Error('SQS_QUEUE_URL environment variable is not set');
+    }
 
-  for (let i = 0; i < items.length; i += BATCH_SIZE) {
-    const batch = items.slice(i, i + BATCH_SIZE);
     const command = new SendMessageBatchCommand({
       QueueUrl: queueUrl,
-      Entries: batch.map((item, index) => ({
-        Id: String(index),
-        MessageBody: JSON.stringify(item),
-        MessageGroupId: item.repoFullName,
+      Entries: entries.map((entry) => ({
+        Id: entry.id,
+        MessageBody: entry.body,
+        MessageGroupId: entry.groupId,
       })),
     });
-    await sqsClient.send(command);
+
+    await this.sqsClient.send(command);
+    return { failedIds: [] };
+  }
+}
+
+export class InMemoryQueueBackend implements QueueBackend {
+  sent: Array<{ id: string; body: string; groupId: string }> = [];
+
+  async sendBatch(entries: Array<{ id: string; body: string; groupId: string }>): Promise<{ failedIds: string[] }> {
+    this.sent.push(...entries);
+    return { failedIds: [] };
+  }
+}
+
+export async function enqueueWorkItems(items: WorkItem[], backend: QueueBackend): Promise<void> {
+  for (let i = 0; i < items.length; i += BATCH_SIZE) {
+    const batch = items.slice(i, i + BATCH_SIZE);
+    const entries = batch.map((item, index) => ({
+      id: String(index),
+      body: JSON.stringify(item),
+      groupId: item.repoFullName,
+    }));
+    const result = await backend.sendBatch(entries);
+    if (result.failedIds.length > 0) {
+      throw new RetryableError(`Failed to enqueue work items: ${result.failedIds.join(', ')}`);
+    }
   }
 }
