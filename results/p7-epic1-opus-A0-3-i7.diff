+import { WORD_COUNT_DEFAULTS } from '../config/defaults.js';
+import type { ProjectType } from '../config/schemas.js';
+import type { WordCountStage } from './types.js';
+
+/**
+ * Tolerance around the per-chapter target, by stage. The writer is held to the
+ * tightest band because it is cheap to retry a draft; the merge gate is the
+ * loosest because rejecting there costs a full revision round.
+ */
+const STAGE_TOLERANCES: Record<WordCountStage, number> = {
+  writer: 0.05,
+  review: 0.1,
+  merge: 0.2,
+};
+
+/** Per-chapter word count target derived from the project's overall target. */
+export function resolveChapterTarget(params: {
+  targetWordCount: number;
+  chapterCount: number;
+}): number {
+  const { targetWordCount, chapterCount } = params;
+  if (chapterCount <= 0) {
+    throw new Error(`chapterCount must be greater than 0, got: ${chapterCount}`);
+  }
+  return Math.floor(targetWordCount / chapterCount);
+}
+
+/** Fractional tolerance applied around the per-chapter target at `stage`. */
+export function resolveTolerance(stage: WordCountStage): number {
+  return STAGE_TOLERANCES[stage];
+}
+
+/** Tolerance rendered for agent prompt prose, e.g. `±10%`. */
+export function formatToleranceForPrompt(stage: WordCountStage): string {
+  return `±${Math.round(resolveTolerance(stage) * 100)}%`;
+}
+
+/** Acceptable word count band around the per-chapter target at `stage`. */
+export function resolveWordCountRange(params: {
+  targetWordCount: number;
+  chapterCount: number;
+  stage: WordCountStage;
+}): { min: number; max: number } {
+  const { stage, ...target } = params;
+  const chapterTarget = resolveChapterTarget(target);
+  const tolerance = resolveTolerance(stage);
+  return {
+    min: Math.floor(chapterTarget * (1 - tolerance)),
+    max: Math.ceil(chapterTarget * (1 + tolerance)),
+  };
+}
+
+/**
+ * Clamps both endpoints of `range` into the project type's per-chapter band.
+ * Clamping both — rather than only raising `min` and only lowering `max` —
+ * keeps the result a valid range: a band lying entirely outside the project
+ * type's band collapses onto the nearer bound instead of inverting.
+ */
+export function clampToProjectType(params: {
+  range: { min: number; max: number };
+  projectType: ProjectType;
+}): { min: number; max: number } {
+  const { range, projectType } = params;
+  const { chapterMin, chapterMax } = WORD_COUNT_DEFAULTS[projectType];
+  return {
+    min: Math.min(Math.max(range.min, chapterMin), chapterMax),
+    max: Math.min(Math.max(range.max, chapterMin), chapterMax),
+  };
+}
