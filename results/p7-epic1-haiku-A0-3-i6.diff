+
+  it('creates an agent run record with status RUNNING and workerType marketer', async () => {
+    const workItem = { type: 'GENERATE_LISTING' as const, projectId: 'proj-123' };
+    const event = makeEvent([makeRecord(workItem)]);
+
+    await handler(event, {} as never, () => {});
+
+    expect(mockAgentRunServiceMethods.create).toHaveBeenCalledOnce();
+    const [runItem] = mockAgentRunServiceMethods.create.mock.calls[0]!;
+    expect(runItem.projectId).toBe('proj-123');
+    expect(runItem.taskArn).toBe('arn:aws:ecs:us-east-1:123:task/test/xyz789');
+    expect(runItem.workerType).toBe('marketer');
+    expect(runItem.status).toBe('RUNNING');
