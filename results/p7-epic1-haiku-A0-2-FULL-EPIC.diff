+    const clamped = clampToProjectType({
+      range,
+      projectType: ProjectType.NOVEL,
+    });
+    // NOVEL: chapterMin=3000, chapterMax=5000
+    // min = min(max(6000, 3000), 5000) = min(6000, 5000) = 5000
+    // max = min(max(8000, 3000), 5000) = min(8000, 5000) = 5000
+    expect(clamped.min).toBe(5000);
+    expect(clamped.max).toBe(5000);
+  });
+
+  it('preserves range when already within bounds', () => {
+    const range = { min: 3500, max: 4500 };
+    const clamped = clampToProjectType({
+      range,
+      projectType: ProjectType.NOVEL,
+    });
+    expect(clamped.min).toBe(3500);
+    expect(clamped.max).toBe(4500);
+  });
+
+  it('works with NOVELLA projectType', () => {
+    const range = { min: 1000, max: 5000 };
+    const clamped = clampToProjectType({
+      range,
+      projectType: ProjectType.NOVELLA,
+    });
+    // NOVELLA: chapterMin=2500, chapterMax=4000
+    expect(clamped.min).toBe(2500);
+    expect(clamped.max).toBe(4000);
+  });
+
+  it('works with SHORT_STORY_COLLECTION projectType', () => {
+    const range = { min: 2000, max: 9000 };
+    const clamped = clampToProjectType({
+      range,
+      projectType: ProjectType.SHORT_STORY_COLLECTION,
+    });
+    // SHORT_STORY_COLLECTION: chapterMin=3000, chapterMax=8000
+    expect(clamped.min).toBe(3000);
+    expect(clamped.max).toBe(8000);
+  });
+
+  it('works with NON_FICTION projectType', () => {
+    const range = { min: 2000, max: 7000 };
+    const clamped = clampToProjectType({
+      range,
+      projectType: ProjectType.NON_FICTION,
+    });
+    // NON_FICTION: chapterMin=3000, chapterMax=6000
+    expect(clamped.min).toBe(3000);
+    expect(clamped.max).toBe(6000);
+  });
+
+  it('throws on unknown projectType', () => {
+    expect(() => {
+      clampToProjectType({
+        range: { min: 1000, max: 5000 },
+        projectType: 'UNKNOWN' as ProjectType,
+      });
+    }).toThrow('Unknown projectType');
+  });
+});
