diff --git a/packages/core/src/writing/__tests__/writing.test.ts b/packages/core/src/writing/__tests__/writing.test.ts
index f2bc211..cedcf4c 100644
--- a/packages/core/src/writing/__tests__/writing.test.ts
+++ b/packages/core/src/writing/__tests__/writing.test.ts
@@ -275,6 +275,63 @@ describe('validateWordCount', () => {
     expect(result.wordCount).toBe(0);
     expect(result.valid).toBe(true);
   });
+
+  it('legacy mode behaves exactly as default (no mode specified)', () => {
+    const text = 'hello world 123 fire—and—forget 3.14';
+    const resultDefault = validateWordCount(text, { min: 0, max: 100 });
+    const resultLegacy = validateWordCount(text, { min: 0, max: 100 }, { mode: 'legacy' });
+    expect(resultLegacy).toEqual(resultDefault);
+  });
+
+  describe('strict mode', () => {
+    it('treats em-dashes as word separators', () => {
+      const result = validateWordCount('fire—and—forget', { min: 0, max: 100 }, { mode: 'strict' });
+      expect(result.wordCount).toBe(3);
+    });
+
+    it('excludes pure-number tokens', () => {
+      const result = validateWordCount('hello 123 world', { min: 0, max: 100 }, { mode: 'strict' });
+      expect(result.wordCount).toBe(2);
+    });
+
+    it('excludes decimal numbers', () => {
+      const result = validateWordCount('version 3.14 pi', { min: 0, max: 100 }, { mode: 'strict' });
+      expect(result.wordCount).toBe(2);
+    });
+
+    it('excludes comma-separated numbers', () => {
+      const result = validateWordCount('population 1,000 people', { min: 0, max: 100 }, { mode: 'strict' });
+      expect(result.wordCount).toBe(2);
+    });
+
+    it('counts alphanumeric tokens with numbers as words', () => {
+      const result = validateWordCount('version 3rd item v2', { min: 0, max: 100 }, { mode: 'strict' });
+      expect(result.wordCount).toBe(4);
+    });
+
+    it('keeps hyphenated compounds as one word', () => {
+      const result = validateWordCount('state-of-the-art technology', { min: 0, max: 100 }, { mode: 'strict' });
+      expect(result.wordCount).toBe(2);
+    });
+
+    it('combines em-dash separation with number exclusion', () => {
+      const result = validateWordCount('fire—100—forget', { min: 0, max: 100 }, { mode: 'strict' });
+      expect(result.wordCount).toBe(2);
+    });
+
+    it('strips markdown before applying strict rules', () => {
+      const text = '**bold 123** and *italic text*';
+      const result = validateWordCount(text, { min: 0, max: 100 }, { mode: 'strict' });
+      // "bold 123 and italic text" → "bold and italic text" (123 excluded)
+      expect(result.wordCount).toBe(4);
+    });
+
+    it('returns deviation correctly with strict mode', () => {
+      const result = validateWordCount('hello world test', { min: 5, max: 10 }, { mode: 'strict' });
+      expect(result.valid).toBe(false);
+      expect(result.deviation).toBe(-2);
+    });
+  });
 });
 
