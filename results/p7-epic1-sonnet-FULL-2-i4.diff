@@ -0,0 +1,76 @@
+import { ProjectType } from '../config/schemas.js';
+import { buildSharedPreamble } from './shared.js';
+
+export interface PackagerPromptParams {
+  title: string;
+  repoName: string;
+  chapterCount: number;
+  projectType?: ProjectType | undefined;
+}
+
+function buildFictionPackagingNotes(): string {
+  return `Combine the chapters into a single reading copy. Keep the prose exactly as written — this is an assembly step, not an editorial pass.`;
+}
+
+function buildNonFictionPackagingNotes(): string {
+  return `Combine the chapters into a single reading copy. Keep the reported prose and citations exactly as written — this is an assembly step, not an editorial or fact-checking pass.`;
+}
+
+export function buildPackagerPrompt(params: PackagerPromptParams): string {
+  const { title, repoName, chapterCount, projectType } = params;
+  const isNonFiction = projectType === ProjectType.NON_FICTION;
+
+  const packagingNotes = isNonFiction
+    ? buildNonFictionPackagingNotes()
+    : buildFictionPackagingNotes();
+
+  const roleIntro = `You are the Packager agent for the project **"${title}"**. Every chapter has been written, reviewed, merged, audited, and fixed — your job is to assemble the finished manuscript and produce a release manifest so the book is ready for the final review and publishing steps that follow.`;
+
+  return `# Packager Agent — System Prompt
+
+${roleIntro}
+
+${buildSharedPreamble()}
+
+## Context
+
+- **Repository**: ${repoName}
+- **Total chapters**: ${chapterCount}
+- **Source**: all chapters have been merged to the \`main\` branch at \`manuscript/chapter-NN.md\`.
+
+## Your Task
+
+${packagingNotes}
+
+### 1. Assemble \`manuscript/manuscript.md\`
+
+Read every chapter file from \`manuscript/chapter-01.md\` through \`manuscript/chapter-${String(chapterCount).padStart(2, '0')}.md\`, in chapter-number order, and concatenate them into a single file at \`manuscript/manuscript.md\`. Separate consecutive chapters with a single blank line. Do not alter chapter headings, wording, or formatting — copy the content verbatim.
+
+### 2. Write \`release/manifest.json\`
+
+Create \`release/manifest.json\` describing the release. Include at minimum:
+
+\`\`\`json
+{
+  "title": "${title}",
+  "chapterCount": ${chapterCount},
+  "chapters": [
+    { "number": 1, "file": "manuscript/chapter-01.md", "title": "..." }
+  ],
+  "manuscriptFile": "manuscript/manuscript.md",
+  "generatedAt": "{ISO timestamp}"
+}
+\`\`\`
+
+Populate \`chapters[].title\` from each chapter's \`# Chapter N: Title\` heading. Use the current time for \`generatedAt\`.
+
+### 3. Commit and Push
+
+\`\`\`
+git add manuscript/manuscript.md release/manifest.json
+git commit -m "package manuscript for release"
+git push
+\`\`\`
+
+Do not create or modify any other files. \`manuscript/manuscript.md\` and \`release/manifest.json\` are the only paths this run may write to, in addition to the shared conventions above.`;
+}
