@@ -0,0 +1,138 @@
+import { describe, it, expect } from 'vitest';
+import {
+  resolveChapterTarget,
+  resolveWordCountRange,
+  resolveTolerance,
+  formatToleranceForPrompt,
+  clampToProjectType,
+} from '../index.js';
+import { ProjectType } from '../../config/schemas.js';
+import type { WordCountStage } from '../index.js';
+
+const STAGES: WordCountStage[] = ['writer', 'review', 'merge'];
+
+describe('resolveChapterTarget', () => {
+  it('divides the project target evenly across chapters', () => {
+    expect(resolveChapterTarget({ targetWordCount: 90000, chapterCount: 3 })).toBe(30000);
+  });
+
+  it('rounds down when the division is not exact', () => {
+    expect(resolveChapterTarget({ targetWordCount: 100000, chapterCount: 30 })).toBe(3333);
+  });
+
+  it('throws when chapterCount is zero', () => {
+    expect(() => resolveChapterTarget({ targetWordCount: 90000, chapterCount: 0 })).toThrow(
+      /chapterCount/,
+    );
+  });
+
+  it('throws when chapterCount is negative', () => {
+    expect(() => resolveChapterTarget({ targetWordCount: 90000, chapterCount: -3 })).toThrow(
+      /chapterCount/,
+    );
+  });
+});
+
+describe('resolveTolerance', () => {
+  it('returns 5% for the writer stage', () => {
+    expect(resolveTolerance('writer')).toBe(0.05);
+  });
+
+  it('returns 10% for the review stage', () => {
+    expect(resolveTolerance('review')).toBe(0.1);
+  });
+
+  it('returns 20% for the merge stage', () => {
+    expect(resolveTolerance('merge')).toBe(0.2);
+  });
+});
+
+describe('formatToleranceForPrompt', () => {
+  it('renders each stage tolerance as prompt prose', () => {
+    expect(formatToleranceForPrompt('writer')).toBe('±5%');
+    expect(formatToleranceForPrompt('review')).toBe('±10%');
+    expect(formatToleranceForPrompt('merge')).toBe('±20%');
+  });
+});
+
+describe('resolveWordCountRange', () => {
+  it('bands the writer stage at ±5% of the chapter target', () => {
+    expect(resolveWordCountRange({ targetWordCount: 90000, chapterCount: 3, stage: 'writer' }))
+      .toEqual({ min: 28500, max: 31500 });
+  });
+
+  it('bands the review stage at ±10% of the chapter target', () => {
+    expect(resolveWordCountRange({ targetWordCount: 90000, chapterCount: 3, stage: 'review' }))
+      .toEqual({ min: 27000, max: 33000 });
+  });
+
+  it('bands the merge stage at ±20% of the chapter target', () => {
+    expect(resolveWordCountRange({ targetWordCount: 90000, chapterCount: 3, stage: 'merge' }))
+      .toEqual({ min: 24000, max: 36000 });
+  });
+
+  it('floors the minimum and ceils the maximum for every stage', () => {
+    // 3333 per chapter: writer bounds are 3166.35 and 3499.65.
+    for (const stage of STAGES) {
+      const tolerance = resolveTolerance(stage);
+      const range = resolveWordCountRange({ targetWordCount: 100000, chapterCount: 30, stage });
+      expect(range.min).toBe(Math.floor(3333 * (1 - tolerance)));
+      expect(range.max).toBe(Math.ceil(3333 * (1 + tolerance)));
+    }
+    expect(resolveWordCountRange({ targetWordCount: 100000, chapterCount: 30, stage: 'writer' }))
+      .toEqual({ min: 3166, max: 3500 });
+  });
+
+  it('throws when chapterCount is zero', () => {
+    expect(() =>
+      resolveWordCountRange({ targetWordCount: 90000, chapterCount: 0, stage: 'merge' }),
+    ).toThrow(/chapterCount/);
+  });
+});
+
+describe('clampToProjectType', () => {
+  it('leaves a range already inside the project type band untouched', () => {
+    expect(
+      clampToProjectType({ range: { min: 3200, max: 4800 }, projectType: ProjectType.NOVEL }),
+    ).toEqual({ min: 3200, max: 4800 });
+  });
+
+  it('raises a minimum below the project type floor', () => {
+    expect(
+      clampToProjectType({ range: { min: 2880, max: 4320 }, projectType: ProjectType.NOVEL }),
+    ).toEqual({ min: 3000, max: 4320 });
+  });
+
+  it('lowers a maximum above the project type ceiling', () => {
+    expect(
+      clampToProjectType({ range: { min: 3500, max: 7000 }, projectType: ProjectType.NOVEL }),
+    ).toEqual({ min: 3500, max: 5000 });
+  });
+
+  it('collapses a range entirely above the band onto the ceiling', () => {
+    const clamped = clampToProjectType({
+      range: { min: 24000, max: 36000 },
+      projectType: ProjectType.NOVEL,
+    });
+    expect(clamped).toEqual({ min: 5000, max: 5000 });
+    expect(clamped.min).toBeLessThanOrEqual(clamped.max);
+  });
+
+  it('collapses a range entirely below the band onto the floor', () => {
+    const clamped = clampToProjectType({
+      range: { min: 240, max: 360 },
+      projectType: ProjectType.NOVEL,
+    });
+    expect(clamped).toEqual({ min: 3000, max: 3000 });
+    expect(clamped.min).toBeLessThanOrEqual(clamped.max);
+  });
+
+  it('uses the band of the given project type', () => {
+    expect(
+      clampToProjectType({ range: { min: 240, max: 360 }, projectType: ProjectType.NOVELLA }),
+    ).toEqual({ min: 2500, max: 2500 });
+    expect(
+      clampToProjectType({ range: { min: 9000, max: 12000 }, projectType: ProjectType.SHORT_STORY_COLLECTION }),
+    ).toEqual({ min: 8000, max: 8000 });
+  });
+});
