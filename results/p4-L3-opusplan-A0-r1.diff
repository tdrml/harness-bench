+  it('findTaskByPrNumber scans with FilterExpression on prNumber', async () => {
+    const task = makeTask({ taskId: 'task-pr', prNumber: 42 });
+    const client = makeClient(() => ({ Items: [task] }));
+    const svc = new TaskGraphsService(client);
+    const result = await svc.findTaskByPrNumber(42);
+    expect(result).toEqual(task);
