@@ -0,0 +1,148 @@
+import { describe, it, expect } from 'vitest';
+import {
+  resolveChapterTarget,
+  resolveTolerance,
+  resolveWordCountRange,
+  formatToleranceForPrompt,
+  clampToProjectType,
+} from '../resolve.js';
+import { ProjectType } from '../../config/schemas.js';
+
+describe('word-count-policy', () => {
+  describe('resolveChapterTarget', () => {
+    it('calculates floor of targetWordCount / chapterCount', () => {
+      expect(resolveChapterTarget({ targetWordCount: 90000, chapterCount: 3 })).toBe(30000);
+      expect(resolveChapterTarget({ targetWordCount: 100000, chapterCount: 7 })).toBe(14285);
+    });
+
+    it('throws when chapterCount is 0 or negative', () => {
+      expect(() =>
+        resolveChapterTarget({ targetWordCount: 90000, chapterCount: 0 }),
+      ).toThrow('chapterCount must be positive');
+      expect(() =>
+        resolveChapterTarget({ targetWordCount: 90000, chapterCount: -5 }),
+      ).toThrow('chapterCount must be positive');
+    });
+  });
+
+  describe('resolveTolerance', () => {
+    it('returns 0.05 for writer stage', () => {
+      expect(resolveTolerance('writer')).toBe(0.05);
+    });
+
+    it('returns 0.10 for review stage', () => {
+      expect(resolveTolerance('review')).toBe(0.10);
+    });
+
+    it('returns 0.20 for merge stage', () => {
+      expect(resolveTolerance('merge')).toBe(0.20);
+    });
+  });
+
+  describe('resolveWordCountRange', () => {
+    it('applies writer tolerance (±5%) correctly', () => {
+      const result = resolveWordCountRange({
+        targetWordCount: 30000,
+        chapterCount: 1,
+        stage: 'writer',
+      });
+      expect(result.min).toBe(28500);
+      expect(result.max).toBe(31500);
+    });
+
+    it('applies review tolerance (±10%) correctly', () => {
+      const result = resolveWordCountRange({
+        targetWordCount: 30000,
+        chapterCount: 1,
+        stage: 'review',
+      });
+      expect(result.min).toBe(27000);
+      expect(result.max).toBe(33000);
+    });
+
+    it('applies merge tolerance (±20%) correctly', () => {
+      const result = resolveWordCountRange({
+        targetWordCount: 30000,
+        chapterCount: 1,
+        stage: 'merge',
+      });
+      expect(result.min).toBe(24000);
+      expect(result.max).toBe(36000);
+    });
+
+    it('uses ceil for max to handle rounding up', () => {
+      // Test that max rounds up: 31500 should ceil to 31500
+      const result = resolveWordCountRange({
+        targetWordCount: 30000,
+        chapterCount: 1,
+        stage: 'writer',
+      });
+      expect(result.max).toBe(31500);
+    });
+  });
+
+  describe('formatToleranceForPrompt', () => {
+    it('formats writer tolerance as ±5%', () => {
+      expect(formatToleranceForPrompt('writer')).toBe('±5%');
+    });
+
+    it('formats review tolerance as ±10%', () => {
+      expect(formatToleranceForPrompt('review')).toBe('±10%');
+    });
+
+    it('formats merge tolerance as ±20%', () => {
+      expect(formatToleranceForPrompt('merge')).toBe('±20%');
+    });
+  });
+
+  describe('clampToProjectType', () => {
+    it('clamps range to project type bounds (NOVEL)', () => {
+      const result = clampToProjectType({
+        range: { min: 24000, max: 36000 },
+        projectType: ProjectType.NOVEL,
+      });
+      // NOVEL: chapterMin: 3000, chapterMax: 5000
+      expect(result.min).toBe(5000);
+      expect(result.max).toBe(5000);
+    });
+
+    it('keeps range unchanged when within bounds', () => {
+      const result = clampToProjectType({
+        range: { min: 3500, max: 4500 },
+        projectType: ProjectType.NOVEL,
+      });
+      expect(result.min).toBe(3500);
+      expect(result.max).toBe(4500);
+    });
+
+    it('raises min when below bounds', () => {
+      const result = clampToProjectType({
+        range: { min: 2000, max: 4500 },
+        projectType: ProjectType.NOVEL,
+      });
+      expect(result.min).toBe(3000);
+      expect(result.max).toBe(4500);
+    });
+
+    it('lowers max when above bounds', () => {
+      const result = clampToProjectType({
+        range: { min: 3500, max: 6000 },
+        projectType: ProjectType.NOVEL,
+      });
+      expect(result.min).toBe(3500);
+      expect(result.max).toBe(5000);
+    });
+
+    it('clamps both endpoints for NOVELLA', () => {
+      const result = clampToProjectType({
+        range: { min: 1000, max: 6000 },
+        projectType: ProjectType.NOVELLA,
+      });
+      // NOVELLA: chapterMin: 2500, chapterMax: 4000
+      // min: max(1000, 2500) = 2500; min(2500, 4000) = 2500
+      // max: max(6000, 2500) = 6000; min(6000, 4000) = 4000
+      expect(result.min).toBe(2500);
+      expect(result.max).toBe(4000);
+    });
+  });
+});
