+import { describe, it, expect } from 'vitest';
+import {
+  resolveChapterTarget,
+  resolveWordCountRange,
+  resolveTolerance,
+  formatToleranceForPrompt,
+  clampToProjectType,
+} from '../resolve.js';
+import { ProjectType } from '../../config/schemas.js';
+
+describe('word-count-policy', () => {
+  describe('resolveChapterTarget', () => {
+    it('computes target per chapter', () => {
+      const result = resolveChapterTarget({
+        targetWordCount: 90000,
+        chapterCount: 30,
+      });
+      expect(result).toBe(3000);
+    });
+
+    it('floors the result', () => {
+      const result = resolveChapterTarget({
+        targetWordCount: 100000,
+        chapterCount: 3,
+      });
+      expect(result).toBe(33333);
+    });
+
+    it('throws if chapterCount is 0', () => {
+      expect(() =>
+        resolveChapterTarget({
+          targetWordCount: 90000,
+          chapterCount: 0,
+        }),
+      ).toThrow('chapterCount must be positive');
+    });
+
+    it('throws if chapterCount is negative', () => {
+      expect(() =>
+        resolveChapterTarget({
+          targetWordCount: 90000,
+          chapterCount: -5,
+        }),
+      ).toThrow('chapterCount must be positive');
+    });
+  });
+
+  describe('resolveTolerance', () => {
+    it('returns 0.05 for writer stage', () => {
+      expect(resolveTolerance('writer')).toBe(0.05);
+    });
+
+    it('returns 0.10 for review stage', () => {
+      expect(resolveTolerance('review')).toBe(0.10);
+    });
+
+    it('returns 0.20 for merge stage', () => {
+      expect(resolveTolerance('merge')).toBe(0.20);
+    });
+  });
+
+  describe('formatToleranceForPrompt', () => {
+    it('returns ±5% for writer stage', () => {
+      expect(formatToleranceForPrompt('writer')).toBe('±5%');
+    });
+
+    it('returns ±10% for review stage', () => {
+      expect(formatToleranceForPrompt('review')).toBe('±10%');
+    });
+
+    it('returns ±20% for merge stage', () => {
+      expect(formatToleranceForPrompt('merge')).toBe('±20%');
+    });
+  });
+
+  describe('resolveWordCountRange', () => {
+    it('creates range with floor/ceil for writer stage', () => {
+      const result = resolveWordCountRange({
+        targetWordCount: 90000,
+        chapterCount: 30,
+        stage: 'writer',
+      });
+      const target = 3000;
+      const tolerance = 0.05;
+      expect(result).toEqual({
+        min: Math.floor(target * (1 - tolerance)),
+        max: Math.ceil(target * (1 + tolerance)),
+      });
+      expect(result).toEqual({
+        min: 2850,
+        max: 3150,
+      });
+    });
+
+    it('creates range with floor/ceil for review stage', () => {
+      const result = resolveWordCountRange({
+        targetWordCount: 90000,
+        chapterCount: 30,
+        stage: 'review',
+      });
+      const target = 3000;
+      const tolerance = 0.10;
+      expect(result.min).toBe(Math.floor(target * (1 - tolerance)));
+      expect(result.max).toBe(Math.ceil(target * (1 + tolerance)));
+      expect(result.min).toBe(2700);
+    });
+
+    it('creates range with floor/ceil for merge stage', () => {
+      const result = resolveWordCountRange({
+        targetWordCount: 90000,
+        chapterCount: 30,
+        stage: 'merge',
+      });
+      const target = 3000;
+      const tolerance = 0.20;
+      expect(result).toEqual({
+        min: Math.floor(target * (1 - tolerance)),
+        max: Math.ceil(target * (1 + tolerance)),
+      });
+      expect(result).toEqual({
+        min: 2400,
+        max: 3600,
+      });
+    });
+  });
+
+  describe('clampToProjectType', () => {
+    it('clamps range within project type bounds', () => {
+      const result = clampToProjectType({
+        range: { min: 2000, max: 4000 },
+        projectType: ProjectType.NOVEL,
+      });
+      expect(result.min).toBeGreaterThanOrEqual(3000);
+      expect(result.max).toBeLessThanOrEqual(5000);
+    });
+
+    it('expands min if below chapterMin', () => {
+      const result = clampToProjectType({
+        range: { min: 2000, max: 4000 },
+        projectType: ProjectType.NOVEL,
+      });
+      expect(result.min).toBe(3000);
+    });
+
+    it('reduces max if above chapterMax', () => {
+      const result = clampToProjectType({
+        range: { min: 4000, max: 6000 },
+        projectType: ProjectType.NOVEL,
+      });
+      expect(result.max).toBe(5000);
+    });
+
+    it('collapses range entirely outside bounds to near bound', () => {
+      const result = clampToProjectType({
+        range: { min: 1000, max: 2000 },
+        projectType: ProjectType.NOVEL,
+      });
+      expect(result.min).toBe(3000);
+      expect(result.max).toBe(3000);
+    });
+
+    it('works with NOVELLA project type', () => {
+      const result = clampToProjectType({
+        range: { min: 2000, max: 4500 },
+        projectType: ProjectType.NOVELLA,
+      });
+      expect(result.min).toBeGreaterThanOrEqual(2500);
+      expect(result.max).toBeLessThanOrEqual(4000);
+    });
+
+    it('throws for unknown project type', () => {
+      expect(() =>
+        clampToProjectType({
+          range: { min: 2000, max: 4000 },
+          projectType: 'UNKNOWN' as ProjectType,
+        }),
+      ).toThrow();
+    });
+  });
+});
