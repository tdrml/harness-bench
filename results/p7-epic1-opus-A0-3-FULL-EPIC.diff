+import { describe, it, expect } from 'vitest';
+import {
+  validateListing,
+  validateManuscriptStructure,
+  MAX_BLURB_LENGTH,
+  REQUIRED_KEYWORD_COUNT,
+  REQUIRED_CATEGORY_COUNT,
+  ALLOWED_BLURB_TAGS,
+} from '../index.js';
+import type { ChapterFile, KdpListing } from '../index.js';
+import { getChapterFilePath } from '../../writing/paths.js';
+
+function makeListing(overrides: Partial<KdpListing> = {}): KdpListing {
+  return {
+    title: 'The Long Way Down',
+    subtitle: 'A Novel',
+    blurb: '<b>She had one night to disappear.</b><br><br>And someone was already waiting.',
+    keywords: Array.from({ length: REQUIRED_KEYWORD_COUNT }, (_, i) => `keyword phrase ${i + 1}`),
+    categories: Array.from({ length: REQUIRED_CATEGORY_COUNT }, () => 'Fiction > Thrillers > Psychological'),
+    author: 'A. N. Author',
+    ...overrides,
+  };
+}
+
+function codes(listing: KdpListing): string[] {
+  return validateListing(listing).errors.map((e) => e.code);
+}
+
+describe('validateListing', () => {
+  it('accepts a well-formed listing', () => {
+    const result = validateListing(makeListing());
+    expect(result.valid).toBe(true);
+    expect(result.errors).toEqual([]);
+  });
+
+  it('accepts a listing without a subtitle', () => {
+    expect(validateListing(makeListing({ subtitle: undefined })).valid).toBe(true);
+  });
+
+  describe('blurb length', () => {
+    it('accepts a blurb of exactly the maximum length', () => {
+      expect(codes(makeListing({ blurb: 'x'.repeat(MAX_BLURB_LENGTH) }))).toEqual([]);
+    });
+
+    it('reports BLURB_TOO_LONG one character over the maximum', () => {
+      expect(codes(makeListing({ blurb: 'x'.repeat(MAX_BLURB_LENGTH + 1) }))).toEqual(['BLURB_TOO_LONG']);
+    });
+  });
+
+  describe('empty blurb', () => {
+    it('reports BLURB_EMPTY for an empty blurb', () => {
+      expect(codes(makeListing({ blurb: '' }))).toEqual(['BLURB_EMPTY']);
+    });
+
+    it('reports BLURB_EMPTY for a whitespace-only blurb', () => {
+      expect(codes(makeListing({ blurb: '  \n\t ' }))).toEqual(['BLURB_EMPTY']);
+    });
+  });
+
+  describe('keyword count', () => {
+    it('reports KEYWORD_COUNT when there are too few keywords', () => {
+      expect(codes(makeListing({ keywords: ['one', 'two'] }))).toEqual(['KEYWORD_COUNT']);
+    });
+
+    it('reports KEYWORD_COUNT when there are too many keywords', () => {
+      const keywords = Array.from({ length: REQUIRED_KEYWORD_COUNT + 1 }, (_, i) => `kw ${i}`);
+      expect(codes(makeListing({ keywords }))).toEqual(['KEYWORD_COUNT']);
+    });
+  });
+
+  describe('category count', () => {
+    it('reports CATEGORY_COUNT when there are too few categories', () => {
+      expect(codes(makeListing({ categories: ['Fiction > Thrillers'] }))).toEqual(['CATEGORY_COUNT']);
+    });
+
+    it('reports CATEGORY_COUNT when there are too many categories', () => {
+      const categories = Array.from({ length: REQUIRED_CATEGORY_COUNT + 1 }, () => 'Fiction > Thrillers');
+      expect(codes(makeListing({ categories }))).toEqual(['CATEGORY_COUNT']);
+    });
+  });
+
+  describe('unresolved placeholders', () => {
+    it('reports UNRESOLVED_PLACEHOLDER for a placeholder in the title', () => {
+      expect(codes(makeListing({ title: 'TODO: pick a title' }))).toEqual(['UNRESOLVED_PLACEHOLDER']);
+    });
+
+    it('reports UNRESOLVED_PLACEHOLDER for a placeholder in the subtitle', () => {
+      expect(codes(makeListing({ subtitle: 'TODO: subtitle' }))).toEqual(['UNRESOLVED_PLACEHOLDER']);
+    });
+
+    it('reports UNRESOLVED_PLACEHOLDER for a placeholder in the author', () => {
+      expect(codes(makeListing({ author: 'TODO: pen name' }))).toEqual(['UNRESOLVED_PLACEHOLDER']);
+    });
+
+    it('reports UNRESOLVED_PLACEHOLDER for a placeholder in a keyword', () => {
+      const keywords = makeListing().keywords;
+      keywords[3] = 'TODO: research this slot';
+      expect(codes(makeListing({ keywords }))).toEqual(['UNRESOLVED_PLACEHOLDER']);
+    });
+
+    it('reports UNRESOLVED_PLACEHOLDER for a placeholder in a category', () => {
+      const categories = makeListing().categories;
+      categories[0] = 'TODO: category';
+      expect(codes(makeListing({ categories }))).toEqual(['UNRESOLVED_PLACEHOLDER']);
+    });
+
+    it('reports UNRESOLVED_PLACEHOLDER only once across many fields', () => {
+      const result = validateListing(
+        makeListing({
+          title: 'TODO: title',
+          author: 'TODO: author',
+          blurb: 'TODO: write the blurb',
+          keywords: Array.from({ length: REQUIRED_KEYWORD_COUNT }, () => 'TODO: keyword'),
+        }),
+      );
+      expect(result.errors.filter((e) => e.code === 'UNRESOLVED_PLACEHOLDER')).toHaveLength(1);
+    });
+
+    it('ignores the word TODO without a colon', () => {
+      expect(codes(makeListing({ title: 'A TODO List for the Damned' }))).toEqual([]);
+    });
+  });
+
+  describe('blurb HTML', () => {
+    it('accepts every allowed tag, opening and closing', () => {
+      const blurb = ALLOWED_BLURB_TAGS.map((tag) => `<${tag}>text</${tag}>`).join('');
+      expect(codes(makeListing({ blurb }))).toEqual([]);
+    });
+
+    it('accepts allowed tags in mixed case', () => {
+      expect(codes(makeListing({ blurb: '<B>Bold</B><BR><I>Italic</I>' }))).toEqual([]);
+    });
+
+    it('reports DISALLOWED_HTML for a tag outside the allowlist', () => {
+      expect(codes(makeListing({ blurb: '<div>Hook</div>' }))).toEqual(['DISALLOWED_HTML']);
+    });
+
+    it('treats a disallowed closing tag as the same tag', () => {
+      expect(codes(makeListing({ blurb: 'Hook</span>' }))).toEqual(['DISALLOWED_HTML']);
+    });
+
+    it('matches disallowed tags case-insensitively', () => {
+      expect(codes(makeListing({ blurb: '<SPAN>Hook</SPAN>' }))).toEqual(['DISALLOWED_HTML']);
+    });
+
+    it('reports DISALLOWED_HTML for a tag with attributes', () => {
+      const result = validateListing(makeListing({ blurb: '<a href="https://example.com">Buy</a>' }));
+      expect(result.errors.map((e) => e.code)).toEqual(['DISALLOWED_HTML']);
+      expect(result.errors[0]?.detail).toContain('a');
+    });
+
+    it('reports DISALLOWED_HTML only once for several offending tags', () => {
+      const result = validateListing(makeListing({ blurb: '<div><span>Hook</span></div><h1>Title</h1>' }));
+      expect(result.errors).toHaveLength(1);
+      expect(result.errors[0]?.detail).toContain('div');
+      expect(result.errors[0]?.detail).toContain('span');
+      expect(result.errors[0]?.detail).toContain('h1');
+    });
+
+    it('does not flag a bare angle bracket', () => {
+      expect(codes(makeListing({ blurb: 'Escape < the room, cost > everything.' }))).toEqual([]);
+    });
+  });
