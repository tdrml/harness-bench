+    expect(outputItem.contentLength).toBe('do the thing'.length);
+  });
+
+  it('launches the ECS task with the standard environment merged with extraEnv', async () => {
+    await launchAgentRun({
+      taskDefArn: 'arn:aws:ecs:us-east-1:123:task-definition/writer:1',
+      workerType: 'writer',
+      systemPrompt: 'do the thing',
+      projectId: 'proj-1',
+      repoName: 'the-dark-tower',
+      extraEnv: { CHAPTER_NUMBER: '1', BRANCH_NAME: 'chapter-01' },
+      config,
+      agentRunService: mockAgentRunService as unknown as AgentRunService,
+      taskOutputService: mockTaskOutputService as unknown as TaskOutputService,
+    });
+
+    expect(vi.mocked(launchECSTask)).toHaveBeenCalledOnce();
+    const [params] = vi.mocked(launchECSTask).mock.calls[0]!;
+    expect(params.taskDefinition).toBe('arn:aws:ecs:us-east-1:123:task-definition/writer:1');
+    expect(params.command).toEqual(['claude', '-p', '$SYSTEM_PROMPT']);
+    expect(params.environment['PROJECT_ID']).toBe('proj-1');
+    expect(params.environment['REPO_NAME']).toBe('the-dark-tower');
+    expect(params.environment['AWS_REGION']).toBe('us-east-1');
+    expect(params.environment['DYNAMODB_TABLE_PREFIX']).toBe('test');
+    expect(params.environment['CHAPTER_NUMBER']).toBe('1');
+    expect(params.environment['BRANCH_NAME']).toBe('chapter-01');
+    expect(typeof params.environment['RUN_ID']).toBe('string');
+  });
+
+  it('creates the agent run record with status RUNNING and no nodeId when not supplied', async () => {
+    const { runId, taskArn } = await launchAgentRun({
+      taskDefArn: 'arn:aws:ecs:us-east-1:123:task-definition/outliner:1',
+      workerType: 'outliner',
+      systemPrompt: 'outline it',
+      projectId: 'proj-1',
+      repoName: 'the-dark-tower',
+      config,
+      agentRunService: mockAgentRunService as unknown as AgentRunService,
+      taskOutputService: mockTaskOutputService as unknown as TaskOutputService,
+    });
+
+    expect(taskArn).toBe('arn:aws:ecs:us-east-1:123:task/test/abc123');
+    expect(mockAgentRunService.create).toHaveBeenCalledOnce();
+    const [runItem] = mockAgentRunService.create.mock.calls[0]!;
+    expect(runItem.runId).toBe(runId);
+    expect(runItem.projectId).toBe('proj-1');
+    expect(runItem.taskArn).toBe(taskArn);
+    expect(runItem.workerType).toBe('outliner');
+    expect(runItem.status).toBe('RUNNING');
+    expect(runItem.nodeId).toBeUndefined();
+    expect(typeof runItem.runId).toBe('string');
+    expect(runItem.runId.length).toBeGreaterThan(0);
+  });
+
+  it('includes nodeId on the agent run record when supplied', async () => {
+    await launchAgentRun({
+      taskDefArn: 'arn:aws:ecs:us-east-1:123:task-definition/writer:1',
+      workerType: 'writer',
+      systemPrompt: 'do the thing',
+      projectId: 'proj-1',
+      repoName: 'the-dark-tower',
+      nodeId: 'node-1',
+      config,
+      agentRunService: mockAgentRunService as unknown as AgentRunService,
+      taskOutputService: mockTaskOutputService as unknown as TaskOutputService,
+    });
+
+    const [runItem] = mockAgentRunService.create.mock.calls[0]!;
+    expect(runItem.nodeId).toBe('node-1');
+  });
+
+  it('uses the same runId for the task output and agent run records', async () => {
+    const { runId } = await launchAgentRun({
+      taskDefArn: 'arn:aws:ecs:us-east-1:123:task-definition/writer:1',
+      workerType: 'writer',
+      systemPrompt: 'do the thing',
+      projectId: 'proj-1',
+      repoName: 'the-dark-tower',
+      config,
+      agentRunService: mockAgentRunService as unknown as AgentRunService,
+      taskOutputService: mockTaskOutputService as unknown as TaskOutputService,
+    });
+
+    const [outputItem] = mockTaskOutputService.save.mock.calls[0]!;
+    const [runItem] = mockAgentRunService.create.mock.calls[0]!;
+    expect(outputItem.runId).toBe(runId);
+    expect(runItem.runId).toBe(runId);
+  });
+
+  it('generates a ulid-shaped run id', async () => {
+    const { runId } = await launchAgentRun({
+      taskDefArn: 'arn:aws:ecs:us-east-1:123:task-definition/writer:1',
+      workerType: 'writer',
+      systemPrompt: 'do the thing',
+      projectId: 'proj-1',
+      repoName: 'the-dark-tower',
+      config,
+      agentRunService: mockAgentRunService as unknown as AgentRunService,
+      taskOutputService: mockTaskOutputService as unknown as TaskOutputService,
+    });
+
+    expect(runId).toMatch(/^[0-9A-HJKMNP-TV-Z]{26}$/);
+  });
+
+  it('propagates failure and does not create the agent run when the ECS launch fails', async () => {
+    vi.mocked(launchECSTask).mockRejectedValueOnce(new Error('ECS error'));
+
+    await expect(
+      launchAgentRun({
+        taskDefArn: 'arn:aws:ecs:us-east-1:123:task-definition/writer:1',
+        workerType: 'writer',
+        systemPrompt: 'do the thing',
+        projectId: 'proj-1',
+        repoName: 'the-dark-tower',
+        config,
+        agentRunService: mockAgentRunService as unknown as AgentRunService,
+        taskOutputService: mockTaskOutputService as unknown as TaskOutputService,
+      }),
+    ).rejects.toThrow('ECS error');
+
+    expect(mockAgentRunService.create).not.toHaveBeenCalled();
+  });
+});
