diff --git a/packages/core/src/release-policy/validate-manuscript.ts b/packages/core/src/release-policy/validate-manuscript.ts
new file mode 100644
index 0000000..e23c5c9
--- /dev/null
+++ b/packages/core/src/release-policy/validate-manuscript.ts
@@ -0,0 +1,104 @@
+import { getChapterFilePath } from '../writing/paths.js';
+import type { ChapterFile, ManuscriptError, ManuscriptValidation } from './types.js';
+import { sortErrorsByCode } from './sort-errors.js';
+
+/** A well-formed chapter heading: `# Chapter <N>: <Title>` with a non-empty title. */
+const H1_PATTERN = /^#\s+Chapter\s+(\d+):\s+(\S.*)$/;
+
+/** Recovers the chapter number from a heading that is otherwise malformed. */
+const H1_NUMBER_PATTERN = /^#\s+Chapter\s+(\d+)/;
+
+/** Last run of digits in a path, e.g. the `07` of `manuscript/chapter-07.md`. */
+const PATH_NUMBER_PATTERN = /(\d+)(?!.*\d)/;
+
+function isHeading1(line: string): boolean {
+  return line.startsWith('#') && !line.startsWith('##');
+}
+
+/**
+ * The chapter number a path encodes, or `null` when the path is not a canonical
+ * chapter path. The convention itself is owned by `getChapterFilePath`: a
+ * candidate number counts only if the helper maps it back to this exact path.
+ */
+function chapterNumberFromPath(path: string): number | null {
+  const digits = PATH_NUMBER_PATTERN.exec(path)?.[1];
+  if (digits === undefined) {
+    return null;
+  }
+  const chapterNumber = Number(digits);
+  return getChapterFilePath(chapterNumber) === path ? chapterNumber : null;
+}
+
+export function validateManuscriptStructure(chapters: ChapterFile[]): ManuscriptValidation {
+  const errors: ManuscriptError[] = [];
+
+  for (const chapter of chapters) {
+    const lines = chapter.content.split('\n');
+    const heading = lines.find(isHeading1);
+
+    if (heading === undefined) {
+      errors.push({
+        code: 'H1_MISSING',
+        detail: `Chapter "${chapter.path}" has no level-1 heading.`,
+      });
+    }
+
+    const firstNonEmpty = lines.find((line) => line.trim().length > 0);
+    if (firstNonEmpty !== undefined && !isHeading1(firstNonEmpty)) {
+      errors.push({
+        code: 'H1_NOT_FIRST',
+        detail: `Chapter "${chapter.path}" starts with "${firstNonEmpty.trim()}" instead of its level-1 heading.`,
+      });
+    }
+
+    if (heading === undefined) {
+      continue;
+    }
+
+    const match = H1_PATTERN.exec(heading);
+    if (match === null) {
+      errors.push({
+        code: 'H1_MALFORMED',
+        detail: `Chapter "${chapter.path}" has heading "${heading.trim()}", expected "# Chapter <N>: <Title>".`,
+      });
+    }
+
+    const numbered = match ?? H1_NUMBER_PATTERN.exec(heading);
+    if (numbered !== null) {
+      const headingNumber = Number(numbered[1]!);
+      const expectedPath = getChapterFilePath(headingNumber);
+      if (expectedPath !== chapter.path) {
+        errors.push({
+          code: 'H1_NUMBER_MISMATCH',
+          detail: `Chapter "${chapter.path}" declares chapter ${headingNumber}, whose path is "${expectedPath}".`,
+        });
+      }
+    }
+  }
+
+  const numbers = chapters
+    .map((chapter) => chapterNumberFromPath(chapter.path))
+    .filter((chapterNumber): chapterNumber is number => chapterNumber !== null);
+  const unique = [...new Set(numbers)].sort((a, b) => a - b);
+
+  const duplicates = unique.filter((n) => numbers.filter((other) => other === n).length > 1);
+  if (duplicates.length > 0) {
+    errors.push({
+      code: 'CHAPTER_DUPLICATE',
+      detail: `Chapter number${duplicates.length > 1 ? 's' : ''} ${duplicates.join(', ')} appear${
+        duplicates.length > 1 ? '' : 's'
+      } more than once.`,
+    });
+  }
+
+  if (unique.some((n, index) => n !== index + 1)) {
+    errors.push({
+      code: 'CHAPTER_GAP',
+      detail: `Chapter numbers [${unique.join(', ')}] are not 1..${unique.length} without gaps.`,
+    });
+  }
+
+  sortErrorsByCode(errors);
+
+  return { valid: errors.length === 0, errors };
+}
