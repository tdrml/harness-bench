+
+    const workItem = { type: 'RECONCILE' as const, projectId: 'proj-123', runId: 'run-abc' };
+    await handler(makeEvent([makeRecord(workItem)]));
+
+    expect(mockProjectServiceMethods.updateStatus).toHaveBeenCalledWith('proj-123', 'FAILED');
+  });
+
+  it('marks the project FAILED when release/listing.json is not valid JSON', async () => {
+    mockGitHubClientMethods.getFileContent.mockResolvedValueOnce(makeFileContent('not json'));
+
+    const workItem = { type: 'RECONCILE' as const, projectId: 'proj-123', runId: 'run-abc' };
+    await handler(makeEvent([makeRecord(workItem)]));
+
+    expect(mockProjectServiceMethods.updateStatus).toHaveBeenCalledWith('proj-123', 'FAILED');
+  });
+
+  it('does not enqueue a follow-up work item', async () => {
+    mockGitHubClientMethods.getFileContent.mockResolvedValueOnce(
+      makeFileContent(JSON.stringify(validListing)),
+    );
+
+    const workItem = { type: 'RECONCILE' as const, projectId: 'proj-123', runId: 'run-abc' };
+    await handler(makeEvent([makeRecord(workItem)]));
+
+    expect(vi.mocked(enqueue)).not.toHaveBeenCalled();
+  });
+});
