+import { describe, it, expect } from 'vitest';
+import {
+  validateListing,
+  MAX_BLURB_LENGTH,
+  REQUIRED_KEYWORD_COUNT,
+  REQUIRED_CATEGORY_COUNT,
+  ALLOWED_BLURB_TAGS,
+} from '../index.js';
+import type { KdpListing } from '../index.js';
+
+const validListing: KdpListing = {
+  title: 'Sample Title',
+  subtitle: 'Sample Subtitle',
+  blurb: 'This is a valid blurb that contains enough content.',
+  keywords: ['key1', 'key2', 'key3', 'key4', 'key5', 'key6', 'key7'],
+  categories: ['cat1', 'cat2', 'cat3'],
+  author: 'John Doe',
+};
+
+describe('validateListing', () => {
+  describe('valid listing', () => {
+    it('returns valid: true and no errors for a completely valid listing', () => {
+      const result = validateListing(validListing);
+      expect(result.valid).toBe(true);
+      expect(result.errors).toHaveLength(0);
+    });
+
+    it('returns valid: true when subtitle is undefined', () => {
+      const listing: KdpListing = {
+        ...validListing,
+        subtitle: undefined,
+      };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(true);
+      expect(result.errors).toHaveLength(0);
+    });
+  });
+
+  describe('BLURB_EMPTY', () => {
+    it('returns BLURB_EMPTY error when blurb is empty string', () => {
+      const listing: KdpListing = { ...validListing, blurb: '' };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'BLURB_EMPTY' }));
+    });
+
+    it('returns BLURB_EMPTY error when blurb is whitespace only', () => {
+      const listing: KdpListing = { ...validListing, blurb: '   \n\t  ' };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'BLURB_EMPTY' }));
+    });
+  });
+
+  describe('BLURB_TOO_LONG', () => {
+    it('returns BLURB_TOO_LONG error when blurb exceeds MAX_BLURB_LENGTH', () => {
+      const listing: KdpListing = {
+        ...validListing,
+        blurb: 'a'.repeat(MAX_BLURB_LENGTH + 1),
+      };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'BLURB_TOO_LONG' }));
+    });
+
+    it('returns valid when blurb is exactly MAX_BLURB_LENGTH', () => {
+      const listing: KdpListing = {
+        ...validListing,
+        blurb: 'a'.repeat(MAX_BLURB_LENGTH),
+      };
+      const result = validateListing(listing);
+      const hasBlurbTooLongError = result.errors.some((e) => e.code === 'BLURB_TOO_LONG');
+      expect(hasBlurbTooLongError).toBe(false);
+    });
+
+    it('returns valid when blurb is just under MAX_BLURB_LENGTH', () => {
+      const listing: KdpListing = {
+        ...validListing,
+        blurb: 'a'.repeat(MAX_BLURB_LENGTH - 1),
+      };
+      const result = validateListing(listing);
+      const hasBlurbTooLongError = result.errors.some((e) => e.code === 'BLURB_TOO_LONG');
+      expect(hasBlurbTooLongError).toBe(false);
+    });
+  });
+
+  describe('KEYWORD_COUNT', () => {
+    it('returns KEYWORD_COUNT error when keyword count is too low', () => {
+      const listing: KdpListing = {
+        ...validListing,
+        keywords: ['key1', 'key2', 'key3'],
+      };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'KEYWORD_COUNT' }));
+    });
+
+    it('returns KEYWORD_COUNT error when keyword count is too high', () => {
+      const listing: KdpListing = {
+        ...validListing,
+        keywords: Array.from({ length: REQUIRED_KEYWORD_COUNT + 1 }, (_, i) => `key${i}`),
+      };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'KEYWORD_COUNT' }));
+    });
+
+    it('returns valid when keyword count is exactly REQUIRED_KEYWORD_COUNT', () => {
+      const listing: KdpListing = {
+        ...validListing,
+        keywords: Array.from({ length: REQUIRED_KEYWORD_COUNT }, (_, i) => `key${i}`),
+      };
+      const result = validateListing(listing);
+      const hasKeywordCountError = result.errors.some((e) => e.code === 'KEYWORD_COUNT');
+      expect(hasKeywordCountError).toBe(false);
+    });
+  });
+
+  describe('CATEGORY_COUNT', () => {
+    it('returns CATEGORY_COUNT error when category count is too low', () => {
+      const listing: KdpListing = {
+        ...validListing,
+        categories: ['cat1', 'cat2'],
+      };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'CATEGORY_COUNT' }));
+    });
+
+    it('returns CATEGORY_COUNT error when category count is too high', () => {
+      const listing: KdpListing = {
+        ...validListing,
+        categories: Array.from({ length: REQUIRED_CATEGORY_COUNT + 1 }, (_, i) => `cat${i}`),
+      };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'CATEGORY_COUNT' }));
+    });
+
+    it('returns valid when category count is exactly REQUIRED_CATEGORY_COUNT', () => {
+      const listing: KdpListing = {
+        ...validListing,
+        categories: Array.from({ length: REQUIRED_CATEGORY_COUNT }, (_, i) => `cat${i}`),
+      };
+      const result = validateListing(listing);
+      const hasCategoryCountError = result.errors.some((e) => e.code === 'CATEGORY_COUNT');
+      expect(hasCategoryCountError).toBe(false);
+    });
+  });
+
+  describe('UNRESOLVED_PLACEHOLDER', () => {
+    it('returns UNRESOLVED_PLACEHOLDER error when TODO: is in title', () => {
+      const listing: KdpListing = {
+        ...validListing,
+        title: 'TODO: Fix this title',
+      };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'UNRESOLVED_PLACEHOLDER' }));
+    });
+
+    it('returns UNRESOLVED_PLACEHOLDER error when TODO: is in subtitle', () => {
+      const listing: KdpListing = {
+        ...validListing,
+        subtitle: 'TODO: Add subtitle',
+      };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'UNRESOLVED_PLACEHOLDER' }));
+    });
+
+    it('returns UNRESOLVED_PLACEHOLDER error when TODO: is in blurb', () => {
+      const listing: KdpListing = {
+        ...validListing,
+        blurb: 'This is TODO: some content',
+      };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'UNRESOLVED_PLACEHOLDER' }));
+    });
+
+    it('returns UNRESOLVED_PLACEHOLDER error when TODO: is in author', () => {
+      const listing: KdpListing = {
+        ...validListing,
+        author: 'TODO: Add author name',
+      };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'UNRESOLVED_PLACEHOLDER' }));
+    });
+
+    it('returns UNRESOLVED_PLACEHOLDER error when TODO: is in a keyword', () => {
+      const listing: KdpListing = {
+        ...validListing,
+        keywords: ['key1', 'TODO: keyword', 'key3', 'key4', 'key5', 'key6', 'key7'],
+      };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'UNRESOLVED_PLACEHOLDER' }));
+    });
+
+    it('returns UNRESOLVED_PLACEHOLDER error when TODO: is in a category', () => {
+      const listing: KdpListing = {
+        ...validListing,
+        categories: ['cat1', 'TODO: category', 'cat3'],
+      };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'UNRESOLVED_PLACEHOLDER' }));
+    });
+
+    it('returns only one UNRESOLVED_PLACEHOLDER error even with multiple TODO: occurrences', () => {
+      const listing: KdpListing = {
+        ...validListing,
+        title: 'TODO: title',
+        author: 'TODO: author',
+        keywords: ['TODO: key1', 'key2', 'key3', 'key4', 'key5', 'key6', 'key7'],
+      };
+      const result = validateListing(listing);
+      const placeholderErrors = result.errors.filter((e) => e.code === 'UNRESOLVED_PLACEHOLDER');
+      expect(placeholderErrors).toHaveLength(1);
+    });
+  });
+
+  describe('DISALLOWED_HTML', () => {
+    it('returns no error for allowed tags', () => {
+      const allowedTagsHtml = ALLOWED_BLURB_TAGS.map((tag) => `<${tag}>content</${tag}>`).join('');
+      const listing: KdpListing = {
+        ...validListing,
+        blurb: allowedTagsHtml,
+      };
+      const result = validateListing(listing);
+      const hasDisallowedHtmlError = result.errors.some((e) => e.code === 'DISALLOWED_HTML');
+      expect(hasDisallowedHtmlError).toBe(false);
+    });
+
+    it('returns DISALLOWED_HTML error for disallowed tags', () => {
+      const listing: KdpListing = {
+        ...validListing,
+        blurb: 'This has <span>disallowed</span> tags',
+      };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'DISALLOWED_HTML' }));
+    });
+
+    it('returns DISALLOWED_HTML error for mixed allowed and disallowed tags', () => {
+      const listing: KdpListing = {
+        ...validListing,
+        blurb: '<b>bold</b> and <span>span</span>',
+      };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'DISALLOWED_HTML' }));
+    });
+
+    it('handles case-insensitive tag matching', () => {
+      const listing: KdpListing = {
+        ...validListing,
+        blurb: '<B>bold</B> <DIV>div</DIV>',
+      };
+      const result = validateListing(listing);
+      const disallowedHtmlError = result.errors.find((e) => e.code === 'DISALLOWED_HTML');
+      if (disallowedHtmlError) {
+        expect(disallowedHtmlError.detail).toContain('div');
+        // B is allowed, so it should only report DIV as disallowed
+        expect(disallowedHtmlError.detail).toMatch(/div/);
+        const tagsList = disallowedHtmlError.detail.match(/tags: ([\w, ]+)\./)?.[1] || '';
+        expect(tagsList).not.toMatch(/\bb\b/);
+      }
+    });
+
+    it('returns only one DISALLOWED_HTML error even with multiple disallowed tags', () => {
+      const listing: KdpListing = {
+        ...validListing,
+        blurb: '<span>span</span> <div>div</div> <a>link</a>',
+      };
+      const result = validateListing(listing);
+      const disallowedHtmlErrors = result.errors.filter((e) => e.code === 'DISALLOWED_HTML');
+      expect(disallowedHtmlErrors).toHaveLength(1);
+    });
+  });
+
+  describe('error sorting', () => {
+    it('returns errors sorted by code in lexicographic order', () => {
+      const listing: KdpListing = {
+        title: '',
+        blurb: '',
+        keywords: [],
+        categories: [],
+        author: 'TODO: author',
+      };
+      const result = validateListing(listing);
+      const codes = result.errors.map((e) => e.code);
+      const sortedCodes = [...codes].sort();
+      expect(codes).toEqual(sortedCodes);
+    });
+  });
+
+  describe('multiple errors', () => {
+    it('collects all errors when multiple validation rules fail', () => {
+      const listing: KdpListing = {
+        title: 'Title',
+        blurb: 'a'.repeat(MAX_BLURB_LENGTH + 1),
+        keywords: ['key1'],
+        categories: ['cat1'],
+        author: 'John Doe',
+      };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(false);
+      expect(result.errors.length).toBeGreaterThan(1);
+      expect(result.errors.map((e) => e.code)).toContain('BLURB_TOO_LONG');
+      expect(result.errors.map((e) => e.code)).toContain('KEYWORD_COUNT');
+      expect(result.errors.map((e) => e.code)).toContain('CATEGORY_COUNT');
+    });
+
+    it('handles blurb empty and blurb too long together (empty takes precedence in sorting)', () => {
+      const listing: KdpListing = {
+        title: 'Title',
+        blurb: '   ', // Empty after trim
+        keywords: validListing.keywords,
+        categories: validListing.categories,
+        author: 'John Doe',
+      };
+      const result = validateListing(listing);
+      const codes = result.errors.map((e) => e.code);
+      expect(codes).toContain('BLURB_EMPTY');
+      // Verify sorting
+      const sortedCodes = [...codes].sort();
+      expect(codes).toEqual(sortedCodes);
+    });
+  });
+
+  describe('constants export', () => {
+    it('exports MAX_BLURB_LENGTH constant', () => {
+      expect(MAX_BLURB_LENGTH).toBe(4000);
+    });
+
+    it('exports REQUIRED_KEYWORD_COUNT constant', () => {
+      expect(REQUIRED_KEYWORD_COUNT).toBe(7);
+    });
+
+    it('exports REQUIRED_CATEGORY_COUNT constant', () => {
+      expect(REQUIRED_CATEGORY_COUNT).toBe(3);
+    });
+
+    it('exports ALLOWED_BLURB_TAGS constant with correct tags', () => {
+      expect(ALLOWED_BLURB_TAGS).toContain('b');
+      expect(ALLOWED_BLURB_TAGS).toContain('i');
+      expect(ALLOWED_BLURB_TAGS).toContain('u');
+      expect(ALLOWED_BLURB_TAGS).toContain('br');
+      expect(ALLOWED_BLURB_TAGS).toContain('p');
+      expect(ALLOWED_BLURB_TAGS).toContain('ul');
+      expect(ALLOWED_BLURB_TAGS).toContain('li');
+      expect(ALLOWED_BLURB_TAGS).toContain('ol');
+      expect(ALLOWED_BLURB_TAGS).toContain('h4');
+      expect(ALLOWED_BLURB_TAGS).toContain('h5');
+      expect(ALLOWED_BLURB_TAGS).toContain('h6');
+      expect(ALLOWED_BLURB_TAGS).toHaveLength(11);
+    });
+  });
+});
