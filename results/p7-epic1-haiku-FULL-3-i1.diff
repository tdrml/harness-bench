+import type { KdpListing, ListingValidation, ListingError } from './types.js';
+
+export const MAX_BLURB_LENGTH = 4000;
+export const REQUIRED_KEYWORD_COUNT = 7;
+export const REQUIRED_CATEGORY_COUNT = 3;
+export const ALLOWED_BLURB_TAGS = ['b', 'i', 'u', 'br', 'p', 'ul', 'li', 'ol', 'h4', 'h5', 'h6'];
+
+export function validateListing(listing: KdpListing): ListingValidation {
+  const errors: ListingError[] = [];
+
+  // 1. BLURB_TOO_LONG
+  if (listing.blurb.length > MAX_BLURB_LENGTH) {
+    errors.push({
+      code: 'BLURB_TOO_LONG',
+      detail: `Blurb exceeds maximum length of ${MAX_BLURB_LENGTH} characters (current: ${listing.blurb.length})`,
+    });
+  }
+
+  // 2. BLURB_EMPTY
+  if (listing.blurb.trim().length === 0) {
+    errors.push({
+      code: 'BLURB_EMPTY',
+      detail: 'Blurb is empty or contains only whitespace',
+    });
+  }
+
+  // 3. KEYWORD_COUNT
+  if (listing.keywords.length !== REQUIRED_KEYWORD_COUNT) {
+    errors.push({
+      code: 'KEYWORD_COUNT',
+      detail: `Keywords must contain exactly ${REQUIRED_KEYWORD_COUNT} entries (current: ${listing.keywords.length})`,
+    });
+  }
+
+  // 4. CATEGORY_COUNT
+  if (listing.categories.length !== REQUIRED_CATEGORY_COUNT) {
+    errors.push({
+      code: 'CATEGORY_COUNT',
+      detail: `Categories must contain exactly ${REQUIRED_CATEGORY_COUNT} entries (current: ${listing.categories.length})`,
+    });
+  }
+
+  // 5. UNRESOLVED_PLACEHOLDER - check all string fields
+  const hasUnresolvedPlaceholder = hasTodoPlaceholder(listing);
+  if (hasUnresolvedPlaceholder) {
+    errors.push({
+      code: 'UNRESOLVED_PLACEHOLDER',
+      detail: 'Listing contains unresolved TODO: placeholders',
+    });
+  }
+
+  // 6. DISALLOWED_HTML - check blurb only
+  const disallowedTags = findDisallowedTags(listing.blurb);
+  if (disallowedTags.length > 0) {
+    errors.push({
+      code: 'DISALLOWED_HTML',
+      detail: `Blurb contains disallowed HTML tags: ${disallowedTags.join(', ')}`,
+    });
+  }
+
+  // Sort errors by code (lexicographic ascending)
+  errors.sort((a, b) => a.code.localeCompare(b.code));
+
+  return {
+    valid: errors.length === 0,
+    errors,
+  };
+}
+
+function hasTodoPlaceholder(listing: KdpListing): boolean {
+  const fields = [
+    listing.title,
+    listing.subtitle,
+    listing.blurb,
+    listing.author,
+    ...listing.keywords,
+    ...listing.categories,
+  ];
+
+  for (const field of fields) {
+    if (field && typeof field === 'string' && field.includes('TODO:')) {
+      return true;
+    }
+  }
+
+  return false;
+}
+
+function findDisallowedTags(blurb: string): string[] {
+  const htmlTagRegex = /<\/?(\w+)[^>]*>/g;
+  const tags = new Set<string>();
+  let match: RegExpExecArray | null;
+
+  while ((match = htmlTagRegex.exec(blurb)) !== null) {
+    const tagName = match[1];
+    if (tagName !== undefined) {
+      const lowerTagName = tagName.toLowerCase();
+      if (!ALLOWED_BLURB_TAGS.includes(lowerTagName)) {
+        tags.add(lowerTagName);
+      }
+    }
+  }
+
+  return Array.from(tags).sort();
+}
