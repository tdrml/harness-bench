@@ -0,0 +1,194 @@
+import { describe, it, expect, vi, beforeEach } from 'vitest';
+import type { EnvironmentConfig } from '@auto-graph/core';
+
+vi.mock('../ecs-launcher.js', () => ({
+  launchECSTask: vi.fn().mockResolvedValue('arn:aws:ecs:us-east-1:123:task/test/abc123'),
+}));
+
+import { launchECSTask } from '../ecs-launcher.js';
+import { launchAgentRun } from '../launch-agent-run.js';
+
+const config: EnvironmentConfig = {
+  AWS_REGION: 'us-east-1',
+  DYNAMODB_TABLE_PREFIX: 'test',
+  SQS_QUEUE_URL: 'https://sqs.us-east-1.amazonaws.com/123',
+  ECS_CLUSTER_ARN: 'arn:aws:ecs:us-east-1:123:cluster/main',
+  ECS_SUBNETS: 'subnet-aaa',
+  ECS_SECURITY_GROUPS: 'sg-aaa',
+  GITHUB_TOKEN: 'ghp_test',
+  GITHUB_ORG: 'test-org',
+  ORCHESTRATION_REPO: 'test-repo',
+  LOG_LEVEL: 'info',
+};
+
+let mockAgentRunService: { create: ReturnType<typeof vi.fn> };
+let mockTaskOutputService: { save: ReturnType<typeof vi.fn> };
+
+beforeEach(() => {
+  vi.clearAllMocks();
+  delete process.env['STATE_MACHINE_ARN'];
+
+  mockAgentRunService = { create: vi.fn().mockResolvedValue(undefined) };
+  mockTaskOutputService = { save: vi.fn().mockResolvedValue(undefined) };
+
+  vi.mocked(launchECSTask).mockResolvedValue('arn:aws:ecs:us-east-1:123:task/test/abc123');
+});
+
+describe('launchAgentRun', () => {
+  it('generates a ulid-formatted run id', async () => {
+    const { runId } = await launchAgentRun({
+      taskDefArn: 'arn:aws:ecs:us-east-1:123:task-definition/writer:1',
+      workerType: 'writer',
+      systemPrompt: 'a prompt',
+      projectId: 'proj-1',
+      repoName: 'my-repo',
+      config,
+      agentRunService: mockAgentRunService as never,
+      taskOutputService: mockTaskOutputService as never,
+    });
+
+    expect(runId).toMatch(/^[0-9A-HJKMNP-TV-Z]{26}$/);
+  });
+
+  it('saves the system prompt as a system-prompt task output before launching', async () => {
+    await launchAgentRun({
+      taskDefArn: 'arn:aws:ecs:us-east-1:123:task-definition/writer:1',
+      workerType: 'writer',
+      systemPrompt: 'a prompt',
+      projectId: 'proj-1',
+      repoName: 'my-repo',
+      config,
+      agentRunService: mockAgentRunService as never,
+      taskOutputService: mockTaskOutputService as never,
+    });
+
+    expect(mockTaskOutputService.save).toHaveBeenCalledOnce();
+    const [outputItem] = mockTaskOutputService.save.mock.calls[0]!;
+    expect(outputItem.projectId).toBe('proj-1');
+    expect(outputItem.outputType).toBe('system-prompt');
+    expect(outputItem.content).toBe('a prompt');
+    expect(outputItem.contentLength).toBe('a prompt'.length);
+  });
+
+  it('launches the ECS task with the standard environment keys merged with extraEnv', async () => {
+    await launchAgentRun({
+      taskDefArn: 'arn:aws:ecs:us-east-1:123:task-definition/writer:1',
+      workerType: 'writer',
+      systemPrompt: 'a prompt',
+      projectId: 'proj-1',
+      repoName: 'my-repo',
+      extraEnv: { CHAPTER_NUMBER: '3' },
+      config,
+      agentRunService: mockAgentRunService as never,
+      taskOutputService: mockTaskOutputService as never,
+    });
+
+    expect(vi.mocked(launchECSTask)).toHaveBeenCalledOnce();
+    const [params] = vi.mocked(launchECSTask).mock.calls[0]!;
+    expect(params.taskDefinition).toBe('arn:aws:ecs:us-east-1:123:task-definition/writer:1');
+    expect(params.command).toEqual(['claude', '-p', '$SYSTEM_PROMPT']);
+    expect(params.environment['PROJECT_ID']).toBe('proj-1');
+    expect(params.environment['REPO_NAME']).toBe('my-repo');
+    expect(params.environment['AWS_REGION']).toBe('us-east-1');
+    expect(params.environment['DYNAMODB_TABLE_PREFIX']).toBe('test');
+    expect(params.environment['CHAPTER_NUMBER']).toBe('3');
+    expect(typeof params.environment['RUN_ID']).toBe('string');
+  });
+
+  it('creates the agent run record with status RUNNING and includes nodeId when supplied', async () => {
+    const { runId, taskArn } = await launchAgentRun({
+      taskDefArn: 'arn:aws:ecs:us-east-1:123:task-definition/writer:1',
+      workerType: 'writer',
+      systemPrompt: 'a prompt',
+      projectId: 'proj-1',
+      repoName: 'my-repo',
+      nodeId: 'node-1',
+      config,
+      agentRunService: mockAgentRunService as never,
+      taskOutputService: mockTaskOutputService as never,
+    });
+
+    expect(mockAgentRunService.create).toHaveBeenCalledOnce();
+    const [runItem] = mockAgentRunService.create.mock.calls[0]!;
+    expect(runItem.runId).toBe(runId);
+    expect(runItem.taskArn).toBe(taskArn);
+    expect(runItem.projectId).toBe('proj-1');
+    expect(runItem.workerType).toBe('writer');
+    expect(runItem.status).toBe('RUNNING');
+    expect(runItem.nodeId).toBe('node-1');
+  });
+
+  it('omits nodeId from the agent run record when not supplied', async () => {
+    await launchAgentRun({
+      taskDefArn: 'arn:aws:ecs:us-east-1:123:task-definition/outliner:1',
+      workerType: 'outliner',
+      systemPrompt: 'a prompt',
+      projectId: 'proj-1',
+      repoName: 'my-repo',
+      config,
+      agentRunService: mockAgentRunService as never,
+      taskOutputService: mockTaskOutputService as never,
+    });
+
+    const [runItem] = mockAgentRunService.create.mock.calls[0]!;
+    expect('nodeId' in runItem).toBe(false);
+  });
+
+  it('uses the same runId across the task output, ECS launch and agent run record', async () => {
+    const { runId } = await launchAgentRun({
+      taskDefArn: 'arn:aws:ecs:us-east-1:123:task-definition/writer:1',
+      workerType: 'writer',
+      systemPrompt: 'a prompt',
+      projectId: 'proj-1',
+      repoName: 'my-repo',
+      config,
+      agentRunService: mockAgentRunService as never,
+      taskOutputService: mockTaskOutputService as never,
+    });
+
+    const [outputItem] = mockTaskOutputService.save.mock.calls[0]!;
+    const [ecsParams] = vi.mocked(launchECSTask).mock.calls[0]!;
+    const [runItem] = mockAgentRunService.create.mock.calls[0]!;
+
+    expect(outputItem.runId).toBe(runId);
+    expect(ecsParams.environment['RUN_ID']).toBe(runId);
+    expect(runItem.runId).toBe(runId);
+  });
+
+  it('returns the taskArn produced by the ECS launch', async () => {
+    vi.mocked(launchECSTask).mockResolvedValueOnce('arn:aws:ecs:us-east-1:123:task/test/custom');
+
+    const { taskArn } = await launchAgentRun({
+      taskDefArn: 'arn:aws:ecs:us-east-1:123:task-definition/writer:1',
+      workerType: 'writer',
+      systemPrompt: 'a prompt',
+      projectId: 'proj-1',
+      repoName: 'my-repo',
+      config,
+      agentRunService: mockAgentRunService as never,
+      taskOutputService: mockTaskOutputService as never,
+    });
+
+    expect(taskArn).toBe('arn:aws:ecs:us-east-1:123:task/test/custom');
+  });
+
+  it('passes stateMachineArn, runId and projectId through to the ECS launcher for SFN kickoff', async () => {
+    process.env['STATE_MACHINE_ARN'] = 'arn:aws:states:us-east-1:123:stateMachine:test';
+
+    const { runId } = await launchAgentRun({
+      taskDefArn: 'arn:aws:ecs:us-east-1:123:task-definition/writer:1',
+      workerType: 'writer',
+      systemPrompt: 'a prompt',
+      projectId: 'proj-1',
+      repoName: 'my-repo',
+      config,
+      agentRunService: mockAgentRunService as never,
+      taskOutputService: mockTaskOutputService as never,
+    });
+
+    const [params] = vi.mocked(launchECSTask).mock.calls[0]!;
+    expect(params.stateMachineArn).toBe('arn:aws:states:us-east-1:123:stateMachine:test');
+    expect(params.runId).toBe(runId);
+    expect(params.projectId).toBe('proj-1');
+  });
+});
