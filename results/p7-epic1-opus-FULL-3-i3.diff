diff --git a/packages/core/src/writing/paths.ts b/packages/core/src/writing/paths.ts
index 3cf6753..b069f86 100644
--- a/packages/core/src/writing/paths.ts
+++ b/packages/core/src/writing/paths.ts
@@ -1,3 +1,10 @@
 export function getChapterFilePath(chapterNumber: number): string {
   return `manuscript/chapter-${String(chapterNumber).padStart(2, '0')}.md`;
 }
+
+// Inverse of getChapterFilePath: the chapter number a manuscript file path
+// stands for, or undefined when the path carries no chapter number at all.
+export function getChapterNumberFromFilePath(filePath: string): number | undefined {
+  const digits = /(\d+)\D*$/.exec(filePath)?.[1];
+  return digits === undefined ? undefined : parseInt(digits, 10);
+}
