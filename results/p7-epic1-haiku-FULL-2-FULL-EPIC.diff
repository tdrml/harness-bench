+import { getChapterFilePath } from '../writing/paths.js';
+import type { ChapterFile, ManuscriptError, ManuscriptValidation } from './types.js';
+
+export function validateManuscriptStructure(chapters: ChapterFile[]): ManuscriptValidation {
+  const errors: ManuscriptError[] = [];
+  const headingNumbers: number[] = [];
+
+  // Per-chapter validation
+  for (const chapter of chapters) {
+    const pathNumber = extractChapterNumberFromPath(chapter.path);
+
+    // Skip validation if path doesn't match expected pattern
+    if (pathNumber === null) {
+      continue;
+    }
+
+    const h1Match = findH1Heading(chapter.content);
+
+    // H1_MISSING
+    if (!h1Match) {
+      errors.push({
+        code: 'H1_MISSING',
+        detail: `Chapter at path "${chapter.path}" has no level-1 markdown heading.`,
+      });
+
+      // H1_NOT_FIRST: still check even if H1_MISSING (first non-empty line is not an H1)
+      errors.push({
+        code: 'H1_NOT_FIRST',
+        detail: `First non-empty line of chapter at path "${chapter.path}" is not the level-1 heading.`,
+      });
+
+      // Skip rules 3 and 4 (H1_MALFORMED and H1_NUMBER_MISMATCH)
+      continue;
+    }
+
+    // H1_NOT_FIRST
+    if (!isH1First(chapter.content, h1Match)) {
+      errors.push({
+        code: 'H1_NOT_FIRST',
+        detail: `First non-empty line of chapter at path "${chapter.path}" is not the level-1 heading.`,
+      });
+    }
+
+    // H1_MALFORMED and extract heading number
+    const headingMatch = h1Match.match(/^#\s+Chapter\s+(\d+)\s*:\s*(.+)$/);
+    if (!headingMatch) {
+      errors.push({
+        code: 'H1_MALFORMED',
+        detail: `Level-1 heading in chapter at path "${chapter.path}" does not match pattern "# Chapter <N>: <Title>" where <N> is one or more digits and <Title> is non-empty.`,
+      });
+      continue;
+    }
+
+    const headingNumber = parseInt(headingMatch[1] ?? '', 10);
+    const title = headingMatch[2] ?? '';
+
+    // Validate title is non-empty
+    if (!title || title.trim().length === 0) {
+      errors.push({
+        code: 'H1_MALFORMED',
+        detail: `Level-1 heading in chapter at path "${chapter.path}" does not match pattern "# Chapter <N>: <Title>" where <N> is one or more digits and <Title> is non-empty.`,
+      });
+      continue;
+    }
+
+    // H1_NUMBER_MISMATCH
+    if (headingNumber !== pathNumber) {
+      errors.push({
+        code: 'H1_NUMBER_MISMATCH',
+        detail: `Chapter number in heading (${headingNumber}) does not match the chapter number implied by path (${pathNumber}).`,
+      });
+    }
+
+    headingNumbers.push(headingNumber);
+  }
+
+  // Set-level validation
+  // CHAPTER_DUPLICATE
+  const seen = new Set<number>();
+  for (const num of headingNumbers) {
+    if (seen.has(num)) {
+      errors.push({
+        code: 'CHAPTER_DUPLICATE',
+        detail: `Two chapters resolve to chapter number ${num}.`,
+      });
+    }
+    seen.add(num);
+  }
+
+  // CHAPTER_GAP
+  if (headingNumbers.length > 0) {
+    const sorted = [...new Set(headingNumbers)].sort((a, b) => a - b);
+    const maxNum = sorted[sorted.length - 1] ?? 0;
+    const isConsecutive = sorted.every((num, i) => num === i + 1);
+    if (!isConsecutive) {
+      const expected = Array.from({ length: maxNum }, (_, i) => i + 1);
+      const missing = expected.filter((n) => !sorted.includes(n));
+      if (missing.length > 0 || sorted[0] !== 1) {
+        errors.push({
+          code: 'CHAPTER_GAP',
+          detail: `Chapter numbers must form the sequence 1..n with no gaps. Got: ${sorted.join(', ')}.`,
+        });
+      }
+    }
+  }
+
+  // Sort errors by code ascending
+  errors.sort((a, b) => a.code.localeCompare(b.code));
+
+  return {
+    valid: errors.length === 0,
+    errors,
+  };
+}
+
+function extractChapterNumberFromPath(path: string): number | null {
+  // Extract potential chapter number from path using simple pattern
+  const match = path.match(/^manuscript\/chapter-(\d+)\.md$/);
+  if (!match) {
+    return null;
+  }
+  const num = parseInt(match[1] ?? '', 10);
+  if (isNaN(num)) {
+    return null;
+  }
+  // Verify by calling getChapterFilePath to ensure path format is correct
+  // (avoids duplicating the zero-padding logic from getChapterFilePath)
+  if (getChapterFilePath(num) === path) {
+    return num;
+  }
+  return null;
+}
+
+function findH1Heading(content: string): string | undefined {
+  const lines = content.split('\n');
+  for (const line of lines) {
+    if (line.match(/^#\s+/)) {
+      return line;
+    }
+  }
+  return undefined;
+}
+
+function isH1First(content: string, h1: string): boolean {
+  const lines = content.split('\n');
+  for (const line of lines) {
+    if (line.trim().length === 0) {
+      continue;
+    }
+    return line === h1;
+  }
+  return false;
+}
diff --git a/packages/core/src/release-policy/validate.ts b/packages/core/src/release-policy/validate.ts
new file mode 100644
index 0000000..8a4b20c
--- /dev/null
+++ b/packages/core/src/release-policy/validate.ts
@@ -0,0 +1,92 @@
+import type { KdpListing, ListingError, ListingValidation } from './types.js';
+import {
+  MAX_BLURB_LENGTH,
+  REQUIRED_KEYWORD_COUNT,
+  REQUIRED_CATEGORY_COUNT,
+  ALLOWED_BLURB_TAGS,
+} from './types.js';
+
+export function validateListing(listing: KdpListing): ListingValidation {
+  const errors: ListingError[] = [];
+
+  // BLURB_TOO_LONG — blurb longer than 4000 characters
+  if (listing.blurb.length > MAX_BLURB_LENGTH) {
+    errors.push({
+      code: 'BLURB_TOO_LONG',
+      detail: `Blurb exceeds maximum length of ${MAX_BLURB_LENGTH} characters (${listing.blurb.length} provided).`,
+    });
+  }
+
+  // BLURB_EMPTY — blurb is empty or whitespace only
+  if (listing.blurb.trim().length === 0) {
+    errors.push({
+      code: 'BLURB_EMPTY',
+      detail: 'Blurb is empty or contains only whitespace.',
+    });
+  }
+
+  // KEYWORD_COUNT — keywords.length is not exactly 7
+  if (listing.keywords.length !== REQUIRED_KEYWORD_COUNT) {
+    errors.push({
+      code: 'KEYWORD_COUNT',
+      detail: `Expected exactly ${REQUIRED_KEYWORD_COUNT} keywords, got ${listing.keywords.length}.`,
+    });
+  }
+
+  // CATEGORY_COUNT — categories.length is not exactly 3
+  if (listing.categories.length !== REQUIRED_CATEGORY_COUNT) {
+    errors.push({
+      code: 'CATEGORY_COUNT',
+      detail: `Expected exactly ${REQUIRED_CATEGORY_COUNT} categories, got ${listing.categories.length}.`,
+    });
+  }
+
+  // UNRESOLVED_PLACEHOLDER — any string field contains "TODO:". One error total, not one per field.
+  const allStringFields = [
+    listing.title,
+    listing.subtitle,
+    listing.blurb,
+    listing.author,
+    ...listing.keywords,
+    ...listing.categories,
+  ];
+  const hasTodo = allStringFields.some((field) => field !== undefined && field.includes('TODO:'));
+  if (hasTodo) {
+    errors.push({
+      code: 'UNRESOLVED_PLACEHOLDER',
+      detail: 'One or more fields contain unresolved "TODO:" placeholders.',
+    });
+  }
+
+  // DISALLOWED_HTML — blurb contains an HTML tag outside allowlist. One error total.
+  const disallowedHtmlTag = findDisallowedHtmlTag(listing.blurb);
+  if (disallowedHtmlTag) {
+    errors.push({
+      code: 'DISALLOWED_HTML',
+      detail: `HTML tag "<${disallowedHtmlTag}>" is not allowed in blurb. Allowed tags: ${ALLOWED_BLURB_TAGS.join(', ')}.`,
+    });
+  }
+
+  // Sort errors by code ascending (lexicographic order)
+  errors.sort((a, b) => a.code.localeCompare(b.code));
+
+  return {
+    valid: errors.length === 0,
+    errors,
+  };
+}
+
+function findDisallowedHtmlTag(text: string): string | undefined {
+  const htmlTagPattern = /<\/?([a-zA-Z][a-zA-Z0-9]*)/g;
+  const allowedTagsLower = ALLOWED_BLURB_TAGS.map((tag) => tag.toLowerCase());
+
+  let match;
+  while ((match = htmlTagPattern.exec(text)) !== null) {
+    const tag = match[1]?.toLowerCase();
+    if (tag !== undefined && !allowedTagsLower.includes(tag)) {
+      return tag;
+    }
+  }
+
+  return undefined;
+}
