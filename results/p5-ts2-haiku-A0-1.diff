+      message: 'The conditional request failed',
+      $metadata: {},
+    });
+    const client = makeClient(() => { throw condErr; });
+    const svc = new RepoLocksService(client);
+    await expect(
+      svc.acquireLock('acme/app', 'owner-2', { takeoverGraceSeconds: 30 }),
