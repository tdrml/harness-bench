+import { getChapterFilePath } from '../writing/paths.js';
+import type { ChapterFile, ManuscriptError, ManuscriptValidation } from './types.js';
+
+export function validateManuscriptStructure(chapters: ChapterFile[]): ManuscriptValidation {
+  const errors: ManuscriptError[] = [];
+  const headingNumbers: number[] = [];
+
+  // Per-chapter validation
+  for (const chapter of chapters) {
+    const pathNumber = extractChapterNumberFromPath(chapter.path);
+
+    // Skip validation if path doesn't match expected pattern
+    if (pathNumber === null) {
+      continue;
+    }
+
+    const h1Match = findH1Heading(chapter.content);
+
+    // H1_MISSING
+    if (!h1Match) {
+      errors.push({
+        code: 'H1_MISSING',
+        detail: `Chapter at path "${chapter.path}" has no level-1 markdown heading.`,
+      });
+
+      // H1_NOT_FIRST: still check even if H1_MISSING (first non-empty line is not an H1)
+      errors.push({
+        code: 'H1_NOT_FIRST',
+        detail: `First non-empty line of chapter at path "${chapter.path}" is not the level-1 heading.`,
+      });
+
+      // Skip rules 3 and 4 (H1_MALFORMED and H1_NUMBER_MISMATCH)
+      continue;
+    }
+
+    // H1_NOT_FIRST
+    if (!isH1First(chapter.content, h1Match)) {
+      errors.push({
+        code: 'H1_NOT_FIRST',
+        detail: `First non-empty line of chapter at path "${chapter.path}" is not the level-1 heading.`,
+      });
+    }
+
+    // H1_MALFORMED and extract heading number
+    const headingMatch = h1Match.match(/^#\s+Chapter\s+(\d+)\s*:\s*(.+)$/);
+    if (!headingMatch) {
+      errors.push({
+        code: 'H1_MALFORMED',
+        detail: `Level-1 heading in chapter at path "${chapter.path}" does not match pattern "# Chapter <N>: <Title>" where <N> is one or more digits and <Title> is non-empty.`,
+      });
+      continue;
+    }
+
+    const headingNumber = parseInt(headingMatch[1] ?? '', 10);
+    const title = headingMatch[2] ?? '';
+
+    // Validate title is non-empty
+    if (!title || title.trim().length === 0) {
+      errors.push({
+        code: 'H1_MALFORMED',
+        detail: `Level-1 heading in chapter at path "${chapter.path}" does not match pattern "# Chapter <N>: <Title>" where <N> is one or more digits and <Title> is non-empty.`,
+      });
+      continue;
+    }
+
+    // H1_NUMBER_MISMATCH
+    if (headingNumber !== pathNumber) {
+      errors.push({
+        code: 'H1_NUMBER_MISMATCH',
+        detail: `Chapter number in heading (${headingNumber}) does not match the chapter number implied by path (${pathNumber}).`,
+      });
+    }
+
+    headingNumbers.push(headingNumber);
+  }
+
+  // Set-level validation
+  // CHAPTER_DUPLICATE
+  const seen = new Set<number>();
+  for (const num of headingNumbers) {
+    if (seen.has(num)) {
+      errors.push({
+        code: 'CHAPTER_DUPLICATE',
+        detail: `Two chapters resolve to chapter number ${num}.`,
+      });
+    }
+    seen.add(num);
+  }
+
+  // CHAPTER_GAP
+  if (headingNumbers.length > 0) {
+    const sorted = [...new Set(headingNumbers)].sort((a, b) => a - b);
+    const maxNum = sorted[sorted.length - 1] ?? 0;
+    const isConsecutive = sorted.every((num, i) => num === i + 1);
+    if (!isConsecutive) {
+      const expected = Array.from({ length: maxNum }, (_, i) => i + 1);
+      const missing = expected.filter((n) => !sorted.includes(n));
+      if (missing.length > 0 || sorted[0] !== 1) {
+        errors.push({
+          code: 'CHAPTER_GAP',
+          detail: `Chapter numbers must form the sequence 1..n with no gaps. Got: ${sorted.join(', ')}.`,
+        });
+      }
+    }
+  }
+
+  // Sort errors by code ascending
+  errors.sort((a, b) => a.code.localeCompare(b.code));
+
+  return {
+    valid: errors.length === 0,
+    errors,
+  };
+}
+
+function extractChapterNumberFromPath(path: string): number | null {
+  // Extract potential chapter number from path using simple pattern
+  const match = path.match(/^manuscript\/chapter-(\d+)\.md$/);
+  if (!match) {
+    return null;
+  }
+  const num = parseInt(match[1] ?? '', 10);
+  if (isNaN(num)) {
+    return null;
+  }
+  // Verify by calling getChapterFilePath to ensure path format is correct
+  // (avoids duplicating the zero-padding logic from getChapterFilePath)
+  if (getChapterFilePath(num) === path) {
+    return num;
+  }
+  return null;
+}
+
+function findH1Heading(content: string): string | undefined {
+  const lines = content.split('\n');
+  for (const line of lines) {
+    if (line.match(/^#\s+/)) {
+      return line;
+    }
+  }
+  return undefined;
+}
+
+function isH1First(content: string, h1: string): boolean {
+  const lines = content.split('\n');
+  for (const line of lines) {
+    if (line.trim().length === 0) {
+      continue;
+    }
+    return line === h1;
+  }
+  return false;
+}
