+import { describe, it, expect } from 'vitest';
+import {
+  validateListing,
+  MAX_BLURB_LENGTH,
+  REQUIRED_KEYWORD_COUNT,
+  REQUIRED_CATEGORY_COUNT,
+  ALLOWED_BLURB_TAGS,
+} from '../index.js';
+
+const validListing = {
+  title: 'Test Book',
+  subtitle: 'A Subtitle',
+  blurb: 'This is a test blurb that is long enough to be valid.',
+  keywords: ['keyword1', 'keyword2', 'keyword3', 'keyword4', 'keyword5', 'keyword6', 'keyword7'],
+  categories: ['category1', 'category2', 'category3'],
+  author: 'Test Author',
+};
+
+describe('validateListing', () => {
+  describe('all checks pass', () => {
+    it('returns valid: true for a valid listing', () => {
+      const result = validateListing(validListing);
+      expect(result.valid).toBe(true);
+      expect(result.errors).toHaveLength(0);
+    });
+
+    it('accepts optional subtitle as undefined', () => {
+      const listing = { ...validListing, subtitle: undefined };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(true);
+    });
+
+    it('accepts allowed HTML tags in blurb', () => {
+      const listing = {
+        ...validListing,
+        blurb: 'This <b>is</b> a <i>test</i> with <u>allowed</u> tags. <br/> <p>Paragraph</p> <ul><li>list</li></ul> <ol><li>ordered</li></ol> <h4>Header</h4> <h5>Header</h5> <h6>Header</h6>',
+      };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(true);
+    });
+
+    it('accepts case-insensitive HTML tags', () => {
+      const listing = {
+        ...validListing,
+        blurb: 'This <B>is</B> a <I>test</I> with <U>tags</U>. <BR/> <P>Paragraph</P> <UL><LI>list</LI></UL>',
+      };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(true);
+    });
+
+    it('accepts exactly MAX_BLURB_LENGTH characters', () => {
+      const listing = {
+        ...validListing,
+        blurb: 'a'.repeat(MAX_BLURB_LENGTH),
+      };
+      const result = validateListing(listing);
+      expect(result.valid).toBe(true);
+    });
+  });
+
+  describe('BLURB_TOO_LONG', () => {
+    it('returns error when blurb exceeds MAX_BLURB_LENGTH', () => {
+      const listing = {
+        ...validListing,
+        blurb: 'a'.repeat(MAX_BLURB_LENGTH + 1),
