diff --git a/packages/lambdas/src/shared/launch-agent-run.ts b/packages/lambdas/src/shared/launch-agent-run.ts
new file mode 100644
index 0000000..0815544
--- /dev/null
+++ b/packages/lambdas/src/shared/launch-agent-run.ts
@@ -0,0 +1,66 @@
+import { ulid } from 'ulid';
+import type { AgentRunService, TaskOutputService, WorkerType } from '@auto-graph/core';
+import { launchECSTask } from './ecs-launcher.js';
+import type { HandlerContext } from './types.js';
+
+export interface LaunchAgentRunParams {
+  taskDefArn: string;
+  workerType: WorkerType;
+  systemPrompt: string;
+  projectId: string;
+  repoName: string;
+  extraEnv?: Record<string, string> | undefined;
+  config: HandlerContext['config'];
+  agentRunService: AgentRunService;
+  taskOutputService: TaskOutputService;
+  nodeId?: string | undefined;
+}
+
+export async function launchAgentRun(params: LaunchAgentRunParams): Promise<{ runId: string; taskArn: string }> {
+  const { taskDefArn, workerType, systemPrompt, projectId, repoName, extraEnv, config, agentRunService, taskOutputService, nodeId } = params;
+
+  const runId = ulid();
+  const now = new Date().toISOString();
+
+  await taskOutputService.save({
+    runId,
+    outputType: 'system-prompt',
+    projectId,
+    content: systemPrompt,
+    contentLength: systemPrompt.length,
+    createdAt: now,
+  });
+
+  const environment = {
+    PROJECT_ID: projectId,
+    REPO_NAME: repoName,
+    RUN_ID: runId,
+    AWS_REGION: config.AWS_REGION,
+    DYNAMODB_TABLE_PREFIX: config.DYNAMODB_TABLE_PREFIX,
+    ...extraEnv,
+  };
+
+  const taskArn = await launchECSTask({
+    taskDefinition: taskDefArn,
+    command: ['claude', '-p', '$SYSTEM_PROMPT'],
+    environment,
+    config,
+    stateMachineArn: process.env['STATE_MACHINE_ARN'],
+    runId,
+    projectId,
+  });
+
+  const agentRunItem = {
+    runId,
+    projectId,
+    taskArn,
+    workerType,
+    status: 'RUNNING' as const,
+    startedAt: now,
+    ...(nodeId !== undefined && { nodeId }),
+  };
+
+  await agentRunService.create(agentRunItem);
+
+  return { runId, taskArn };
+}
