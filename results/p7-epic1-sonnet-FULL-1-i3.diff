diff --git a/packages/core/src/release-policy/manuscript.ts b/packages/core/src/release-policy/manuscript.ts
new file mode 100644
index 0000000..6243904
--- /dev/null
+++ b/packages/core/src/release-policy/manuscript.ts
@@ -0,0 +1,88 @@
+import { getChapterFilePath } from '../writing/index.js';
+import type { ChapterFile, ManuscriptError, ManuscriptValidation } from './types.js';
+
+const H1_LINE_PATTERN = /^#\s+/;
+const H1_HEADING_PATTERN = /^#\s+Chapter\s+(\d+):\s+(.+)$/;
+const CHAPTER_PATH_NUMBER_PATTERN = /chapter-(\d+)\.md$/;
+
+function resolveChapterNumberFromPath(path: string): number | undefined {
+  const match = CHAPTER_PATH_NUMBER_PATTERN.exec(path);
+  if (!match) {
+    return undefined;
+  }
+  const candidate = parseInt(match[1]!, 10);
+  return getChapterFilePath(candidate) === path ? candidate : undefined;
+}
+
+export function validateManuscriptStructure(chapters: ChapterFile[]): ManuscriptValidation {
+  const errors: ManuscriptError[] = [];
+  const pathNumbers = chapters.map((chapter) => resolveChapterNumberFromPath(chapter.path));
+
+  for (let i = 0; i < chapters.length; i++) {
+    const chapter = chapters[i]!;
+    const lines = chapter.content.split(/\r?\n/);
+    const h1Index = lines.findIndex((line) => H1_LINE_PATTERN.test(line));
+
+    if (h1Index === -1) {
+      errors.push({
+        code: 'H1_MISSING',
+        detail: `chapter at "${chapter.path}" has no level-1 markdown heading.`,
+      });
+      continue;
+    }
+
+    const firstNonEmptyIndex = lines.findIndex((line) => line.trim().length > 0);
+    if (firstNonEmptyIndex !== h1Index) {
+      errors.push({
+        code: 'H1_NOT_FIRST',
+        detail: `chapter at "${chapter.path}" has content before its level-1 heading.`,
+      });
+    }
+
+    const headingMatch = H1_HEADING_PATTERN.exec(lines[h1Index]!);
+    if (!headingMatch || headingMatch[2]!.trim().length === 0) {
+      errors.push({
+        code: 'H1_MALFORMED',
+        detail: `chapter at "${chapter.path}" has a heading that does not match "# Chapter <N>: <Title>".`,
+      });
+      continue;
+    }
+
+    const headingNumber = parseInt(headingMatch[1]!, 10);
+    const pathNumber = pathNumbers[i];
+    if (pathNumber === undefined || headingNumber !== pathNumber) {
+      errors.push({
+        code: 'H1_NUMBER_MISMATCH',
+        detail: `chapter at "${chapter.path}" has heading number ${headingNumber}, which does not match the chapter number implied by its path.`,
+      });
+    }
+  }
+
+  const counts = new Map<number, number>();
+  for (const number of pathNumbers) {
+    if (number === undefined) {
+      continue;
+    }
+    counts.set(number, (counts.get(number) ?? 0) + 1);
+  }
+
+  if ([...counts.values()].some((count) => count > 1)) {
+    errors.push({
+      code: 'CHAPTER_DUPLICATE',
+      detail: 'two or more chapters resolve to the same chapter number.',
+    });
+  }
+
+  const uniqueSorted = [...counts.keys()].sort((a, b) => a - b);
+  const isContiguousFromOne = uniqueSorted.every((number, index) => number === index + 1);
+  if (!isContiguousFromOne) {
+    errors.push({
+      code: 'CHAPTER_GAP',
+      detail: `chapter numbers must form an unbroken sequence starting at 1, found [${uniqueSorted.join(', ')}].`,
+    });
+  }
+
+  errors.sort((a, b) => (a.code < b.code ? -1 : a.code > b.code ? 1 : 0));
+
+  return { valid: errors.length === 0, errors };
+}
