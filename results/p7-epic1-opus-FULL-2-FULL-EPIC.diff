index 0000000..9786f37
--- /dev/null
+++ b/packages/core/src/release-policy/validate-manuscript.ts
@@ -0,0 +1,110 @@
+import { getChapterFilePath } from '../writing/paths.js';
+import type { ChapterFile, ManuscriptError, ManuscriptValidation } from './types.js';
+
+/** Matches a level-1 heading line, but not a deeper (`##`) heading. */
+const H1_LINE_PATTERN = /^#(?!#)/;
+
+/** The heading shape every chapter must use: `# Chapter <N>: <Title>`. */
+const H1_HEADING_PATTERN = /^#\s+Chapter\s+(\d+):\s+(.+)$/;
+
+/** First run of digits in a chapter file name. */
+const FILE_NAME_NUMBER_PATTERN = /\d+/;
+
+/**
+ * Chapter number encoded in a manuscript path.
+ *
+ * `getChapterFilePath` owns the chapter path convention; this reads the number
+ * back out of a path that follows it.
+ */
+function chapterNumberFromPath(path: string): number | undefined {
+  const fileName = path.slice(path.lastIndexOf('/') + 1);
+  const match = FILE_NAME_NUMBER_PATTERN.exec(fileName);
+  if (match === null) {
+    return undefined;
+  }
+  return Number.parseInt(match[0], 10);
+}
+
+function validateChapter(chapter: ChapterFile, pathNumber: number | undefined): ManuscriptError[] {
+  const errors: ManuscriptError[] = [];
+  const lines = chapter.content.split('\n');
+  const headingLine = lines.find((line) => H1_LINE_PATTERN.test(line));
+  const firstNonEmptyLine = lines.find((line) => line.trim().length > 0);
+
+  if (headingLine === undefined) {
+    errors.push({
+      code: 'H1_MISSING',
+      detail: `${chapter.path} has no level-1 heading.`,
+    });
+  }
+
+  if (firstNonEmptyLine === undefined || !H1_LINE_PATTERN.test(firstNonEmptyLine)) {
+    errors.push({
+      code: 'H1_NOT_FIRST',
+      detail: `The first non-empty line of ${chapter.path} is not its level-1 heading.`,
+    });
+  }
+
+  if (headingLine === undefined) {
+    return errors;
+  }
+
+  const headingMatch = H1_HEADING_PATTERN.exec(headingLine);
+  if (headingMatch === null || headingMatch[2]!.trim().length === 0) {
+    errors.push({
+      code: 'H1_MALFORMED',
+      detail: `Heading "${headingLine}" in ${chapter.path} does not match "# Chapter <N>: <Title>".`,
+    });
+    return errors;
+  }
+
+  const headingNumber = Number.parseInt(headingMatch[1]!, 10);
+  if (pathNumber !== undefined && headingNumber !== pathNumber) {
+    errors.push({
+      code: 'H1_NUMBER_MISMATCH',
+      detail: `${chapter.path} declares chapter ${headingNumber}, whose path should be ${getChapterFilePath(headingNumber)}.`,
+    });
+  }
+
+  return errors;
+}
+
+export function validateManuscriptStructure(chapters: ChapterFile[]): ManuscriptValidation {
+  const errors: ManuscriptError[] = [];
+  const chapterNumbers: number[] = [];
+
+  for (const chapter of chapters) {
+    const chapterNumber = chapterNumberFromPath(chapter.path);
+    errors.push(...validateChapter(chapter, chapterNumber));
+    if (chapterNumber !== undefined) {
+      chapterNumbers.push(chapterNumber);
+    }
+  }
+
+  const seen = new Set<number>();
+  const reportedDuplicates = new Set<number>();
+  for (const chapterNumber of chapterNumbers) {
+    if (seen.has(chapterNumber) && !reportedDuplicates.has(chapterNumber)) {
+      reportedDuplicates.add(chapterNumber);
+      errors.push({
+        code: 'CHAPTER_DUPLICATE',
+        detail: `Chapter ${chapterNumber} (${getChapterFilePath(chapterNumber)}) appears more than once.`,
+      });
+    }
+    seen.add(chapterNumber);
+  }
+
+  const uniqueNumbers = [...seen].sort((a, b) => a - b);
+  if (uniqueNumbers.some((chapterNumber, index) => chapterNumber !== index + 1)) {
+    errors.push({
+      code: 'CHAPTER_GAP',
+      detail: `Chapter numbers are ${uniqueNumbers.join(', ')}; expected ${uniqueNumbers
+        .map((_, index) => index + 1)
+        .join(', ')} with no gaps.`,
+    });
+  }
+
+  errors.sort((a, b) => (a.code < b.code ? -1 : a.code > b.code ? 1 : 0));
+
+  return { valid: errors.length === 0, errors };
+}
