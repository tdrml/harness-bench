@@ -0,0 +1,79 @@
+import type { KdpListing, ListingError, ListingValidation } from './types.js';
+
+/** Maximum KDP book description length, including HTML tags. */
+export const MAX_BLURB_LENGTH = 4000;
+
+/** KDP gives exactly 7 backend keyword slots. */
+export const REQUIRED_KEYWORD_COUNT = 7;
+
+/** KDP allows exactly 3 browse categories. */
+export const REQUIRED_CATEGORY_COUNT = 3;
+
+/** HTML tags KDP accepts inside a book description. */
+export const ALLOWED_BLURB_TAGS = ['b', 'i', 'u', 'br', 'p', 'ul', 'li', 'ol', 'h4', 'h5', 'h6'];
+
+const PLACEHOLDER_MARKER = 'TODO:';
+
+const TAG_PATTERN = /<\s*\/?\s*([a-zA-Z][a-zA-Z0-9]*)[^>]*>/g;
+
+function findDisallowedTags(blurb: string): string[] {
+  const allowed = new Set(ALLOWED_BLURB_TAGS);
+  const disallowed: string[] = [];
+  for (const match of blurb.matchAll(TAG_PATTERN)) {
+    const tag = match[1]?.toLowerCase();
+    if (tag !== undefined && !allowed.has(tag) && !disallowed.includes(tag)) {
+      disallowed.push(tag);
+    }
+  }
+  return disallowed;
+}
+
+export function validateListing(listing: KdpListing): ListingValidation {
+  const { title, subtitle, blurb, keywords, categories, author } = listing;
+  const errors: ListingError[] = [];
+
+  if (blurb.length > MAX_BLURB_LENGTH) {
+    errors.push({
+      code: 'BLURB_TOO_LONG',
+      detail: `Blurb is ${blurb.length} characters, exceeding the maximum of ${MAX_BLURB_LENGTH}.`,
+    });
+  }
+
+  if (blurb.trim().length === 0) {
+    errors.push({ code: 'BLURB_EMPTY', detail: 'Blurb is empty or whitespace only.' });
+  }
+
+  if (keywords.length !== REQUIRED_KEYWORD_COUNT) {
+    errors.push({
+      code: 'KEYWORD_COUNT',
+      detail: `Expected exactly ${REQUIRED_KEYWORD_COUNT} keywords, found ${keywords.length}.`,
+    });
+  }
+
+  if (categories.length !== REQUIRED_CATEGORY_COUNT) {
+    errors.push({
+      code: 'CATEGORY_COUNT',
+      detail: `Expected exactly ${REQUIRED_CATEGORY_COUNT} categories, found ${categories.length}.`,
+    });
+  }
+
+  const stringFields = [title, subtitle ?? '', blurb, author, ...keywords, ...categories];
+  if (stringFields.some((field) => field.includes(PLACEHOLDER_MARKER))) {
+    errors.push({
+      code: 'UNRESOLVED_PLACEHOLDER',
+      detail: `Listing contains an unresolved "${PLACEHOLDER_MARKER}" placeholder.`,
+    });
+  }
+
+  const disallowedTags = findDisallowedTags(blurb);
+  if (disallowedTags.length > 0) {
+    errors.push({
+      code: 'DISALLOWED_HTML',
+      detail: `Blurb contains disallowed HTML tags: ${disallowedTags.join(', ')}.`,
+    });
+  }
+
+  errors.sort((a, b) => (a.code < b.code ? -1 : a.code > b.code ? 1 : 0));
+
+  return { valid: errors.length === 0, errors };
+}
