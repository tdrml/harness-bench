@@ -0,0 +1,166 @@
+import type { ChapterFile, KdpListing, ListingError, ListingValidation, ManuscriptError, ManuscriptValidation } from './types.js';
+
+export const MAX_BLURB_LENGTH = 4000;
+export const REQUIRED_KEYWORD_COUNT = 7;
+export const REQUIRED_CATEGORY_COUNT = 3;
+export const ALLOWED_BLURB_TAGS = ['b', 'i', 'u', 'br', 'p', 'ul', 'li', 'ol', 'h4', 'h5', 'h6'];
+
+export function validateListing(listing: KdpListing): ListingValidation {
+  const errors: ListingError[] = [];
+
+  // Check BLURB_TOO_LONG
+  if (listing.blurb.length > MAX_BLURB_LENGTH) {
+    errors.push({ code: 'BLURB_TOO_LONG', detail: `Blurb exceeds maximum length of ${MAX_BLURB_LENGTH} characters.` });
+  }
+
+  // Check BLURB_EMPTY
+  if (listing.blurb.trim().length === 0) {
+    errors.push({ code: 'BLURB_EMPTY', detail: 'Blurb is empty or whitespace only.' });
+  }
+
+  // Check KEYWORD_COUNT
+  if (listing.keywords.length !== REQUIRED_KEYWORD_COUNT) {
+    errors.push({ code: 'KEYWORD_COUNT', detail: `Keywords count must be exactly ${REQUIRED_KEYWORD_COUNT}, got ${listing.keywords.length}.` });
+  }
+
+  // Check CATEGORY_COUNT
+  if (listing.categories.length !== REQUIRED_CATEGORY_COUNT) {
+    errors.push({ code: 'CATEGORY_COUNT', detail: `Categories count must be exactly ${REQUIRED_CATEGORY_COUNT}, got ${listing.categories.length}.` });
+  }
+
+  // Check UNRESOLVED_PLACEHOLDER - one error total for any TODO: in any string field
+  const allStringFields = [
+    listing.title,
+    listing.subtitle,
+    listing.blurb,
+    listing.author,
+    ...listing.keywords,
+    ...listing.categories,
+  ];
+
+  const hasTodo = allStringFields.some((field) => field !== undefined && field.includes('TODO:'));
+  if (hasTodo) {
+    errors.push({ code: 'UNRESOLVED_PLACEHOLDER', detail: 'Listing contains unresolved placeholder (TODO:).' });
+  }
+
+  // Check DISALLOWED_HTML - one error total if any disallowed tags found
+  if (!hasDisallowedHtml(listing.blurb, ALLOWED_BLURB_TAGS)) {
+    // No error, so we continue
+  } else {
+    errors.push({ code: 'DISALLOWED_HTML', detail: 'Blurb contains HTML tags outside the allowed list.' });
+  }
+
+  // Sort errors by code lexicographically
+  errors.sort((a, b) => a.code.localeCompare(b.code));
+
+  return {
+    valid: errors.length === 0,
+    errors,
+  };
+}
+
+export function validateManuscriptStructure(chapters: ChapterFile[]): ManuscriptValidation {
+  const errors: ManuscriptError[] = [];
+  const chapterNumbers = new Set<number>();
+  const numberToChapters = new Map<number, number>();
+
+  for (let i = 0; i < chapters.length; i++) {
+    const chapter = chapters[i]!;
+    const pathChapterNumber = extractChapterNumber(chapter.path);
+
+    if (pathChapterNumber === null) {
+      continue;
+    }
+
+    chapterNumbers.add(pathChapterNumber);
+    numberToChapters.set(pathChapterNumber, (numberToChapters.get(pathChapterNumber) ?? 0) + 1);
+
+    const lines = chapter.content.split('\n');
+    const nonEmptyLines = lines.filter((line) => line.trim().length > 0);
+
+    // H1_MISSING check
+    const h1Line = nonEmptyLines.find((line) => line.trim().startsWith('# '));
+    if (!h1Line) {
+      errors.push({ code: 'H1_MISSING', detail: `Chapter at ${chapter.path} has no level-1 heading.` });
+      continue;
+    }
+
+    // H1_NOT_FIRST check
+    if (nonEmptyLines.length > 0 && nonEmptyLines[0] !== h1Line) {
+      errors.push({ code: 'H1_NOT_FIRST', detail: `Chapter at ${chapter.path} has content before the level-1 heading.` });
+    }
+
+    // H1_MALFORMED and H1_NUMBER_MISMATCH checks (skipped if H1_MISSING)
+    const h1Match = h1Line.match(/^#\s+Chapter\s+(\d+):\s+(.+)$/);
+    if (!h1Match) {
+      errors.push({ code: 'H1_MALFORMED', detail: `Chapter at ${chapter.path} has malformed level-1 heading.` });
+    } else {
+      const h1ChapterNumber = parseInt(h1Match[1]!, 10);
+      const h1Title = h1Match[2]!.trim();
+
+      // Check if title is non-empty
+      if (!h1Title) {
+        errors.push({ code: 'H1_MALFORMED', detail: `Chapter at ${chapter.path} has malformed level-1 heading.` });
+      } else if (h1ChapterNumber !== pathChapterNumber) {
+        // H1_NUMBER_MISMATCH check
+        errors.push({
+          code: 'H1_NUMBER_MISMATCH',
+          detail: `Chapter at ${chapter.path} has heading number ${h1ChapterNumber} but path indicates ${pathChapterNumber}.`,
+        });
+      }
+    }
+  }
+
+  // CHAPTER_DUPLICATE check
+  numberToChapters.forEach((count, number) => {
+    if (count > 1) {
+      errors.push({ code: 'CHAPTER_DUPLICATE', detail: `Chapter ${number} appears ${count} times.` });
+    }
+  });
+
+  // CHAPTER_GAP check
+  if (chapterNumbers.size > 0) {
+    const sortedNumbers = Array.from(chapterNumbers).sort((a, b) => a - b);
+    const expectedNumbers = Array.from({ length: sortedNumbers[sortedNumbers.length - 1]! }, (_, i) => i + 1);
+    const hasGap = JSON.stringify(sortedNumbers) !== JSON.stringify(expectedNumbers);
+
+    if (hasGap) {
+      errors.push({
+        code: 'CHAPTER_GAP',
+        detail: `Chapter numbers do not form a continuous sequence from 1 to ${sortedNumbers[sortedNumbers.length - 1]}.`,
+      });
+    }
+  }
+
+  // Sort errors by code lexicographically
+  errors.sort((a, b) => a.code.localeCompare(b.code));
+
+  return {
+    valid: errors.length === 0,
+    errors,
+  };
+}
+
+function extractChapterNumber(path: string): number | null {
+  const match = path.match(/chapter-(\d+)\.md$/);
+  if (!match || !match[1]) {
+    return null;
+  }
+  return parseInt(match[1], 10);
+}
+
+function hasDisallowedHtml(text: string, allowedTags: string[]): boolean {
+  // Match HTML tags (opening, closing, and self-closing)
+  const tagRegex = /<\/?([a-zA-Z0-9]+)[\s>\/]*>/g;
+  const lowerAllowedTags = allowedTags.map((t) => t.toLowerCase());
+
+  let match;
+  while ((match = tagRegex.exec(text)) !== null) {
+    const tagName = match[1]?.toLowerCase();
+    if (tagName && !lowerAllowedTags.includes(tagName)) {
+      return true; // Found a disallowed tag
+    }
+  }
+
+  return false; // All tags are allowed (or no tags present)
+}
