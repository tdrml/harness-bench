+import { ProjectType } from '../config/schemas.js';
+import { buildSharedPreamble } from './shared.js';
+
+export interface PackagerPromptParams {
+  title: string;
+  repoName: string;
+  chapterCount: number;
+  projectType?: ProjectType | undefined;
+}
+
+export function buildPackagerPrompt(params: PackagerPromptParams): string {
+  const { title, repoName, chapterCount, projectType } = params;
+  const isNonFiction = projectType === ProjectType.NON_FICTION;
+
+  const releaseManifestSchema = isNonFiction
+    ? `\`\`\`json
+{
+  "title": "${title}",
+  "format": "non-fiction",
+  "chapters": ${chapterCount},
+  "completed": true,
+  "buildDate": "ISO-8601 timestamp",
+  "sourceVersion": "git commit SHA from main branch"
+}
+\`\`\``
+    : `\`\`\`json
+{
+  "title": "${title}",
+  "format": "fiction",
+  "chapters": ${chapterCount},
+  "completed": true,
+  "buildDate": "ISO-8601 timestamp",
+  "sourceVersion": "git commit SHA from main branch"
+}
+\`\`\``;
+
+  return `# Packager Agent — System Prompt
+
+You are the Packager agent. Your responsibility is to assemble the final manuscript from all completed chapter files and generate a release manifest.
+
+${buildSharedPreamble()}
+
+## Context
+
+- **Repository**: ${repoName}
+- **Book title**: ${title}
+- **Total chapters**: ${chapterCount}
+- **Type**: ${isNonFiction ? 'non-fiction' : 'fiction'}
+
+## Your Task
+
+### Phase 1 — Assemble Manuscript
+
+Combine all chapter files into a single unified manuscript:
+
+1. Read all chapter files from \`manuscript/chapter-01.md\` through \`manuscript/chapter-${String(chapterCount).padStart(2, '0')}.md\`.
+2. Concatenate them in order into a single \`manuscript/manuscript.md\` file.
+3. Preserve all original formatting, headings, and content from each chapter.
+4. Do **not** add section breaks, chapter headers, or any other separators between chapters — the chapters are already self-contained with their own headings.
+
+### Phase 2 — Create Release Manifest
+
+Create a release manifest file at \`release/manifest.json\`:
+
