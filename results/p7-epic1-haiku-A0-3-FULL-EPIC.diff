+  code: string;
+  detail: string;
+}
+
+export interface ManuscriptValidation {
+  valid: boolean;
+  errors: ManuscriptError[];
+}
+
+export const MAX_BLURB_LENGTH = 4000;
+export const REQUIRED_KEYWORD_COUNT = 7;
+export const REQUIRED_CATEGORY_COUNT = 3;
+export const ALLOWED_BLURB_TAGS = ['b', 'i', 'u', 'br', 'p', 'ul', 'li', 'ol', 'h4', 'h5', 'h6'];
diff --git a/packages/core/src/release-policy/validate.ts b/packages/core/src/release-policy/validate.ts
new file mode 100644
index 0000000..4b5003c
--- /dev/null
+++ b/packages/core/src/release-policy/validate.ts
@@ -0,0 +1,199 @@
+import type {
+  KdpListing,
+  ListingError,
+  ListingValidation,
+  ChapterFile,
+  ManuscriptError,
+  ManuscriptValidation,
+} from './types.js';
+import {
+  MAX_BLURB_LENGTH,
+  REQUIRED_KEYWORD_COUNT,
+  REQUIRED_CATEGORY_COUNT,
+  ALLOWED_BLURB_TAGS,
+} from './types.js';
+import { getChapterFilePath } from '../writing/paths.js';
+
+export function validateListing(listing: KdpListing): ListingValidation {
+  const errors: ListingError[] = [];
+
+  // Check BLURB_TOO_LONG
+  if (listing.blurb.length > MAX_BLURB_LENGTH) {
+    errors.push({
+      code: 'BLURB_TOO_LONG',
+      detail: `Blurb exceeds maximum length of ${MAX_BLURB_LENGTH} characters (current: ${listing.blurb.length})`,
+    });
+  }
+
+  // Check BLURB_EMPTY
+  if (!listing.blurb.trim()) {
+    errors.push({
+      code: 'BLURB_EMPTY',
+      detail: 'Blurb is empty or contains only whitespace',
+    });
+  }
+
+  // Check KEYWORD_COUNT
+  if (listing.keywords.length !== REQUIRED_KEYWORD_COUNT) {
+    errors.push({
+      code: 'KEYWORD_COUNT',
+      detail: `Keywords count must be exactly ${REQUIRED_KEYWORD_COUNT} (current: ${listing.keywords.length})`,
+    });
+  }
+
+  // Check CATEGORY_COUNT
+  if (listing.categories.length !== REQUIRED_CATEGORY_COUNT) {
+    errors.push({
+      code: 'CATEGORY_COUNT',
+      detail: `Categories count must be exactly ${REQUIRED_CATEGORY_COUNT} (current: ${listing.categories.length})`,
+    });
+  }
+
+  // Check UNRESOLVED_PLACEHOLDER - one error total for any TODO: substring
+  const fieldsToCheck = [
+    listing.title,
+    listing.subtitle ?? '',
+    listing.blurb,
+    listing.author,
+    ...listing.keywords,
+    ...listing.categories,
+  ];
+  if (fieldsToCheck.some((field) => field.includes('TODO:'))) {
+    errors.push({
+      code: 'UNRESOLVED_PLACEHOLDER',
+      detail: 'Listing contains unresolved placeholder text (TODO:)',
+    });
+  }
+
+  // Check DISALLOWED_HTML - one error total
+  const disallowedTags = findDisallowedHtmlTags(listing.blurb);
+  if (disallowedTags.length > 0) {
+    errors.push({
+      code: 'DISALLOWED_HTML',
+      detail: `Blurb contains disallowed HTML tags: ${disallowedTags.join(', ')}`,
+    });
+  }
+
+  // Sort errors by code (lexicographic order)
+  errors.sort((a, b) => a.code.localeCompare(b.code));
+
+  return {
+    valid: errors.length === 0,
+    errors,
+  };
+}
+
+function findDisallowedHtmlTags(text: string): string[] {
+  const allowedTagsLower = ALLOWED_BLURB_TAGS.map((tag) => tag.toLowerCase());
+  const tagRegex = /<\/?(\w+)[^>]*>/g;
+  const foundTags = new Set<string>();
+
+  let match;
+  while ((match = tagRegex.exec(text)) !== null) {
+    const tagName = match[1];
+    if (tagName !== undefined) {
+      const tagNameLower = tagName.toLowerCase();
+      if (!allowedTagsLower.includes(tagNameLower)) {
+        foundTags.add(tagNameLower);
+      }
+    }
+  }
+
+  return Array.from(foundTags).sort();
+}
+
+export function validateManuscriptStructure(chapters: ChapterFile[]): ManuscriptValidation {
+  const errors: ManuscriptError[] = [];
+  const chapterNumbers: number[] = [];
+
+  for (const chapter of chapters) {
+    const chapterNumber = extractChapterNumber(chapter.path);
+    chapterNumbers.push(chapterNumber);
+
+    const lines = chapter.content.split('\n').map((line) => line.trimEnd());
+    const firstNonEmptyLineIndex = lines.findIndex((line) => line.length > 0);
+    const firstNonEmptyLine = firstNonEmptyLineIndex >= 0 ? lines[firstNonEmptyLineIndex] : null;
+
+    const h1Heading = lines.find((line) => line.startsWith('# ')) ?? null;
+
+    // Rule 1: H1_MISSING
+    if (!h1Heading) {
+      errors.push({
+        code: 'H1_MISSING',
+        detail: `Chapter at path "${chapter.path}" has no level-1 markdown heading`,
+      });
+      continue;
+    }
+
+    // Rule 2: H1_NOT_FIRST
+    if (firstNonEmptyLine !== h1Heading) {
+      errors.push({
+        code: 'H1_NOT_FIRST',
+        detail: `Chapter at path "${chapter.path}" has level-1 heading that is not the first non-empty line`,
+      });
+    }
+
+    // Rule 3: H1_MALFORMED
+    const h1Match = h1Heading.match(/^# Chapter (\d+): (.+)$/);
+    if (!h1Match) {
+      errors.push({
+        code: 'H1_MALFORMED',
+        detail: `Chapter at path "${chapter.path}" has malformed level-1 heading (expected format: "# Chapter <N>: <Title>")`,
+      });
+      continue;
+    }
+
+    const headingNumber = parseInt(h1Match[1] ?? '0', 10);
+
+    // Rule 4: H1_NUMBER_MISMATCH
+    if (chapterNumber !== headingNumber) {
+      errors.push({
+        code: 'H1_NUMBER_MISMATCH',
+        detail: `Chapter at path "${chapter.path}" has heading number ${headingNumber} but path indicates chapter ${chapterNumber}`,
+      });
+    }
+  }
+
+  // Rule 5: CHAPTER_DUPLICATE
+  const uniqueNumbers = new Set(chapterNumbers);
+  if (uniqueNumbers.size < chapterNumbers.length) {
+    const duplicates = chapterNumbers.filter(
+      (num, index) => chapterNumbers.indexOf(num) !== index
+    );
+    const uniqueDuplicates = Array.from(new Set(duplicates));
+    for (const num of uniqueDuplicates) {
+      errors.push({
+        code: 'CHAPTER_DUPLICATE',
+        detail: `Multiple chapters resolve to chapter number ${num}`,
+      });
+    }
+  }
+
+  // Rule 6: CHAPTER_GAP
+  if (chapterNumbers.length > 0) {
+    const sortedNumbers = [...chapterNumbers].sort((a, b) => a - b);
+    const expectedNumbers = Array.from({ length: sortedNumbers.length }, (_, i) => i + 1);
+    if (JSON.stringify(sortedNumbers) !== JSON.stringify(expectedNumbers)) {
+      errors.push({
+        code: 'CHAPTER_GAP',
+        detail: `Chapter numbers must form a sequence from 1 to ${sortedNumbers.length} with no gaps (found: ${sortedNumbers.join(', ')})`,
+      });
+    }
+  }
+
+  // Sort errors by code
+  errors.sort((a, b) => a.code.localeCompare(b.code));
+
+  return {
+    valid: errors.length === 0,
+    errors,
+  };
+}
+
+function extractChapterNumber(path: string): number {
+  const match = path.match(/chapter-(\d+)/);
+  if (match && match[1] !== undefined) {
+    return parseInt(match[1], 10);
+  }
+  return 0;
+}
diff --git a/packages/core/src/word-count-policy/__tests__/word-count-policy.test.ts b/packages/core/src/word-count-policy/__tests__/word-count-policy.test.ts
