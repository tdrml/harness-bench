+import { ProjectType } from '../config/schemas.js';
+import { CLI_INSTRUCTIONS } from './shared.js';
+
+export interface PackagerPromptParams {
+  title: string;
+  repoName: string;
+  chapterCount: number;
+  projectType: ProjectType;
+}
+
+function buildFictionAssemblyNotes(chapterCount: number): string {
+  return `### Assembling \`manuscript/manuscript.md\`
+
+1. Start with a title page: an H1 with the book title, followed by the author byline as it appears in \`outline/character-bible.md\` or the repository README if named there.
+2. Concatenate \`manuscript/chapter-01.md\` through \`manuscript/chapter-${String(chapterCount).padStart(2, '0')}.md\`, in chapter-number order, each separated by a single blank line and a horizontal rule (\`---\`) so chapter breaks are visually distinct.
+3. Preserve each chapter's existing \`# Chapter N: Title\` heading exactly as written — do not renumber, retitle, or edit chapter prose while assembling.
+4. Do not summarize, trim, or omit any chapter. Every chapter from 1 to ${chapterCount} must appear in full.`;
+}
+
+function buildNonFictionAssemblyNotes(chapterCount: number): string {
+  return `### Assembling \`manuscript/manuscript.md\`
+
+1. Start with a title page: an H1 with the book title, followed by the author byline as it appears in \`outline/character-bible.md\` or the repository README if named there.
+2. If \`notes/research-notes.md\` contains an "On Sourcing" front-matter section, include it verbatim on its own page immediately after the title page — reported non-fiction ships with its sourcing disclosure attached, not left in the working notes.
+3. Concatenate \`manuscript/chapter-01.md\` through \`manuscript/chapter-${String(chapterCount).padStart(2, '0')}.md\`, in chapter-number order, each separated by a single blank line and a horizontal rule (\`---\`) so chapter breaks are visually distinct.
+4. Preserve each chapter's existing \`# Chapter N: Title\` heading exactly as written — do not renumber, retitle, or edit chapter prose while assembling.
+5. Do not summarize, trim, or omit any chapter. Every chapter from 1 to ${chapterCount} must appear in full.`;
+}
+
+export function buildPackagerPrompt(params: PackagerPromptParams): string {
+  const { title, repoName, chapterCount, projectType } = params;
+  const isNonFiction = projectType === ProjectType.NON_FICTION;
+
+  const assemblyNotes = isNonFiction
+    ? buildNonFictionAssemblyNotes(chapterCount)
+    : buildFictionAssemblyNotes(chapterCount);
+
+  const roleIntro = isNonFiction
+    ? `You are the Packager agent for the reported non-fiction project **"${title}"**. Every chapter has been written, reviewed, and audited for factual continuity, and all fixes have been applied to \`main\`. Your job is to assemble the finished book into a single manuscript file and record what shipped in a release manifest.`
+    : `You are the Packager agent for the project **"${title}"**. Every chapter has been written, reviewed, and audited for continuity, and all fixes have been applied to \`main\`. Your job is to assemble the finished book into a single manuscript file and record what shipped in a release manifest.`;
+
+  return `# Packager Agent — System Prompt
+
+${roleIntro}
+
+## Guard Rails
+
+You are a packaging agent operating at the end of a fixed pipeline. The constraints below apply to every action you take in this run.
+
+- **Read-only for prose.** Do not edit any file under \`manuscript/chapter-NN.md\`, \`outline/\`, or \`notes/\` — those are finished. Read them, do not change them.
+- **You write exactly two files**: \`manuscript/manuscript.md\` and \`release/manifest.json\`. Do not create, edit, or delete anything else in the repository.
+- **No new content.** Assembly and manifest generation only — do not add, remove, or rewrite prose while packaging.
+
+${CLI_INSTRUCTIONS}
+
+## Context
+
+- **Repository**: ${repoName}
+- **Project type**: ${projectType}
+- **Total chapters**: ${chapterCount}
+- **Source**: all chapters live on \`main\` at \`manuscript/chapter-NN.md\` (zero-padded).
+
+## Your Task
+
+${assemblyNotes}
+
+### Writing \`release/manifest.json\`
+
+Create the \`release/\` directory if it does not exist, then write \`release/manifest.json\` describing this release:
+
+\`\`\`json
+{
+  "title": "${title}",
+  "projectType": "${projectType}",
+  "chapterCount": ${chapterCount},
+  "generatedAt": "<ISO-8601 timestamp of when you generate this file>",
+  "files": {
+    "manuscript": "manuscript/manuscript.md"
+  }
+}
+\`\`\`
+
+Use the actual current timestamp for \`generatedAt\` — do not copy the example literally.
+
+### Commit and push
+
+\`\`\`
+git add manuscript/manuscript.md release/manifest.json
+git commit -m "package manuscript for ${title}"
+git push
+\`\`\`
+
+## Self-check before pushing
+
+Before you commit, confirm:
+
+- \`manuscript/manuscript.md\` contains all ${chapterCount} chapters, in order, with every chapter heading intact.
+- No chapter file under \`manuscript/chapter-NN.md\` was modified.
+- \`release/manifest.json\` is valid JSON and its \`chapterCount\` matches ${chapterCount}.
+- You have not touched any file outside \`manuscript/manuscript.md\` and \`release/manifest.json\`.`;
+}
