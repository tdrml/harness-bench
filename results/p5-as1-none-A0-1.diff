@@ -275,6 +275,76 @@ describe('validateWordCount', () => {
     expect(result.wordCount).toBe(0);
     expect(result.valid).toBe(true);
   });
+
+  describe('strict mode', () => {
+    it('treats em-dashes as word separators', () => {
+      const text = 'fire—and—forget';
+      const result = validateWordCount(text, { min: 1, max: 10 }, { mode: 'strict' });
+      expect(result.wordCount).toBe(3);
+    });
+
+    it('excludes pure-number tokens from count', () => {
+      const text = 'The number 3 is small but 1000 is large';
+      const result = validateWordCount(text, { min: 1, max: 20 }, { mode: 'strict' });
+      // "The number is small but is large" = 7 words (3 and 1000 excluded)
+      expect(result.wordCount).toBe(7);
+    });
+
+    it('excludes decimal numbers from count', () => {
+      const text = 'Pi is 3.14 and tau is 6.28';
+      const result = validateWordCount(text, { min: 1, max: 20 }, { mode: 'strict' });
+      // "Pi is and tau is" = 5 words (3.14 and 6.28 excluded)
+      expect(result.wordCount).toBe(5);
+    });
+
+    it('excludes comma-formatted numbers from count', () => {
+      const text = 'The population is 1,000,000 people';
+      const result = validateWordCount(text, { min: 1, max: 20 }, { mode: 'strict' });
+      // "The population is people" = 4 words (1,000,000 excluded)
+      expect(result.wordCount).toBe(4);
+    });
+
+    it('counts tokens mixing digits and letters', () => {
+      const text = '3rd place and v2 release';
+      const result = validateWordCount(text, { min: 1, max: 10 }, { mode: 'strict' });
+      // "3rd place and v2 release" = 5 words (3rd and v2 still count)
+      expect(result.wordCount).toBe(5);
+    });
+
+    it('handles hyphenated compounds as one word', () => {
+      const text = 'state-of-the-art technology';
+      const result = validateWordCount(text, { min: 1, max: 10 }, { mode: 'strict' });
+      // "state-of-the-art technology" = 2 words
+      expect(result.wordCount).toBe(2);
+    });
+
+    it('combines em-dashes and number exclusion', () => {
+      const text = 'Chapter 5 discusses the fire—and—forget pattern with 3 examples';
+      const result = validateWordCount(text, { min: 1, max: 20 }, { mode: 'strict' });
+      // "Chapter discusses the fire and forget pattern with examples" = 9 words
+      // (5 and 3 excluded, em-dashes create 3 words from fire—and—forget)
+      expect(result.wordCount).toBe(9);
+    });
+
+    it('returns correct valid/deviation flags with strict mode', () => {
+      const text = '1 2 3 alpha beta';
+      const result = validateWordCount(text, { min: 2, max: 5 }, { mode: 'strict' });
+      // "alpha beta" = 2 words (1, 2, 3 excluded)
+      expect(result.wordCount).toBe(2);
+      expect(result.valid).toBe(true);
+      expect(result.deviation).toBe(0);
+    });
+
+    it('maintains strict mode over legacy with same text', () => {
+      const text = 'fire—and—forget costs 100 dollars';
+      const legacyResult = validateWordCount(text, { min: 1, max: 100 });
+      const strictResult = validateWordCount(text, { min: 1, max: 100 }, { mode: 'strict' });
+      // Legacy: "fire—and—forget costs 100 dollars" = 4 words
+      // Strict: "fire and forget costs dollars" = 5 words (em-dashes separate, 100 excluded)
+      expect(legacyResult.wordCount).toBe(4);
+      expect(strictResult.wordCount).toBe(5);
+    });
+  });
 });
 
