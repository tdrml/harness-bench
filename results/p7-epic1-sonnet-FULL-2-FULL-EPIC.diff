+      await projectService.updateStatus(projectId, 'RELEASING');
+
+      await enqueueReaction(
+        config.SQS_QUEUE_URL,
+        { type: 'GENERATE_LISTING', projectId },
+        runId,
+      );
+
+      logger.info('Packager succeeded, project marked RELEASING, enqueued GENERATE_LISTING', {
+        projectId,
+        runId,
+      });
+      break;
+    }
+
+    case 'marketer': {
+      // Marketer wrote the store listing — read it back from main, validate
+      // it against KDP's field requirements, and finalize the release status.
+      let validation: ReturnType<typeof validateListing>;
+      try {
+        const listingFile = await github.getFileContent(repo, 'release/listing.json', 'main');
+        const listingContent = Buffer.from(listingFile.content, 'base64').toString('utf-8');
+        const listing = JSON.parse(listingContent) as KdpListing;
+        validation = validateListing(listing);
+      } catch (err) {
+        await projectService.updateStatus(projectId, 'FAILED');
+        logger.error('Marketer succeeded but release/listing.json is missing or unparseable', {
+          projectId,
+          runId,
+          error: err instanceof Error ? err.message : String(err),
+        });
+        break;
+      }
+
+      if (validation.valid) {
+        await projectService.updateStatus(projectId, 'RELEASED');
+        logger.info('Marketer succeeded, listing valid, project released', {
+          projectId,
+          runId,
+        });
+      } else {
+        await projectService.updateStatus(projectId, 'FAILED');
+        logger.error('Marketer succeeded but listing failed validation', {
+          projectId,
+          runId,
+          errorCodes: validation.errors.map((e) => e.code),
+        });
+      }
+      break;
+    }
