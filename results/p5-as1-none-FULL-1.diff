+      const resultStrict = validateWordCount(text, { min: 0, max: 20 }, { mode: 'strict' });
+      expect(resultLegacy.wordCount).toBe(6);
+      expect(resultStrict.wordCount).toBe(4);
+    });
+
+    it('excludes comma-separated numbers in strict mode', () => {
+      const text = 'It costs 1,000 dollars and 2,500 cents';
+      const resultLegacy = validateWordCount(text, { min: 0, max: 20 }, { mode: 'legacy' });
+      const resultStrict = validateWordCount(text, { min: 0, max: 20 }, { mode: 'strict' });
+      expect(resultLegacy.wordCount).toBe(7);
+      expect(resultStrict.wordCount).toBe(5);
+    });
+
+    it('counts hyphenated compounds as one word in strict mode', () => {
+      const text = 'state-of-the-art design';
+      const resultStrict = validateWordCount(text, { min: 0, max: 10 }, { mode: 'strict' });
+      expect(resultStrict.wordCount).toBe(2);
+    });
+
+    it('counts alphanumeric tokens like 3rd and v2 in strict mode', () => {
+      const text = 'The 3rd version and v2 release';
+      const resultLegacy = validateWordCount(text, { min: 0, max: 20 }, { mode: 'legacy' });
+      const resultStrict = validateWordCount(text, { min: 0, max: 20 }, { mode: 'strict' });
+      expect(resultLegacy.wordCount).toBe(6);
+      expect(resultStrict.wordCount).toBe(6);
+    });
+
+    it('combines em-dash splitting and number exclusion in strict mode', () => {
+      const text = 'Chapter 1—with 5 scenes—and 3.14 length';
+      const resultStrict = validateWordCount(text, { min: 0, max: 20 }, { mode: 'strict' });
+      // "Chapter" / "with" / "scenes" / "and" / "length" = 5 words
