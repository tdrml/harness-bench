+
+  async findTaskByRepoAndPrNumber(
+    repoFullName: string,
+    prNumber: number,
+  ): Promise<{ projectId: string; task: Task } | undefined> {
+    const parts = repoFullName.split('/');
+    if (parts.length !== 2 || !parts[0] || !parts[1]) {
+      return undefined;
+    }
+    const [repoOwner, repoName] = parts;
+
+    let lastEvaluatedKey: Record<string, unknown> | undefined;
+    do {
+      const result = await this.client.send(
+        new ScanCommand({
+          TableName: this.projectsTableName,
+          FilterExpression: 'repoOwner = :repoOwner AND repoName = :repoName',
+          ExpressionAttributeValues: {
+            ':repoOwner': repoOwner,
+            ':repoName': repoName,
+          },
+          ExclusiveStartKey: lastEvaluatedKey,
+        }),
+      );
+
+      const projects = (result.Items ?? []) as Project[];
+      for (const project of projects) {
+        const tasks = await this.getGraph(project.projectId);
+        const task = tasks.find((t) => t.prNumber === prNumber);
+        if (task) {
+          return { projectId: project.projectId, task };
+        }
+      }
+
+      lastEvaluatedKey = result.LastEvaluatedKey as Record<string, unknown> | undefined;
+    } while (lastEvaluatedKey);
+
+    return undefined;
+  }
 }
