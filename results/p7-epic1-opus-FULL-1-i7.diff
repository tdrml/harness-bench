+import { describe, it, expect } from 'vitest';
+import {
+  resolveChapterTarget,
+  resolveWordCountRange,
+  resolveTolerance,
+  formatToleranceForPrompt,
+  clampToProjectType,
+} from '../index.js';
+import { ProjectType } from '../../config/schemas.js';
+
+describe('resolveChapterTarget', () => {
+  it('floors the per-chapter share of the target word count', () => {
+    expect(resolveChapterTarget({ targetWordCount: 90_000, chapterCount: 3 })).toBe(30_000);
+    expect(resolveChapterTarget({ targetWordCount: 100_000, chapterCount: 3 })).toBe(33_333);
+  });
+
+  it('throws when chapterCount is zero', () => {
+    expect(() => resolveChapterTarget({ targetWordCount: 90_000, chapterCount: 0 })).toThrow(
+      /chapterCount must be positive/,
+    );
+  });
+
+  it('throws when chapterCount is negative', () => {
+    expect(() => resolveChapterTarget({ targetWordCount: 90_000, chapterCount: -2 })).toThrow(
+      /chapterCount must be positive/,
+    );
+  });
+});
+
+describe('resolveTolerance', () => {
+  it('returns the pinned tolerance per stage', () => {
+    expect(resolveTolerance('writer')).toBe(0.05);
+    expect(resolveTolerance('review')).toBe(0.1);
+    expect(resolveTolerance('merge')).toBe(0.2);
+  });
+});
+
+describe('formatToleranceForPrompt', () => {
+  it('renders the tolerance the way prompts quote it', () => {
+    expect(formatToleranceForPrompt('writer')).toBe('±5%');
+    expect(formatToleranceForPrompt('review')).toBe('±10%');
+    expect(formatToleranceForPrompt('merge')).toBe('±20%');
+  });
+});
+
+describe('resolveWordCountRange', () => {
+  it('builds a floor/ceil band around the chapter target for the writer stage', () => {
+    expect(
+      resolveWordCountRange({ targetWordCount: 90_000, chapterCount: 3, stage: 'writer' }),
+    ).toEqual({ min: 28_500, max: 31_500 });
+  });
+
+  it('widens the band for review and merge', () => {
+    expect(
+      resolveWordCountRange({ targetWordCount: 90_000, chapterCount: 3, stage: 'review' }),
+    ).toEqual({ min: 27_000, max: 33_000 });
+    expect(
+      resolveWordCountRange({ targetWordCount: 90_000, chapterCount: 3, stage: 'merge' }),
+    ).toEqual({ min: 24_000, max: 36_000 });
+  });
+
+  it('rounds the maximum up for every stage, including merge', () => {
+    // target 3333 → merge max 3999.6, which ceils to 4000 rather than flooring.
+    expect(
+      resolveWordCountRange({ targetWordCount: 10_000, chapterCount: 3, stage: 'merge' }),
+    ).toEqual({ min: 2_666, max: 4_000 });
+  });
+
+  it('throws for a non-positive chapter count', () => {
+    expect(() =>
+      resolveWordCountRange({ targetWordCount: 10_000, chapterCount: 0, stage: 'writer' }),
+    ).toThrow(/chapterCount must be positive/);
+  });
+});
+
+describe('clampToProjectType', () => {
+  it('leaves a range already inside the project type band untouched', () => {
+    expect(
+      clampToProjectType({ range: { min: 3_200, max: 4_800 }, projectType: ProjectType.NOVEL }),
+    ).toEqual({ min: 3_200, max: 4_800 });
+  });
+
+  it('raises a low minimum and lowers a high maximum', () => {
+    expect(
+      clampToProjectType({ range: { min: 1_000, max: 9_000 }, projectType: ProjectType.NOVEL }),
+    ).toEqual({ min: 3_000, max: 5_000 });
+  });
+
+  it('collapses a band entirely above the project type band onto its upper bound', () => {
+    expect(
+      clampToProjectType({ range: { min: 24_000, max: 36_000 }, projectType: ProjectType.NOVEL }),
+    ).toEqual({ min: 5_000, max: 5_000 });
+  });
+
+  it('collapses a band entirely below the project type band onto its lower bound', () => {
+    expect(
+      clampToProjectType({ range: { min: 200, max: 400 }, projectType: ProjectType.NOVELLA }),
+    ).toEqual({ min: 2_500, max: 2_500 });
+  });
+
+  it('uses the band of the given project type', () => {
+    expect(
+      clampToProjectType({
+        range: { min: 1_000, max: 20_000 },
+        projectType: ProjectType.SHORT_STORY_COLLECTION,
+      }),
+    ).toEqual({ min: 3_000, max: 8_000 });
+  });
+});
