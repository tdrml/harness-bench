+} from './types.js';
 
 const HTML_TAG_PATTERN = /<\/?\s*([a-zA-Z][a-zA-Z0-9]*)\b[^>]*>/g;
 
@@ -72,3 +80,97 @@ export function validateListing(listing: KdpListing): ListingValidation {
 
   return { valid: errors.length === 0, errors };
 }
+
+const H1_LINE_PATTERN = /^#\s+/;
+const H1_STRUCTURE_PATTERN = /^# Chapter (\d+): (.+)$/;
+
+function chapterNumberFromPath(path: string): number | undefined {
+  const digitsMatch = /(\d+)/.exec(path);
+  if (!digitsMatch) {
+    return undefined;
+  }
+  const candidate = Number(digitsMatch[1]);
+  return getChapterFilePath(candidate) === path ? candidate : undefined;
+}
+
+function validateChapterStructure(chapter: ChapterFile): ManuscriptError[] {
+  const errors: ManuscriptError[] = [];
+  const lines = chapter.content.split('\n');
+  const h1Index = lines.findIndex((line) => H1_LINE_PATTERN.test(line));
+  const firstNonEmptyIndex = lines.findIndex((line) => line.trim().length > 0);
+
+  if (h1Index === -1) {
+    errors.push({ code: 'H1_MISSING', detail: `${chapter.path} has no level-1 markdown heading.` });
+  }
+
+  if (firstNonEmptyIndex !== -1 && firstNonEmptyIndex !== h1Index) {
+    errors.push({
+      code: 'H1_NOT_FIRST',
+      detail: `${chapter.path} does not open with the level-1 heading.`,
+    });
+  }
+
+  if (h1Index !== -1) {
+    const h1Line = lines[h1Index]!;
+    const structureMatch = H1_STRUCTURE_PATTERN.exec(h1Line);
+    const title = structureMatch?.[2]?.trim();
+    if (!structureMatch || !title) {
+      errors.push({
+        code: 'H1_MALFORMED',
+        detail: `${chapter.path} heading "${h1Line}" does not match "# Chapter <N>: <Title>".`,
+      });
+    } else {
+      const headingNumber = Number(structureMatch[1]);
+      const pathNumber = chapterNumberFromPath(chapter.path);
+      if (headingNumber !== pathNumber) {
+        errors.push({
+          code: 'H1_NUMBER_MISMATCH',
+          detail: `${chapter.path} heading declares chapter ${headingNumber}, but the file path implies chapter ${pathNumber ?? 'unknown'}.`,
+        });
+      }
+    }
+  }
+
+  return errors;
+}
+
+export function validateManuscriptStructure(chapters: ChapterFile[]): ManuscriptValidation {
+  const errors: ManuscriptError[] = [];
+
+  for (const chapter of chapters) {
+    errors.push(...validateChapterStructure(chapter));
+  }
+
+  const numberToPaths = new Map<number, string[]>();
+  for (const chapter of chapters) {
+    const chapterNumber = chapterNumberFromPath(chapter.path);
+    if (chapterNumber === undefined) {
+      continue;
+    }
+    const paths = numberToPaths.get(chapterNumber) ?? [];
+    paths.push(chapter.path);
+    numberToPaths.set(chapterNumber, paths);
+  }
+
+  for (const [chapterNumber, paths] of numberToPaths) {
+    if (paths.length > 1) {
+      errors.push({
+        code: 'CHAPTER_DUPLICATE',
+        detail: `Chapter ${chapterNumber} is claimed by multiple files: ${paths.join(', ')}.`,
+      });
+    }
+  }
+
+  const sortedNumbers = Array.from(numberToPaths.keys()).sort((a, b) => a - b);
+  const isGapless = sortedNumbers.every((chapterNumber, index) => chapterNumber === index + 1);
+  if (!isGapless) {
+    errors.push({
+      code: 'CHAPTER_GAP',
+      detail: `Chapter numbers ${JSON.stringify(sortedNumbers)} are not a contiguous sequence starting at 1.`,
+    });
+  }
+
+  errors.sort((a, b) => (a.code < b.code ? -1 : a.code > b.code ? 1 : 0));
+
+  return { valid: errors.length === 0, errors };
+}
