+import type { KdpListing, ListingError, ListingValidation } from './types.js';
+
+export const MAX_BLURB_LENGTH = 4000;
+export const REQUIRED_KEYWORD_COUNT = 7;
+export const REQUIRED_CATEGORY_COUNT = 3;
+export const ALLOWED_BLURB_TAGS = ['b', 'i', 'u', 'br', 'p', 'ul', 'li', 'ol', 'h4', 'h5', 'h6'];
+
+export function validateListing(listing: KdpListing): ListingValidation {
+  const errors: ListingError[] = [];
+
+  // BLURB_TOO_LONG — blurb longer than 4000 characters
+  if (listing.blurb.length > MAX_BLURB_LENGTH) {
+    errors.push({
+      code: 'BLURB_TOO_LONG',
+      detail: `Blurb length ${listing.blurb.length} exceeds maximum ${MAX_BLURB_LENGTH} characters.`,
+    });
+  }
+
+  // BLURB_EMPTY — blurb is empty or whitespace only
+  if (listing.blurb.trim().length === 0) {
+    errors.push({
+      code: 'BLURB_EMPTY',
+      detail: 'Blurb is empty or contains only whitespace.',
+    });
+  }
+
+  // KEYWORD_COUNT — keywords.length is not exactly 7
+  if (listing.keywords.length !== REQUIRED_KEYWORD_COUNT) {
+    errors.push({
+      code: 'KEYWORD_COUNT',
+      detail: `Keywords count ${listing.keywords.length} does not equal required count ${REQUIRED_KEYWORD_COUNT}.`,
+    });
+  }
+
+  // CATEGORY_COUNT — categories.length is not exactly 3
+  if (listing.categories.length !== REQUIRED_CATEGORY_COUNT) {
+    errors.push({
+      code: 'CATEGORY_COUNT',
+      detail: `Categories count ${listing.categories.length} does not equal required count ${REQUIRED_CATEGORY_COUNT}.`,
+    });
+  }
+
+  // UNRESOLVED_PLACEHOLDER — any string field contains "TODO:" (one error total)
+  const fieldsToCheck: (string | undefined)[] = [
+    listing.title,
+    listing.subtitle,
+    listing.blurb,
+    listing.author,
+    ...listing.keywords,
+    ...listing.categories,
+  ];
+
+  if (fieldsToCheck.some((field) => field !== undefined && field.includes('TODO:'))) {
+    errors.push({
+      code: 'UNRESOLVED_PLACEHOLDER',
+      detail: 'One or more fields contain unresolved TODO: placeholder.',
+    });
+  }
+
+  // DISALLOWED_HTML — blurb contains HTML tags outside allowlist (case-insensitive, one error total)
+  const htmlTagRegex = /<\/?([a-zA-Z][a-zA-Z0-9]*)\b[^>]*>/g;
+  const foundTags = new Set<string>();
+  let match: RegExpExecArray | null;
+
+  while ((match = htmlTagRegex.exec(listing.blurb)) !== null) {
+    const tagName = match[1];
+    if (tagName !== undefined) {
+      foundTags.add(tagName.toLowerCase());
+    }
+  }
+
+  const disallowedTags = Array.from(foundTags).filter(
+    (tag) => !ALLOWED_BLURB_TAGS.includes(tag)
+  );
+
+  if (disallowedTags.length > 0) {
+    errors.push({
+      code: 'DISALLOWED_HTML',
+      detail: `Blurb contains disallowed HTML tags: ${disallowedTags.join(', ')}.`,
+    });
+  }
+
+  // Sort errors by code ascending (lexicographic order)
+  errors.sort((a, b) => a.code.localeCompare(b.code));
+
+  return {
+    valid: errors.length === 0,
+    errors,
+  };
+}
