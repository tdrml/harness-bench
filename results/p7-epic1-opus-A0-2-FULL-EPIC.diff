+        makeListing({
+          blurb: '<div>TODO: write this</div>',
+          keywords: ['one'],
+          categories: [],
+        }),
+      );
+      expect(result.valid).toBe(false);
+      expect(result.errors.map((e) => e.code)).toEqual([
+        'CATEGORY_COUNT',
+        'DISALLOWED_HTML',
+        'KEYWORD_COUNT',
+        'UNRESOLVED_PLACEHOLDER',
+      ]);
+    });
+
+    it('sorts errors by code ascending', () => {
+      const result = validateListing(
+        makeListing({
+          blurb: '   ',
+          keywords: [],
+          categories: [],
+          title: 'TODO: title',
+        }),
+      );
+      const sorted = [...result.errors.map((e) => e.code)].sort();
+      expect(result.errors.map((e) => e.code)).toEqual(sorted);
+    });
+
+    it('gives every error a non-empty detail', () => {
+      const result = validateListing(makeListing({ blurb: '<div>x</div>', keywords: [] }));
+      for (const error of result.errors) {
+        expect(error.detail.length).toBeGreaterThan(0);
+      }
+    });
+  });
+
+  describe('constants', () => {
+    it('exposes the documented limits', () => {
+      expect(MAX_BLURB_LENGTH).toBe(4000);
+      expect(REQUIRED_KEYWORD_COUNT).toBe(7);
+      expect(REQUIRED_CATEGORY_COUNT).toBe(3);
+      expect(ALLOWED_BLURB_TAGS).toEqual(['b', 'i', 'u', 'br', 'p', 'ul', 'li', 'ol', 'h4', 'h5', 'h6']);
+    });
+  });
+});
+
+function makeChapter(chapterNumber: number, content?: string): ChapterFile {
+  return {
+    path: getChapterFilePath(chapterNumber),
+    content: content ?? `# Chapter ${chapterNumber}: A Title\n\nShe walked to the harbor.\n`,
+  };
+}
+
+const manuscriptCodes = (chapters: ChapterFile[]): string[] =>
+  validateManuscriptStructure(chapters).errors.map((e) => e.code);
+
+describe('validateManuscriptStructure', () => {
+  describe('well-formed manuscripts', () => {
+    it('returns valid: true with no errors', () => {
+      const result = validateManuscriptStructure([makeChapter(1), makeChapter(2), makeChapter(3)]);
+      expect(result.valid).toBe(true);
+      expect(result.errors).toHaveLength(0);
+    });
+
+    it('accepts an empty manuscript', () => {
+      const result = validateManuscriptStructure([]);
+      expect(result.valid).toBe(true);
+      expect(result.errors).toHaveLength(0);
+    });
+
+    it('accepts chapters given out of order', () => {
+      expect(manuscriptCodes([makeChapter(2), makeChapter(1)])).toEqual([]);
+    });
+
+    it('accepts a heading preceded by blank lines', () => {
+      expect(manuscriptCodes([makeChapter(1, '\n\n# Chapter 1: A Title\n\nText.\n')])).toEqual([]);
+    });
+
+    it('accepts a two-digit chapter number', () => {
+      expect(manuscriptCodes(Array.from({ length: 12 }, (_, i) => makeChapter(i + 1)))).toEqual([]);
+    });
+  });
+
+  describe('heading presence', () => {
+    it('reports H1_MISSING when there is no level-1 heading', () => {
+      const result = validateManuscriptStructure([makeChapter(1, 'She walked to the harbor.\n')]);
+      expect(result.valid).toBe(false);
+      expect(result.errors.map((e) => e.code)).toEqual(['H1_MISSING']);
+      expect(result.errors[0]?.detail).toContain(getChapterFilePath(1));
+    });
+
+    it('does not treat a level-2 heading as a level-1 heading', () => {
+      expect(manuscriptCodes([makeChapter(1, '## Chapter 1: A Title\n\nText.\n')])).toEqual([
+        'H1_MISSING',
+      ]);
+    });
+
+    it('skips the malformed and mismatch rules when the heading is missing', () => {
+      expect(manuscriptCodes([makeChapter(1, '')])).toEqual(['H1_MISSING']);
+    });
+  });
+
+  describe('heading position', () => {
+    it('reports H1_NOT_FIRST when prose precedes the heading', () => {
+      expect(
+        manuscriptCodes([makeChapter(1, 'A stray line.\n\n# Chapter 1: A Title\n\nText.\n')]),
+      ).toEqual(['H1_NOT_FIRST']);
+    });
+
+    it('reports H1_NOT_FIRST when a level-2 heading precedes the heading', () => {
+      expect(
+        manuscriptCodes([makeChapter(1, '## Part One\n\n# Chapter 1: A Title\n\nText.\n')]),
+      ).toEqual(['H1_NOT_FIRST']);
+    });
+  });
+
+  describe('heading shape', () => {
+    it('reports H1_MALFORMED when the heading is not a chapter heading', () => {
+      const result = validateManuscriptStructure([makeChapter(1, '# A Title\n\nText.\n')]);
+      expect(result.errors.map((e) => e.code)).toEqual(['H1_MALFORMED']);
+      expect(result.errors[0]?.detail).toContain('A Title');
+    });
+
+    it('reports H1_MALFORMED when the chapter number is not digits', () => {
+      expect(manuscriptCodes([makeChapter(1, '# Chapter One: A Title\n\nText.\n')])).toEqual([
+        'H1_MALFORMED',
+      ]);
+    });
+
+    it('reports H1_MALFORMED when the title is empty', () => {
+      expect(manuscriptCodes([makeChapter(1, '# Chapter 1:\n\nText.\n')])).toEqual([
+        'H1_MALFORMED',
+      ]);
+    });
+
+    it('reports H1_MALFORMED when the colon is missing', () => {
+      expect(manuscriptCodes([makeChapter(1, '# Chapter 1 A Title\n\nText.\n')])).toEqual([
+        'H1_MALFORMED',
+      ]);
+    });
+
+    it('does not report H1_NUMBER_MISMATCH for a malformed heading', () => {
+      expect(manuscriptCodes([makeChapter(1, '# Chapter Two: A Title\n\nText.\n')])).toEqual([
+        'H1_MALFORMED',
+      ]);
+    });
+  });
+
+  describe('heading number', () => {
+    it('reports H1_NUMBER_MISMATCH when the heading number is not the path number', () => {
+      const chapters = [makeChapter(1), makeChapter(2, '# Chapter 3: A Title\n\nText.\n')];
+      const result = validateManuscriptStructure(chapters);
+      expect(result.errors.map((e) => e.code)).toEqual(['H1_NUMBER_MISMATCH']);
+      expect(result.errors[0]?.detail).toContain(getChapterFilePath(3));
+    });
+
+    it('reports H1_NUMBER_MISMATCH for a path that ignores the chapter convention', () => {
+      const chapters: ChapterFile[] = [
+        { path: 'manuscript/prologue.md', content: '# Chapter 1: A Title\n\nText.\n' },
+      ];
+      expect(manuscriptCodes(chapters)).toEqual(['CHAPTER_GAP', 'H1_NUMBER_MISMATCH']);
+    });
+  });
+
+  describe('chapter set', () => {
+    it('reports CHAPTER_DUPLICATE when two chapters share a number', () => {
+      const result = validateManuscriptStructure([makeChapter(1), makeChapter(1), makeChapter(2)]);
+      expect(result.valid).toBe(false);
+      expect(result.errors.map((e) => e.code)).toEqual(['CHAPTER_DUPLICATE']);
+      expect(result.errors[0]?.detail).toContain('1');
+    });
+
+    it('reports CHAPTER_GAP when a chapter number is missing', () => {
+      const result = validateManuscriptStructure([makeChapter(1), makeChapter(3)]);
+      expect(result.errors.map((e) => e.code)).toEqual(['CHAPTER_GAP']);
+      expect(result.errors[0]?.detail).toContain('1, 3');
+    });
+
+    it('reports CHAPTER_GAP when the numbering does not start at 1', () => {
+      expect(manuscriptCodes([makeChapter(2), makeChapter(3)])).toEqual(['CHAPTER_GAP']);
+    });
+
+    it('evaluates the set rules on path numbers, not heading numbers', () => {
+      const chapters = [makeChapter(1), makeChapter(2, '# Chapter 1: A Title\n\nText.\n')];
+      expect(manuscriptCodes(chapters)).toEqual(['H1_NUMBER_MISMATCH']);
+    });
+  });
+
+  describe('multiple violations', () => {
+    it('reports one error per violated rule, sorted by code ascending', () => {
+      const chapters: ChapterFile[] = [
+        makeChapter(1, 'A stray line.\n\n# Chapter 1: A Title\n'),
+        makeChapter(3, 'No heading at all.\n'),
+        makeChapter(5, '# Chapter 4: A Title\n'),
+      ];
+      const result = validateManuscriptStructure(chapters);
+      expect(result.valid).toBe(false);
+      expect(result.errors.map((e) => e.code)).toEqual([
+        'CHAPTER_GAP',
+        'H1_MISSING',
+        'H1_NOT_FIRST',
+        'H1_NUMBER_MISMATCH',
+      ]);
+    });
+
+    it('reports per-chapter errors of the same code in chapters order', () => {
+      const chapters = [
+        makeChapter(1, '# A Title\n'),
+        makeChapter(2, '# Another Title\n'),
+      ];
+      const result = validateManuscriptStructure(chapters);
+      expect(result.errors.map((e) => e.detail)).toEqual([
+        expect.stringContaining(getChapterFilePath(1)),
+        expect.stringContaining(getChapterFilePath(2)),
+      ]);
+    });
+
+    it('gives every error a non-empty detail', () => {
+      const result = validateManuscriptStructure([makeChapter(2, 'No heading.\n')]);
+      expect(result.errors.length).toBeGreaterThan(0);
+      for (const error of result.errors) {
+        expect(error.detail.length).toBeGreaterThan(0);
+      }
+    });
+  });
+});
