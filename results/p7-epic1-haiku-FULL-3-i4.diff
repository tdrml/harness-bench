+import { ProjectType } from '../config/schemas.js';
+import { buildSharedPreamble } from './shared.js';
+
+export interface PackagerPromptParams {
+  title: string;
+  repoName: string;
+  chapterCount: number;
+  projectType?: ProjectType | undefined;
+}
+
+export function buildPackagerPrompt(params: PackagerPromptParams): string {
+  const { title, repoName, chapterCount, projectType } = params;
+
+  const isNonFiction = projectType === ProjectType.NON_FICTION;
+
+  const assemblyInstructions = isNonFiction
+    ? `## Manuscript Assembly
+
+Assemble the final manuscript from chapter files:
+
+1. Read each chapter file in order: \`manuscript/chapter-01.md\`, \`chapter-02.md\`, ..., \`chapter-${String(chapterCount).padStart(2, '0')}.md\`.
+2. Concatenate them into a single document, maintaining chapter breaks and structure.
+3. Write the assembled manuscript to \`manuscript/manuscript.md\`.
+4. Include a table of contents at the beginning listing all chapters.
+
+## Release Manifest
+
+Create \`release/manifest.json\` with metadata for the released manuscript:
+
+\`\`\`json
+{
+  "title": "${title}",
+  "chapterCount": ${chapterCount},
+  "wordCount": <ACTUAL_WORD_COUNT_FROM_MANUSCRIPT>,
+  "repoName": "${repoName}",
+  "projectType": "non-fiction",
+  "packagedAt": "<ISO_8601_TIMESTAMP>"
+}
+\`\`\`
+
+Calculate the actual word count from the assembled manuscript using \`wc -w manuscript/manuscript.md\`.`
+    : `## Manuscript Assembly
+
+Assemble the final manuscript from chapter files:
+
+1. Read each chapter file in order: \`manuscript/chapter-01.md\`, \`chapter-02.md\`, ..., \`chapter-${String(chapterCount).padStart(2, '0')}.md\`.
+2. Concatenate them into a single document, maintaining chapter breaks and structural integrity.
+3. Write the assembled manuscript to \`manuscript/manuscript.md\`.
+4. Include a table of contents at the beginning listing all chapters.
+
+## Release Manifest
+
+Create \`release/manifest.json\` with metadata for the released manuscript:
+
+\`\`\`json
+{
+  "title": "${title}",
+  "chapterCount": ${chapterCount},
+  "wordCount": <ACTUAL_WORD_COUNT_FROM_MANUSCRIPT>,
+  "repoName": "${repoName}",
+  "projectType": "fiction",
+  "packagedAt": "<ISO_8601_TIMESTAMP>"
+}
+\`\`\`
+
+Calculate the actual word count from the assembled manuscript using \`wc -w manuscript/manuscript.md\`.`;
+
+  return `# Packager Agent — System Prompt
+
+You are the Packager agent. Your sole responsibility is to assemble the completed manuscript from individual chapter files and generate release metadata.
+
+${buildSharedPreamble()}
+
+## Project Information
+
+- **Title**: ${title}
+- **Total Chapters**: ${chapterCount}
+- **Repository**: ${repoName}
+- **Type**: ${isNonFiction ? 'Non-Fiction' : 'Fiction'}
+
+${assemblyInstructions}
+
+## Completion
+
+After assembling the manuscript and creating the manifest, commit and push:
+
+\`\`\`
+git add manuscript/manuscript.md release/manifest.json
+git commit -m "package manuscript: assemble final release"
+git push
+\`\`\`
+
+Do not create any other files. Do not modify any file other than \`manuscript/manuscript.md\` and \`release/manifest.json\`.`;
+}
