+import {
+  type KdpListing,
+  type ListingError,
+  type ListingValidation,
+  type ChapterFile,
+  type ManuscriptError,
+  type ManuscriptValidation,
+  MAX_BLURB_LENGTH,
+  REQUIRED_KEYWORD_COUNT,
+  REQUIRED_CATEGORY_COUNT,
+  ALLOWED_BLURB_TAGS,
+} from './types.js';
+import { getChapterFilePath } from '../writing/paths.js';
+
+export function validateListing(listing: KdpListing): ListingValidation {
+  const errors: ListingError[] = [];
+
+  // 1. Check BLURB_EMPTY
+  if (!listing.blurb || listing.blurb.trim() === '') {
+    errors.push({ code: 'BLURB_EMPTY', detail: 'Blurb is empty or whitespace only.' });
+  }
+
+  // 2. Check BLURB_TOO_LONG
+  if (listing.blurb.length > MAX_BLURB_LENGTH) {
+    errors.push({
+      code: 'BLURB_TOO_LONG',
+      detail: `Blurb exceeds maximum length of ${MAX_BLURB_LENGTH} characters (current: ${listing.blurb.length}).`,
+    });
+  }
+
+  // 3. Check KEYWORD_COUNT
+  if (listing.keywords.length !== REQUIRED_KEYWORD_COUNT) {
+    errors.push({
+      code: 'KEYWORD_COUNT',
+      detail: `Keywords must have exactly ${REQUIRED_KEYWORD_COUNT} entries (current: ${listing.keywords.length}).`,
+    });
+  }
+
+  // 4. Check CATEGORY_COUNT
+  if (listing.categories.length !== REQUIRED_CATEGORY_COUNT) {
+    errors.push({
+      code: 'CATEGORY_COUNT',
+      detail: `Categories must have exactly ${REQUIRED_CATEGORY_COUNT} entries (current: ${listing.categories.length}).`,
+    });
+  }
+
+  // 5. Check UNRESOLVED_PLACEHOLDER - one error total, not per field
+  const fieldsToCheck: (string | undefined)[] = [
+    listing.title,
+    listing.subtitle,
+    listing.blurb,
+    listing.author,
+    ...listing.keywords,
+    ...listing.categories,
+  ];
+  if (fieldsToCheck.some((field) => field !== undefined && field.includes('TODO:'))) {
+    errors.push({ code: 'UNRESOLVED_PLACEHOLDER', detail: 'Unresolved placeholder "TODO:" found in listing.' });
+  }
+
+  // 6. Check DISALLOWED_HTML - one error total
+  const htmlTagRegex = /<\/?([a-zA-Z][a-zA-Z0-9]*)\b[^>]*>/g;
+  const matches = listing.blurb.match(htmlTagRegex);
+  if (matches) {
+    const allowedTagsLower = ALLOWED_BLURB_TAGS.map((tag) => tag.toLowerCase());
+    const disallowedFound = matches.some((match) => {
+      const tagNameMatch = match.match(/<\/?([a-zA-Z][a-zA-Z0-9]*)\b/i);
+      if (!tagNameMatch?.[1]) return false;
+      const tagName = tagNameMatch[1].toLowerCase();
+      return !allowedTagsLower.includes(tagName);
+    });
+    if (disallowedFound) {
+      errors.push({ code: 'DISALLOWED_HTML', detail: `Blurb contains HTML tags outside the allowlist.` });
+    }
+  }
+
+  // Sort errors lexicographically by code
+  errors.sort((a, b) => a.code.localeCompare(b.code));
+
+  return {
+    valid: errors.length === 0,
+    errors,
+  };
+}
+
+export function validateManuscriptStructure(chapters: ChapterFile[]): ManuscriptValidation {
+  const errors: ManuscriptError[] = [];
+  const validChapters: number[] = [];
+
+  // Per-chapter validation
+  for (let i = 0; i < chapters.length; i++) {
+    const chapter = chapters[i]!;
+    const lines = chapter.content.split('\n');
+    const nonEmptyLines = lines.filter((line) => line.trim() !== '');
+
+    // 1. Check H1_MISSING - look for any line matching the pattern (with required content)
+    const h1StrictRegex = /^#\s+Chapter\s+(\d+):\s+(.+)$/;
+    const h1Match = nonEmptyLines.find((line) => h1StrictRegex.test(line));
+
+    if (!h1Match) {
+      // Check if there's a partial match (structure exists but no title)
+      const h1PartialRegex = /^#\s+Chapter\s+(\d+):\s*$/;
+      const partialMatch = nonEmptyLines.find((line) => h1PartialRegex.test(line));
+
+      if (partialMatch) {
+        // Structure exists but title is empty
+        errors.push({
+          code: 'H1_MALFORMED',
+          detail: `Chapter at path "${chapter.path}" heading does not match "# Chapter <N>: <Title>" format.`,
+        });
+      } else {
+        // No H1 at all
+        errors.push({
+          code: 'H1_MISSING',
+          detail: `Chapter at path "${chapter.path}" has no level-1 heading.`,
+        });
+      }
+      continue;
+    }
+
+    // 2. Check H1_NOT_FIRST
+    if (nonEmptyLines[0] !== h1Match) {
+      errors.push({
+        code: 'H1_NOT_FIRST',
+        detail: `Chapter at path "${chapter.path}" does not start with a level-1 heading.`,
+      });
+      continue;
+    }
+
+    // Extract heading details for rules 3 and 4
+    const headingMatch = h1StrictRegex.exec(h1Match);
+    if (!headingMatch) {
+      errors.push({
+        code: 'H1_MALFORMED',
+        detail: `Chapter at path "${chapter.path}" heading does not match "# Chapter <N>: <Title>" format.`,
+      });
+      continue;
+    }
+
+    const headingNumber = parseInt(headingMatch[1]!, 10);
+
+    // 4. Check H1_NUMBER_MISMATCH
+    // Extract chapter number from path using the same convention as getChapterFilePath
+    const pathMatch = /manuscript\/chapter-(\d+)\.md$/.exec(chapter.path);
+    if (!pathMatch) {
+      errors.push({
+        code: 'H1_NUMBER_MISMATCH',
+        detail: `Chapter at path "${chapter.path}" does not follow the expected naming convention.`,
+      });
+      continue;
+    }
+
+    const pathNumber = parseInt(pathMatch[1]!, 10);
+    if (headingNumber !== pathNumber) {
+      errors.push({
+        code: 'H1_NUMBER_MISMATCH',
+        detail: `Chapter at path "${chapter.path}" has heading number ${headingNumber} but expected ${pathNumber}.`,
+      });
+      continue;
+    }
+
+    // Track valid chapter numbers for set-level validation
+    validChapters.push(pathNumber);
+  }
+
+  // Set-level validation
+  // 5. Check CHAPTER_DUPLICATE
+  const numberCounts = new Map<number, number>();
+  for (const chapterFile of chapters) {
+    const pathMatch = /manuscript\/chapter-(\d+)\.md$/.exec(chapterFile.path);
+    if (pathMatch) {
+      const num = parseInt(pathMatch[1]!, 10);
+      numberCounts.set(num, (numberCounts.get(num) ?? 0) + 1);
+    }
+  }
+
+  for (const [num, count] of numberCounts.entries()) {
+    if (count > 1) {
+      errors.push({
+        code: 'CHAPTER_DUPLICATE',
+        detail: `Chapter number ${num} appears ${count} times.`,
+      });
+    }
+  }
+
+  // 6. Check CHAPTER_GAP - use unique sorted chapter numbers
+  const uniqueNumbers = Array.from(new Set(validChapters)).sort((a, b) => a - b);
+  if (uniqueNumbers.length > 0) {
+    const expectedNumbers = Array.from({ length: uniqueNumbers.length }, (_, i) => i + 1);
+    if (!arraysEqual(uniqueNumbers, expectedNumbers)) {
+      errors.push({
+        code: 'CHAPTER_GAP',
+        detail: `Chapter numbers are not sequential from 1 to ${uniqueNumbers.length}.`,
+      });
+    }
+  }
+
+  // Sort errors lexicographically by code
+  errors.sort((a, b) => a.code.localeCompare(b.code));
+
+  return {
+    valid: errors.length === 0,
+    errors,
+  };
+}
+
+function arraysEqual(a: number[], b: number[]): boolean {
+  if (a.length !== b.length) return false;
+  return a.every((val, idx) => val === b[idx]);
+}
