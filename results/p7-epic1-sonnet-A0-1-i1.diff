+import { describe, it, expect } from 'vitest';
+import { validateListing } from '../index.js';
+import type { KdpListing } from '../index.js';
+
+function baseListing(overrides: Partial<KdpListing> = {}): KdpListing {
+  return {
+    title: 'The Adventure Begins',
+    subtitle: 'A Tale of Courage',
+    blurb: 'A short but compelling blurb about the story.',
+    keywords: ['fantasy', 'adventure', 'magic', 'quest', 'hero', 'dragon', 'kingdom'],
+    categories: ['Fiction', 'Fantasy', 'Adventure'],
+    author: 'Jane Doe',
+    ...overrides,
+  };
+}
+
+describe('validateListing', () => {
+  it('returns valid: true with no errors for a well-formed listing', () => {
+    const result = validateListing(baseListing());
+    expect(result.valid).toBe(true);
+    expect(result.errors).toHaveLength(0);
+  });
+
+  it('allows a listing without a subtitle', () => {
+    const result = validateListing(baseListing({ subtitle: undefined }));
+    expect(result.valid).toBe(true);
+  });
+
+  describe('BLURB_TOO_LONG', () => {
+    it('flags a blurb longer than 4000 characters', () => {
+      const result = validateListing(baseListing({ blurb: 'a'.repeat(4001) }));
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(
+        expect.objectContaining({ code: 'BLURB_TOO_LONG' }),
+      );
+    });
+
+    it('does not flag a blurb exactly at the limit', () => {
+      const result = validateListing(baseListing({ blurb: 'a'.repeat(4000) }));
+      expect(result.errors.some((e) => e.code === 'BLURB_TOO_LONG')).toBe(false);
+    });
+  });
+
+  describe('BLURB_EMPTY', () => {
+    it('flags an empty blurb', () => {
+      const result = validateListing(baseListing({ blurb: '' }));
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'BLURB_EMPTY' }));
+    });
+
+    it('flags a whitespace-only blurb', () => {
+      const result = validateListing(baseListing({ blurb: '   \n\t  ' }));
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'BLURB_EMPTY' }));
+    });
+  });
+
+  describe('KEYWORD_COUNT', () => {
+    it('flags too few keywords', () => {
+      const result = validateListing(baseListing({ keywords: ['one', 'two'] }));
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'KEYWORD_COUNT' }));
+    });
+
+    it('flags too many keywords', () => {
+      const result = validateListing(
+        baseListing({ keywords: Array(8).fill('word') }),
+      );
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'KEYWORD_COUNT' }));
+    });
+  });
+
+  describe('CATEGORY_COUNT', () => {
+    it('flags too few categories', () => {
+      const result = validateListing(baseListing({ categories: ['Fiction'] }));
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'CATEGORY_COUNT' }));
+    });
+
+    it('flags too many categories', () => {
+      const result = validateListing(
+        baseListing({ categories: ['Fiction', 'Fantasy', 'Adventure', 'Drama'] }),
+      );
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'CATEGORY_COUNT' }));
+    });
+  });
+
+  describe('UNRESOLVED_PLACEHOLDER', () => {
+    it('flags a TODO: placeholder in the title', () => {
+      const result = validateListing(baseListing({ title: 'TODO: pick a title' }));
+      expect(result.errors).toContainEqual(
+        expect.objectContaining({ code: 'UNRESOLVED_PLACEHOLDER' }),
+      );
+    });
+
+    it('flags a TODO: placeholder inside a keyword entry', () => {
+      const result = validateListing(
+        baseListing({
+          keywords: ['fantasy', 'adventure', 'magic', 'quest', 'hero', 'dragon', 'TODO: keyword'],
+        }),
+      );
+      expect(result.errors).toContainEqual(
+        expect.objectContaining({ code: 'UNRESOLVED_PLACEHOLDER' }),
+      );
+    });
+
+    it('flags a TODO: placeholder inside a category entry', () => {
+      const result = validateListing(
+        baseListing({ categories: ['Fiction', 'Fantasy', 'TODO: category'] }),
+      );
+      expect(result.errors).toContainEqual(
+        expect.objectContaining({ code: 'UNRESOLVED_PLACEHOLDER' }),
+      );
+    });
+
+    it('reports only one error when multiple fields contain TODO:', () => {
+      const result = validateListing(
+        baseListing({ title: 'TODO: title', author: 'TODO: author' }),
+      );
+      const placeholderErrors = result.errors.filter((e) => e.code === 'UNRESOLVED_PLACEHOLDER');
+      expect(placeholderErrors).toHaveLength(1);
+    });
+  });
+
+  describe('DISALLOWED_HTML', () => {
+    it('allows tags from the allowlist', () => {
+      const result = validateListing(
+        baseListing({ blurb: '<p>Hello <b>world</b>, this is <i>great</i>.</p><br>' }),
+      );
+      expect(result.errors.some((e) => e.code === 'DISALLOWED_HTML')).toBe(false);
+    });
+
+    it('flags a disallowed tag', () => {
+      const result = validateListing(baseListing({ blurb: 'A story <script>alert(1)</script>.' }));
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'DISALLOWED_HTML' }));
+    });
+
+    it('matches case-insensitively', () => {
+      const result = validateListing(baseListing({ blurb: 'A story <B>bold</B> text.' }));
+      expect(result.errors.some((e) => e.code === 'DISALLOWED_HTML')).toBe(false);
+    });
+
+    it('treats closing tags the same as opening tags', () => {
+      const result = validateListing(baseListing({ blurb: 'Bad closing </div> tag.' }));
+      expect(result.errors).toContainEqual(expect.objectContaining({ code: 'DISALLOWED_HTML' }));
+    });
+
+    it('reports only one error when multiple disallowed tags are present', () => {
+      const result = validateListing(
+        baseListing({ blurb: 'A story <div>bad</div> and <span>also bad</span>.' }),
+      );
+      const htmlErrors = result.errors.filter((e) => e.code === 'DISALLOWED_HTML');
+      expect(htmlErrors).toHaveLength(1);
+    });
+  });
+
+  it('sorts errors by code ascending', () => {
+    const result = validateListing({
+      title: '',
+      blurb: '',
+      keywords: [],
+      categories: [],
+      author: '',
+    });
+    const codes = result.errors.map((e) => e.code);
+    const sorted = [...codes].sort();
+    expect(codes).toEqual(sorted);
+    expect(result.valid).toBe(false);
+  });
+});
