+    );
+    mockGitHubClientMethods.getFileContent.mockResolvedValue(
+      makeFileContent(JSON.stringify(validListing)),
+    );
+  });
+
+  it('reads release/listing.json from the main branch', async () => {
+    const workItem = { type: 'RECONCILE' as const, projectId: 'proj-123', runId: 'run-abc' };
+    await handler(makeEvent([makeRecord(workItem)]));
+
+    expect(mockGitHubClientMethods.getFileContent).toHaveBeenCalledWith(
+      { owner: 'test-org', repo: 'the-dark-tower' },
+      'release/listing.json',
+      'main',
+    );
+  });
+
+  it('sets the project status to RELEASED when the listing is valid', async () => {
+    const workItem = { type: 'RECONCILE' as const, projectId: 'proj-123', runId: 'run-abc' };
+    await handler(makeEvent([makeRecord(workItem)]));
+
+    expect(mockProjectServiceMethods.updateStatus).toHaveBeenCalledWith('proj-123', 'RELEASED');
+    expect(vi.mocked(enqueue)).not.toHaveBeenCalled();
+  });
+
+  it('sets the project status to FAILED when the listing is invalid', async () => {
+    mockGitHubClientMethods.getFileContent.mockResolvedValue(
+      makeFileContent(JSON.stringify({ ...validListing, keywords: ['one', 'two'] })),
+    );
+
+    const workItem = { type: 'RECONCILE' as const, projectId: 'proj-123', runId: 'run-abc' };
+    await handler(makeEvent([makeRecord(workItem)]));
+
+    expect(mockProjectServiceMethods.updateStatus).toHaveBeenCalledWith('proj-123', 'FAILED');
+  });
+
+  it('sets the project status to FAILED when the listing is unparseable', async () => {
+    mockGitHubClientMethods.getFileContent.mockResolvedValue(makeFileContent('not json {'));
+
+    const workItem = { type: 'RECONCILE' as const, projectId: 'proj-123', runId: 'run-abc' };
+    await handler(makeEvent([makeRecord(workItem)]));
+
+    expect(mockProjectServiceMethods.updateStatus).toHaveBeenCalledWith('proj-123', 'FAILED');
+  });
+
+  it('sets the project status to FAILED when the listing file is missing', async () => {
+    mockGitHubClientMethods.getFileContent.mockRejectedValue(new Error('Not Found'));
+
+    const workItem = { type: 'RECONCILE' as const, projectId: 'proj-123', runId: 'run-abc' };
+    const result = await handler(makeEvent([makeRecord(workItem)]));
+
+    expect(mockProjectServiceMethods.updateStatus).toHaveBeenCalledWith('proj-123', 'FAILED');
+    if (result && typeof result === 'object' && 'batchItemFailures' in result) {
+      expect(result.batchItemFailures).toEqual([]);
+    }
+  });
+
+  it('marks the agent run SUCCEEDED', async () => {
+    const workItem = { type: 'RECONCILE' as const, projectId: 'proj-123', runId: 'run-abc' };
+    await handler(makeEvent([makeRecord(workItem)]));
+
+    expect(mockAgentRunServiceMethods.updateStatus).toHaveBeenCalledWith(
+      'run-abc',
+      'SUCCEEDED',
+      expect.objectContaining({ exitCode: 0 }),
+    );
+  });
