 }
+
+export function getChapterNumberFromPath(path: string): number | null {
+  const match = /chapter-(\d+)\.md$/.exec(path);
+  if (!match || !match[1]) {
+    return null;
+  }
+  return parseInt(match[1], 10);
+}
