+import { describe, it, expect } from 'vitest';
+import { validateListing, validateManuscriptStructure } from '../index.js';
+import type { ChapterFile, KdpListing } from '../index.js';
+import { getChapterFilePath } from '../../writing/index.js';
+
+const validListing: KdpListing = {
+  title: 'The Last Signal',
+  subtitle: 'A Thriller',
+  blurb: '<b>Opening hook.</b><br><br>Setup paragraph.<br><br><i>For fans of</i> Author X.',
+  keywords: ['a', 'b', 'c', 'd', 'e', 'f', 'g'],
+  categories: ['Fiction > Thrillers', 'Fiction > Mystery', 'Fiction > Suspense'],
+  author: 'Jane Doe',
+};
+
+describe('validateListing', () => {
+  it('returns valid: true with no errors for a well-formed listing', () => {
+    const result = validateListing(validListing);
+    expect(result.valid).toBe(true);
+    expect(result.errors).toEqual([]);
+  });
+
+  it('flags a blurb longer than 4000 characters', () => {
+    const result = validateListing({ ...validListing, blurb: 'a'.repeat(4001) });
+    expect(result.valid).toBe(false);
+    expect(result.errors).toEqual([{ code: 'BLURB_TOO_LONG', detail: expect.any(String) }]);
+  });
+
+  it('flags an empty blurb', () => {
+    const result = validateListing({ ...validListing, blurb: '' });
+    expect(result.errors).toEqual([{ code: 'BLURB_EMPTY', detail: expect.any(String) }]);
+  });
+
+  it('flags a whitespace-only blurb as empty', () => {
+    const result = validateListing({ ...validListing, blurb: '   \n\t  ' });
+    expect(result.errors).toEqual([{ code: 'BLURB_EMPTY', detail: expect.any(String) }]);
+  });
+
+  it('flags a keyword count other than 7', () => {
+    const result = validateListing({ ...validListing, keywords: ['a', 'b'] });
+    expect(result.errors).toEqual([{ code: 'KEYWORD_COUNT', detail: expect.any(String) }]);
+  });
+
+  it('flags a category count other than 3', () => {
+    const result = validateListing({ ...validListing, categories: ['Fiction > Thrillers'] });
+    expect(result.errors).toEqual([{ code: 'CATEGORY_COUNT', detail: expect.any(String) }]);
+  });
+
+  it('flags an unresolved placeholder in any field with a single error', () => {
+    const result = validateListing({
+      ...validListing,
+      title: 'TODO: pick title',
+      author: 'TODO: pick author',
+    });
+    const placeholderErrors = result.errors.filter((e) => e.code === 'UNRESOLVED_PLACEHOLDER');
+    expect(placeholderErrors).toHaveLength(1);
+  });
+
+  it('detects an unresolved placeholder inside a keyword entry', () => {
+    const result = validateListing({ ...validListing, keywords: ['TODO: fill in', 'b', 'c', 'd', 'e', 'f', 'g'] });
+    expect(result.errors).toEqual([{ code: 'UNRESOLVED_PLACEHOLDER', detail: expect.any(String) }]);
+  });
+
+  it('detects an unresolved placeholder inside a category entry', () => {
+    const result = validateListing({
+      ...validListing,
+      categories: ['TODO: fill in', 'Fiction > Mystery', 'Fiction > Suspense'],
+    });
+    expect(result.errors).toEqual([{ code: 'UNRESOLVED_PLACEHOLDER', detail: expect.any(String) }]);
+  });
+
+  it('flags disallowed HTML tags in the blurb with a single error', () => {
+    const result = validateListing({
+      ...validListing,
+      blurb: '<div>Not allowed</div><span>Also not allowed</span>',
+    });
+    const htmlErrors = result.errors.filter((e) => e.code === 'DISALLOWED_HTML');
+    expect(htmlErrors).toHaveLength(1);
+  });
+
+  it('treats disallowed tag matching case-insensitively', () => {
+    const result = validateListing({ ...validListing, blurb: '<DIV>bad</DIV>' });
+    expect(result.errors).toEqual([{ code: 'DISALLOWED_HTML', detail: expect.any(String) }]);
+  });
+
+  it('allows the whitelisted tags, including closing tags, case-insensitively', () => {
+    const result = validateListing({
+      ...validListing,
+      blurb: '<B>bold</B><I>italic</I><U>underline</U><P>para</P><br/><H4>head</H4>',
+    });
+    expect(result.errors).toEqual([]);
+  });
+
+  it('sorts multiple errors by code ascending', () => {
+    const result = validateListing({
+      title: '',
+      blurb: '',
+      keywords: [],
+      categories: [],
+      author: '',
+    });
+    const codes = result.errors.map((e) => e.code);
+    expect(codes).toEqual([...codes].sort());
+    expect(codes).toEqual(['BLURB_EMPTY', 'CATEGORY_COUNT', 'KEYWORD_COUNT']);
+  });
+
+  it('does not require a subtitle', () => {
+    const { subtitle: _subtitle, ...withoutSubtitle } = validListing;
+    const result = validateListing(withoutSubtitle);
+    expect(result.valid).toBe(true);
+  });
+});
+
+function chapter(n: number, content?: string): ChapterFile {
+  return {
+    path: getChapterFilePath(n),
+    content: content ?? `# Chapter ${n}: Title ${n}\n\nBody text.`,
+  };
+}
+
+describe('validateManuscriptStructure', () => {
+  it('returns valid: true with no errors for a well-formed manuscript', () => {
+    const result = validateManuscriptStructure([chapter(1), chapter(2), chapter(3)]);
+    expect(result.valid).toBe(true);
+    expect(result.errors).toEqual([]);
+  });
+
+  it('flags a chapter with no level-1 heading', () => {
+    const result = validateManuscriptStructure([chapter(1, 'Just prose, no heading anywhere.')]);
+    expect(result.errors).toContainEqual({ code: 'H1_MISSING', detail: expect.any(String) });
+  });
+
+  it('flags a level-1 heading that is not the first non-empty line', () => {
+    const result = validateManuscriptStructure([
+      chapter(1, 'An introductory line.\n\n# Chapter 1: Title 1\n\nBody text.'),
+    ]);
+    expect(result.errors).toEqual([{ code: 'H1_NOT_FIRST', detail: expect.any(String) }]);
+  });
+
+  it('does not flag H1_NOT_FIRST when leading blank lines precede the heading', () => {
+    const result = validateManuscriptStructure([chapter(1, '\n\n# Chapter 1: Title 1\n\nBody text.')]);
+    expect(result.errors).toEqual([]);
+  });
+
+  it('flags a level-1 heading that does not match "# Chapter <N>: <Title>"', () => {
+    const result = validateManuscriptStructure([chapter(1, '# Just a title\n\nBody text.')]);
+    expect(result.errors).toEqual([{ code: 'H1_MALFORMED', detail: expect.any(String) }]);
+  });
+
+  it('flags a level-1 heading with an empty title', () => {
+    const result = validateManuscriptStructure([chapter(1, '# Chapter 1: \n\nBody text.')]);
+    expect(result.errors).toEqual([{ code: 'H1_MALFORMED', detail: expect.any(String) }]);
+  });
+
+  it('flags a heading number that does not match the chapter number implied by the path', () => {
+    const result = validateManuscriptStructure([chapter(1, '# Chapter 2: Title 2\n\nBody text.')]);
+    expect(result.errors).toEqual([{ code: 'H1_NUMBER_MISMATCH', detail: expect.any(String) }]);
+  });
+
+  it('skips H1_MALFORMED and H1_NUMBER_MISMATCH once H1_MISSING has fired', () => {
+    const result = validateManuscriptStructure([chapter(1, 'Some prose without any heading at all.')]);
+    const codes = result.errors.map((e) => e.code);
+    expect(codes).toContain('H1_MISSING');
+    expect(codes).not.toContain('H1_MALFORMED');
+    expect(codes).not.toContain('H1_NUMBER_MISMATCH');
+  });
+
+  it('flags two chapters that resolve to the same chapter number', () => {
+    const duplicate: ChapterFile = { path: chapter(1).path, content: '# Chapter 1: Another Title\n\nBody.' };
+    const result = validateManuscriptStructure([chapter(1), duplicate]);
+    expect(result.errors).toContainEqual({ code: 'CHAPTER_DUPLICATE', detail: expect.any(String) });
+  });
+
+  it('flags a gap in the chapter number sequence', () => {
+    const result = validateManuscriptStructure([chapter(1), chapter(3)]);
+    expect(result.errors).toContainEqual({ code: 'CHAPTER_GAP', detail: expect.any(String) });
+  });
+
+  it('does not flag a gap for a contiguous, out-of-order sequence', () => {
+    const result = validateManuscriptStructure([chapter(2), chapter(1), chapter(3)]);
+    expect(result.errors).toEqual([]);
+  });
+
+  it('sorts multiple errors by code ascending', () => {
+    const result = validateManuscriptStructure([
+      chapter(1, 'No heading here.'),
