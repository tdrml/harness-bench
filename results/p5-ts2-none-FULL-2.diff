@@ -560,4 +560,48 @@ describe('RepoLocksService', () => {
     const result = await svc.isLocked('acme/app');
     expect(result).toBe(false);
   });
+
+  it('acquireLock uses default grace period of 30 seconds', async () => {
+    const now = Math.floor(Date.now() / 1000);
+    const client = makeClient(() => ({}));
+    const svc = new RepoLocksService(client);
+    await svc.acquireLock('acme/app', 'owner-1');
+    const cmd = (client.send as ReturnType<typeof vi.fn>).mock.calls[0][0];
+    const graceExpiredAt = cmd.input.ExpressionAttributeValues[':now'];
+    expect(graceExpiredAt).toBeGreaterThanOrEqual(now - 30);
+    expect(graceExpiredAt).toBeLessThanOrEqual(now - 29);
+  });
+
+  it('acquireLock respects custom takeoverGraceSeconds', async () => {
+    const now = Math.floor(Date.now() / 1000);
+    const client = makeClient(() => ({}));
+    const svc = new RepoLocksService(client);
+    await svc.acquireLock('acme/app', 'owner-1', { takeoverGraceSeconds: 60 });
+    const cmd = (client.send as ReturnType<typeof vi.fn>).mock.calls[0][0];
+    const graceExpiredAt = cmd.input.ExpressionAttributeValues[':now'];
+    expect(graceExpiredAt).toBeGreaterThanOrEqual(now - 60);
+    expect(graceExpiredAt).toBeLessThanOrEqual(now - 59);
+  });
+
+  it('acquireLock with takeoverGraceSeconds: 0 reproduces old behavior', async () => {
+    const now = Math.floor(Date.now() / 1000);
+    const client = makeClient(() => ({}));
+    const svc = new RepoLocksService(client);
+    await svc.acquireLock('acme/app', 'owner-1', { takeoverGraceSeconds: 0 });
+    const cmd = (client.send as ReturnType<typeof vi.fn>).mock.calls[0][0];
+    const graceExpiredAt = cmd.input.ExpressionAttributeValues[':now'];
+    expect(graceExpiredAt).toBeGreaterThanOrEqual(now);
+    expect(graceExpiredAt).toBeLessThanOrEqual(now + 1);
+  });
+
+  it('acquireLock does not change new lock TTL based on grace period', async () => {
+    const before = Math.floor(Date.now() / 1000);
+    const client = makeClient(() => ({}));
+    const svc = new RepoLocksService(client);
+    await svc.acquireLock('acme/app', 'owner-1', { takeoverGraceSeconds: 60 });
+    const after = Math.floor(Date.now() / 1000);
+    const cmd = (client.send as ReturnType<typeof vi.fn>).mock.calls[0][0];
+    expect(cmd.input.Item.ttl).toBeGreaterThanOrEqual(before + 1800);
+    expect(cmd.input.Item.ttl).toBeLessThanOrEqual(after + 1800);
+  });
 });
