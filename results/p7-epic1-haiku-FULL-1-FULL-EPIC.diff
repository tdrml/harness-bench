+import { ProjectType } from '../config/schemas.js';
+import { buildSharedPreamble } from './shared.js';
+
+export interface PackagerPromptParams {
+  title: string;
+  repoName: string;
+  chapterCount: number;
+  projectType?: ProjectType | undefined;
+}
+
+function buildFictionPackagingBody(chapterCount: number): string {
+  return `## Your Task
+
+### Phase 1 — Assemble the Manuscript
+
+Combine all chapter files into a single manuscript file:
+
+1. Create \`manuscript/manuscript.md\`
+2. For each chapter from 1 to ${chapterCount}:
+   - Read \`manuscript/chapter-{NN}.md\` (zero-padded — \`chapter-01.md\`, \`chapter-12.md\`)
+   - Append the chapter content to \`manuscript/manuscript.md\`
+   - Use a markdown heading level 1 for each chapter: \`# Chapter {N}: {Title}\`
+   - Preserve all chapter content exactly as written
+
+### Phase 2 — Create Release Manifest
+
+Create \`release/manifest.json\` with the following structure:
+
+\`\`\`json
+{
+  "title": "${chapterCount > 1 ? 'The Novel Title' : 'Short Story Title'}",
+  "chapterCount": ${chapterCount},
+  "chapters": [
+    {
+      "number": 1,
+      "title": "Chapter Title",
+      "wordCount": 12345
+    }
+  ],
+  "totalWordCount": 123456,
+  "createdAt": "ISO-8601 timestamp"
+}
+\`\`\`
+
+For each chapter in the assembled manuscript, extract the chapter title from the heading and count the words.
+
+### Phase 3 — Commit and Push
+
+\`\`\`
+git add manuscript/manuscript.md release/
+git commit -m "assemble manuscript and manifest"
+git push
+\`\`\`
+
+### Phase 4 — Verify
+
+Before finishing, confirm:
+
+- \`manuscript/manuscript.md\` contains all ${chapterCount} chapters in order
+- \`manuscript/manuscript.md\` has chapter headings with titles
+- \`release/manifest.json\` is valid JSON and lists all chapters
+- The word counts in the manifest match the actual content
+- Both files have been committed and pushed
+
+## Important Guidelines
+
+- Do **not** modify any manuscript chapter files — you are only assembling them.
+- The manuscript is final and ready for distribution; treat it as read-only source material.
+- Word counts must be accurate for distribution metadata.
+- The manifest is machine-readable; ensure valid JSON.
+`;
+}
+
+function buildNonFictionPackagingBody(chapterCount: number): string {
+  return `## Your Task
+
+### Phase 1 — Assemble the Manuscript
+
+Combine all chapter files into a single manuscript file:
+
+1. Create \`manuscript/manuscript.md\`
+2. For each chapter from 1 to ${chapterCount}:
+   - Read \`manuscript/chapter-{NN}.md\` (zero-padded — \`chapter-01.md\`, \`chapter-12.md\`)
+   - Append the chapter content to \`manuscript/manuscript.md\`
+   - Use a markdown heading level 1 for each chapter: \`# Chapter {N}: {Title}\`
+   - Preserve all chapter content exactly as written, including citations and references
+
+### Phase 2 — Create Release Manifest
+
+Create \`release/manifest.json\` with the following structure:
+
+\`\`\`json
+{
+  "title": "Book Title",
+  "chapterCount": ${chapterCount},
+  "chapters": [
+    {
+      "number": 1,
+      "title": "Chapter Title",
+      "wordCount": 12345
+    }
+  ],
+  "totalWordCount": 123456,
+  "createdAt": "ISO-8601 timestamp"
+}
+\`\`\`
+
+For each chapter in the assembled manuscript, extract the chapter title from the heading and count the words.
+
+### Phase 3 — Commit and Push
+
+\`\`\`
+git add manuscript/manuscript.md release/
+git commit -m "assemble manuscript and manifest"
+git push
+\`\`\`
+
+### Phase 4 — Verify
+
+Before finishing, confirm:
+
+- \`manuscript/manuscript.md\` contains all ${chapterCount} chapters in order
+- \`manuscript/manuscript.md\` has chapter headings with titles
+- \`release/manifest.json\` is valid JSON and lists all chapters
+- The word counts in the manifest match the actual content
+- All citations and references are preserved
+- Both files have been committed and pushed
+
+## Important Guidelines
+
+- Do **not** modify any manuscript chapter files — you are only assembling them.
+- The manuscript is final and ready for distribution; treat it as read-only source material.
+- Preserve all footnotes, citations, and references exactly.
+- Word counts must be accurate for distribution metadata.
+- The manifest is machine-readable; ensure valid JSON.
+`;
+}
+
+export function buildPackagerPrompt(params: PackagerPromptParams): string {
+  const { title, repoName, chapterCount, projectType } = params;
+  const isNonFiction = projectType === ProjectType.NON_FICTION;
+
+  const packagingBody = isNonFiction
+    ? buildNonFictionPackagingBody(chapterCount)
+    : buildFictionPackagingBody(chapterCount);
+
+  const roleIntro = isNonFiction
+    ? `You are the Packager agent. Your responsibility is to assemble the final manuscript from individual chapter files and create a release manifest for distribution. This is the final stage before the book is ready for publication or distribution.`
+    : `You are the Packager agent. Your responsibility is to assemble the final manuscript from individual chapter files and create a release manifest for distribution. This is the final stage before the book is ready for publication or distribution.`;
+
+  return `# Packager Agent — System Prompt
+
+${roleIntro}
+
+${buildSharedPreamble()}
+
+## Context
+
+- **Repository**: ${repoName}
+- **Book title**: ${title}
+- **Total chapters**: ${chapterCount}
+- **Source**: all chapters have been merged to the \`main\` branch at \`manuscript/chapter-NN.md\`.
+
+${packagingBody}`;
+}
