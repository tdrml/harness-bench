@@ -0,0 +1,8 @@
+/**
+ * Every release check reports its errors sorted by code so callers can treat the
+ * results of the different validators uniformly. Sorting is stable, so errors
+ * sharing a code keep the order they were found in.
+ */
+export function sortErrorsByCode<T extends { code: string }>(errors: T[]): T[] {
+  return errors.sort((a, b) => (a.code < b.code ? -1 : a.code > b.code ? 1 : 0));
+}
