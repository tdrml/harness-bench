+import { ulid } from 'ulid';
+import type { LaunchAgentRunParams } from '../../../shared/index.js';
+import { MOCK_TASK_ARN } from './test-data.js';
+
+/**
+ * Stand-in for the real `launchAgentRun`, used by integration tests that mock
+ * the `shared/index.js` barrel. It skips the real ECS call but otherwise
+ * mirrors the real helper's effects (task output save + agent run create)
+ * against whichever mocked services the handler passes in, so reconcile and
+ * other downstream logic that reads from the in-memory store behaves the
+ * same as it would against the real implementation.
+ */
+export async function mockLaunchAgentRun(
+  params: LaunchAgentRunParams,
+): Promise<{ runId: string; taskArn: string }> {
+  const runId = ulid();
+  const now = new Date().toISOString();
+
+  await params.taskOutputService.save({
+    runId,
+    outputType: 'system-prompt',
+    projectId: params.projectId,
+    content: params.systemPrompt,
+    contentLength: params.systemPrompt.length,
+    createdAt: now,
+  });
+
+  await params.agentRunService.create({
+    runId,
+    projectId: params.projectId,
+    taskArn: MOCK_TASK_ARN,
+    workerType: params.workerType,
+    status: 'RUNNING',
+    startedAt: now,
+    ...(params.nodeId !== undefined ? { nodeId: params.nodeId } : {}),
+  });
+
+  return { runId, taskArn: MOCK_TASK_ARN };
+}
