+
+function chapterFile(chapterNumber: number, overrides: Partial<ChapterFile> = {}): ChapterFile {
+  const padded = String(chapterNumber).padStart(2, '0');
+  return {
+    path: `manuscript/chapter-${padded}.md`,
+    content: `# Chapter ${chapterNumber}: Title ${chapterNumber}\n\nSome opening text.\n`,
