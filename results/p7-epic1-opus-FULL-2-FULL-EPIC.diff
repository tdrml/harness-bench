+    });
+  });
+
+  describe('H1_NUMBER_MISMATCH', () => {
+    it('flags a heading number that disagrees with the path', () => {
+      const content = `# Chapter 4: Arrival\n\n${chapterBody}\n`;
+      const result = validateManuscriptStructure([chapter(1, content)]);
+      expect(result.errors.map((error) => error.code)).toEqual(['H1_NUMBER_MISMATCH']);
+      expect(result.errors[0]?.detail).toContain(getChapterFilePath(4));
