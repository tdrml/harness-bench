--- /dev/null
+++ b/packages/core/src/word-count-policy/__tests__/word-count-policy.test.ts
@@ -0,0 +1,131 @@
+import { describe, it, expect } from 'vitest';
+import {
+  resolveChapterTarget,
+  resolveTolerance,
+  resolveWordCountRange,
+  formatToleranceForPrompt,
+  clampToProjectType,
+} from '../index.js';
+import { ProjectType } from '../../config/schemas.js';
+
+describe('resolveChapterTarget', () => {
+  it('divides the total budget evenly across chapters', () => {
+    expect(resolveChapterTarget({ targetWordCount: 90000, chapterCount: 25 })).toBe(3600);
+  });
+
+  it('rounds down when the division is not exact', () => {
+    expect(resolveChapterTarget({ targetWordCount: 100000, chapterCount: 3 })).toBe(33333);
+  });
+
+  it('throws when chapterCount is zero', () => {
+    expect(() => resolveChapterTarget({ targetWordCount: 90000, chapterCount: 0 })).toThrow(
+      /chapterCount must be positive/,
+    );
+  });
+
+  it('throws when chapterCount is negative', () => {
+    expect(() => resolveChapterTarget({ targetWordCount: 90000, chapterCount: -3 })).toThrow(
+      /chapterCount must be positive/,
+    );
+  });
+});
+
+describe('resolveTolerance', () => {
+  it('holds the writer to ±5%', () => {
+    expect(resolveTolerance('writer')).toBe(0.05);
+  });
+
+  it('holds review to ±10%', () => {
+    expect(resolveTolerance('review')).toBe(0.1);
+  });
+
+  it('holds merge to ±20%', () => {
+    expect(resolveTolerance('merge')).toBe(0.2);
+  });
+});
+
+describe('formatToleranceForPrompt', () => {
+  it('renders each stage tolerance as a signed percentage', () => {
+    expect(formatToleranceForPrompt('writer')).toBe('±5%');
+    expect(formatToleranceForPrompt('review')).toBe('±10%');
+    expect(formatToleranceForPrompt('merge')).toBe('±20%');
+  });
+});
+
+describe('resolveWordCountRange', () => {
+  it('bands the writer stage at ±5% of the chapter target', () => {
+    expect(resolveWordCountRange({ targetWordCount: 90000, chapterCount: 25, stage: 'writer' }))
+      .toEqual({ min: 3420, max: 3780 });
+  });
+
+  it('bands the review stage at ±10% of the chapter target', () => {
+    // 3600 * 1.1 is 3960.0000000000005 in IEEE-754, so the ceil lands one word
+    // above the exact 3960 — the band is pinned to the arithmetic, not rounded.
+    expect(resolveWordCountRange({ targetWordCount: 90000, chapterCount: 25, stage: 'review' }))
+      .toEqual({ min: 3240, max: 3961 });
+  });
+
+  it('bands the merge stage at ±20% of the chapter target', () => {
+    expect(resolveWordCountRange({ targetWordCount: 90000, chapterCount: 25, stage: 'merge' }))
+      .toEqual({ min: 2880, max: 4320 });
+  });
+
+  it('floors the minimum and ceils the maximum', () => {
+    // 3333 * 0.95 = 3166.35 → 3166; 3333 * 1.05 = 3499.65 → 3500
+    expect(resolveWordCountRange({ targetWordCount: 9999, chapterCount: 3, stage: 'writer' }))
+      .toEqual({ min: 3166, max: 3500 });
+  });
+
+  it('propagates the chapterCount guard', () => {
+    expect(() =>
+      resolveWordCountRange({ targetWordCount: 90000, chapterCount: 0, stage: 'merge' }),
+    ).toThrow(/chapterCount must be positive/);
+  });
+});
+
+describe('clampToProjectType', () => {
+  it('leaves a range already inside the project type band untouched', () => {
+    expect(
+      clampToProjectType({ range: { min: 3200, max: 4800 }, projectType: ProjectType.NOVEL }),
+    ).toEqual({ min: 3200, max: 4800 });
+  });
+
+  it('raises a minimum below the project type floor', () => {
+    expect(
+      clampToProjectType({ range: { min: 2880, max: 4320 }, projectType: ProjectType.NOVEL }),
+    ).toEqual({ min: 3000, max: 4320 });
+  });
+
+  it('lowers a maximum above the project type ceiling', () => {
+    expect(
+      clampToProjectType({ range: { min: 3200, max: 6000 }, projectType: ProjectType.NOVEL }),
+    ).toEqual({ min: 3200, max: 5000 });
+  });
+
+  it('collapses a range entirely above the band onto the ceiling', () => {
+    expect(
+      clampToProjectType({ range: { min: 24000, max: 36000 }, projectType: ProjectType.NOVEL }),
+    ).toEqual({ min: 5000, max: 5000 });
+  });
+
+  it('collapses a range entirely below the band onto the floor', () => {
+    expect(
+      clampToProjectType({ range: { min: 240, max: 360 }, projectType: ProjectType.NOVEL }),
+    ).toEqual({ min: 3000, max: 3000 });
+  });
+
+  it('uses the band of the given project type', () => {
+    expect(
+      clampToProjectType({ range: { min: 1000, max: 9000 }, projectType: ProjectType.NOVELLA }),
+    ).toEqual({ min: 2500, max: 4000 });
+    expect(
+      clampToProjectType({
+        range: { min: 1000, max: 9000 },
+        projectType: ProjectType.SHORT_STORY_COLLECTION,
+      }),
+    ).toEqual({ min: 3000, max: 8000 });
+    expect(
+      clampToProjectType({ range: { min: 1000, max: 9000 }, projectType: ProjectType.NON_FICTION }),
+    ).toEqual({ min: 3000, max: 6000 });
+  });
+});
