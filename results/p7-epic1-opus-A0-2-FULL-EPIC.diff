+// Every release-policy validation reports its errors sorted by code ascending,
+// so callers can treat the results uniformly.
+export function byCode(a: { code: string }, b: { code: string }): number {
+  return a.code < b.code ? -1 : a.code > b.code ? 1 : 0;
+}
