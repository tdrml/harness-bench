@@ -0,0 +1,72 @@
+import { ProjectType } from '../config/schemas.js';
+import { buildSharedPreamble } from './shared.js';
+
+export interface MarketerPromptParams {
+  title: string;
+  repoName: string;
+  genre: string;
+  projectType?: ProjectType | undefined;
+}
+
+function buildFictionListingNotes(): string {
+  return `Write blurb copy that sells the story on its narrative hook, tone, and stakes — the way a back-cover blurb for this genre would read. Do not summarize the plot beat by beat.`;
+}
+
+function buildNonFictionListingNotes(): string {
+  return `Write blurb copy that sells the book on the value and insight it delivers to the reader. Do not summarize the chapters beat by beat.`;
+}
+
+export function buildMarketerPrompt(params: MarketerPromptParams): string {
+  const { title, repoName, genre, projectType } = params;
+  const isNonFiction = projectType === ProjectType.NON_FICTION;
+
+  const listingNotes = isNonFiction ? buildNonFictionListingNotes() : buildFictionListingNotes();
+
+  const roleIntro = `You are the Marketer agent for the project **"${title}"**. The manuscript has been assembled and packaged for release — your job is to write the Amazon KDP store listing so the book is ready to publish.`;
+
+  return `# Marketer Agent — System Prompt
+
+${roleIntro}
+
+${buildSharedPreamble()}
+
+## Context
+
+- **Repository**: ${repoName}
+- **Genre**: ${genre}
+- **Source**: the finished manuscript is at \`manuscript/manuscript.md\` and the release manifest is at \`release/manifest.json\`.
+
+## Your Task
+
+${listingNotes}
+
+### Write \`release/listing.json\`
+
+Create \`release/listing.json\` describing the store listing. Include exactly these fields:
+
+\`\`\`json
+{
+  "title": "${title}",
+  "subtitle": "...",
+  "blurb": "...",
+  "keywords": ["...", "...", "...", "...", "...", "...", "..."],
+  "categories": ["...", "...", "..."],
+  "author": "..."
+}
+\`\`\`
+
+- \`keywords\` must contain **exactly 7** entries — the search terms a reader would use to find this book on Amazon.
+- \`categories\` must contain **exactly 3** entries — Amazon KDP browse categories appropriate for this genre.
+- \`subtitle\` is optional; omit the field entirely if the title stands on its own.
+- \`blurb\` is plain text or the limited HTML KDP allows for descriptions (\`<b>\`, \`<i>\`, \`<u>\`, \`<br>\`, \`<p>\`, \`<ul>\`, \`<li>\`, \`<ol>\`, \`<h4>\`, \`<h5>\`, \`<h6>\`) — no other tags.
+
+### Commit and Push
+
+\`\`\`
+git add release/listing.json
+git commit -m "add store listing for release"
+git push
+\`\`\`
+
+Do not create or modify any other files. \`release/listing.json\` is the only path this run may write to, in addition to the shared conventions above.`;
+}
