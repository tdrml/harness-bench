--- /dev/null
+++ b/packages/core/src/release-policy/validate-listing.ts
@@ -0,0 +1,96 @@
+import type { KdpListing, ListingError, ListingValidation } from './types.js';
+
+export const MAX_BLURB_LENGTH = 4000;
+export const REQUIRED_KEYWORD_COUNT = 7;
+export const REQUIRED_CATEGORY_COUNT = 3;
+
+// HTML tags Amazon KDP accepts in a book description
+export const ALLOWED_BLURB_TAGS = [
+  'b',
+  'i',
+  'u',
+  'br',
+  'p',
+  'ul',
+  'li',
+  'ol',
+  'h4',
+  'h5',
+  'h6',
+] as const;
+
+const ALLOWED_BLURB_TAG_SET = new Set<string>(ALLOWED_BLURB_TAGS);
+
+const PLACEHOLDER_MARKER = 'TODO:';
+// Opening or closing tag, capturing the tag name
+const HTML_TAG_RE = /<\s*\/?\s*([a-zA-Z][a-zA-Z0-9]*)[^>]*>/g;
+
+function findDisallowedTags(blurb: string): string[] {
+  const disallowed: string[] = [];
+  for (const match of blurb.matchAll(HTML_TAG_RE)) {
+    const tag = match[1]?.toLowerCase();
+    if (tag !== undefined && !ALLOWED_BLURB_TAG_SET.has(tag) && !disallowed.includes(tag)) {
+      disallowed.push(tag);
+    }
+  }
+  return disallowed;
+}
+
+export function validateListing(listing: KdpListing): ListingValidation {
+  const errors: ListingError[] = [];
+
+  if (listing.blurb.length > MAX_BLURB_LENGTH) {
+    errors.push({
+      code: 'BLURB_TOO_LONG',
+      detail: `Blurb is ${listing.blurb.length} characters, exceeding the maximum of ${MAX_BLURB_LENGTH}.`,
+    });
+  }
+
+  if (listing.blurb.trim().length === 0) {
+    errors.push({
+      code: 'BLURB_EMPTY',
+      detail: 'Blurb is empty.',
+    });
+  }
+
+  if (listing.keywords.length !== REQUIRED_KEYWORD_COUNT) {
+    errors.push({
+      code: 'KEYWORD_COUNT',
+      detail: `Listing has ${listing.keywords.length} keywords, expected exactly ${REQUIRED_KEYWORD_COUNT}.`,
+    });
+  }
+
+  if (listing.categories.length !== REQUIRED_CATEGORY_COUNT) {
+    errors.push({
+      code: 'CATEGORY_COUNT',
+      detail: `Listing has ${listing.categories.length} categories, expected exactly ${REQUIRED_CATEGORY_COUNT}.`,
+    });
+  }
+
+  const stringFields: string[] = [
+    listing.title,
+    ...(listing.subtitle === undefined ? [] : [listing.subtitle]),
+    listing.blurb,
+    listing.author,
+    ...listing.keywords,
+    ...listing.categories,
+  ];
+  if (stringFields.some((value) => value.includes(PLACEHOLDER_MARKER))) {
+    errors.push({
+      code: 'UNRESOLVED_PLACEHOLDER',
+      detail: `Listing contains unresolved "${PLACEHOLDER_MARKER}" placeholders.`,
+    });
+  }
+
+  const disallowedTags = findDisallowedTags(listing.blurb);
+  if (disallowedTags.length > 0) {
+    errors.push({
+      code: 'DISALLOWED_HTML',
+      detail: `Blurb contains disallowed HTML tags: ${disallowedTags.join(', ')}.`,
+    });
+  }
+
+  errors.sort((a, b) => (a.code < b.code ? -1 : a.code > b.code ? 1 : 0));
+
+  return { valid: errors.length === 0, errors };
+}
