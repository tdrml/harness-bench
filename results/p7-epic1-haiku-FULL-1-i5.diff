diff --git a/packages/lambdas/src/shared/__tests__/launch-agent-run.test.ts b/packages/lambdas/src/shared/__tests__/launch-agent-run.test.ts
new file mode 100644
index 0000000..9fbd29c
--- /dev/null
+++ b/packages/lambdas/src/shared/__tests__/launch-agent-run.test.ts
@@ -0,0 +1,219 @@
+import { describe, it, expect, vi, beforeEach } from 'vitest';
+import type { AgentRunService, TaskOutputService, EnvironmentConfig } from '@auto-graph/core';
+import { launchAgentRun } from '../launch-agent-run.js';
+
+vi.mock('../ecs-launcher.js');
+
+describe('launchAgentRun', () => {
+  let mockAgentRunService: AgentRunService;
+  let mockTaskOutputService: TaskOutputService;
+  const baseConfig: EnvironmentConfig = {
+    AWS_REGION: 'us-east-1',
+    DYNAMODB_TABLE_PREFIX: 'test',
+    GITHUB_TOKEN: 'ghp_test',
+    GITHUB_ORG: 'test-org',
+    ORCHESTRATION_REPO: 'test-repo',
+    SQS_QUEUE_URL: 'https://sqs.us-east-1.amazonaws.com/123/test.fifo',
+    ECS_CLUSTER_ARN: 'arn:aws:ecs:us-east-1:123:cluster/test',
+    ECS_SUBNETS: 'subnet-abc',
+    ECS_SECURITY_GROUPS: 'sg-abc',
+    LOG_LEVEL: 'info',
+  };
+
+  beforeEach(async () => {
+    vi.clearAllMocks();
+
+    mockAgentRunService = {
+      create: vi.fn().mockResolvedValue(undefined),
+    } as never;
+
+    mockTaskOutputService = {
+      save: vi.fn().mockResolvedValue(undefined),
+    } as never;
+
+    const { launchECSTask } = await import('../ecs-launcher.js');
+    vi.mocked(launchECSTask).mockResolvedValue('arn:aws:ecs:us-east-1:123:task/test-task-id');
+  });
+
+  it('generates a ULID runId', async () => {
+    const result = await launchAgentRun({
+      taskDefArn: 'arn:aws:ecs:us-east-1:123:task-definition/outliner:1',
+      workerType: 'outliner',
+      systemPrompt: 'test prompt',
+      projectId: 'proj-123',
+      repoName: 'test-repo',
+      config: baseConfig,
+      agentRunService: mockAgentRunService,
+      taskOutputService: mockTaskOutputService,
+    });
+
+    expect(result.runId).toMatch(/^[0-9A-Z]{26}$/); // ULID format
+  });
+
+  it('saves system prompt as task output', async () => {
+    const systemPrompt = 'test system prompt';
+
+    await launchAgentRun({
+      taskDefArn: 'arn:aws:ecs:us-east-1:123:task-definition/outliner:1',
+      workerType: 'outliner',
+      systemPrompt,
+      projectId: 'proj-123',
+      repoName: 'test-repo',
+      config: baseConfig,
+      agentRunService: mockAgentRunService,
+      taskOutputService: mockTaskOutputService,
+    });
+
+    expect(mockTaskOutputService.save).toHaveBeenCalledOnce();
+    const [params] = vi.mocked(mockTaskOutputService.save).mock.calls[0]!;
+    expect(params.outputType).toBe('system-prompt');
+    expect(params.content).toBe(systemPrompt);
+    expect(params.contentLength).toBe(systemPrompt.length);
+    expect(params.projectId).toBe('proj-123');
+  });
+
