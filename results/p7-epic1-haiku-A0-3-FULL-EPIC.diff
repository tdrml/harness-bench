+    await handler(event, {} as never, () => {});
+
+    expect(vi.mocked(enqueue)).toHaveBeenCalledOnce();
+    const [queueUrl, enqueuedItem] = vi.mocked(enqueue).mock.calls[0]!;
+    expect(queueUrl).toBe(baseEnv.SQS_QUEUE_URL);
