new file mode 100644
index 0000000..b52143b
--- /dev/null
+++ b/packages/lambdas/src/__tests__/integration/packaging.test.ts
@@ -0,0 +1,149 @@
+/**
+ * Integration test: manuscript packaging.
+ *
+ * Verifies that:
+ * 1. A PACKAGE_MANUSCRIPT work item reaches the packager handler through the
+ *    harness, launches the packager ECS task and moves the project to PACKAGING.
+ * 2. Reconcile marks a finished packager run SUCCEEDED.
+ * 3. Reconcile re-enqueues PACKAGE_MANUSCRIPT when the packager run failed.
+ */
+import { describe, it, expect, beforeEach, beforeAll, vi } from 'vitest';
+
+vi.mock('@auto-graph/core', async (importOriginal) => {
+  const actual = await importOriginal<typeof import('@auto-graph/core')>();
+  const mockAws = await import('./helpers/mock-aws.js');
+  const { mockGitHub } = await import('./helpers/mock-github.js');
+  const { addToQueue } = await import('./helpers/queue.js');
+
+  return {
+    ...actual,
+    createDynamoClient: vi.fn().mockReturnValue({}),
+    ProjectService: mockAws.MockProjectService,
+    TaskGraphService: mockAws.MockTaskGraphService,
+    AgentRunService: mockAws.MockAgentRunService,
+    RepoLockService: mockAws.MockRepoLockService,
+    TaskOutputService: mockAws.MockTaskOutputService,
+    RateLimitService: mockAws.MockRateLimitService,
+    createGitHubClient: vi.fn().mockReturnValue(mockGitHub),
+    enqueue: vi.fn().mockImplementation(async (_url: string, item: unknown) => {
+      addToQueue(item);
+    }),
+  };
+});
+
+vi.mock('../../shared/index.js', async (importOriginal) => {
+  const actual = await importOriginal<typeof import('../../shared/index.js')>();
+  return {
+    ...actual,
+    launchECSTask: vi.fn().mockResolvedValue(
+      'arn:aws:ecs:us-east-1:123456789:task/inttest/mock-task-id',
+    ),
+    getECSTaskStatus: vi.fn().mockResolvedValue({ status: 'STOPPED', exitCode: 0 }),
+  };
+});
+
+import { store, resetStore } from './helpers/store.js';
+import { resetQueue, pendingQueue } from './helpers/queue.js';
+import { resetMockGitHub } from './helpers/mock-github.js';
+import {
+  PROJECT_ID,
+  REPO_NAME,
+  BASE_ENV,
+  makeProjectItem,
+  makeTaskGraphItem,
+  makeChapterNode,
+  MOCK_TASK_ARN,
+} from './helpers/test-data.js';
+import { dispatch } from './helpers/pipeline-runner.js';
+import { launchECSTask, getECSTaskStatus } from '../../shared/index.js';
+
+beforeAll(() => {
+  for (const [key, value] of Object.entries(BASE_ENV)) {
+    process.env[key] = value;
+  }
+});
+
+beforeEach(() => {
+  resetStore();
+  resetQueue();
+  resetMockGitHub();
+  vi.clearAllMocks();
+  vi.mocked(launchECSTask).mockResolvedValue(MOCK_TASK_ARN);
+  vi.mocked(getECSTaskStatus).mockResolvedValue({ status: 'STOPPED', exitCode: 0 });
+
+  store.projects.set(PROJECT_ID, makeProjectItem({ status: 'REVIEWING' }));
+  const node1 = makeChapterNode('node-1', 1, { status: 'MERGED' });
+  store.taskGraphsByProjectVersion.set(PROJECT_ID, new Map([[2, makeTaskGraphItem([node1])]]));
+  store.taskGraphLatestVersion.set(PROJECT_ID, 2);
+});
+
+describe('PACKAGE_MANUSCRIPT dispatch', () => {
+  it('launches the packager ECS task and enqueues RECONCILE', async () => {
+    await dispatch({ type: 'PACKAGE_MANUSCRIPT', projectId: PROJECT_ID });
+
+    expect(vi.mocked(launchECSTask)).toHaveBeenCalledOnce();
+    const [params] = vi.mocked(launchECSTask).mock.calls[0]!;
+    expect(params.taskDefinition).toBe(BASE_ENV['PACKAGER_TASK_DEF_ARN']);
+    expect(params.environment['REPO_NAME']).toBe(REPO_NAME);
+
+    expect(pendingQueue).toHaveLength(1);
+    expect((pendingQueue[0] as { type: string }).type).toBe('RECONCILE');
+
+    const runId = (pendingQueue[0] as { runId: string }).runId;
+    const agentRun = store.agentRuns.get(runId)!;
+    expect(agentRun.workerType).toBe('packager');
+    expect(agentRun.status).toBe('RUNNING');
+
+    expect(store.projects.get(PROJECT_ID)!.status).toBe('PACKAGING');
+  });
+
+  it('stores the packager system prompt as a task output', async () => {
+    await dispatch({ type: 'PACKAGE_MANUSCRIPT', projectId: PROJECT_ID });
+
+    const output = store.taskOutputs.find((o) => o.outputType === 'system-prompt');
+    expect(output).toBeDefined();
+    expect(output!.content).toContain('release/manifest.json');
+    expect(output!.content).toContain('manuscript/manuscript.md');
+  });
+});
+
+describe('Reconcile — packager run', () => {
+  it('marks a finished packager run SUCCEEDED', async () => {
+    const runId = 'run-packager-ok';
+    store.agentRuns.set(runId, {
+      runId,
+      projectId: PROJECT_ID,
+      taskArn: MOCK_TASK_ARN,
+      workerType: 'packager',
+      status: 'RUNNING',
+      startedAt: new Date().toISOString(),
+    });
+
+    await dispatch({ type: 'RECONCILE', projectId: PROJECT_ID, runId });
+
+    expect(store.agentRuns.get(runId)!.status).toBe('SUCCEEDED');
+    expect(pendingQueue).toHaveLength(0);
+  });
+
+  it('re-enqueues PACKAGE_MANUSCRIPT when the packager run failed', async () => {
+    vi.mocked(getECSTaskStatus).mockResolvedValueOnce({ status: 'STOPPED', exitCode: 1 });
+
+    const runId = 'run-packager-fail';
+    store.agentRuns.set(runId, {
+      runId,
