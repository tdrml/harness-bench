@@ -0,0 +1,153 @@
+import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';
+import type { AgentRunService, TaskOutputService, EnvironmentConfig } from '@auto-graph/core';
+
+vi.mock('../ecs-launcher.js', async (importOriginal) => {
+  const actual = await importOriginal<typeof import('../ecs-launcher.js')>();
+  return {
+    ...actual,
+    launchECSTask: vi.fn().mockResolvedValue('arn:aws:ecs:us-east-1:123:task/test/abc123'),
+  };
+});
+
+import { launchECSTask } from '../ecs-launcher.js';
+import { launchAgentRun } from '../launch-agent-run.js';
+
+const config: EnvironmentConfig = {
+  AWS_REGION: 'us-east-1',
+  DYNAMODB_TABLE_PREFIX: 'test',
+  SQS_QUEUE_URL: 'https://sqs.us-east-1.amazonaws.com/123',
+  ECS_CLUSTER_ARN: 'arn:aws:ecs:us-east-1:123:cluster/main',
+  ECS_SUBNETS: 'subnet-aaa',
+  ECS_SECURITY_GROUPS: 'sg-aaa',
+  GITHUB_TOKEN: 'ghp_test',
+  GITHUB_ORG: 'test-org',
+  ORCHESTRATION_REPO: 'test-repo',
+  LOG_LEVEL: 'info',
+};
+
+let mockAgentRunService: { create: ReturnType<typeof vi.fn> };
+let mockTaskOutputService: { save: ReturnType<typeof vi.fn> };
+
+beforeEach(() => {
+  vi.clearAllMocks();
+  vi.mocked(launchECSTask).mockResolvedValue('arn:aws:ecs:us-east-1:123:task/test/abc123');
+
+  mockAgentRunService = { create: vi.fn().mockResolvedValue(undefined) };
+  mockTaskOutputService = { save: vi.fn().mockResolvedValue(undefined) };
+});
+
+afterEach(() => {
+  delete process.env['STATE_MACHINE_ARN'];
+});
+
+function baseParams() {
+  return {
+    taskDefArn: 'arn:aws:ecs:us-east-1:123:task-definition/outliner:1',
+    workerType: 'outliner' as const,
+    systemPrompt: 'a system prompt',
+    projectId: 'proj-123',
+    repoName: 'the-dark-tower',
+    config,
+    agentRunService: mockAgentRunService as unknown as AgentRunService,
+    taskOutputService: mockTaskOutputService as unknown as TaskOutputService,
+  };
+}
+
+describe('launchAgentRun', () => {
+  it('generates a ulid-shaped runId', async () => {
+    const result = await launchAgentRun(baseParams());
+    expect(result.runId).toMatch(/^[0-9A-HJKMNP-TV-Z]{26}$/);
+  });
+
+  it('returns the runId and taskArn from launchECSTask', async () => {
+    const result = await launchAgentRun(baseParams());
+    expect(result.taskArn).toBe('arn:aws:ecs:us-east-1:123:task/test/abc123');
+  });
+
+  it('saves the system prompt as a task output', async () => {
+    const result = await launchAgentRun(baseParams());
+
+    expect(mockTaskOutputService.save).toHaveBeenCalledOnce();
+    const [outputItem] = mockTaskOutputService.save.mock.calls[0]!;
+    expect(outputItem.runId).toBe(result.runId);
+    expect(outputItem.outputType).toBe('system-prompt');
+    expect(outputItem.projectId).toBe('proj-123');
+    expect(outputItem.content).toBe('a system prompt');
+    expect(outputItem.contentLength).toBe('a system prompt'.length);
+  });
+
+  it('launches the ECS task with the standard environment keys', async () => {
+    const result = await launchAgentRun(baseParams());
+
+    expect(vi.mocked(launchECSTask)).toHaveBeenCalledOnce();
+    const [params] = vi.mocked(launchECSTask).mock.calls[0]!;
+    expect(params.taskDefinition).toBe('arn:aws:ecs:us-east-1:123:task-definition/outliner:1');
+    expect(params.command).toEqual(['claude', '-p', '$SYSTEM_PROMPT']);
+    expect(params.environment['PROJECT_ID']).toBe('proj-123');
+    expect(params.environment['REPO_NAME']).toBe('the-dark-tower');
+    expect(params.environment['RUN_ID']).toBe(result.runId);
+    expect(params.environment['AWS_REGION']).toBe('us-east-1');
+    expect(params.environment['DYNAMODB_TABLE_PREFIX']).toBe('test');
+    expect(params.config).toBe(config);
+    expect(params.runId).toBe(result.runId);
+    expect(params.projectId).toBe('proj-123');
+  });
+
+  it('merges extraEnv into the standard environment keys', async () => {
+    await launchAgentRun({
+      ...baseParams(),
+      extraEnv: { CHAPTER_NUMBER: '3', BRANCH_NAME: 'chapter-03' },
+    });
+
+    const [params] = vi.mocked(launchECSTask).mock.calls[0]!;
+    expect(params.environment['CHAPTER_NUMBER']).toBe('3');
+    expect(params.environment['BRANCH_NAME']).toBe('chapter-03');
+    expect(params.environment['PROJECT_ID']).toBe('proj-123');
+  });
+
+  it('passes STATE_MACHINE_ARN from the environment to launchECSTask', async () => {
+    process.env['STATE_MACHINE_ARN'] = 'arn:aws:states:us-east-1:123:stateMachine/test';
+
+    await launchAgentRun(baseParams());
+
+    const [params] = vi.mocked(launchECSTask).mock.calls[0]!;
+    expect(params.stateMachineArn).toBe('arn:aws:states:us-east-1:123:stateMachine/test');
+  });
+
+  it('creates the agent-run record with status RUNNING', async () => {
+    const result = await launchAgentRun(baseParams());
+
+    expect(mockAgentRunService.create).toHaveBeenCalledOnce();
+    const [runItem] = mockAgentRunService.create.mock.calls[0]!;
+    expect(runItem.runId).toBe(result.runId);
+    expect(runItem.projectId).toBe('proj-123');
+    expect(runItem.taskArn).toBe(result.taskArn);
+    expect(runItem.workerType).toBe('outliner');
+    expect(runItem.status).toBe('RUNNING');
+    expect(runItem.nodeId).toBeUndefined();
+  });
+
+  it('includes nodeId on the agent-run record when supplied', async () => {
+    await launchAgentRun({ ...baseParams(), nodeId: 'node-1' });
+
+    const [runItem] = mockAgentRunService.create.mock.calls[0]!;
+    expect(runItem.nodeId).toBe('node-1');
+  });
+
+  it('uses the same runId for the task output and the agent-run record', async () => {
+    await launchAgentRun(baseParams());
+
+    const [outputItem] = mockTaskOutputService.save.mock.calls[0]!;
+    const [runItem] = mockAgentRunService.create.mock.calls[0]!;
+    expect(outputItem.runId).toBe(runItem.runId);
+  });
+
+  it('saves the task output before launching the ECS task, even when the launch fails', async () => {
+    vi.mocked(launchECSTask).mockRejectedValueOnce(new Error('ECS launch error'));
+
+    await expect(launchAgentRun(baseParams())).rejects.toThrow('ECS launch error');
+
+    expect(mockTaskOutputService.save).toHaveBeenCalledOnce();
+    expect(mockAgentRunService.create).not.toHaveBeenCalled();
+  });
+});
