+export interface KdpListing {
+  title: string;
+  subtitle?: string | undefined;
+  blurb: string;
+  keywords: string[];
+  categories: string[];
+  author: string;
+}
+
+export interface ListingError {
+  code: string;
+  detail: string;
+}
+
+export interface ListingValidation {
+  valid: boolean;
+  errors: ListingError[];
+}
