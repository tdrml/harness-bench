+import type { KdpListing, ListingValidation, ListingError } from './types.js';
+
+export const MAX_BLURB_LENGTH = 4000;
+export const REQUIRED_KEYWORD_COUNT = 7;
+export const REQUIRED_CATEGORY_COUNT = 3;
+export const ALLOWED_BLURB_TAGS = ['b', 'i', 'u', 'br', 'p', 'ul', 'li', 'ol', 'h4', 'h5', 'h6'];
+
+export function validateListing(listing: KdpListing): ListingValidation {
+  const errors: ListingError[] = [];
+
+  // Check blurb length
+  if (listing.blurb.length > MAX_BLURB_LENGTH) {
+    errors.push({
+      code: 'BLURB_TOO_LONG',
+      detail: `Blurb exceeds maximum length of ${MAX_BLURB_LENGTH} characters`,
+    });
+  }
+
+  // Check blurb is not empty
+  if (listing.blurb.trim() === '') {
+    errors.push({
+      code: 'BLURB_EMPTY',
+      detail: 'Blurb cannot be empty or whitespace only',
+    });
+  }
+
+  // Check keyword count
+  if (listing.keywords.length !== REQUIRED_KEYWORD_COUNT) {
+    errors.push({
+      code: 'KEYWORD_COUNT',
+      detail: `Keywords must contain exactly ${REQUIRED_KEYWORD_COUNT} entries, found ${listing.keywords.length}`,
+    });
+  }
+
+  // Check category count
+  if (listing.categories.length !== REQUIRED_CATEGORY_COUNT) {
+    errors.push({
+      code: 'CATEGORY_COUNT',
+      detail: `Categories must contain exactly ${REQUIRED_CATEGORY_COUNT} entries, found ${listing.categories.length}`,
+    });
+  }
+
+  // Check for unresolved placeholders
+  if (hasUnresolvedPlaceholder(listing)) {
+    errors.push({
+      code: 'UNRESOLVED_PLACEHOLDER',
+      detail: 'Listing contains unresolved placeholder "TODO:"',
+    });
+  }
+
+  // Check for disallowed HTML tags
+  const disallowedHtmlError = checkDisallowedHtmlTags(listing.blurb);
+  if (disallowedHtmlError) {
+    errors.push(disallowedHtmlError);
+  }
+
+  // Sort errors by code ascending
+  errors.sort((a, b) => a.code.localeCompare(b.code));
+
+  return {
+    valid: errors.length === 0,
+    errors,
+  };
+}
+
+function hasUnresolvedPlaceholder(listing: KdpListing): boolean {
+  const fieldsToCheck: string[] = [
+    listing.title,
+    listing.blurb,
+    listing.author,
+    ...(listing.subtitle ? [listing.subtitle] : []),
+    ...listing.keywords,
+    ...listing.categories,
+  ];
+
+  return fieldsToCheck.some((field) => field.includes('TODO:'));
+}
+
+function checkDisallowedHtmlTags(blurb: string): ListingError | null {
+  // Extract all HTML tags from the blurb
+  const tagRegex = /<\/?([a-zA-Z][a-zA-Z0-9]*)/g;
+  const matches = blurb.matchAll(tagRegex);
+
+  const lowerAllowedTags = ALLOWED_BLURB_TAGS.map((tag) => tag.toLowerCase());
+
+  for (const match of matches) {
+    const tagName = match[1];
+    if (tagName !== undefined) {
+      if (!lowerAllowedTags.includes(tagName.toLowerCase())) {
+        return {
+          code: 'DISALLOWED_HTML',
+          detail: `Blurb contains disallowed HTML tag: <${tagName}>`,
+        };
+      }
+    }
+  }
+
+  return null;
+}
