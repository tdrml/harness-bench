--- /dev/null
+++ b/packages/core/src/release-policy/validate.ts
@@ -0,0 +1,72 @@
+import type { KdpListing, ListingError, ListingValidation } from './types.js';
+
+export const MAX_BLURB_LENGTH = 4000;
+export const REQUIRED_KEYWORD_COUNT = 7;
+export const REQUIRED_CATEGORY_COUNT = 3;
+export const ALLOWED_BLURB_TAGS = ['b', 'i', 'u', 'br', 'p', 'ul', 'li', 'ol', 'h4', 'h5', 'h6'];
+
+const ALLOWED_BLURB_TAG_SET = new Set(ALLOWED_BLURB_TAGS);
+const HTML_TAG_PATTERN = /<\/?\s*([a-zA-Z][a-zA-Z0-9]*)\b[^>]*>/g;
+const PLACEHOLDER_TOKEN = 'TODO:';
+
+export function validateListing(listing: KdpListing): ListingValidation {
+  const errors: ListingError[] = [];
+
+  if (listing.blurb.length > MAX_BLURB_LENGTH) {
+    errors.push({
+      code: 'BLURB_TOO_LONG',
+      detail: `Blurb is ${listing.blurb.length} characters, exceeding the ${MAX_BLURB_LENGTH} character limit.`,
+    });
+  }
+
+  if (listing.blurb.trim().length === 0) {
+    errors.push({ code: 'BLURB_EMPTY', detail: 'Blurb is empty or whitespace only.' });
+  }
+
+  if (listing.keywords.length !== REQUIRED_KEYWORD_COUNT) {
+    errors.push({
+      code: 'KEYWORD_COUNT',
+      detail: `Expected exactly ${REQUIRED_KEYWORD_COUNT} keywords, found ${listing.keywords.length}.`,
+    });
+  }
+
+  if (listing.categories.length !== REQUIRED_CATEGORY_COUNT) {
+    errors.push({
+      code: 'CATEGORY_COUNT',
+      detail: `Expected exactly ${REQUIRED_CATEGORY_COUNT} categories, found ${listing.categories.length}.`,
+    });
+  }
+
+  const stringFields = [
+    listing.title,
+    listing.subtitle,
+    listing.blurb,
+    listing.author,
+    ...listing.keywords,
+    ...listing.categories,
+  ];
+  if (stringFields.some((field) => field !== undefined && field.includes(PLACEHOLDER_TOKEN))) {
+    errors.push({
+      code: 'UNRESOLVED_PLACEHOLDER',
+      detail: `One or more fields contain an unresolved "${PLACEHOLDER_TOKEN}" placeholder.`,
+    });
+  }
+
+  const disallowedTags = new Set<string>();
+  for (const match of listing.blurb.matchAll(HTML_TAG_PATTERN)) {
+    const tagName = match[1]?.toLowerCase();
+    if (tagName !== undefined && !ALLOWED_BLURB_TAG_SET.has(tagName)) {
+      disallowedTags.add(tagName);
+    }
+  }
+  if (disallowedTags.size > 0) {
+    errors.push({
+      code: 'DISALLOWED_HTML',
+      detail: `Blurb contains disallowed HTML tag(s): ${[...disallowedTags].sort().join(', ')}.`,
+    });
+  }
+
+  errors.sort((a, b) => (a.code < b.code ? -1 : a.code > b.code ? 1 : 0));
+
+  return { valid: errors.length === 0, errors };
+}
