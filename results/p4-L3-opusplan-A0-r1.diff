+
+  it('findTaskByPrNumber returns undefined when no match', async () => {
+    const client = makeClient(() => ({ Items: [] }));
+    const svc = new TaskGraphsService(client);
+    const result = await svc.findTaskByPrNumber(999);
+    expect(result).toBeUndefined();
+  });
+
+  it('findTaskByPrNumber paginates via LastEvaluatedKey and finds match on second page', async () => {
+    const task2 = makeTask({ taskId: 'task-2', prNumber: 42 });
+    const lastKey = { projectId: 'proj-1', taskId: 'task-1' };
+    const sendFn = vi.fn()
+      .mockResolvedValueOnce({ Items: [], LastEvaluatedKey: lastKey })
+      .mockResolvedValueOnce({ Items: [task2] });
+    const client = { send: sendFn } as unknown as import('@aws-sdk/lib-dynamodb').DynamoDBDocumentClient;
+    const svc = new TaskGraphsService(client);
+    const result = await svc.findTaskByPrNumber(42);
+    expect(result).toEqual(task2);
+    expect(sendFn).toHaveBeenCalledTimes(2);
+    const secondCall = sendFn.mock.calls[1][0];
+    expect(secondCall.input.ExclusiveStartKey).toEqual(lastKey);
+  });
 });
 
