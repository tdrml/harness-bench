+      expect(codesOf(makeListing({ categories }))).toEqual(['CATEGORY_COUNT']);
+    });
+  });
+
+  describe('UNRESOLVED_PLACEHOLDER', () => {
+    it('flags a placeholder in the title', () => {
+      expect(codesOf(makeListing({ title: 'TODO: pick a title' }))).toEqual(['UNRESOLVED_PLACEHOLDER']);
+    });
+
+    it('flags a placeholder in the subtitle', () => {
