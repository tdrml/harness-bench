+import { launchECSTask } from './ecs-launcher.js';
+import type { HandlerContext } from './types.js';
+
+export interface LaunchAgentRunParams {
+  taskDefArn: string;
+  workerType: WorkerType;
+  systemPrompt: string;
+  projectId: string;
+  repoName: string;
+  /** Worker-specific environment entries, merged over the standard keys. */
+  extraEnv?: Record<string, string> | undefined;
+  config: HandlerContext['config'];
+  agentRunService: AgentRunService;
+  taskOutputService: TaskOutputService;
+  nodeId?: string | undefined;
+}
+
+/**
+ * Starts an ECS worker: generates the run id, persists the system prompt,
+ * launches the task and records the RUNNING agent run.
+ *
+ * Handlers keep their own prompt, extra environment, status updates and
+ * follow-up enqueues — only the launch itself lives here.
+ */
+export async function launchAgentRun(
+  params: LaunchAgentRunParams,
+): Promise<{ runId: string; taskArn: string }> {
+  const {
+    taskDefArn,
+    workerType,
+    systemPrompt,
+    projectId,
+    repoName,
+    extraEnv,
+    config,
+    agentRunService,
+    taskOutputService,
+    nodeId,
+  } = params;
+
+  const runId = ulid();
+  const now = new Date().toISOString();
+
+  await taskOutputService.save({
+    runId,
+    outputType: 'system-prompt',
+    projectId,
+    content: systemPrompt,
+    contentLength: systemPrompt.length,
+    createdAt: now,
+  });
+
+  const taskArn = await launchECSTask({
+    taskDefinition: taskDefArn,
+    command: ['claude', '-p', '$SYSTEM_PROMPT'],
+    environment: {
+      PROJECT_ID: projectId,
+      REPO_NAME: repoName,
+      RUN_ID: runId,
+      AWS_REGION: config.AWS_REGION,
+      DYNAMODB_TABLE_PREFIX: config.DYNAMODB_TABLE_PREFIX,
+      ...extraEnv,
+    },
+    config,
+    stateMachineArn: process.env['STATE_MACHINE_ARN'],
+    runId,
+    projectId,
+  });
+
+  await agentRunService.create({
+    runId,
+    projectId,
+    taskArn,
+    workerType,
+    ...(nodeId !== undefined ? { nodeId } : {}),
+    status: 'RUNNING',
+    startedAt: now,
+  });
+
+  return { runId, taskArn };
+}
