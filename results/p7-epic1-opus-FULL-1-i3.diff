+    it('reports a manuscript that does not start at chapter 1', () => {
+      expect(structureCodes([chapter(2, body(2, 'The Offer')), chapter(3, body(3, 'Fallout'))])).toEqual([
+        'CHAPTER_GAP',
+      ]);
+    });
+
+    it('accepts chapters supplied out of order', () => {
+      expect(
+        validateManuscriptStructure([chapter(2, body(2, 'B')), chapter(1, body(1, 'A'))]).valid,
+      ).toBe(true);
+    });
+  });
+
+  describe('multiple violations', () => {
+    it('reports every violation, sorted by code', () => {
+      const result = validateManuscriptStructure([
+        chapter(1, 'Prose first.\n\n# Chapter 1: Arrival\n'),
+        chapter(3, '# Chapter 9: Fallout\n\nText.\n'),
+        chapter(4, 'No heading at all.\n'),
+      ]);
+      expect(result.valid).toBe(false);
+      expect(result.errors.map((e) => e.code)).toEqual([
+        'CHAPTER_GAP',
+        'H1_MISSING',
+        'H1_NOT_FIRST',
+        'H1_NOT_FIRST',
+        'H1_NUMBER_MISMATCH',
+      ]);
+    });
+
+    it('keeps chapter order among errors sharing a code', () => {
+      const result = validateManuscriptStructure([
+        chapter(1, body(7, 'A')),
+        chapter(2, body(8, 'B')),
+      ]);
+      expect(result.errors.map((e) => e.code)).toEqual([
+        'H1_NUMBER_MISMATCH',
+        'H1_NUMBER_MISMATCH',
+      ]);
+      expect(result.errors[0]?.detail).toContain('chapter-01.md');
+      expect(result.errors[1]?.detail).toContain('chapter-02.md');
+    });
+
+    it('gives every error a non-empty detail', () => {
+      const result = validateManuscriptStructure([
+        chapter(2, 'Prose.\n\n# Chapter 5\n'),
+        chapter(2, ''),
+      ]);
+      expect(result.errors.length).toBeGreaterThan(0);
+      for (const error of result.errors) {
+        expect(error.detail.length).toBeGreaterThan(0);
+      }
+    });
+  });
+});
