+import type { ProjectType } from '../config/schemas.js';
+import { WORD_COUNT_DEFAULTS } from '../config/defaults.js';
+import type { WordCountStage } from './types.js';
+
+export function resolveChapterTarget(params: {
+  targetWordCount: number;
+  chapterCount: number;
+}): number {
+  if (params.chapterCount <= 0) {
+    throw new Error('chapterCount must be positive');
+  }
+  return Math.floor(params.targetWordCount / params.chapterCount);
+}
+
+export function resolveTolerance(stage: WordCountStage): number {
+  switch (stage) {
+    case 'writer':
+      return 0.05;
+    case 'review':
+      return 0.10;
+    case 'merge':
+      return 0.20;
+  }
+}
+
+export function resolveWordCountRange(params: {
+  targetWordCount: number;
+  chapterCount: number;
+  stage: WordCountStage;
+}): { min: number; max: number } {
+  const target = resolveChapterTarget({
+    targetWordCount: params.targetWordCount,
+    chapterCount: params.chapterCount,
+  });
+
+  const tolerance = resolveTolerance(params.stage);
+
+  return {
+    min: Math.floor(target * (1 - tolerance)),
+    max: Math.ceil(target * (1 + tolerance)),
+  };
+}
+
+export function formatToleranceForPrompt(stage: WordCountStage): string {
+  const tolerance = resolveTolerance(stage);
+  const percent = Math.round(tolerance * 100);
+  return `±${percent}%`;
+}
+
+export function clampToProjectType(params: {
+  range: { min: number; max: number };
+  projectType: ProjectType;
+}): { min: number; max: number } {
+  const defaults = WORD_COUNT_DEFAULTS[params.projectType];
+  const { chapterMin, chapterMax } = defaults;
+
+  return {
+    min: Math.min(Math.max(params.range.min, chapterMin), chapterMax),
+    max: Math.min(Math.max(params.range.max, chapterMin), chapterMax),
+  };
+}
