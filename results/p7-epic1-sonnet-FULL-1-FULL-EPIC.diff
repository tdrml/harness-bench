+    await handler(makeEvent([makeRecord(workItem)]));
+
+    expect(vi.mocked(enqueue)).toHaveBeenCalledOnce();
+    const [, enqueuedItem] = vi.mocked(enqueue).mock.calls[0]!;
+    expect(enqueuedItem).toEqual({ type: 'GENERATE_LISTING', projectId: 'proj-123' });
+  });
+
+  it('does not mark the project complete directly — the marketer stage owns that', async () => {
+    const workItem = { type: 'RECONCILE' as const, projectId: 'proj-123', runId: 'run-abc' };
+    await handler(makeEvent([makeRecord(workItem)]));
+
+    expect(mockProjectServiceMethods.setComplete).not.toHaveBeenCalled();
+  });
+
+  it('sets the project status to RELEASING', async () => {
+    const workItem = { type: 'RECONCILE' as const, projectId: 'proj-123', runId: 'run-abc' };
+    await handler(makeEvent([makeRecord(workItem)]));
+
+    expect(mockProjectServiceMethods.updateStatus).toHaveBeenCalledWith('proj-123', 'RELEASING');
+  });
+});
+
+// ---------------------------------------------------------------------------
+// Success path — marketer
+// ---------------------------------------------------------------------------
+
+describe('RECONCILE — marketer success', () => {
+  const validListing = {
+    title: 'The Dark Tower',
+    blurb: 'A gunslinger pursues the Man in Black across a desert.',
+    keywords: ['gunslinger', 'dark fantasy', 'quest', 'desert', 'epic', 'series', 'adventure'],
+    categories: ['Fiction > Fantasy > Epic', 'Fiction > Adventure', 'Fiction > Action & Adventure'],
+    author: 'Jordan Vale',
+  };
+
+  beforeEach(() => {
+    mockAgentRunServiceMethods.get.mockResolvedValue(
+      makeAgentRun({ workerType: 'marketer', nodeId: undefined }),
+    );
+  });
+
+  it('reads release/listing.json from the main branch', async () => {
+    mockGitHubClientMethods.getFileContent.mockResolvedValueOnce(
+      makeFileContent(JSON.stringify(validListing)),
+    );
+
+    const workItem = { type: 'RECONCILE' as const, projectId: 'proj-123', runId: 'run-abc' };
+    await handler(makeEvent([makeRecord(workItem)]));
+
+    expect(mockGitHubClientMethods.getFileContent).toHaveBeenCalledWith(
+      { owner: 'test-org', repo: 'the-dark-tower' },
+      'release/listing.json',
+      'main',
+    );
+  });
+
+  it('marks the project RELEASED when the listing is valid', async () => {
+    mockGitHubClientMethods.getFileContent.mockResolvedValueOnce(
+      makeFileContent(JSON.stringify(validListing)),
+    );
+
+    const workItem = { type: 'RECONCILE' as const, projectId: 'proj-123', runId: 'run-abc' };
+    await handler(makeEvent([makeRecord(workItem)]));
+
+    expect(mockProjectServiceMethods.updateStatus).toHaveBeenCalledWith('proj-123', 'RELEASED');
+  });
+
+  it('completes the project with the persisted totalWordCount and task graph chapterCount before marking RELEASED', async () => {
+    mockProjectServiceMethods.get.mockResolvedValue({ ...validProject, totalWordCount: 90000 });
+    mockGitHubClientMethods.getFileContent.mockResolvedValueOnce(
+      makeFileContent(JSON.stringify(validListing)),
+    );
+
+    const workItem = { type: 'RECONCILE' as const, projectId: 'proj-123', runId: 'run-abc' };
+    await handler(makeEvent([makeRecord(workItem)]));
+
+    expect(mockProjectServiceMethods.setComplete).toHaveBeenCalledOnce();
+    // validTaskGraph has 2 nodes
+    expect(mockProjectServiceMethods.setComplete).toHaveBeenCalledWith('proj-123', 90000, 2);
+
+    const setCompleteOrder = mockProjectServiceMethods.setComplete.mock.invocationCallOrder[0]!;
+    const updateStatusOrder = mockProjectServiceMethods.updateStatus.mock.invocationCallOrder[0]!;
+    expect(setCompleteOrder).toBeLessThan(updateStatusOrder);
+  });
+
+  it('marks the project FAILED when the listing fails validation', async () => {
+    const invalidListing = { ...validListing, keywords: ['too', 'few'] };
+    mockGitHubClientMethods.getFileContent.mockResolvedValueOnce(
+      makeFileContent(JSON.stringify(invalidListing)),
+    );
+
+    const workItem = { type: 'RECONCILE' as const, projectId: 'proj-123', runId: 'run-abc' };
+    await handler(makeEvent([makeRecord(workItem)]));
+
+    expect(mockProjectServiceMethods.updateStatus).toHaveBeenCalledWith('proj-123', 'FAILED');
+    expect(mockProjectServiceMethods.setComplete).not.toHaveBeenCalled();
+  });
+
+  it('marks the project FAILED when release/listing.json is missing', async () => {
