+        'UNRESOLVED_PLACEHOLDER',
+      ]);
+    });
+
+    it('sorts DISALLOWED_HTML ahead of the other codes it collides with', () => {
+      const result = validateListing(
+        makeListing({ blurb: `<div>${'x'.repeat(MAX_BLURB_LENGTH)}</div>`, keywords: [] }),
+      );
+      expect(result.errors.map((e) => e.code)).toEqual([
+        'BLURB_TOO_LONG',
+        'DISALLOWED_HTML',
+        'KEYWORD_COUNT',
+      ]);
+    });
+  });
+});
+
+function makeChapter(chapterNumber: number, content?: string): ChapterFile {
+  return {
+    path: getChapterFilePath(chapterNumber),
+    content: content ?? `# Chapter ${chapterNumber}: The Long Way Down\n\nShe ran.\n`,
+  };
+}
+
+function structureCodes(chapters: ChapterFile[]): string[] {
+  return validateManuscriptStructure(chapters).errors.map((e) => e.code);
+}
+
+describe('validateManuscriptStructure', () => {
+  it('accepts a well-formed manuscript', () => {
+    const result = validateManuscriptStructure([makeChapter(1), makeChapter(2), makeChapter(3)]);
+    expect(result.valid).toBe(true);
+    expect(result.errors).toEqual([]);
+  });
+
+  it('accepts a manuscript long enough to need zero-padded and unpadded paths', () => {
+    const chapters = Array.from({ length: 12 }, (_, i) => makeChapter(i + 1));
+    expect(structureCodes(chapters)).toEqual([]);
+  });
