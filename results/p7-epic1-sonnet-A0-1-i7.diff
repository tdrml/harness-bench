+import { describe, it, expect } from 'vitest';
+import {
+  resolveChapterTarget,
+  resolveTolerance,
+  formatToleranceForPrompt,
+  resolveWordCountRange,
+  clampToProjectType,
+} from '../index.js';
+import { ProjectType } from '../../config/schemas.js';
+import { WORD_COUNT_DEFAULTS } from '../../config/defaults.js';
+
+describe('resolveChapterTarget', () => {
+  it('floors targetWordCount / chapterCount', () => {
+    expect(resolveChapterTarget({ targetWordCount: 90000, chapterCount: 3 })).toBe(30000);
+    expect(resolveChapterTarget({ targetWordCount: 100000, chapterCount: 7 })).toBe(14285);
+  });
+
+  it('throws when chapterCount is zero', () => {
+    expect(() => resolveChapterTarget({ targetWordCount: 90000, chapterCount: 0 })).toThrow();
+  });
+
+  it('throws when chapterCount is negative', () => {
+    expect(() => resolveChapterTarget({ targetWordCount: 90000, chapterCount: -1 })).toThrow();
+  });
+});
+
+describe('resolveTolerance', () => {
+  it('returns 0.05 for writer', () => {
+    expect(resolveTolerance('writer')).toBe(0.05);
+  });
+
+  it('returns 0.10 for review', () => {
+    expect(resolveTolerance('review')).toBe(0.1);
+  });
+
+  it('returns 0.20 for merge', () => {
+    expect(resolveTolerance('merge')).toBe(0.2);
+  });
+});
+
+describe('formatToleranceForPrompt', () => {
+  it('formats each stage as a percentage string', () => {
+    expect(formatToleranceForPrompt('writer')).toBe('±5%');
+    expect(formatToleranceForPrompt('review')).toBe('±10%');
+    expect(formatToleranceForPrompt('merge')).toBe('±20%');
+  });
+});
+
+describe('resolveWordCountRange', () => {
+  it('uses floor for min and ceil for max at every stage', () => {
+    // target = 30000
+    expect(resolveWordCountRange({ targetWordCount: 90000, chapterCount: 3, stage: 'writer' })).toEqual({
+      min: 28500,
+      max: 31500,
+    });
+    expect(resolveWordCountRange({ targetWordCount: 90000, chapterCount: 3, stage: 'review' })).toEqual({
+      min: 27000,
+      max: 33000,
+    });
+    expect(resolveWordCountRange({ targetWordCount: 90000, chapterCount: 3, stage: 'merge' })).toEqual({
+      min: 24000,
+      max: 36000,
+    });
+  });
+
+  it('rounds min down and max up for non-integer boundaries', () => {
+    // target = floor(100000 / 7) = 14285
+    // writer tolerance 0.05 -> min = floor(14285 * 0.95) = floor(13570.75) = 13570
+    //                           max = ceil(14285 * 1.05) = ceil(14999.25) = 15000
+    expect(resolveWordCountRange({ targetWordCount: 100000, chapterCount: 7, stage: 'writer' })).toEqual({
+      min: 13570,
+      max: 15000,
+    });
+  });
+});
+
+describe('clampToProjectType', () => {
+  it('returns the range unchanged when it is already within the project type band', () => {
+    const { chapterMin, chapterMax } = WORD_COUNT_DEFAULTS[ProjectType.NOVEL];
+    const range = { min: chapterMin + 100, max: chapterMax - 100 };
+    expect(clampToProjectType({ range, projectType: ProjectType.NOVEL })).toEqual(range);
+  });
+
+  it('raises min up to chapterMin when the range starts below the band', () => {
+    const { chapterMin, chapterMax } = WORD_COUNT_DEFAULTS[ProjectType.NOVEL];
+    const range = { min: chapterMin - 500, max: chapterMax - 100 };
+    expect(clampToProjectType({ range, projectType: ProjectType.NOVEL })).toEqual({
+      min: chapterMin,
+      max: chapterMax - 100,
+    });
+  });
+
+  it('lowers max down to chapterMax when the range ends above the band', () => {
+    const { chapterMin, chapterMax } = WORD_COUNT_DEFAULTS[ProjectType.NOVEL];
+    const range = { min: chapterMin + 100, max: chapterMax + 500 };
+    expect(clampToProjectType({ range, projectType: ProjectType.NOVEL })).toEqual({
+      min: chapterMin + 100,
+      max: chapterMax,
+    });
+  });
+
+  it('collapses both endpoints to chapterMax when the whole range lies above the band', () => {
+    const { chapterMax } = WORD_COUNT_DEFAULTS[ProjectType.NOVEL];
+    const range = { min: chapterMax + 1000, max: chapterMax + 2000 };
+    expect(clampToProjectType({ range, projectType: ProjectType.NOVEL })).toEqual({
+      min: chapterMax,
+      max: chapterMax,
+    });
+  });
+
+  it('collapses both endpoints to chapterMin when the whole range lies below the band', () => {
+    const { chapterMin } = WORD_COUNT_DEFAULTS[ProjectType.NOVEL];
+    const range = { min: chapterMin - 2000, max: chapterMin - 1000 };
+    expect(clampToProjectType({ range, projectType: ProjectType.NOVEL })).toEqual({
+      min: chapterMin,
+      max: chapterMin,
+    });
+  });
+});
