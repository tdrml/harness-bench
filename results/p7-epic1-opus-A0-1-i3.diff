@@ -1,3 +1,16 @@
 export function getChapterFilePath(chapterNumber: number): string {
   return `manuscript/chapter-${String(chapterNumber).padStart(2, '0')}.md`;
 }
+
+/**
+ * Inverse of {@link getChapterFilePath}: the chapter number a manuscript path refers to,
+ * or `undefined` when the path is not a canonical chapter path.
+ */
+export function getChapterNumberFromPath(filePath: string): number | undefined {
+  const digits = /\d+/.exec(filePath);
+  if (digits === null) {
+    return undefined;
+  }
+  const chapterNumber = parseInt(digits[0], 10);
+  return getChapterFilePath(chapterNumber) === filePath ? chapterNumber : undefined;
+}
