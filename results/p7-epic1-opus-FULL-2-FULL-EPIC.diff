+import { describe, it, expect } from 'vitest';
+import {
+  validateListing,
+  MAX_BLURB_LENGTH,
+  REQUIRED_KEYWORD_COUNT,
+  REQUIRED_CATEGORY_COUNT,
+  ALLOWED_BLURB_TAGS,
+  validateManuscriptStructure,
+} from '../index.js';
+import type { ChapterFile, KdpListing } from '../index.js';
+import { getChapterFilePath } from '../../writing/paths.js';
+
+const validListing: KdpListing = {
+  title: 'The Silent House',
+  subtitle: 'A Psychological Thriller',
+  blurb: '<b>She thought the house was listening.</b><br><br>Then it started answering.',
+  keywords: [
+    'psychological thriller suspense unreliable narrator',
+    'domestic suspense smart home AI',
+    'gaslighting manipulation thriller',
+    'surveillance technology thriller',
+    'missing husband mystery twists',
+    'isolated house thriller dark',
+    'artificial intelligence domestic noir',
+  ],
+  categories: [
+    'Fiction > Thrillers & Suspense > Psychological Thrillers',
+    'Fiction > Thrillers & Suspense > Domestic Thrillers',
+    'Fiction > Science Fiction > High Tech',
+  ],
+  author: 'A. N. Author',
+};
+
+const codesOf = (listing: KdpListing): string[] =>
+  validateListing(listing).errors.map((error) => error.code);
+
+describe('validateListing', () => {
+  describe('constants', () => {
+    it('exposes the KDP limits', () => {
+      expect(MAX_BLURB_LENGTH).toBe(4000);
+      expect(REQUIRED_KEYWORD_COUNT).toBe(7);
+      expect(REQUIRED_CATEGORY_COUNT).toBe(3);
+      expect(ALLOWED_BLURB_TAGS).toEqual(['b', 'i', 'u', 'br', 'p', 'ul', 'li', 'ol', 'h4', 'h5', 'h6']);
+    });
+  });
+
+  describe('valid listings', () => {
+    it('returns valid: true with no errors for a complete listing', () => {
+      const result = validateListing(validListing);
+      expect(result.valid).toBe(true);
+      expect(result.errors).toHaveLength(0);
+    });
+
+    it('accepts a listing without a subtitle', () => {
+      const { subtitle: _subtitle, ...rest } = validListing;
+      const result = validateListing(rest);
+      expect(result.valid).toBe(true);
+      expect(result.errors).toHaveLength(0);
+    });
+
+    it('accepts a blurb of exactly the maximum length', () => {
+      const blurb = 'a'.repeat(MAX_BLURB_LENGTH);
+      const result = validateListing({ ...validListing, blurb });
+      expect(result.valid).toBe(true);
+    });
+
+    it('accepts every allowed tag, in any case, opening and closing', () => {
+      const blurb = ALLOWED_BLURB_TAGS.map((tag) => `<${tag.toUpperCase()}>x</${tag}>`).join('');
+      const result = validateListing({ ...validListing, blurb });
+      expect(result.valid).toBe(true);
+    });
+  });
+
+  describe('BLURB_TOO_LONG', () => {
+    it('flags a blurb longer than the maximum', () => {
+      const blurb = 'a'.repeat(MAX_BLURB_LENGTH + 1);
+      const result = validateListing({ ...validListing, blurb });
+      expect(result.valid).toBe(false);
+      expect(result.errors).toHaveLength(1);
+      expect(result.errors[0]?.code).toBe('BLURB_TOO_LONG');
+      expect(result.errors[0]?.detail).toContain(String(MAX_BLURB_LENGTH));
+    });
+  });
+
+  describe('BLURB_EMPTY', () => {
+    it('flags an empty blurb', () => {
+      expect(codesOf({ ...validListing, blurb: '' })).toEqual(['BLURB_EMPTY']);
+    });
+
+    it('flags a whitespace-only blurb', () => {
+      expect(codesOf({ ...validListing, blurb: '  \n\t ' })).toEqual(['BLURB_EMPTY']);
+    });
+  });
+
+  describe('KEYWORD_COUNT', () => {
+    it('flags too few keywords', () => {
+      expect(codesOf({ ...validListing, keywords: validListing.keywords.slice(0, 6) })).toEqual([
+        'KEYWORD_COUNT',
+      ]);
+    });
+
+    it('flags too many keywords', () => {
+      const keywords = [...validListing.keywords, 'one more slot'];
+      const result = validateListing({ ...validListing, keywords });
+      expect(result.errors).toHaveLength(1);
+      expect(result.errors[0]?.code).toBe('KEYWORD_COUNT');
+      expect(result.errors[0]?.detail).toContain('8');
+    });
+
+    it('flags no keywords at all', () => {
+      expect(codesOf({ ...validListing, keywords: [] })).toEqual(['KEYWORD_COUNT']);
+    });
+  });
+
+  describe('CATEGORY_COUNT', () => {
+    it('flags too few categories', () => {
+      expect(codesOf({ ...validListing, categories: validListing.categories.slice(0, 2) })).toEqual([
+        'CATEGORY_COUNT',
+      ]);
+    });
+
+    it('flags too many categories', () => {
+      const categories = [...validListing.categories, 'Fiction > Horror'];
+      expect(codesOf({ ...validListing, categories })).toEqual(['CATEGORY_COUNT']);
+    });
+  });
+
+  describe('UNRESOLVED_PLACEHOLDER', () => {
+    it('flags a placeholder in the title', () => {
+      expect(codesOf({ ...validListing, title: 'TODO: pick a title' })).toEqual([
+        'UNRESOLVED_PLACEHOLDER',
+      ]);
+    });
+
+    it('flags a placeholder in the subtitle', () => {
+      expect(codesOf({ ...validListing, subtitle: 'TODO: subtitle' })).toEqual([
+        'UNRESOLVED_PLACEHOLDER',
+      ]);
+    });
+
+    it('flags a placeholder in the author', () => {
+      expect(codesOf({ ...validListing, author: 'TODO: pen name' })).toEqual([
+        'UNRESOLVED_PLACEHOLDER',
+      ]);
+    });
+
+    it('flags a placeholder in a keyword entry', () => {
+      const keywords = [...validListing.keywords.slice(0, 6), 'TODO: seventh slot'];
+      expect(codesOf({ ...validListing, keywords })).toEqual(['UNRESOLVED_PLACEHOLDER']);
+    });
+
+    it('flags a placeholder in a category entry', () => {
+      const categories = [...validListing.categories.slice(0, 2), 'TODO: adjacent category'];
+      expect(codesOf({ ...validListing, categories })).toEqual(['UNRESOLVED_PLACEHOLDER']);
+    });
+
+    it('reports one error even when several fields have placeholders', () => {
+      const result = validateListing({
+        ...validListing,
+        title: 'TODO: title',
+        author: 'TODO: author',
+        blurb: 'TODO: blurb',
+      });
+      expect(result.errors).toHaveLength(1);
+      expect(result.errors[0]?.code).toBe('UNRESOLVED_PLACEHOLDER');
+    });
+
+    it('does not flag the word TODO without a colon', () => {
+      expect(codesOf({ ...validListing, title: 'TODO pick a title' })).toEqual([]);
+    });
+  });
+
+  describe('DISALLOWED_HTML', () => {
+    it('flags a disallowed tag', () => {
+      const result = validateListing({ ...validListing, blurb: '<div>Hook</div>' });
+      expect(result.errors).toHaveLength(1);
+      expect(result.errors[0]?.code).toBe('DISALLOWED_HTML');
+      expect(result.errors[0]?.detail).toContain('div');
+    });
+
+    it('flags a disallowed tag regardless of case', () => {
+      expect(codesOf({ ...validListing, blurb: '<SPAN>Hook</SPAN>' })).toEqual(['DISALLOWED_HTML']);
+    });
+
+    it('flags a disallowed tag with attributes', () => {
+      expect(
+        codesOf({ ...validListing, blurb: '<a href="https://example.com">Hook</a>' }),
+      ).toEqual(['DISALLOWED_HTML']);
+    });
+
+    it('flags a disallowed closing tag on its own', () => {
+      expect(codesOf({ ...validListing, blurb: 'Hook</h1>' })).toEqual(['DISALLOWED_HTML']);
+    });
+
+    it('reports one error even when several disallowed tags appear', () => {
+      const result = validateListing({
+        ...validListing,
+        blurb: '<div>Hook</div><span>More</span><img src="x">',
+      });
+      expect(result.errors).toHaveLength(1);
+      expect(result.errors[0]?.detail).toContain('div');
+      expect(result.errors[0]?.detail).toContain('span');
+      expect(result.errors[0]?.detail).toContain('img');
+    });
+
+    it('does not flag allowed tags mixed with self-closing syntax', () => {
+      expect(codesOf({ ...validListing, blurb: '<p>Hook<br/>Line</p>' })).toEqual([]);
+    });
+  });
+
+  describe('multiple errors', () => {
+    it('reports every violation, sorted by code', () => {
+      const result = validateListing({
+        title: 'TODO: title',
+        blurb: '   <div></div>   ',
+        keywords: [],
+        categories: [],
+        author: 'A. N. Author',
+      });
+      expect(result.valid).toBe(false);
+      expect(result.errors.map((error) => error.code)).toEqual([
+        'CATEGORY_COUNT',
+        'DISALLOWED_HTML',
+        'KEYWORD_COUNT',
+        'UNRESOLVED_PLACEHOLDER',
+      ]);
+    });
+
+    it('reports both blurb errors when a long blurb is whitespace only', () => {
+      const blurb = ' '.repeat(MAX_BLURB_LENGTH + 1);
+      expect(codesOf({ ...validListing, blurb })).toEqual(['BLURB_EMPTY', 'BLURB_TOO_LONG']);
+    });
+  });
+});
+
+const chapter = (chapterNumber: number, content: string): ChapterFile => ({
+  path: getChapterFilePath(chapterNumber),
+  content,
+});
+
+const chapterBody = 'The house was listening again.';
+
+const wellFormed = (chapterNumber: number, title = 'Arrival'): ChapterFile =>
+  chapter(chapterNumber, `# Chapter ${chapterNumber}: ${title}\n\n${chapterBody}\n`);
+
+const manuscriptCodesOf = (chapters: ChapterFile[]): string[] =>
+  validateManuscriptStructure(chapters).errors.map((error) => error.code);
+
+describe('validateManuscriptStructure', () => {
+  describe('valid manuscripts', () => {
+    it('returns valid: true with no errors for a well-formed manuscript', () => {
+      const result = validateManuscriptStructure([wellFormed(1), wellFormed(2), wellFormed(3)]);
+      expect(result.valid).toBe(true);
+      expect(result.errors).toHaveLength(0);
+    });
+
+    it('accepts an empty chapter list', () => {
+      expect(validateManuscriptStructure([])).toEqual({ valid: true, errors: [] });
+    });
+
+    it('accepts chapters given out of order as long as the numbers are complete', () => {
+      expect(manuscriptCodesOf([wellFormed(2), wellFormed(1)])).toEqual([]);
+    });
+
+    it('accepts a heading followed by deeper headings', () => {
+      const content = `# Chapter 1: Arrival\n\n## Scene one\n\n${chapterBody}\n`;
+      expect(manuscriptCodesOf([chapter(1, content)])).toEqual([]);
+    });
+
+    it('accepts leading blank lines before the heading', () => {
+      const content = `\n\n# Chapter 1: Arrival\n\n${chapterBody}\n`;
+      expect(manuscriptCodesOf([chapter(1, content)])).toEqual([]);
+    });
+  });
+
+  describe('H1_MISSING', () => {
+    it('flags a chapter with no level-1 heading', () => {
+      const content = `## Scene one\n\n${chapterBody}\n`;
+      const result = validateManuscriptStructure([chapter(1, content)]);
+      expect(result.valid).toBe(false);
+      expect(result.errors.map((error) => error.code)).toContain('H1_MISSING');
+      expect(result.errors[0]?.detail).toContain('manuscript/chapter-01.md');
+    });
+
+    it('skips the malformed and mismatch checks when the heading is missing', () => {
+      expect(manuscriptCodesOf([chapter(1, chapterBody)])).toEqual(['H1_MISSING', 'H1_NOT_FIRST']);
+    });
+
+    it('flags empty content', () => {
+      expect(manuscriptCodesOf([chapter(1, '')])).toEqual(['H1_MISSING', 'H1_NOT_FIRST']);
+    });
+  });
+
+  describe('H1_NOT_FIRST', () => {
+    it('flags prose before the heading', () => {
+      const content = `${chapterBody}\n\n# Chapter 1: Arrival\n`;
+      expect(manuscriptCodesOf([chapter(1, content)])).toEqual(['H1_NOT_FIRST']);
+    });
+
+    it('flags a deeper heading before the level-1 heading', () => {
+      const content = `## Scene one\n\n# Chapter 1: Arrival\n\n${chapterBody}\n`;
+      expect(manuscriptCodesOf([chapter(1, content)])).toEqual(['H1_NOT_FIRST']);
+    });
+  });
+
+  describe('H1_MALFORMED', () => {
+    it('flags a heading without the Chapter prefix', () => {
+      const content = `# Arrival\n\n${chapterBody}\n`;
+      const result = validateManuscriptStructure([chapter(1, content)]);
+      expect(result.errors.map((error) => error.code)).toEqual(['H1_MALFORMED']);
+      expect(result.errors[0]?.detail).toContain('# Arrival');
+    });
+
+    it('flags a heading without a colon', () => {
+      expect(manuscriptCodesOf([chapter(1, '# Chapter 1 Arrival\n')])).toEqual(['H1_MALFORMED']);
+    });
+
+    it('flags a heading with an empty title', () => {
+      expect(manuscriptCodesOf([chapter(1, '# Chapter 1:   \n')])).toEqual(['H1_MALFORMED']);
+    });
+
+    it('flags a heading with a non-numeric chapter number', () => {
+      expect(manuscriptCodesOf([chapter(1, '# Chapter one: Arrival\n')])).toEqual(['H1_MALFORMED']);
+    });
+
+    it('does not also report a number mismatch for a malformed heading', () => {
+      expect(manuscriptCodesOf([wellFormed(1), chapter(2, '# Arrival\n')])).toEqual([
