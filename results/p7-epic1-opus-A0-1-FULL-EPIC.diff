+      const keywords = ['one', 'two', 'three', 'four', 'five', 'six', 'TODO: slot 7'];
+      expect(codesOf(makeListing({ keywords }))).toEqual(['UNRESOLVED_PLACEHOLDER']);
+    });
+
+    it('flags a placeholder in a category entry', () => {
