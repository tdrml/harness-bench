+
+function isStringArray(value: unknown): value is string[] {
+  return Array.isArray(value) && value.every((entry) => typeof entry === 'string');
+}
+
+/**
+ * Parse `release/listing.json` into a {@link KdpListing}. Returns undefined
+ * when the content is not JSON or does not carry the listing's field shape —
+ * the caller treats both as an unusable listing rather than letting
+ * {@link validateListing} throw on a malformed object.
+ */
+function parseListingJson(content: string): KdpListing | undefined {
+  let raw: unknown;
+  try {
+    raw = JSON.parse(content);
+  } catch {
+    return undefined;
+  }
+
+  if (typeof raw !== 'object' || raw === null) {
+    return undefined;
+  }
+
+  const listing = raw as Partial<KdpListing>;
+  if (
+    typeof listing.title !== 'string' ||
+    typeof listing.blurb !== 'string' ||
+    typeof listing.author !== 'string' ||
+    !isStringArray(listing.keywords) ||
+    !isStringArray(listing.categories) ||
+    (listing.subtitle !== undefined && typeof listing.subtitle !== 'string')
+  ) {
+    return undefined;
+  }
+
+  return listing as KdpListing;
+}
