+      characters: [],
+      timeline: [],
+      plotThreads: [],
+      worldState: { weather: 'rainy' },
+    };
+    const result = deserializeContinuityState(oldData);
+    expect(result.locations).toEqual({});
+    expect(result.worldState).toEqual({ weather: 'rainy' });
+  });
+
+  it('defaults missing arrays to empty arrays', () => {
+    const data = {
+      worldState: { key: 'value' },
+    };
+    const result = deserializeContinuityState(data);
+    expect(result.characters).toEqual([]);
+    expect(result.timeline).toEqual([]);
+    expect(result.plotThreads).toEqual([]);
+    expect(result.worldState).toEqual({ key: 'value' });
+    expect(result.locations).toEqual({});
+  });
+
+  it('defaults undefined worldState to empty object', () => {
+    const data = {
+      characters: [],
+      timeline: [],
+      plotThreads: [],
+      locations: { place: 'description' },
+    };
+    const result = deserializeContinuityState(data);
+    expect(result.worldState).toEqual({});
+    expect(result.locations).toEqual({ place: 'description' });
+  });
+
+  it('handles null values gracefully', () => {
