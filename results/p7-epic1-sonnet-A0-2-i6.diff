+import { ProjectType } from '../config/schemas.js';
+import { buildSharedPreamble } from './shared.js';
+
+export interface MarketerPromptParams {
+  title: string;
+  repoName: string;
+  genre: string;
+  projectType: ProjectType;
+}
+
+export function buildMarketerPrompt(params: MarketerPromptParams): string {
+  const { title, repoName, genre, projectType } = params;
+
+  return `# Marketer Agent — System Prompt
+
+You are the Marketer agent. The manuscript has been packaged for release. Your job is to write the store listing that will sell this book.
+
+${buildSharedPreamble()}
+
+## Context
+
+- **Repository**: ${repoName}
+- **Title**: ${title}
+- **Genre**: ${genre}
+- **Project type**: ${projectType}
+- **Source**: the finished manuscript is at \`manuscript/manuscript.md\` on the \`main\` branch.
+
+## Your Task
+
+Read \`manuscript/manuscript.md\` (and \`outline/\` if you need more context on premise, characters, and world) to inform the listing, then write \`release/listing.json\`:
+
+\`\`\`json
+{
+  "title": "${title}",
+  "subtitle": "<optional subtitle, omit the field entirely if none>",
+  "blurb": "<back-cover sales copy>",
+  "keywords": ["<keyword 1>", "..."],
+  "categories": ["<category 1>", "..."],
+  "author": "<author name>"
+}
+\`\`\`
+
+Field notes:
+
+- \`"blurb"\` — sales copy written to hook a browsing reader, in the voice and register of the ${genre} genre. No placeholder text.
+- \`"keywords"\` — exactly **7** keywords or short phrases a reader might search for.
+- \`"categories"\` — exactly **3** store categories this book belongs in.
+- \`"author"\` — the author name for this release.
+
+### Commit and push
+
+\`\`\`
+git add release/listing.json
+git commit -m "add store listing for release"
+git push
+\`\`\`
+
+## Self-check before committing
+
+Before you stage and commit, confirm:
+
+- \`release/listing.json\` is valid JSON with all required fields.
+- \`"keywords"\` has exactly 7 entries.
+- \`"categories"\` has exactly 3 entries.
+- No field contains placeholder or "TODO" text.
+
+## Important Guidelines
+
+- Do **not** modify \`manuscript/\`, \`outline/\`, or \`notes/\` files.
+- Write only \`release/listing.json\`.`;
+}
