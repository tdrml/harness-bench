+import { getChapterFilePath, getChapterNumberFromPath } from '../writing/paths.js';
+import { sortErrorsByCode } from './sort-errors.js';
+import type { ChapterFile, ManuscriptError, ManuscriptValidation } from './types.js';
+
+/** A level-1 ATX heading: a line opening with a single `#`. */
+const H1_LINE_PATTERN = /^#(?!#)/;
+
+/** The canonical chapter heading, mirroring the one `parseChapterMarkdown` reads. */
+const CHAPTER_HEADING_PATTERN = /^#\s+Chapter\s+(\d+):\s+(.+)$/;
+
+function validateChapter(chapter: ChapterFile, errors: ManuscriptError[]): void {
+  const lines = chapter.content.split('\n');
+  const headingIndex = lines.findIndex((line) => H1_LINE_PATTERN.test(line));
+  const firstContentIndex = lines.findIndex((line) => line.trim().length > 0);
+
+  if (headingIndex === -1) {
+    errors.push({
+      code: 'H1_MISSING',
+      detail: `${chapter.path} has no level-1 heading.`,
+    });
+  }
+
+  if (firstContentIndex !== -1 && firstContentIndex !== headingIndex) {
+    errors.push({
+      code: 'H1_NOT_FIRST',
+      detail: `${chapter.path} does not open with its level-1 heading.`,
+    });
+  }
+
+  if (headingIndex === -1) {
+    return;
+  }
+
+  const heading = lines[headingIndex]!.trimEnd();
+  const match = CHAPTER_HEADING_PATTERN.exec(heading);
+  if (match === null) {
+    errors.push({
+      code: 'H1_MALFORMED',
+      detail: `${chapter.path} heading "${heading}" does not match "# Chapter <N>: <Title>".`,
+    });
+    return;
+  }
+
+  const headingNumber = parseInt(match[1]!, 10);
+  const pathNumber = getChapterNumberFromPath(chapter.path);
+  if (pathNumber !== undefined && headingNumber !== pathNumber) {
+    errors.push({
+      code: 'H1_NUMBER_MISMATCH',
+      detail: `${chapter.path} is chapter ${pathNumber} but its heading declares chapter ${headingNumber}, which belongs in ${getChapterFilePath(headingNumber)}.`,
+    });
+  }
+}
+
+function validateChapterNumbers(chapters: ChapterFile[], errors: ManuscriptError[]): void {
+  const seen = new Set<number>();
+  const duplicates = new Set<number>();
+
+  for (const chapter of chapters) {
+    const chapterNumber = getChapterNumberFromPath(chapter.path);
+    if (chapterNumber === undefined) {
+      continue;
+    }
+    if (seen.has(chapterNumber)) {
+      duplicates.add(chapterNumber);
+    }
+    seen.add(chapterNumber);
+  }
+
+  for (const chapterNumber of duplicates) {
+    errors.push({
+      code: 'CHAPTER_DUPLICATE',
+      detail: `Chapter ${chapterNumber} (${getChapterFilePath(chapterNumber)}) appears more than once.`,
+    });
+  }
+
+  const missing: number[] = [];
+  for (let chapterNumber = 1; chapterNumber <= seen.size; chapterNumber++) {
+    if (!seen.has(chapterNumber)) {
+      missing.push(chapterNumber);
+    }
+  }
+
+  if (missing.length > 0) {
+    errors.push({
+      code: 'CHAPTER_GAP',
+      detail: `Chapter numbers are not contiguous from 1: missing ${missing.join(', ')}.`,
+    });
+  }
+}
+
+export function validateManuscriptStructure(chapters: ChapterFile[]): ManuscriptValidation {
+  const errors: ManuscriptError[] = [];
+
+  for (const chapter of chapters) {
+    validateChapter(chapter, errors);
+  }
+
+  validateChapterNumbers(chapters, errors);
+
+  return { valid: errors.length === 0, errors: sortErrorsByCode(errors) };
+}
diff --git a/packages/core/src/release-policy/sort-errors.ts b/packages/core/src/release-policy/sort-errors.ts
