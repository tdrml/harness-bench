+import { describe, it, expect } from 'vitest';
+import {
+  resolveChapterTarget,
+  resolveWordCountRange,
+  resolveTolerance,
+  formatToleranceForPrompt,
+  clampToProjectType,
+} from '../index.js';
+import { ProjectType } from '../../config/schemas.js';
+
+describe('resolveChapterTarget', () => {
+  it('floors the per-chapter average', () => {
+    expect(resolveChapterTarget({ targetWordCount: 100_000, chapterCount: 30 })).toBe(3333);
+  });
+
+  it('throws when chapterCount is zero', () => {
+    expect(() => resolveChapterTarget({ targetWordCount: 100_000, chapterCount: 0 })).toThrow();
+  });
+
+  it('throws when chapterCount is negative', () => {
+    expect(() => resolveChapterTarget({ targetWordCount: 100_000, chapterCount: -5 })).toThrow();
+  });
+});
+
+describe('resolveTolerance', () => {
+  it('returns 0.05 for writer', () => {
+    expect(resolveTolerance('writer')).toBe(0.05);
+  });
+
+  it('returns 0.1 for review', () => {
+    expect(resolveTolerance('review')).toBe(0.1);
+  });
+
+  it('returns 0.2 for merge', () => {
+    expect(resolveTolerance('merge')).toBe(0.2);
+  });
+});
+
+describe('formatToleranceForPrompt', () => {
+  it('formats writer tolerance', () => {
+    expect(formatToleranceForPrompt('writer')).toBe('±5%');
+  });
+
+  it('formats review tolerance', () => {
+    expect(formatToleranceForPrompt('review')).toBe('±10%');
+  });
+
+  it('formats merge tolerance', () => {
+    expect(formatToleranceForPrompt('merge')).toBe('±20%');
+  });
+});
+
+describe('resolveWordCountRange', () => {
+  it('uses floor/ceil around the target for the writer stage', () => {
+    const range = resolveWordCountRange({
+      targetWordCount: 100_000,
+      chapterCount: 30,
+      stage: 'writer',
+    });
+    // target = 3333, tolerance = 0.05
+    expect(range).toEqual({ min: Math.floor(3333 * 0.95), max: Math.ceil(3333 * 1.05) });
+  });
+
+  it('uses floor/ceil around the target for the review stage', () => {
+    const range = resolveWordCountRange({
+      targetWordCount: 100_000,
+      chapterCount: 30,
+      stage: 'review',
+    });
+    expect(range).toEqual({ min: Math.floor(3333 * 0.9), max: Math.ceil(3333 * 1.1) });
+  });
+
+  it('uses floor/ceil around the target for the merge stage, including the upper bound', () => {
+    const range = resolveWordCountRange({
+      targetWordCount: 100_000,
+      chapterCount: 30,
+      stage: 'merge',
+    });
+    // Previously the merge gate floored the max; this must now ceil it.
+    expect(range).toEqual({ min: Math.floor(3333 * 0.8), max: Math.ceil(3333 * 1.2) });
+  });
+});
+
+describe('clampToProjectType', () => {
+  it('leaves a range untouched when it already sits inside the project type band', () => {
+    const result = clampToProjectType({
+      range: { min: 3_500, max: 4_500 },
+      projectType: ProjectType.NOVEL,
+    });
+    expect(result).toEqual({ min: 3_500, max: 4_500 });
+  });
+
+  it('raises a min below the project type minimum', () => {
+    const result = clampToProjectType({
+      range: { min: 1_000, max: 4_500 },
+      projectType: ProjectType.NOVEL,
+    });
+    expect(result).toEqual({ min: 3_000, max: 4_500 });
+  });
+
+  it('lowers a max above the project type maximum', () => {
+    const result = clampToProjectType({
+      range: { min: 3_500, max: 10_000 },
+      projectType: ProjectType.NOVEL,
+    });
+    expect(result).toEqual({ min: 3_500, max: 5_000 });
+  });
+
+  it('collapses a range lying entirely below the band onto the lower bound', () => {
+    const result = clampToProjectType({
+      range: { min: 500, max: 900 },
+      projectType: ProjectType.NOVEL,
+    });
+    expect(result).toEqual({ min: 3_000, max: 3_000 });
+  });
+
+  it('collapses a range lying entirely above the band onto the upper bound', () => {
+    const result = clampToProjectType({
+      range: { min: 8_000, max: 9_000 },
+      projectType: ProjectType.NOVEL,
+    });
+    expect(result).toEqual({ min: 5_000, max: 5_000 });
+  });
+});
