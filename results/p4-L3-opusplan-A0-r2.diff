 } from '@aws-sdk/lib-dynamodb';
@@ -78,6 +79,30 @@ export class TaskGraphsService {
     return result.Item as Task | undefined;
   }
 
+  async findTaskByPrNumber(prNumber: number): Promise<Task | undefined> {
+    let lastEvaluatedKey: Record<string, unknown> | undefined;
+
+    do {
+      const result = await this.client.send(
+        new ScanCommand({
+          TableName: this.tableName,
+          FilterExpression: 'prNumber = :prNumber',
+          ExpressionAttributeValues: { ':prNumber': prNumber },
+          ExclusiveStartKey: lastEvaluatedKey,
+        }),
+      );
+
+      const items = (result.Items ?? []) as Task[];
+      if (items.length > 0) {
+        return items[0];
+      }
+
+      lastEvaluatedKey = result.LastEvaluatedKey as Record<string, unknown> | undefined;
+    } while (lastEvaluatedKey);
+
+    return undefined;
+  }
