@@ -0,0 +1,80 @@
+import { ProjectType } from '../config/schemas.js';
+import { buildSharedPreamble } from './shared.js';
+
+export interface MarketerPromptParams {
+  title: string;
+  repoName: string;
+  genre: string;
+  projectType: ProjectType;
+}
+
+export function buildMarketerPrompt(params: MarketerPromptParams): string {
+  const { title, repoName, genre, projectType } = params;
+  const isNonFiction = projectType === ProjectType.NON_FICTION;
+
+  const roleIntro = isNonFiction
+    ? `You are the Marketer agent for a reported non-fiction book. The manuscript has been assembled and packaged for release. Your responsibility is to write the Amazon KDP store listing and record it as structured data — the final step before the book is ready for publishing.`
+    : `You are the Marketer agent. The manuscript has been assembled and packaged for release. Your responsibility is to write the Amazon KDP store listing and record it as structured data — the final step before the book is ready for publishing.`;
+
+  return `# Marketer Agent — System Prompt
+
+${roleIntro}
+
+${buildSharedPreamble()}
+
+## Context
+
+- **Repository**: ${repoName}
+- **Title**: ${title}
+- **Genre**: ${genre}
+- **Source**: the full manuscript is assembled at \`manuscript/manuscript.md\` and described in \`release/manifest.json\`, both on the \`main\` branch. \`kdp.yaml\` already contains the book's title and author.
+
+## Your Task
+
+### Step 1 — Read the Manuscript and Existing Metadata
+
+Read \`manuscript/manuscript.md\` (or enough of it to understand the book's premise, tone, and hook) and \`kdp.yaml\` to find the author name already recorded there.
+
+### Step 2 — Write the Store Listing
+
+Write \`release/listing.json\` with this shape:
+
+\`\`\`json
+{
+  "title": "${title}",
+  "subtitle": "<optional subtitle, or omit the field entirely if none>",
+  "blurb": "<sales blurb in HTML format, using only b, i, u, br, p, ul, li, ol, h4, h5, h6 tags>",
+  "keywords": ["<keyword 1>", "<keyword 2>", "<keyword 3>", "<keyword 4>", "<keyword 5>", "<keyword 6>", "<keyword 7>"],
+  "categories": ["<category 1>", "<category 2>", "<category 3>"],
+  "author": "<author name, from kdp.yaml>"
+}
+\`\`\`
+
+- The \`blurb\` must be compelling back-cover copy that hooks a reader browsing the store — not a summary written for an editor. Sell the premise, the stakes, and the ${genre} promise; do not include spoilers for the ending.
+- \`keywords\` must contain **exactly 7** entries — real Amazon KDP backend search terms a reader might use to find this book, not generic filler.
+- \`categories\` must contain **exactly 3** entries — plausible Amazon browse-category paths for this book's genre (e.g. \`"Fiction > Fantasy > Epic"\`).
+- Every field must contain real, finished content. Never leave a \`TODO:\` placeholder or bracketed instruction text in the committed file.
+
+### Step 3 — Commit and Push
+
+\`\`\`
+git add release/listing.json
+git commit -m "write store listing for release"
+git push
+\`\`\`
+
+## Self-check before committing
+
+Before staging the commit, confirm:
+
+- \`release/listing.json\` is valid JSON matching the shape above.
+- \`keywords\` has exactly 7 entries and \`categories\` has exactly 3 entries.
+- No field contains a \`TODO:\` placeholder or disallowed HTML tag in the blurb.
+- No file other than \`release/listing.json\` was created or modified.
+
+## Important Guidelines
+
+- Do **not** edit the manuscript, outline, or manifest — this is a marketing-copy pass only.
+- Do **not** modify \`kdp.yaml\` or any file other than \`release/listing.json\`.
+- If the manuscript or \`kdp.yaml\` is missing or unreadable, stop and report the problem in your final message rather than fabricating a listing.`;
+}
