new file mode 100644
index 0000000..3b0801c
--- /dev/null
+++ b/packages/core/src/word-count-policy/resolve.ts
@@ -0,0 +1,54 @@
+import type { WordCountStage } from './types.js';
+
+const STAGE_TOLERANCES: Record<WordCountStage, number> = {
+  writer: 0.05,
+  review: 0.1,
+  merge: 0.2,
+};
+
+export interface ResolveChapterTargetParams {
+  targetWordCount: number;
+  chapterCount: number;
+}
+
+export interface ResolveWordCountRangeParams extends ResolveChapterTargetParams {
+  stage: WordCountStage;
+}
+
+/**
+ * Per-chapter word count target: the project's total budget split evenly across
+ * its chapters, rounded down.
+ */
+export function resolveChapterTarget(params: ResolveChapterTargetParams): number {
+  const { targetWordCount, chapterCount } = params;
+  if (chapterCount <= 0) {
+    throw new Error(`chapterCount must be positive, received: ${chapterCount}`);
+  }
+  return Math.floor(targetWordCount / chapterCount);
+}
+
+/** Fractional tolerance allowed around the per-chapter target at a given stage. */
+export function resolveTolerance(stage: WordCountStage): number {
+  return STAGE_TOLERANCES[stage];
+}
+
+/** Acceptable word count band around the per-chapter target for a given stage. */
+export function resolveWordCountRange(
+  params: ResolveWordCountRangeParams,
+): { min: number; max: number } {
+  const { targetWordCount, chapterCount, stage } = params;
+  const target = resolveChapterTarget({ targetWordCount, chapterCount });
+  const tolerance = resolveTolerance(stage);
+  return {
+    min: Math.floor(target * (1 - tolerance)),
+    max: Math.ceil(target * (1 + tolerance)),
+  };
+}
+
+/**
+ * The stage's tolerance rendered for agent prompts, so prompt prose and the gate
+ * that grades against it can never drift apart.
+ */
+export function formatToleranceForPrompt(stage: WordCountStage): string {
+  return `±${Math.round(resolveTolerance(stage) * 100)}%`;
+}
