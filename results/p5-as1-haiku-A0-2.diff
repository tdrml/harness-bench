+// ---------------------------------------------------------------------------
+// validateWordCount — strict mode
+// ---------------------------------------------------------------------------
+
+describe('validateWordCount — strict mode', () => {
+  it('treats em-dashes as word separators in strict mode', () => {
+    const text = 'fire—and—forget';
+    const result = validateWordCount(text, { min: 0, max: 10 }, { mode: 'strict' });
+    expect(result.wordCount).toBe(3);
+    expect(result.valid).toBe(true);
+  });
+
+  it('keeps em-dashes as non-separators in legacy mode (default)', () => {
+    const text = 'fire—and—forget';
+    const result = validateWordCount(text, { min: 0, max: 10 });
+    expect(result.wordCount).toBe(1);
+    expect(result.valid).toBe(true);
+  });
+
+  it('excludes pure-number tokens in strict mode', () => {
+    const text = 'I have 3 apples and 2.5 oranges';
+    const result = validateWordCount(text, { min: 0, max: 10 }, { mode: 'strict' });
+    // Tokens: I, have, 3, apples, and, 2.5, oranges
+    // Pure numbers (3, 2.5) excluded: I, have, apples, and, oranges = 5
+    expect(result.wordCount).toBe(5);
+    expect(result.valid).toBe(true);
+  });
+
+  it('counts comma-separated numbers (e.g., 1,000) as pure numbers in strict mode', () => {
+    const text = 'The population is 1,000 people';
+    const result = validateWordCount(text, { min: 0, max: 10 }, { mode: 'strict' });
+    // Tokens: The, population, is, 1,000, people
+    // Pure numbers (1,000) excluded: The, population, is, people = 4
+    expect(result.wordCount).toBe(4);
+    expect(result.valid).toBe(true);
+  });
+
+  it('counts mixed alphanumeric tokens (e.g., v2, 3rd) in strict mode', () => {
+    const text = 'Version 3.0 and v2 patches';
+    const result = validateWordCount(text, { min: 0, max: 10 }, { mode: 'strict' });
+    // Tokens: Version, 3.0, and, v2, patches
+    // Pure number (3.0) excluded, but v2 is mixed: Version, and, v2, patches = 4
+    expect(result.wordCount).toBe(4);
+    expect(result.valid).toBe(true);
+  });
+
+  it('keeps hyphenated compounds as one word in strict mode', () => {
+    const text = 'state-of-the-art solution';
+    const result = validateWordCount(text, { min: 0, max: 10 }, { mode: 'strict' });
+    // Tokens: state-of-the-art, solution = 2
+    expect(result.wordCount).toBe(2);
+    expect(result.valid).toBe(true);
+  });
+
+  it('keeps hyphenated compounds as one word in legacy mode', () => {
+    const text = 'state-of-the-art solution';
+    const result = validateWordCount(text, { min: 0, max: 10 });
+    // Tokens: state-of-the-art, solution = 2
+    expect(result.wordCount).toBe(2);
+    expect(result.valid).toBe(true);
+  });
+
+  it('treats both whitespace and em-dashes as separators in strict mode', () => {
+    const text = 'word1 — word2—word3';
+    const result = validateWordCount(text, { min: 0, max: 10 }, { mode: 'strict' });
+    // After em-dash replacement with space: 'word1   word2 word3'
+    // Split and filter empty: word1, word2, word3 = 3
+    expect(result.wordCount).toBe(3);
+    expect(result.valid).toBe(true);
+  });
+
+  it('strips markdown before applying strict mode rules', () => {
+    const text = '**3** words here';
+    const result = validateWordCount(text, { min: 0, max: 10 }, { mode: 'strict' });
+    // After markdown removal: '3 words here'
+    // Tokens: 3, words, here
+    // Pure number (3) excluded: words, here = 2
+    expect(result.wordCount).toBe(2);
+    expect(result.valid).toBe(true);
+  });
+
+  it('maintains backward compatibility with legacy mode by default', () => {
+    const text = 'fire—and—forget 3 items';
+    const legacyResult = validateWordCount(text, { min: 0, max: 10 });
+    const strictResult = validateWordCount(text, { min: 0, max: 10 }, { mode: 'strict' });
+    // Legacy: 'fire—and—forget' is 1 word, '3' is 1 word, 'items' is 1 word = 3
+    expect(legacyResult.wordCount).toBe(3);
+    // Strict: 'fire', 'and', 'forget' = 3, 'items' = 1, '3' excluded = 4
+    expect(strictResult.wordCount).toBe(4);
+    expect(legacyResult.wordCount).not.toBe(strictResult.wordCount);
+  });
+
+  it('applies deviation and valid checks correctly in strict mode', () => {
+    const text = 'fire—and—forget';
+    const result = validateWordCount(text, { min: 5, max: 10 }, { mode: 'strict' });
+    // Strict: 3 words, min 5 → below range
+    expect(result.wordCount).toBe(3);
+    expect(result.valid).toBe(false);
+    expect(result.deviation).toBe(-2);
+  });
+
+  it('handles consecutive em-dashes as single separator', () => {
+    const text = 'word1———word2';
+    const result = validateWordCount(text, { min: 0, max: 10 }, { mode: 'strict' });
+    // After em-dash replacement with space: 'word1   word2'
+    // Split and filter empty: word1, word2 = 2
+    expect(result.wordCount).toBe(2);
+    expect(result.valid).toBe(true);
+  });
+
+  it('handles numbers with multiple decimal places in strict mode', () => {
+    const text = 'The value is 3.14159 units';
+    const result = validateWordCount(text, { min: 0, max: 10 }, { mode: 'strict' });
+    // Tokens: The, value, is, 3.14159, units
+    // Pure number (3.14159) excluded: The, value, is, units = 4
+    expect(result.wordCount).toBe(4);
+    expect(result.valid).toBe(true);
+  });
+});
+
