+import { describe, it, expect } from 'vitest';
+import { validateListing, MAX_BLURB_LENGTH } from '../index.js';
+import type { KdpListing } from '../index.js';
+
+function makeListing(overrides: Partial<KdpListing> = {}): KdpListing {
+  return {
+    title: 'My Book',
+    subtitle: undefined,
+    blurb: 'A gripping tale of adventure.',
+    keywords: ['a', 'b', 'c', 'd', 'e', 'f', 'g'],
+    categories: ['Fiction', 'Adventure', 'Fantasy'],
+    author: 'Jane Doe',
+    ...overrides,
+  };
+}
+
+describe('validateListing', () => {
+  it('returns valid: true with no errors for a well-formed listing', () => {
+    const result = validateListing(makeListing());
+    expect(result.valid).toBe(true);
+    expect(result.errors).toHaveLength(0);
+  });
+
+  describe('BLURB_TOO_LONG', () => {
+    it('flags a blurb longer than the maximum length', () => {
+      const result = validateListing(makeListing({ blurb: 'a'.repeat(MAX_BLURB_LENGTH + 1) }));
+      expect(result.valid).toBe(false);
+      expect(result.errors.map((e) => e.code)).toContain('BLURB_TOO_LONG');
+    });
+
+    it('does not flag a blurb exactly at the maximum length', () => {
+      const result = validateListing(makeListing({ blurb: 'a'.repeat(MAX_BLURB_LENGTH) }));
+      expect(result.errors.map((e) => e.code)).not.toContain('BLURB_TOO_LONG');
+    });
+  });
+
+  describe('BLURB_EMPTY', () => {
+    it('flags an empty blurb', () => {
+      const result = validateListing(makeListing({ blurb: '' }));
+      expect(result.errors.map((e) => e.code)).toContain('BLURB_EMPTY');
+    });
+
+    it('flags a whitespace-only blurb', () => {
+      const result = validateListing(makeListing({ blurb: '   \n\t  ' }));
+      expect(result.errors.map((e) => e.code)).toContain('BLURB_EMPTY');
+    });
+  });
+
+  describe('KEYWORD_COUNT', () => {
+    it('flags fewer than 7 keywords', () => {
+      const result = validateListing(makeListing({ keywords: ['a', 'b'] }));
+      expect(result.errors.map((e) => e.code)).toContain('KEYWORD_COUNT');
+    });
+
+    it('flags more than 7 keywords', () => {
+      const result = validateListing(makeListing({ keywords: Array(8).fill('k') }));
+      expect(result.errors.map((e) => e.code)).toContain('KEYWORD_COUNT');
+    });
+
+    it('does not flag exactly 7 keywords', () => {
+      const result = validateListing(makeListing({ keywords: Array(7).fill('k') }));
+      expect(result.errors.map((e) => e.code)).not.toContain('KEYWORD_COUNT');
+    });
+  });
+
+  describe('CATEGORY_COUNT', () => {
+    it('flags a category count other than 3', () => {
+      const result = validateListing(makeListing({ categories: ['a', 'b'] }));
+      expect(result.errors.map((e) => e.code)).toContain('CATEGORY_COUNT');
+    });
+
+    it('does not flag exactly 3 categories', () => {
+      const result = validateListing(makeListing({ categories: ['a', 'b', 'c'] }));
+      expect(result.errors.map((e) => e.code)).not.toContain('CATEGORY_COUNT');
+    });
+  });
+
+  describe('UNRESOLVED_PLACEHOLDER', () => {
+    it('flags a TODO: placeholder in the title', () => {
+      const result = validateListing(makeListing({ title: 'TODO: pick a title' }));
+      expect(result.errors.map((e) => e.code)).toContain('UNRESOLVED_PLACEHOLDER');
+    });
+
+    it('flags a TODO: placeholder inside a keyword', () => {
+      const result = validateListing(
+        makeListing({ keywords: ['a', 'b', 'c', 'd', 'e', 'f', 'TODO: keyword'] }),
+      );
+      expect(result.errors.map((e) => e.code)).toContain('UNRESOLVED_PLACEHOLDER');
+    });
+
+    it('flags a TODO: placeholder inside a category', () => {
+      const result = validateListing(makeListing({ categories: ['a', 'b', 'TODO: category'] }));
+      expect(result.errors.map((e) => e.code)).toContain('UNRESOLVED_PLACEHOLDER');
+    });
+
+    it('reports only one error even with multiple TODO: occurrences', () => {
+      const result = validateListing(
+        makeListing({
+          title: 'TODO: title',
+          blurb: 'TODO: blurb',
+          author: 'TODO: author',
+        }),
+      );
+      expect(result.errors.filter((e) => e.code === 'UNRESOLVED_PLACEHOLDER')).toHaveLength(1);
+    });
+  });
+
+  describe('DISALLOWED_HTML', () => {
+    it('does not flag allowed tags', () => {
+      const result = validateListing({
+        ...makeListing(),
+        blurb: '<p>Hello <b>world</b>, <i>enjoy</i> this <br/> book. <ul><li>Item</li></ul></p>',
+      });
+      expect(result.errors.map((e) => e.code)).not.toContain('DISALLOWED_HTML');
+    });
+
+    it('flags a tag outside the allowlist', () => {
+      const result = validateListing({ ...makeListing(), blurb: '<script>alert(1)</script>' });
+      expect(result.errors.map((e) => e.code)).toContain('DISALLOWED_HTML');
+    });
+
+    it('is case-insensitive when matching tags', () => {
+      const result = validateListing({ ...makeListing(), blurb: '<B>bold</B>' });
+      expect(result.errors.map((e) => e.code)).not.toContain('DISALLOWED_HTML');
+    });
+
+    it('treats closing tags the same as opening tags', () => {
+      const result = validateListing({ ...makeListing(), blurb: 'Some text</div>' });
+      expect(result.errors.map((e) => e.code)).toContain('DISALLOWED_HTML');
+    });
+
+    it('reports only one error even with multiple disallowed tags', () => {
+      const result = validateListing({
+        ...makeListing(),
+        blurb: '<script>a</script><iframe>b</iframe>',
+      });
+      expect(result.errors.filter((e) => e.code === 'DISALLOWED_HTML')).toHaveLength(1);
+    });
+  });
+
+  describe('errors ordering', () => {
+    it('sorts errors by code ascending', () => {
+      const result = validateListing({
+        title: 'TODO: title',
+        subtitle: undefined,
+        blurb: '',
+        keywords: [],
+        categories: [],
+        author: 'Jane Doe',
+      });
+      const codes = result.errors.map((e) => e.code);
+      const sorted = [...codes].sort();
+      expect(codes).toEqual(sorted);
+      expect(codes).toEqual([
+        'BLURB_EMPTY',
+        'CATEGORY_COUNT',
+        'KEYWORD_COUNT',
+        'UNRESOLVED_PLACEHOLDER',
+      ]);
+    });
+  });
+});
