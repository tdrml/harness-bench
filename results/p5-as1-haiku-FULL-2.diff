+describe('validateWordCount — strict mode', () => {
+  it('treats em-dashes as word separators', () => {
+    const result = validateWordCount('fire—and—forget', { min: 0, max: 10 }, { mode: 'strict' });
+    expect(result.wordCount).toBe(3);
+    expect(result.valid).toBe(true);
+  });
+
+  it('excludes pure-number tokens in strict mode', () => {
+    const result = validateWordCount('I have 3 apples and 2.5 oranges', { min: 0, max: 10 }, { mode: 'strict' });
+    // Words: I, have, 3 (pure number, excluded), apples, and, 2.5 (pure number, excluded), oranges
+    expect(result.wordCount).toBe(5);
+  });
+
+  it('counts mixed alphanumeric tokens in strict mode', () => {
+    const result = validateWordCount('Version 3.0 and v2 patches', { min: 0, max: 10 }, { mode: 'strict' });
+    // Words: Version, 3.0 (pure number, excluded), and, v2 (has letters, counted), patches
+    expect(result.wordCount).toBe(4);
+  });
+
+  it('keeps hyphenated compounds as one word in strict mode', () => {
+    const result = validateWordCount('state-of-the-art solution', { min: 0, max: 10 }, { mode: 'strict' });
+    // Words: state-of-the-art (stays 1), solution
+    expect(result.wordCount).toBe(2);
+  });
+
+  it('treats whitespace and em-dashes both as separators', () => {
+    const result = validateWordCount('word1 — word2—word3', { min: 0, max: 10 }, { mode: 'strict' });
+    expect(result.wordCount).toBe(3);
+  });
+
+  it('strips markdown in strict mode before applying rules', () => {
+    const result = validateWordCount('**3** words here', { min: 0, max: 10 }, { mode: 'strict' });
+    // After markdown removal: '3 words here', then '3' is pure number excluded
+    expect(result.wordCount).toBe(2);
+  });
+
+  it('defaults to legacy mode when mode omitted', () => {
+    const result = validateWordCount('fire—and—forget', { min: 0, max: 10 });
+    expect(result.wordCount).toBe(1);
+  });
+
+  it('counts numbers with thousands separators as pure numbers', () => {
+    const result = validateWordCount('I have 1,000 apples', { min: 0, max: 10 }, { mode: 'strict' });
+    // Words: I, have, 1,000 (pure number, excluded), apples
+    expect(result.wordCount).toBe(3);
+  });
+
+  it('handles deviation calculation in strict mode', () => {
+    const result = validateWordCount('word1—word2', { min: 5, max: 10 }, { mode: 'strict' });
+    // Words: word1, word2 = 2 words
+    expect(result.wordCount).toBe(2);
+    expect(result.valid).toBe(false);
+    expect(result.deviation).toBe(-3);
+  });
+});
+
