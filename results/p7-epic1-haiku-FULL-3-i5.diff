diff --git a/packages/lambdas/src/shared/__tests__/launch-agent-run.test.ts b/packages/lambdas/src/shared/__tests__/launch-agent-run.test.ts
new file mode 100644
index 0000000..a4041ba
--- /dev/null
+++ b/packages/lambdas/src/shared/__tests__/launch-agent-run.test.ts
@@ -0,0 +1,191 @@
+import { describe, it, expect, vi, beforeEach } from 'vitest';
+import { launchAgentRun } from '../launch-agent-run.js';
+import type { AgentRunService, TaskOutputService, EnvironmentConfig } from '@auto-graph/core';
+
+vi.mock('../ecs-launcher.js', () => ({
+  launchECSTask: vi.fn().mockResolvedValue('arn:aws:ecs:us-east-1:123:task/test-task'),
+}));
+
+vi.mock('ulid', () => ({
+  ulid: vi.fn().mockReturnValue('01arwx3f0r0nc0w0fzhyx4gxbn'),
+}));
+
+import { launchECSTask } from '../ecs-launcher.js';
+import { ulid } from 'ulid';
+
+describe('launchAgentRun', () => {
+  let mockAgentRunService: AgentRunService;
+  let mockTaskOutputService: TaskOutputService;
+  let config: EnvironmentConfig;
+
+  beforeEach(() => {
+    vi.clearAllMocks();
+
+    mockAgentRunService = {
+      create: vi.fn().mockResolvedValue(undefined),
+    } as never;
+
+    mockTaskOutputService = {
+      save: vi.fn().mockResolvedValue(undefined),
+    } as never;
+
+    config = {
+      AWS_REGION: 'us-east-1',
+      DYNAMODB_TABLE_PREFIX: 'test',
+    } as EnvironmentConfig;
+  });
+
+  it('generates a runId using ulid()', async () => {
+    await launchAgentRun({
+      taskDefArn: 'arn:aws:ecs:us-east-1:123:task-definition/writer:1',
+      workerType: 'writer',
+      systemPrompt: 'Write chapter 1',
+      projectId: 'proj-123',
+      repoName: 'my-repo',
+      config,
+      agentRunService: mockAgentRunService,
+      taskOutputService: mockTaskOutputService,
+    });
+
+    expect(ulid).toHaveBeenCalledOnce();
+  });
+
+  it('saves the system prompt to task output', async () => {
+    await launchAgentRun({
+      taskDefArn: 'arn:aws:ecs:us-east-1:123:task-definition/writer:1',
+      workerType: 'writer',
+      systemPrompt: 'Write chapter 1',
+      projectId: 'proj-123',
+      repoName: 'my-repo',
+      config,
+      agentRunService: mockAgentRunService,
+      taskOutputService: mockTaskOutputService,
+    });
+
+    expect(mockTaskOutputService.save).toHaveBeenCalledOnce();
+    const [output] = vi.mocked(mockTaskOutputService.save).mock.calls[0]!;
+    expect(output.outputType).toBe('system-prompt');
+    expect(output.projectId).toBe('proj-123');
+    expect(output.content).toBe('Write chapter 1');
+    expect(output.contentLength).toBe(15);
+  });
+
+  it('launches ECS task with standard environment variables', async () => {
+    await launchAgentRun({
+      taskDefArn: 'arn:aws:ecs:us-east-1:123:task-definition/writer:1',
+      workerType: 'writer',
+      systemPrompt: 'Write chapter 1',
+      projectId: 'proj-123',
+      repoName: 'my-repo',
+      config,
+      agentRunService: mockAgentRunService,
+      taskOutputService: mockTaskOutputService,
+    });
+
+    expect(launchECSTask).toHaveBeenCalledOnce();
+    const [params] = vi.mocked(launchECSTask).mock.calls[0]!;
+    expect(params.taskDefinition).toBe('arn:aws:ecs:us-east-1:123:task-definition/writer:1');
+    expect(params.command).toEqual(['claude', '-p', '$SYSTEM_PROMPT']);
+    expect(params.environment['PROJECT_ID']).toBe('proj-123');
+    expect(params.environment['REPO_NAME']).toBe('my-repo');
+    expect(params.environment['RUN_ID']).toBe('01arwx3f0r0nc0w0fzhyx4gxbn');
+    expect(params.environment['AWS_REGION']).toBe('us-east-1');
+    expect(params.environment['DYNAMODB_TABLE_PREFIX']).toBe('test');
+  });
+
+  it('merges extraEnv with standard environment variables', async () => {
+    await launchAgentRun({
+      taskDefArn: 'arn:aws:ecs:us-east-1:123:task-definition/writer:1',
+      workerType: 'writer',
+      systemPrompt: 'Write chapter 1',
+      projectId: 'proj-123',
+      repoName: 'my-repo',
+      extraEnv: {
+        CHAPTER_NUMBER: '1',
+        BRANCH_NAME: 'chapter-01',
+      },
+      config,
+      agentRunService: mockAgentRunService,
+      taskOutputService: mockTaskOutputService,
+    });
+
+    const [params] = vi.mocked(launchECSTask).mock.calls[0]!;
+    expect(params.environment['CHAPTER_NUMBER']).toBe('1');
+    expect(params.environment['BRANCH_NAME']).toBe('chapter-01');
+    expect(params.environment['PROJECT_ID']).toBe('proj-123');
+  });
+
+  it('creates agent run record with status RUNNING', async () => {
+    await launchAgentRun({
+      taskDefArn: 'arn:aws:ecs:us-east-1:123:task-definition/writer:1',
+      workerType: 'writer',
+      systemPrompt: 'Write chapter 1',
+      projectId: 'proj-123',
+      repoName: 'my-repo',
+      config,
+      agentRunService: mockAgentRunService,
+      taskOutputService: mockTaskOutputService,
+    });
+
+    expect(mockAgentRunService.create).toHaveBeenCalledOnce();
+    const [runItem] = vi.mocked(mockAgentRunService.create).mock.calls[0]!;
+    expect(runItem.runId).toBe('01arwx3f0r0nc0w0fzhyx4gxbn');
+    expect(runItem.projectId).toBe('proj-123');
+    expect(runItem.taskArn).toBe('arn:aws:ecs:us-east-1:123:task/test-task');
+    expect(runItem.workerType).toBe('writer');
+    expect(runItem.status).toBe('RUNNING');
+  });
+
+  it('includes nodeId in agent run record when provided', async () => {
+    await launchAgentRun({
+      taskDefArn: 'arn:aws:ecs:us-east-1:123:task-definition/writer:1',
+      workerType: 'writer',
+      systemPrompt: 'Write chapter 1',
+      projectId: 'proj-123',
+      repoName: 'my-repo',
+      nodeId: 'node-1',
+      config,
+      agentRunService: mockAgentRunService,
+      taskOutputService: mockTaskOutputService,
+    });
+
+    const [runItem] = vi.mocked(mockAgentRunService.create).mock.calls[0]!;
+    expect(runItem.nodeId).toBe('node-1');
+  });
+
+  it('returns runId and taskArn', async () => {
+    const result = await launchAgentRun({
+      taskDefArn: 'arn:aws:ecs:us-east-1:123:task-definition/writer:1',
+      workerType: 'writer',
+      systemPrompt: 'Write chapter 1',
+      projectId: 'proj-123',
+      repoName: 'my-repo',
+      config,
+      agentRunService: mockAgentRunService,
+      taskOutputService: mockTaskOutputService,
+    });
+
+    expect(result.runId).toBe('01arwx3f0r0nc0w0fzhyx4gxbn');
+    expect(result.taskArn).toBe('arn:aws:ecs:us-east-1:123:task/test-task');
+  });
+
+  it('uses the same runId for all operations', async () => {
+    await launchAgentRun({
+      taskDefArn: 'arn:aws:ecs:us-east-1:123:task-definition/writer:1',
+      workerType: 'writer',
+      systemPrompt: 'Write chapter 1',
+      projectId: 'proj-123',
+      repoName: 'my-repo',
