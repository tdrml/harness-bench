@@ -0,0 +1,73 @@
+import {
+  MAX_BLURB_LENGTH,
+  REQUIRED_KEYWORD_COUNT,
+  REQUIRED_CATEGORY_COUNT,
+  ALLOWED_BLURB_TAGS,
+} from './constants.js';
+import type { KdpListing, ListingError, ListingValidation } from './types.js';
+
+const HTML_TAG_PATTERN = /<\/?\s*([a-zA-Z][a-zA-Z0-9]*)\b[^>]*>/g;
+
+function containsPlaceholder(listing: KdpListing): boolean {
+  const stringFields = [listing.title, listing.subtitle, listing.blurb, listing.author];
+  const allStrings = [...stringFields, ...listing.keywords, ...listing.categories];
+  return allStrings.some((field) => field !== undefined && field.includes('TODO:'));
+}
+
+function containsDisallowedHtml(blurb: string): boolean {
+  const allowed = new Set<string>(ALLOWED_BLURB_TAGS);
+  for (const match of blurb.matchAll(HTML_TAG_PATTERN)) {
+    const tagName = match[1]?.toLowerCase();
+    if (tagName !== undefined && !allowed.has(tagName)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+export function validateListing(listing: KdpListing): ListingValidation {
+  const errors: ListingError[] = [];
+
+  if (listing.blurb.length > MAX_BLURB_LENGTH) {
+    errors.push({
+      code: 'BLURB_TOO_LONG',
+      detail: `blurb is ${listing.blurb.length} characters, exceeding the maximum of ${MAX_BLURB_LENGTH}.`,
+    });
+  }
+
+  if (listing.blurb.trim().length === 0) {
+    errors.push({ code: 'BLURB_EMPTY', detail: 'blurb is empty or contains only whitespace.' });
+  }
+
+  if (listing.keywords.length !== REQUIRED_KEYWORD_COUNT) {
+    errors.push({
+      code: 'KEYWORD_COUNT',
+      detail: `keywords must contain exactly ${REQUIRED_KEYWORD_COUNT} entries, found ${listing.keywords.length}.`,
+    });
+  }
+
+  if (listing.categories.length !== REQUIRED_CATEGORY_COUNT) {
+    errors.push({
+      code: 'CATEGORY_COUNT',
+      detail: `categories must contain exactly ${REQUIRED_CATEGORY_COUNT} entries, found ${listing.categories.length}.`,
+    });
+  }
+
+  if (containsPlaceholder(listing)) {
+    errors.push({
+      code: 'UNRESOLVED_PLACEHOLDER',
+      detail: 'one or more fields contain an unresolved "TODO:" placeholder.',
+    });
+  }
+
+  if (containsDisallowedHtml(listing.blurb)) {
+    errors.push({
+      code: 'DISALLOWED_HTML',
+      detail: `blurb contains an HTML tag outside the allowlist (${ALLOWED_BLURB_TAGS.join(', ')}).`,
+    });
+  }
+
+  errors.sort((a, b) => (a.code < b.code ? -1 : a.code > b.code ? 1 : 0));
+
+  return { valid: errors.length === 0, errors };
+}
