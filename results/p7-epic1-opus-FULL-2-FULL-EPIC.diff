+
+    it('keeps chapter order within a repeated code', () => {
+      const chapters = [chapter(1, '# Chapter 1\n'), chapter(2, '# Chapter 2\n')];
+      const result = validateManuscriptStructure(chapters);
+      expect(result.errors.map((error) => error.code)).toEqual(['H1_MALFORMED', 'H1_MALFORMED']);
+      expect(result.errors[0]?.detail).toContain(getChapterFilePath(1));
+      expect(result.errors[1]?.detail).toContain(getChapterFilePath(2));
+    });
