+      ]);
+      expect(result.errors.map((e) => e.code)).toContain('CHAPTER_DUPLICATE');
+    });
+  });
+
+  describe('CHAPTER_GAP', () => {
+    it('flags a manuscript missing a chapter number', () => {
+      const result = validateManuscriptStructure([chapterFile(1), chapterFile(3)]);
+      expect(result.errors.map((e) => e.code)).toContain('CHAPTER_GAP');
+    });
+
+    it('does not flag a contiguous 1..n sequence', () => {
+      const result = validateManuscriptStructure([chapterFile(1), chapterFile(2), chapterFile(3)]);
+      expect(result.errors.map((e) => e.code)).not.toContain('CHAPTER_GAP');
+    });
+  });
+
+  describe('ordering and combination', () => {
+    it('sorts errors by code ascending', () => {
