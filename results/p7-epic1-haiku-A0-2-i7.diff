+
+describe('resolveChapterTarget', () => {
+  it('computes floor division of targetWordCount by chapterCount', () => {
+    const target = resolveChapterTarget({
+      targetWordCount: 90000,
+      chapterCount: 3,
+    });
+    expect(target).toBe(30000);
+  });
+
+  it('floors the result', () => {
+    const target = resolveChapterTarget({
+      targetWordCount: 100000,
+      chapterCount: 3,
+    });
+    expect(target).toBe(33333);
+  });
+
+  it('throws when chapterCount is 0', () => {
+    expect(() => {
+      resolveChapterTarget({
+        targetWordCount: 90000,
+        chapterCount: 0,
+      });
+    }).toThrow('chapterCount must be greater than 0');
+  });
+
+  it('throws when chapterCount is negative', () => {
+    expect(() => {
+      resolveChapterTarget({
+        targetWordCount: 90000,
+        chapterCount: -1,
+      });
+    }).toThrow('chapterCount must be greater than 0');
+  });
+});
+
+describe('resolveTolerance', () => {
+  it('returns 0.05 for writer stage', () => {
+    expect(resolveTolerance('writer')).toBe(0.05);
+  });
+
+  it('returns 0.10 for review stage', () => {
+    expect(resolveTolerance('review')).toBe(0.10);
+  });
+
+  it('returns 0.20 for merge stage', () => {
+    expect(resolveTolerance('merge')).toBe(0.20);
+  });
+});
+
+describe('resolveWordCountRange', () => {
+  it('calculates range for writer stage (±5%)', () => {
+    const range = resolveWordCountRange({
+      targetWordCount: 90000,
+      chapterCount: 3,
+      stage: 'writer',
+    });
+    // target = 30000, tolerance = 0.05
+    // min = floor(30000 * 0.95) = floor(28500) = 28500
+    // max = ceil(30000 * 1.05) = ceil(31500) = 31500
+    expect(range.min).toBe(28500);
+    expect(range.max).toBe(31500);
+  });
+
+  it('calculates range for review stage (±10%)', () => {
+    const range = resolveWordCountRange({
+      targetWordCount: 90000,
+      chapterCount: 3,
+      stage: 'review',
+    });
+    // target = 30000, tolerance = 0.10
+    // min = floor(30000 * 0.90) = floor(27000) = 27000
+    // max = ceil(30000 * 1.10) = ceil(33000) = 33000
+    expect(range.min).toBe(27000);
+    expect(range.max).toBe(33000);
+  });
+
+  it('calculates range for merge stage (±20%)', () => {
+    const range = resolveWordCountRange({
+      targetWordCount: 90000,
+      chapterCount: 3,
+      stage: 'merge',
+    });
+    // target = 30000, tolerance = 0.20
+    // min = floor(30000 * 0.80) = floor(24000) = 24000
+    // max = ceil(30000 * 1.20) = ceil(36000) = 36000
+    expect(range.min).toBe(24000);
+    expect(range.max).toBe(36000);
