index 0000000..46bd4b8
--- /dev/null
+++ b/packages/core/src/release-policy/manuscript.ts
@@ -0,0 +1,88 @@
+import { getChapterFilePath } from '../writing/index.js';
+import type { ChapterFile, ManuscriptError, ManuscriptValidation } from './types.js';
+
+const H1_LINE_PATTERN = /^#\s+\S/;
+const CHAPTER_HEADING_PATTERN = /^#\s+Chapter\s+(\d+):\s+(.+)$/;
+
+function findH1LineIndex(lines: string[]): number | undefined {
+  const index = lines.findIndex((line) => H1_LINE_PATTERN.test(line));
+  return index === -1 ? undefined : index;
+}
+
+export function validateManuscriptStructure(chapters: ChapterFile[]): ManuscriptValidation {
+  const errors: ManuscriptError[] = [];
+  const resolvedNumbers: number[] = [];
+
+  for (const chapter of chapters) {
+    const lines = chapter.content.split('\n');
+    const h1Index = findH1LineIndex(lines);
+
+    if (h1Index === undefined) {
+      errors.push({
+        code: 'H1_MISSING',
+        detail: `${chapter.path} has no level-1 markdown heading.`,
+      });
+      continue;
+    }
+
+    const firstNonEmptyIndex = lines.findIndex((line) => line.trim().length > 0);
+    if (firstNonEmptyIndex !== h1Index) {
+      errors.push({
+        code: 'H1_NOT_FIRST',
+        detail: `${chapter.path} has content before its level-1 heading.`,
+      });
+    }
+
+    const h1Line = lines[h1Index]!;
+    const match = CHAPTER_HEADING_PATTERN.exec(h1Line);
+    const title = match?.[2]?.trim();
+
+    if (!match || !title) {
+      errors.push({
+        code: 'H1_MALFORMED',
+        detail: `${chapter.path} heading "${h1Line.trim()}" does not match "# Chapter <N>: <Title>".`,
+      });
+      continue;
+    }
+
+    const chapterNumber = parseInt(match[1]!, 10);
+    resolvedNumbers.push(chapterNumber);
+
+    const expectedPath = getChapterFilePath(chapterNumber);
+    if (expectedPath !== chapter.path) {
+      errors.push({
+        code: 'H1_NUMBER_MISMATCH',
+        detail: `${chapter.path} heading declares chapter ${chapterNumber}, but its path implies ${expectedPath}.`,
+      });
+    }
+  }
+
+  const seen = new Set<number>();
+  const duplicates = new Set<number>();
+  for (const chapterNumber of resolvedNumbers) {
+    if (seen.has(chapterNumber)) {
+      duplicates.add(chapterNumber);
+    }
+    seen.add(chapterNumber);
+  }
+  if (duplicates.size > 0) {
+    const list = [...duplicates].sort((a, b) => a - b).join(', ');
+    errors.push({
+      code: 'CHAPTER_DUPLICATE',
+      detail: `Chapter number(s) ${list} are used by more than one chapter.`,
+    });
+  }
+
+  const sorted = [...resolvedNumbers].sort((a, b) => a - b);
+  const hasGap = sorted.some((chapterNumber, index) => chapterNumber !== index + 1);
+  if (hasGap) {
+    errors.push({
+      code: 'CHAPTER_GAP',
+      detail: `Chapter numbers [${sorted.join(', ')}] are not a contiguous sequence starting at 1.`,
+    });
+  }
+
+  errors.sort((a, b) => (a.code < b.code ? -1 : a.code > b.code ? 1 : 0));
+
+  return { valid: errors.length === 0, errors };
+}
