+function extractChapterNumber(path: string): number | undefined {
+  const match = /manuscript\/chapter-(\d+)\.md$/.exec(path);
+  if (!match || match[1] === undefined) {
+    return undefined;
+  }
+
+  const chapterNumber = parseInt(match[1], 10);
+
+  if (isNaN(chapterNumber)) {
+    return undefined;
+  }
+
+  // Verify by regenerating the expected path using the canonical helper
+  const expectedPath = getChapterFilePath(chapterNumber);
+  if (expectedPath === path) {
+    return chapterNumber;
+  }
+
+  return undefined;
+}
+
+export function validateManuscriptStructure(chapters: ChapterFile[]): ManuscriptValidation {
+  const errors: ManuscriptError[] = [];
+
+  // Per-chapter rules
+  const chapterNumbers: number[] = [];
+
+  for (const chapter of chapters) {
+    const expectedChapterNumber = extractChapterNumber(chapter.path);
+    const lines = chapter.content.split('\n');
+
+    // Find any H1 heading
+    let h1LineIndex = -1;
+    let h1LineText = '';
+    for (let i = 0; i < lines.length; i++) {
+      const line = lines[i];
+      if (line !== undefined && line.trim().startsWith('#')) {
+        const hashMatch = line.match(/^#+/);
+        const hashCount = hashMatch ? hashMatch[0].length : 0;
+        if (hashCount === 1) {
+          h1LineIndex = i;
+          h1LineText = line.trim();
+          break;
+        }
+      }
+    }
+
+    // Check H1_MISSING
+    if (h1LineIndex === -1) {
+      errors.push({
+        code: 'H1_MISSING',
+        detail: `Chapter at ${chapter.path} is missing a level-1 heading`,
+      });
+      continue;
+    }
+
+    // Check H1_NOT_FIRST
+    let firstNonEmptyLineIsH1 = false;
+    for (let i = 0; i < lines.length; i++) {
+      const line = lines[i];
+      if (line !== undefined) {
+        const trimmed = line.trim();
+        if (trimmed.length > 0) {
+          firstNonEmptyLineIsH1 = i === h1LineIndex;
+          break;
+        }
+      }
+    }
+
+    if (!firstNonEmptyLineIsH1) {
+      errors.push({
+        code: 'H1_NOT_FIRST',
+        detail: `Chapter at ${chapter.path} has a non-empty line before the level-1 heading`,
+      });
+    }
+
+    // Check H1_MALFORMED and H1_NUMBER_MISMATCH
+    const h1Match = /^#\s+Chapter\s+(\d+):\s+(.+)$/.exec(h1LineText);
+
+    if (!h1Match) {
+      errors.push({
+        code: 'H1_MALFORMED',
+        detail: `Chapter at ${chapter.path} has a malformed level-1 heading`,
+      });
+      continue;
+    }
+
+    const h1Title = h1Match[2];
+    if (h1Title === undefined || h1Title.trim().length === 0) {
+      errors.push({
+        code: 'H1_MALFORMED',
+        detail: `Chapter at ${chapter.path} has a malformed level-1 heading (missing or empty title)`,
+      });
+      continue;
+    }
+
+    // Check H1_NUMBER_MISMATCH
+    const h1ChapterNumber = parseInt(h1Match[1]!, 10);
+    if (expectedChapterNumber !== undefined && h1ChapterNumber !== expectedChapterNumber) {
+      errors.push({
+        code: 'H1_NUMBER_MISMATCH',
+        detail: `Chapter at ${chapter.path} has heading chapter number ${h1ChapterNumber} but path indicates chapter ${expectedChapterNumber}`,
+      });
+    }
+
+    if (expectedChapterNumber !== undefined) {
+      chapterNumbers.push(expectedChapterNumber);
+    }
+  }
+
+  // Set-level rules
+  // Check for duplicates
+  const seenNumbers = new Set<number>();
+  for (const num of chapterNumbers) {
+    if (seenNumbers.has(num)) {
+      errors.push({
+        code: 'CHAPTER_DUPLICATE',
+        detail: `Chapter number ${num} appears multiple times`,
+      });
+    }
+    seenNumbers.add(num);
+  }
+
+  // Check for gaps
+  if (chapterNumbers.length > 0) {
+    const sorted = Array.from(new Set(chapterNumbers)).sort((a, b) => a - b);
+    for (let i = 0; i < sorted.length; i++) {
+      if (sorted[i] !== i + 1) {
+        errors.push({
+          code: 'CHAPTER_GAP',
+          detail: `Chapter numbers are not contiguous starting from 1. Found: ${sorted.join(', ')}`,
+        });
+        break;
+      }
+    }
+  }
+
+  // Sort errors by code
+  errors.sort((a, b) => a.code.localeCompare(b.code));
+
+  return {
+    valid: errors.length === 0,
+    errors,
+  };
+}
