+// ---------------------------------------------------------------------------
+// validateManuscriptStructure
+// ---------------------------------------------------------------------------
+
+function chapter(chapterNumber: number, content: string): ChapterFile {
+  return { path: getChapterFilePath(chapterNumber), content };
+}
+
+function body(chapterNumber: number, title: string): string {
+  return `# Chapter ${chapterNumber}: ${title}\n\nShe closed the door behind her.\n`;
+}
+
+function structureCodes(chapters: ChapterFile[]): string[] {
+  return validateManuscriptStructure(chapters).errors.map((e) => e.code);
+}
+
+describe('validateManuscriptStructure', () => {
+  describe('valid manuscripts', () => {
+    it('accepts a gap-free, well-formed set of chapters', () => {
+      const result = validateManuscriptStructure([
+        chapter(1, body(1, 'Arrival')),
+        chapter(2, body(2, 'The Offer')),
+        chapter(3, body(3, 'Fallout')),
+      ]);
+      expect(result.valid).toBe(true);
+      expect(result.errors).toHaveLength(0);
+    });
+
+    it('accepts an empty manuscript', () => {
+      const result = validateManuscriptStructure([]);
+      expect(result.valid).toBe(true);
+      expect(result.errors).toHaveLength(0);
+    });
+
+    it('accepts a double-digit chapter number', () => {
+      expect(validateManuscriptStructure([chapter(1, body(1, 'A'))]).valid).toBe(true);
+      const long = Array.from({ length: 12 }, (_, i) => chapter(i + 1, body(i + 1, `T${i}`)));
+      expect(validateManuscriptStructure(long).valid).toBe(true);
+    });
+
+    it('allows blank lines before the heading', () => {
+      expect(validateManuscriptStructure([chapter(1, `\n\n${body(1, 'Arrival')}`)]).valid).toBe(
+        true,
+      );
+    });
+
+    it('allows level-2 headings after the level-1 heading', () => {
+      const content = `# Chapter 1: Arrival\n\n## Scene one\n\nText.\n`;
+      expect(validateManuscriptStructure([chapter(1, content)]).valid).toBe(true);
+    });
+  });
+
+  describe('H1_MISSING', () => {
+    it('reports a chapter with no level-1 heading', () => {
+      const content = '## Scene one\n\nShe closed the door.\n';
+      expect(structureCodes([chapter(1, content)])).toEqual(['H1_MISSING', 'H1_NOT_FIRST']);
+    });
+
+    it('reports an empty chapter', () => {
+      expect(structureCodes([chapter(1, '')])).toEqual(['H1_MISSING']);
+    });
+
+    it('skips the malformed and number checks for a chapter with no heading', () => {
+      const result = validateManuscriptStructure([{ path: 'manuscript/notes.md', content: 'Text' }]);
+      expect(result.errors.map((e) => e.code)).toEqual(['H1_MISSING', 'H1_NOT_FIRST']);
+    });
+
+    it('names the offending chapter in the detail', () => {
+      const result = validateManuscriptStructure([chapter(1, '')]);
+      expect(result.errors[0]?.detail).toContain('manuscript/chapter-01.md');
+    });
+  });
+
+  describe('H1_NOT_FIRST', () => {
+    it('reports prose before the heading', () => {
+      const content = `An epigraph.\n\n${body(1, 'Arrival')}`;
+      expect(structureCodes([chapter(1, content)])).toEqual(['H1_NOT_FIRST']);
+    });
+
+    it('reports a level-2 heading before the level-1 heading', () => {
+      const content = `## Scene one\n\n# Chapter 1: Arrival\n\nText.\n`;
+      expect(structureCodes([chapter(1, content)])).toEqual(['H1_NOT_FIRST']);
+    });
+  });
+
+  describe('H1_MALFORMED', () => {
+    it('reports a heading that is not a chapter heading', () => {
+      expect(structureCodes([chapter(1, '# Arrival\n\nText.\n')])).toEqual(['H1_MALFORMED']);
+    });
+
+    it('reports a heading with a non-numeric chapter number', () => {
+      expect(structureCodes([chapter(1, '# Chapter one: Arrival\n\nText.\n')])).toEqual([
+        'H1_MALFORMED',
+      ]);
+    });
+
+    it('reports a heading with an empty title', () => {
+      expect(structureCodes([chapter(1, '# Chapter 1:   \n\nText.\n')])).toEqual(['H1_MALFORMED']);
+    });
+
+    it('reports a heading with no title separator', () => {
+      expect(structureCodes([chapter(1, '# Chapter 1 Arrival\n\nText.\n')])).toEqual([
+        'H1_MALFORMED',
+      ]);
+    });
+
+    it('still checks the chapter number of a malformed heading that carries one', () => {
+      expect(structureCodes([chapter(1, '# Chapter 2\n\nText.\n')])).toEqual([
+        'H1_MALFORMED',
+        'H1_NUMBER_MISMATCH',
+      ]);
+    });
+  });
+
+  describe('H1_NUMBER_MISMATCH', () => {
+    it('reports a heading number that does not match the path', () => {
+      const result = validateManuscriptStructure([chapter(1, body(4, 'Arrival'))]);
+      expect(result.errors.map((e) => e.code)).toEqual(['H1_NUMBER_MISMATCH']);
+      expect(result.errors[0]?.detail).toContain('manuscript/chapter-04.md');
+    });
+
+    it('reports a heading whose path is not a canonical chapter path', () => {
+      expect(structureCodes([{ path: 'chapter-01.md', content: body(1, 'Arrival') }])).toEqual([
+        'H1_NUMBER_MISMATCH',
+      ]);
+    });
+  });
+
+  describe('CHAPTER_DUPLICATE', () => {
+    it('reports two chapters resolving to the same number', () => {
+      const result = validateManuscriptStructure([
+        chapter(1, body(1, 'Arrival')),
+        chapter(1, body(1, 'Arrival Again')),
+        chapter(2, body(2, 'The Offer')),
+      ]);
+      expect(result.errors.map((e) => e.code)).toEqual(['CHAPTER_DUPLICATE']);
+      expect(result.errors[0]?.detail).toContain('1');
+    });
+
+    it('does not report a gap when the deduplicated numbers are contiguous', () => {
+      expect(
+        structureCodes([chapter(1, body(1, 'A')), chapter(1, body(1, 'B')), chapter(2, body(2, 'C'))]),
+      ).toEqual(['CHAPTER_DUPLICATE']);
+    });
+  });
+
+  describe('CHAPTER_GAP', () => {
+    it('reports a missing chapter number', () => {
+      const result = validateManuscriptStructure([
+        chapter(1, body(1, 'Arrival')),
+        chapter(3, body(3, 'Fallout')),
+      ]);
+      expect(result.errors.map((e) => e.code)).toEqual(['CHAPTER_GAP']);
+      expect(result.errors[0]?.detail).toContain('3');
+    });
+
+    it('reports a manuscript that does not start at chapter 1', () => {
+      expect(structureCodes([chapter(2, body(2, 'The Offer')), chapter(3, body(3, 'Fallout'))])).toEqual([
+        'CHAPTER_GAP',
+      ]);
+    });
+
+    it('accepts chapters supplied out of order', () => {
+      expect(
+        validateManuscriptStructure([chapter(2, body(2, 'B')), chapter(1, body(1, 'A'))]).valid,
+      ).toBe(true);
+    });
+  });
+
+  describe('multiple violations', () => {
+    it('reports every violation, sorted by code', () => {
+      const result = validateManuscriptStructure([
+        chapter(1, 'Prose first.\n\n# Chapter 1: Arrival\n'),
+        chapter(3, '# Chapter 9: Fallout\n\nText.\n'),
+        chapter(4, 'No heading at all.\n'),
+      ]);
+      expect(result.valid).toBe(false);
+      expect(result.errors.map((e) => e.code)).toEqual([
+        'CHAPTER_GAP',
+        'H1_MISSING',
+        'H1_NOT_FIRST',
+        'H1_NOT_FIRST',
+        'H1_NUMBER_MISMATCH',
+      ]);
+    });
+
+    it('keeps chapter order among errors sharing a code', () => {
+      const result = validateManuscriptStructure([
+        chapter(1, body(7, 'A')),
+        chapter(2, body(8, 'B')),
+      ]);
+      expect(result.errors.map((e) => e.code)).toEqual([
+        'H1_NUMBER_MISMATCH',
+        'H1_NUMBER_MISMATCH',
+      ]);
+      expect(result.errors[0]?.detail).toContain('chapter-01.md');
+      expect(result.errors[1]?.detail).toContain('chapter-02.md');
+    });
+
+    it('gives every error a non-empty detail', () => {
+      const result = validateManuscriptStructure([
+        chapter(2, 'Prose.\n\n# Chapter 5\n'),
+        chapter(2, ''),
+      ]);
+      expect(result.errors.length).toBeGreaterThan(0);
+      for (const error of result.errors) {
+        expect(error.detail.length).toBeGreaterThan(0);
+      }
+    });
+  });
+});
