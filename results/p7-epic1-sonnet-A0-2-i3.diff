@@ -0,0 +1,99 @@
+import { describe, it, expect } from 'vitest';
+import { validateManuscriptStructure } from '../index.js';
+import type { ChapterFile } from '../index.js';
+import { getChapterFilePath } from '../../writing/index.js';
+
+function chapter(number: number, overrides: Partial<ChapterFile> = {}): ChapterFile {
+  return {
+    path: getChapterFilePath(number),
+    content: `# Chapter ${number}: Title ${number}\n\nBody text for chapter ${number}.`,
+    ...overrides,
+  };
+}
+
+describe('validateManuscriptStructure', () => {
+  it('returns valid: true with no errors for a well-formed manuscript', () => {
+    const result = validateManuscriptStructure([chapter(1), chapter(2), chapter(3)]);
+    expect(result.valid).toBe(true);
+    expect(result.errors).toHaveLength(0);
+  });
+
+  it('flags a chapter with no level-1 heading, and the trivially unmet first-line rule alongside it', () => {
+    const result = validateManuscriptStructure([
+      chapter(1, { content: 'Just some prose with no heading at all.' }),
+    ]);
+    expect(result.valid).toBe(false);
+    expect(result.errors.map((e) => e.code)).toEqual(['H1_MISSING', 'H1_NOT_FIRST']);
+  });
+
+  it('flags a heading that is not the first non-empty line', () => {
+    const result = validateManuscriptStructure([
+      chapter(1, { content: 'Some intro text.\n\n# Chapter 1: Title 1\n\nBody.' }),
+    ]);
+    expect(result.valid).toBe(false);
+    expect(result.errors).toEqual([{ code: 'H1_NOT_FIRST', detail: expect.any(String) }]);
+  });
+
+  it('flags a level-1 heading that does not match the "# Chapter <N>: <Title>" pattern', () => {
+    const result = validateManuscriptStructure([
+      chapter(1, { content: '# Introduction\n\nBody.' }),
+    ]);
+    expect(result.valid).toBe(false);
+    expect(result.errors).toEqual([{ code: 'H1_MALFORMED', detail: expect.any(String) }]);
+  });
+
+  it('flags a heading with an empty title as malformed', () => {
+    const result = validateManuscriptStructure([
+      chapter(1, { content: '# Chapter 1:   \n\nBody.' }),
+    ]);
+    expect(result.valid).toBe(false);
+    expect(result.errors).toEqual([{ code: 'H1_MALFORMED', detail: expect.any(String) }]);
+  });
+
+  it('flags a heading number that does not match the chapter number implied by the path', () => {
+    const result = validateManuscriptStructure([
+      chapter(1, { content: '# Chapter 2: Title 2\n\nBody.' }),
+    ]);
+    expect(result.valid).toBe(false);
+    expect(result.errors).toEqual([{ code: 'H1_NUMBER_MISMATCH', detail: expect.any(String) }]);
+  });
+
+  it('skips H1_MALFORMED and H1_NUMBER_MISMATCH checks for a chapter that already has H1_MISSING', () => {
+    const result = validateManuscriptStructure([chapter(1, { content: 'No heading here.' })]);
+    expect(result.errors.map((e) => e.code)).toEqual(['H1_MISSING', 'H1_NOT_FIRST']);
+  });
+
+  it('flags two chapters that resolve to the same chapter number', () => {
+    const result = validateManuscriptStructure([chapter(1), chapter(1)]);
+    expect(result.valid).toBe(false);
+    expect(result.errors).toEqual([{ code: 'CHAPTER_DUPLICATE', detail: expect.any(String) }]);
+  });
+
+  it('flags a gap in the chapter number sequence', () => {
+    const result = validateManuscriptStructure([chapter(1), chapter(3)]);
+    expect(result.valid).toBe(false);
+    expect(result.errors).toEqual([{ code: 'CHAPTER_GAP', detail: expect.any(String) }]);
+  });
+
+  it('flags both duplicate and gap errors together, sorted by code', () => {
+    const result = validateManuscriptStructure([chapter(1), chapter(1), chapter(4)]);
+    expect(result.valid).toBe(false);
+    expect(result.errors.map((e) => e.code)).toEqual(['CHAPTER_DUPLICATE', 'CHAPTER_GAP']);
+  });
+
+  it('sorts multiple errors on a single chapter by code ascending', () => {
+    const result = validateManuscriptStructure([
+      chapter(1, { content: 'Some intro text.\n\n# not a valid heading\n\nBody.' }),
+    ]);
+    expect(result.valid).toBe(false);
+    expect(result.errors.map((e) => e.code)).toEqual(['H1_MALFORMED', 'H1_NOT_FIRST']);
+  });
+
+  it('evaluates per-chapter rules in chapter order before set-level rules', () => {
+    const result = validateManuscriptStructure([
+      chapter(1, { content: '# Introduction\n\nBody.' }),
+      chapter(1),
+    ]);
+    expect(result.errors.map((e) => e.code)).toEqual(['CHAPTER_DUPLICATE', 'H1_MALFORMED']);
+  });
+});
