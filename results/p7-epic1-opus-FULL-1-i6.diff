+describe('GENERATE_LISTING stage', () => {
+  const VALID_LISTING = JSON.stringify({
+    title: 'The Test Novel',
+    blurb: '<p>A hero embarks on a journey to save the world.</p>',
+    keywords: ['fantasy', 'epic quest', 'hero journey', 'magic', 'adventure', 'saga', 'destiny'],
+    categories: ['Fiction > Fantasy > Epic', 'Fiction > Fantasy > Action', 'Fiction > Adventure'],
+    author: 'Jordan Vale',
+  });
+
+  function seedMarketerRun(runId: string): void {
+    store.agentRuns.set(runId, {
+      runId,
+      projectId: PROJECT_ID,
+      taskArn: MOCK_TASK_ARN,
+      workerType: 'marketer',
+      status: 'RUNNING',
+      startedAt: new Date().toISOString(),
+    });
+  }
+
+  it('launches a marketer run and moves the project to RELEASING', async () => {
+    store.projects.set(PROJECT_ID, makeProjectItem({ status: 'PACKAGING' }));
+
+    await dispatch({ type: 'GENERATE_LISTING', projectId: PROJECT_ID });
+
+    const runs = Array.from(store.agentRuns.values()).filter((r) => r.workerType === 'marketer');
+    expect(runs).toHaveLength(1);
+    expect(runs[0]!.status).toBe('RUNNING');
+    expect(runs[0]!.taskArn).toBe(MOCK_TASK_ARN);
+
+    expect(store.projects.get(PROJECT_ID)!.status).toBe('RELEASING');
+
+    expect(pendingQueue).toHaveLength(1);
+    expect((pendingQueue[0] as { type: string }).type).toBe('RECONCILE');
+  });
+
+  it('moves the project to RELEASED when the listing validates', async () => {
+    store.projects.set(PROJECT_ID, makeProjectItem({ status: 'RELEASING' }));
+    fileContents.set('release/listing.json', VALID_LISTING);
+
+    const runId = 'run-marketer-ok';
+    seedMarketerRun(runId);
+
+    await dispatch({ type: 'RECONCILE', projectId: PROJECT_ID, runId });
+
+    expect(store.agentRuns.get(runId)!.status).toBe('SUCCEEDED');
+    expect(store.projects.get(PROJECT_ID)!.status).toBe('RELEASED');
+    expect(pendingQueue).toHaveLength(0);
+  });
+
+  it('moves the project to FAILED when the listing is invalid', async () => {
+    store.projects.set(PROJECT_ID, makeProjectItem({ status: 'RELEASING' }));
