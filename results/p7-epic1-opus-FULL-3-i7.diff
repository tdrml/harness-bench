index 0000000..794882a
--- /dev/null
+++ b/packages/core/src/word-count-policy/clamp.ts
@@ -0,0 +1,25 @@
+import { WORD_COUNT_DEFAULTS } from '../config/defaults.js';
+import type { ProjectType } from '../config/schemas.js';
+
+export interface ClampToProjectTypeParams {
+  range: { min: number; max: number };
+  projectType: ProjectType;
+}
+
+/**
+ * Clamp a resolved word count band into the project type's per-chapter band.
+ *
+ * Both endpoints are clamped, not just `min` raised and `max` lowered: a resolved
+ * band lying entirely outside the project type's band then collapses onto the
+ * nearer bound instead of inverting into a `min` greater than its `max`.
+ */
+export function clampToProjectType(
+  params: ClampToProjectTypeParams,
+): { min: number; max: number } {
+  const { range, projectType } = params;
+  const { chapterMin, chapterMax } = WORD_COUNT_DEFAULTS[projectType];
+  return {
+    min: Math.min(Math.max(range.min, chapterMin), chapterMax),
+    max: Math.min(Math.max(range.max, chapterMin), chapterMax),
+  };
+}
