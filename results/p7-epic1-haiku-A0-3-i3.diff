+export function validateManuscriptStructure(chapters: ChapterFile[]): ManuscriptValidation {
+  const errors: ManuscriptError[] = [];
+  const chapterNumbers: number[] = [];
+
+  for (const chapter of chapters) {
+    const chapterNumber = extractChapterNumber(chapter.path);
+    chapterNumbers.push(chapterNumber);
+
+    const lines = chapter.content.split('\n').map((line) => line.trimEnd());
+    const firstNonEmptyLineIndex = lines.findIndex((line) => line.length > 0);
+    const firstNonEmptyLine = firstNonEmptyLineIndex >= 0 ? lines[firstNonEmptyLineIndex] : null;
+
+    const h1Heading = lines.find((line) => line.startsWith('# ')) ?? null;
+
+    // Rule 1: H1_MISSING
+    if (!h1Heading) {
+      errors.push({
+        code: 'H1_MISSING',
+        detail: `Chapter at path "${chapter.path}" has no level-1 markdown heading`,
+      });
+      continue;
+    }
+
+    // Rule 2: H1_NOT_FIRST
+    if (firstNonEmptyLine !== h1Heading) {
+      errors.push({
+        code: 'H1_NOT_FIRST',
+        detail: `Chapter at path "${chapter.path}" has level-1 heading that is not the first non-empty line`,
+      });
+    }
+
+    // Rule 3: H1_MALFORMED
+    const h1Match = h1Heading.match(/^# Chapter (\d+): (.+)$/);
+    if (!h1Match) {
+      errors.push({
+        code: 'H1_MALFORMED',
+        detail: `Chapter at path "${chapter.path}" has malformed level-1 heading (expected format: "# Chapter <N>: <Title>")`,
+      });
+      continue;
+    }
+
+    const headingNumber = parseInt(h1Match[1] ?? '0', 10);
+
+    // Rule 4: H1_NUMBER_MISMATCH
+    if (chapterNumber !== headingNumber) {
+      errors.push({
+        code: 'H1_NUMBER_MISMATCH',
+        detail: `Chapter at path "${chapter.path}" has heading number ${headingNumber} but path indicates chapter ${chapterNumber}`,
+      });
+    }
+  }
+
+  // Rule 5: CHAPTER_DUPLICATE
+  const uniqueNumbers = new Set(chapterNumbers);
+  if (uniqueNumbers.size < chapterNumbers.length) {
+    const duplicates = chapterNumbers.filter(
+      (num, index) => chapterNumbers.indexOf(num) !== index
+    );
+    const uniqueDuplicates = Array.from(new Set(duplicates));
+    for (const num of uniqueDuplicates) {
+      errors.push({
+        code: 'CHAPTER_DUPLICATE',
+        detail: `Multiple chapters resolve to chapter number ${num}`,
+      });
+    }
+  }
+
+  // Rule 6: CHAPTER_GAP
+  if (chapterNumbers.length > 0) {
+    const sortedNumbers = [...chapterNumbers].sort((a, b) => a - b);
+    const expectedNumbers = Array.from({ length: sortedNumbers.length }, (_, i) => i + 1);
+    if (JSON.stringify(sortedNumbers) !== JSON.stringify(expectedNumbers)) {
+      errors.push({
+        code: 'CHAPTER_GAP',
+        detail: `Chapter numbers must form a sequence from 1 to ${sortedNumbers.length} with no gaps (found: ${sortedNumbers.join(', ')})`,
+      });
+    }
+  }
+
+  // Sort errors by code
+  errors.sort((a, b) => a.code.localeCompare(b.code));
+
+  return {
+    valid: errors.length === 0,
+    errors,
+  };
+}
+
+function extractChapterNumber(path: string): number {
+  const match = path.match(/chapter-(\d+)/);
+  if (match && match[1] !== undefined) {
+    return parseInt(match[1], 10);
+  }
+  return 0;
+}
