+  it('re-enqueues GENERATE_LISTING for retry', async () => {
+    const workItem = { type: 'RECONCILE' as const, projectId: 'proj-123', runId: 'run-abc' };
+    await handler(makeEvent([makeRecord(workItem)]));
+
+    expect(vi.mocked(enqueue)).toHaveBeenCalledOnce();
+    const [, enqueuedItem] = vi.mocked(enqueue).mock.calls[0]!;
+    expect(enqueuedItem).toEqual({ type: 'GENERATE_LISTING', projectId: 'proj-123' });
