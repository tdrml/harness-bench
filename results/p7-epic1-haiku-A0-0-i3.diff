@@ -0,0 +1,134 @@
+import type { ChapterFile, ManuscriptError, ManuscriptValidation } from './types.js';
+
+export function validateManuscriptStructure(chapters: ChapterFile[]): ManuscriptValidation {
+  const errors: ManuscriptError[] = [];
+  const chapterNumbers: number[] = [];
+  const chapterNumberToIndex = new Map<number, number>();
+
+  // Per-chapter validation
+  for (let i = 0; i < chapters.length; i++) {
+    const chapter = chapters[i]!;
+    const chapterNumber = extractChapterNumber(chapter.path);
+
+    if (chapterNumber === null) {
+      errors.push({
+        code: 'INVALID_PATH',
+        detail: `Chapter path does not follow expected format: ${chapter.path}`,
+      });
+      continue;
+    }
+
+    // Check for H1_MISSING
+    const h1Match = chapter.content.match(/^#\s+/m);
+    const hasMissingH1 = !h1Match;
+    if (hasMissingH1) {
+      errors.push({
+        code: 'H1_MISSING',
+        detail: `Chapter ${chapterNumber} has no level-1 markdown heading.`,
+      });
+      continue;
+    }
+
+    // Only count this chapter number if it passes H1_MISSING check
+    chapterNumbers.push(chapterNumber);
+    if (!chapterNumberToIndex.has(chapterNumber)) {
+      chapterNumberToIndex.set(chapterNumber, i);
+    }
+
+    // Find first non-empty line and first level-1 heading line
+    const lines = chapter.content.split('\n');
+    const firstNonEmptyLine = lines.find((line) => line.trim() !== '');
+    const firstHeadingLine = lines.find((line) => line.match(/^#\s+/));
+
+    // Check for H1_NOT_FIRST - first non-empty line is not a heading
+    if (firstNonEmptyLine && !firstNonEmptyLine.startsWith('# ')) {
+      errors.push({
+        code: 'H1_NOT_FIRST',
+        detail: `Chapter ${chapterNumber}: first non-empty line is not the level-1 heading.`,
+      });
+    }
+
+    // Check for H1_MALFORMED - must match "# Chapter <N>: <Title>"
+    const h1Line = firstHeadingLine ?? '';
+    const h1Pattern = /^#\s+Chapter\s+(\d+):\s+(.+)$/;
+    const h1Malformed = !h1Pattern.test(h1Line);
+
+    if (h1Malformed) {
+      errors.push({
+        code: 'H1_MALFORMED',
+        detail: `Chapter ${chapterNumber}: level-1 heading does not match "# Chapter <N>: <Title>" pattern.`,
+      });
+    }
+
+    // Check for H1_NUMBER_MISMATCH
+    const headingMatch = h1Line.match(h1Pattern);
+    if (headingMatch) {
+      const headingNumber = parseInt(headingMatch[1]!, 10);
+      if (headingNumber !== chapterNumber) {
+        errors.push({
+          code: 'H1_NUMBER_MISMATCH',
+          detail: `Chapter ${chapterNumber}: heading number ${headingNumber} does not match chapter number from path.`,
+        });
+      }
+    }
+  }
+
+  // Set-level validation (always run if we can extract chapter numbers)
+  if (chapterNumbers.length > 0) {
+    // Check for CHAPTER_DUPLICATE
+    const duplicates = new Set<number>();
+    const seen = new Set<number>();
+    for (const num of chapterNumbers) {
+      if (seen.has(num)) {
+        duplicates.add(num);
+      }
+      seen.add(num);
+    }
+    for (const num of duplicates) {
+      errors.push({
+        code: 'CHAPTER_DUPLICATE',
+        detail: `Chapter number ${num} appears in multiple files.`,
+      });
+    }
+
+    // Check for CHAPTER_GAP
+    const sortedNumbers = [...new Set(chapterNumbers)].sort((a, b) => a - b);
+    if (sortedNumbers.length > 0) {
+      const expected = Array.from({ length: sortedNumbers[sortedNumbers.length - 1]! }, (_, i) => i + 1);
+      const hasGap = !arraysEqual(sortedNumbers, expected);
+      if (hasGap) {
+        errors.push({
+          code: 'CHAPTER_GAP',
+          detail: `Chapter numbers are not contiguous from 1 to ${sortedNumbers[sortedNumbers.length - 1]}.`,
+        });
+      }
+    }
+  }
+
+  // Sort errors by code ascending
+  errors.sort((a, b) => a.code.localeCompare(b.code));
+
+  return {
+    valid: errors.length === 0,
+    errors,
+  };
+}
+
+function extractChapterNumber(path: string): number | null {
+  // Expected format: manuscript/chapter-01.md, manuscript/chapter-1.md, etc.
+  // The path should match what getChapterFilePath produces: manuscript/chapter-{padStart(2, '0')}.md
+  const match = path.match(/^manuscript\/chapter-(\d+)\.md$/);
+  if (!match) {
+    return null;
+  }
+  const num = parseInt(match[1]!, 10);
+  return num;
+}
+
+function arraysEqual(a: number[], b: number[]): boolean {
+  if (a.length !== b.length) return false;
+  for (let i = 0; i < a.length; i++) {
+    if (a[i] !== b[i]) return false;
+  }
+  return true;
+}
