+/** Sorts validation errors by code ascending, so every release-policy check reports uniformly. */
+export function sortErrorsByCode(errors: { code: string }[]): void {
+  errors.sort((a, b) => (a.code < b.code ? -1 : a.code > b.code ? 1 : 0));
+}
