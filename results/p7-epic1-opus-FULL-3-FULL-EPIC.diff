+import { describe, it, expect } from 'vitest';
+import {
+  validateListing,
+  MAX_BLURB_LENGTH,
+  REQUIRED_KEYWORD_COUNT,
+  REQUIRED_CATEGORY_COUNT,
+  ALLOWED_BLURB_TAGS,
+} from '../index.js';
+import type { KdpListing } from '../index.js';
+
+function makeListing(overrides: Partial<KdpListing> = {}): KdpListing {
+  return {
+    title: 'The Glass Harbor',
+    subtitle: 'A Novel',
+    blurb: '<b>She thought the harbor was safe.</b><br>It was not.',
+    keywords: ['one', 'two', 'three', 'four', 'five', 'six', 'seven'],
+    categories: ['Fiction > Thriller', 'Fiction > Mystery', 'Fiction > Suspense'],
+    author: 'A. Writer',
+    ...overrides,
+  };
+}
+
+function codesOf(listing: KdpListing): string[] {
+  return validateListing(listing).errors.map((e) => e.code);
+}
+
+describe('constants', () => {
+  it('exposes the KDP limits', () => {
+    expect(MAX_BLURB_LENGTH).toBe(4000);
+    expect(REQUIRED_KEYWORD_COUNT).toBe(7);
+    expect(REQUIRED_CATEGORY_COUNT).toBe(3);
+    expect([...ALLOWED_BLURB_TAGS]).toEqual([
+      'b',
+      'i',
+      'u',
+      'br',
+      'p',
+      'ul',
+      'li',
+      'ol',
+      'h4',
+      'h5',
+      'h6',
+    ]);
+  });
+});
+
+describe('validateListing', () => {
+  describe('valid listings', () => {
+    it('returns valid with no errors for a well-formed listing', () => {
+      const result = validateListing(makeListing());
+      expect(result.valid).toBe(true);
+      expect(result.errors).toHaveLength(0);
+    });
+
+    it('accepts a listing without a subtitle', () => {
+      const result = validateListing(makeListing({ subtitle: undefined }));
+      expect(result.valid).toBe(true);
+    });
+
+    it('accepts a blurb exactly at the maximum length', () => {
+      const result = validateListing(makeListing({ blurb: 'a'.repeat(MAX_BLURB_LENGTH) }));
+      expect(result.valid).toBe(true);
+    });
+
+    it('accepts every allowed tag, including closing and uppercase forms', () => {
+      const blurb = ALLOWED_BLURB_TAGS.map((t) => `<${t.toUpperCase()}>x</${t}>`).join('');
+      const result = validateListing(makeListing({ blurb }));
+      expect(result.valid).toBe(true);
+    });
+  });
+
+  describe('blurb length', () => {
+    it('flags BLURB_TOO_LONG when the blurb exceeds the maximum', () => {
+      const result = validateListing(makeListing({ blurb: 'a'.repeat(MAX_BLURB_LENGTH + 1) }));
+      expect(result.valid).toBe(false);
+      expect(result.errors.map((e) => e.code)).toEqual(['BLURB_TOO_LONG']);
+      expect(result.errors[0]?.detail).toContain('4001');
+    });
+  });
+
+  describe('empty blurb', () => {
+    it('flags BLURB_EMPTY for an empty blurb', () => {
+      expect(codesOf(makeListing({ blurb: '' }))).toEqual(['BLURB_EMPTY']);
+    });
+
+    it('flags BLURB_EMPTY for a whitespace-only blurb', () => {
+      expect(codesOf(makeListing({ blurb: '  \n\t ' }))).toEqual(['BLURB_EMPTY']);
+    });
+  });
+
+  describe('keyword count', () => {
+    it('flags KEYWORD_COUNT when there are too few keywords', () => {
+      const result = validateListing(makeListing({ keywords: ['one', 'two'] }));
+      expect(result.errors.map((e) => e.code)).toEqual(['KEYWORD_COUNT']);
+      expect(result.errors[0]?.detail).toContain('2');
+    });
+
+    it('flags KEYWORD_COUNT when there are too many keywords', () => {
+      const keywords = Array.from({ length: 8 }, (_, i) => `kw${i}`);
+      expect(codesOf(makeListing({ keywords }))).toEqual(['KEYWORD_COUNT']);
+    });
+  });
+
+  describe('category count', () => {
+    it('flags CATEGORY_COUNT when there are too few categories', () => {
+      expect(codesOf(makeListing({ categories: ['Fiction > Thriller'] }))).toEqual([
+        'CATEGORY_COUNT',
+      ]);
+    });
+
+    it('flags CATEGORY_COUNT when there are too many categories', () => {
+      const categories = Array.from({ length: 4 }, (_, i) => `Fiction > Genre ${i}`);
+      expect(codesOf(makeListing({ categories }))).toEqual(['CATEGORY_COUNT']);
+    });
+  });
+
+  describe('unresolved placeholders', () => {
+    it.each<[string, Partial<KdpListing>]>([
+      ['title', { title: 'TODO: pick a title' }],
+      ['subtitle', { subtitle: 'TODO: subtitle' }],
+      ['blurb', { blurb: 'TODO: write the hook' }],
+      ['author', { author: 'TODO: pen name' }],
+      ['keywords', { keywords: ['one', 'two', 'three', 'four', 'five', 'six', 'TODO: slot 7'] }],
+      [
+        'categories',
+        { categories: ['Fiction > Thriller', 'Fiction > Mystery', 'TODO: third category'] },
+      ],
+    ])('flags UNRESOLVED_PLACEHOLDER for %s', (_field, overrides) => {
+      expect(codesOf(makeListing(overrides))).toContain('UNRESOLVED_PLACEHOLDER');
+    });
+
+    it('reports one error even when many fields contain placeholders', () => {
+      const codes = codesOf(
+        makeListing({
+          title: 'TODO: title',
+          subtitle: 'TODO: subtitle',
+          author: 'TODO: author',
+          keywords: Array.from({ length: 7 }, () => 'TODO: keyword'),
+        }),
+      );
+      expect(codes.filter((c) => c === 'UNRESOLVED_PLACEHOLDER')).toHaveLength(1);
+    });
+
+    it('does not flag a bare TODO without a colon', () => {
+      expect(validateListing(makeListing({ title: 'TODO pick a title' })).valid).toBe(true);
+    });
+  });
+
+  describe('disallowed HTML', () => {
+    it('flags DISALLOWED_HTML for a tag outside the allowlist', () => {
+      const result = validateListing(makeListing({ blurb: '<div>Hook</div>' }));
+      expect(result.errors.map((e) => e.code)).toEqual(['DISALLOWED_HTML']);
+      expect(result.errors[0]?.detail).toContain('div');
+    });
+
+    it('matches case-insensitively', () => {
+      expect(codesOf(makeListing({ blurb: '<SPAN>Hook</SPAN>' }))).toEqual(['DISALLOWED_HTML']);
+    });
+
+    it('flags a disallowed closing tag as the same tag', () => {
+      expect(codesOf(makeListing({ blurb: 'Hook</a>' }))).toEqual(['DISALLOWED_HTML']);
+    });
+
+    it('flags tags with attributes', () => {
+      expect(codesOf(makeListing({ blurb: '<a href="https://example.com">Hook</a>' }))).toEqual([
+        'DISALLOWED_HTML',
+      ]);
+    });
+
+    it('reports one error even when several disallowed tags are present', () => {
+      const codes = codesOf(makeListing({ blurb: '<div><span>Hook</span></div><img src="x">' }));
+      expect(codes).toEqual(['DISALLOWED_HTML']);
+    });
+
+    it('does not flag self-closing allowed tags', () => {
