+describe('enqueueWorkItems — InMemoryQueueBackend', () => {
+  it('accumulates entries in .sent array', async () => {
+    const backend = new InMemoryQueueBackend();
+    const items: WorkItem[] = Array.from({ length: 5 }, () =>
+      makeItem('RECONCILE', { repoFullName: 'org/repo' }),
     );
+    await enqueueWorkItems(items, backend);
+    expect(backend.sent).toHaveLength(5);
+  });
+
+  it('entries have correct structure', async () => {
+    const backend = new InMemoryQueueBackend();
+    const item = makeItem('RECONCILE', { repoFullName: 'org/repo' });
+    await enqueueWorkItems([item], backend);
+    expect(backend.sent[0]).toEqual({
+      id: '0',
+      body: JSON.stringify(item),
+      groupId: 'org/repo',
+    });
+  });
+
+  it('.sent starts empty', async () => {
+    const backend = new InMemoryQueueBackend();
+    expect(backend.sent).toHaveLength(0);
+  });
+
+  it('.sent grows on each call', async () => {
+    const backend = new InMemoryQueueBackend();
+    const item = makeItem('RECONCILE');
+    await enqueueWorkItems([item], backend);
+    expect(backend.sent).toHaveLength(1);
+    await enqueueWorkItems([item, item], backend);
+    expect(backend.sent).toHaveLength(3);
+  });
+
+  it('never returns failed IDs', async () => {
+    const backend = new InMemoryQueueBackend();
+    const item = makeItem('RECONCILE');
+    const result = await backend.sendBatch([
+      { id: '0', body: JSON.stringify(item), groupId: 'org/repo' },
+    ]);
+    expect(result.failedIds).toEqual([]);
+  });
+});
+
+describe('enqueueWorkItems — failedIds handling', () => {
+  it('throws RetryableError if backend returns failedIds', async () => {
+    const backend = makeBackend();
+    (backend.sendBatch as ReturnType<typeof vi.fn>).mockResolvedValueOnce({
+      failedIds: ['0', '5'],
+    });
+    const items = Array.from({ length: 10 }, () => makeItem('RECONCILE'));
+    await expect(enqueueWorkItems(items, backend)).rejects.toThrow(
+      'Work items failed to enqueue: 0, 5',
+    );
+  });
+
+  it('error is a RetryableError with correct code', async () => {
+    const backend = makeBackend();
+    (backend.sendBatch as ReturnType<typeof vi.fn>).mockResolvedValueOnce({
+      failedIds: ['3'],
+    });
+    const items = Array.from({ length: 5 }, () => makeItem('RECONCILE'));
+    try {
+      await enqueueWorkItems(items, backend);
+      throw new Error('Should have thrown');
+    } catch (err: unknown) {
+      const error = err as { code?: string; message?: string };
